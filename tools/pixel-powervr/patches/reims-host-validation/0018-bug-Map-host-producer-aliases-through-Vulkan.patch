diff --git a/crates/reims-vgpu-vulkan/examples/producer_memory/imported.rs b/crates/reims-vgpu-vulkan/examples/producer_memory/imported.rs
new file mode 100644
index 0000000..f3036bb
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/producer_memory/imported.rs
@@ -0,0 +1,130 @@
+//! A same-device Vulkan import of the producer's opaque FD for this host diagnostic.
+//!
+//! The FD is an API handle, not a promised POSIX byte layout. Vulkan interprets it and maps
+//! the imported allocation. This helper deliberately requires coherent memory: the producer's
+//! noncoherent native provider has a separate cache/alias qualification on the target device.
+
+use ash::vk;
+use metal2vulkan_runtime as rt;
+use reims_vgpu_vulkan::producer::NativeView;
+use std::error::Error;
+use std::os::fd::{AsRawFd, BorrowedFd, IntoRawFd};
+use std::ptr::NonNull;
+
+pub(super) struct ImportedMapping {
+    device: Option<rt::Device>,
+    memory: vk::DeviceMemory,
+    pointer: Option<NonNull<u8>>,
+    mapped: bool,
+}
+
+// SAFETY: the caller serializes every pointer access through the producer's CPU epoch. The
+// mapping owner only unmaps/frees its own import after those accesses and before lease release.
+unsafe impl Send for ImportedMapping {}
+
+impl ImportedMapping {
+    /// Import an owned duplicate and map it using the actual Vulkan allocation parameters.
+    ///
+    /// # Safety
+    /// `device` is the exact runtime device used to create `view`'s producer. Its exclusive CPU
+    /// epoch stays live until this mapping and every pointer user are gone. No GPU access occurs
+    /// during that interval. The imported memory is never bound to another runtime resource.
+    pub(super) unsafe fn new(
+        device: &rt::Device,
+        view: &NativeView,
+    ) -> Result<Self, Box<dyn Error>> {
+        let info = view.info();
+        let flags = vk::MemoryPropertyFlags::from_raw(info.memory_flags);
+        if !flags.contains(
+            vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT,
+        ) {
+            return Err(
+                "Vulkan-import alias diagnostic requires coherent host-visible memory".into(),
+            );
+        }
+        // SAFETY: the constructor's contract ties this device and allocation together.
+        let raw = unsafe { device.raw() };
+        let usage = vk::BufferUsageFlags::from(device.vk_buffer_usage());
+        let handle = vk::ExternalMemoryHandleTypeFlags::OPAQUE_FD;
+        let query = vk::PhysicalDeviceExternalBufferInfo::default()
+            .usage(usage)
+            .handle_type(handle);
+        let mut support = vk::ExternalBufferProperties::default();
+        // SAFETY: the live device's physical-device query with initialized output.
+        unsafe {
+            raw.instance.get_physical_device_external_buffer_properties(
+                raw.physical_device,
+                &query,
+                &mut support,
+            );
+        }
+        let external = support.external_memory_properties;
+        if !external
+            .external_memory_features
+            .contains(vk::ExternalMemoryFeatureFlags::IMPORTABLE)
+            || !external.compatible_handle_types.contains(handle)
+            || external
+                .external_memory_features
+                .contains(vk::ExternalMemoryFeatureFlags::DEDICATED_ONLY)
+        {
+            return Err("device does not support this non-dedicated opaque-FD import".into());
+        }
+        // SAFETY: view owns this descriptor throughout the duplicate operation.
+        let fd = unsafe { BorrowedFd::borrow_raw(view.fd()) }.try_clone_to_owned()?;
+        let mut import = vk::ImportMemoryFdInfoKHR::default()
+            .handle_type(handle)
+            .fd(fd.as_raw_fd());
+        let mut address =
+            vk::MemoryAllocateFlagsInfo::default().flags(vk::MemoryAllocateFlags::DEVICE_ADDRESS);
+        // OPAQUE_FD imports use the export's allocation size and memory type, never
+        // vkGetMemoryFdPropertiesKHR or an inferred mmap offset.
+        let mut allocation = vk::MemoryAllocateInfo::default()
+            .allocation_size(info.allocation_bytes)
+            .memory_type_index(info.memory_type)
+            .push_next(&mut import);
+        if usage.contains(vk::BufferUsageFlags::SHADER_DEVICE_ADDRESS) {
+            allocation = allocation.push_next(&mut address);
+        }
+        // SAFETY: same device, allocation size/type/flags and a supported live handle. The
+        // producer refuses dedicated allocations; no dedicated binding is being omitted here.
+        let memory = unsafe { raw.device.allocate_memory(&allocation, None) }?;
+        // A successful import consumes the duplicate. On failure above OwnedFd closes it.
+        let _ = fd.into_raw_fd();
+        let mut mapping = Self {
+            device: Some(device.clone()),
+            memory,
+            pointer: None,
+            mapped: false,
+        };
+        // SAFETY: this imported memory handle is owned here and has not yet been mapped.
+        let pointer = unsafe {
+            raw.device
+                .map_memory(memory, 0, vk::WHOLE_SIZE, vk::MemoryMapFlags::empty())
+        }?;
+        mapping.mapped = true;
+        mapping.pointer = Some(NonNull::new(pointer.cast()).ok_or("null imported mapping")?);
+        Ok(mapping)
+    }
+
+    pub(super) fn address(&self) -> Result<NonNull<u8>, Box<dyn Error>> {
+        self.pointer
+            .ok_or_else(|| "imported Vulkan memory is not mapped".into())
+    }
+}
+
+impl Drop for ImportedMapping {
+    fn drop(&mut self) {
+        if let Some(device) = self.device.take() {
+            // SAFETY: every CPU user stopped before the mapping owner is dropped. The import
+            // has no bound resource or GPU use, and each handle is released exactly once.
+            unsafe {
+                let raw = device.raw();
+                if self.mapped {
+                    raw.device.unmap_memory(self.memory);
+                }
+                raw.device.free_memory(self.memory, None);
+            }
+            drop(device);
+        }
+    }
+}
