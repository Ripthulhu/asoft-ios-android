+/// Host awake time for platform cache ages. It deliberately excludes suspend, unlike the
+/// guest-visible monotonic clock, and cannot be mixed with its `MonoTime` deadlines.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct AwakeTime(u64);
+
+impl AwakeTime {
+    /// Awake time since this reading, saturating if the host clock moves backwards.
+    pub(crate) fn elapsed(self) -> Duration {
+        Duration::from_nanos(nanos(libc::CLOCK_MONOTONIC).saturating_sub(self.0))
+    }
+}
+
 impl LinuxClock {
     /// The process's Clock.
     pub fn new() -> LinuxClock {
         LinuxClock
     }
 
+    /// Cache-maintenance time on `CLOCK_MONOTONIC`, preserving Linux `Instant`'s suspend
+    /// semantics without using the guest's sleep-inclusive clock for platform reclamation.
+    pub(crate) fn now_awake(&self) -> AwakeTime {
+        AwakeTime(nanos(libc::CLOCK_MONOTONIC))
+    }
+
