+    /// A particular file's mapping at an address. Holding its descriptor prevents inode reuse,
+    /// but keeps no CPU mapping or surface alive. A later mapping at the same address is not it.
+    pub(crate) struct FileMapping {
+        at: HostAddr,
+        identity: (String, u64, u64),
+        _file: Arc<OwnedFd>,
+    }
+
+    impl FileMapping {
+        pub(crate) fn new(at: HostAddr) -> Self {
+            use std::os::unix::fs::MetadataExt as _;
+
+            let pieces = files::pieces(at.addr().to_u64(), 1).unwrap();
+            let file = Arc::clone(&pieces[0].backing.fd);
+            let identity = Self::identity(at).unwrap();
+            let metadata =
+                std::fs::metadata(format!("/proc/self/fd/{}", file.as_raw_fd())).unwrap();
+            assert_eq!(
+                identity.0,
+                format!(
+                    "{:02x}:{:02x}",
+                    libc::major(metadata.dev()),
+                    libc::minor(metadata.dev())
+                )
+            );
+            assert_eq!(identity.1, metadata.ino());
+            assert_ne!(identity.1, 0, "a file mapping, not anonymous memory");
+            Self {
+                at,
+                identity,
+                _file: file,
+            }
+        }
+
+        fn identity(at: HostAddr) -> Option<(String, u64, u64)> {
+            let first = at.addr().to_u64();
+            let maps = std::fs::read_to_string("/proc/self/maps").unwrap();
+            for line in maps.lines() {
+                let mut fields = line.split_whitespace();
+                let (low, high) = fields.next()?.split_once('-')?;
+                let low = u64::from_str_radix(low, 16).unwrap();
+                let high = u64::from_str_radix(high, 16).unwrap();
+                if !(low..high).contains(&first) {
+                    continue;
+                }
+                let _permissions = fields.next()?;
+                let offset = u64::from_str_radix(fields.next()?, 16).unwrap();
+                let device = fields.next()?.to_owned();
+                let inode = fields.next()?.parse().unwrap();
+                return Some((device, inode, offset + first - low));
+            }
+            None
+        }
+
+        pub(crate) fn is_mapped(&self) -> bool {
+            Self::identity(self.at).as_ref() == Some(&self.identity)
+        }
+    }
+
+    /// Reusing an address does not keep the original file mapping alive. The replacement is
+    /// made over this test's own live reservation, so no unowned mapping is overwritten.
+    #[test]
+    fn a_file_mapping_witness_distinguishes_address_reuse() {
+        let at = allocate_aliasable(page()).unwrap();
+        let witness = FileMapping::new(at);
+        assert!(witness.is_mapped());
+        vm().allocate_fixed_overwrite(at, page()).unwrap();
+        assert!(mapped(at), "the address still has a mapping");
+        assert!(!witness.is_mapped(), "the original file mapping is gone");
+        assert!(vm().deallocate(at, page()).is_success());
+    }
+
