From: Codex <codex@openai.com>
Date: Sat, 21 Nov 2026 22:46:49 +0100
Subject: [PATCH 17/18] :white_check_mark: Track file identity in surface
 lifetime tests

An unrelated mapping can reuse a released surface address before mincore
observes its disappearance. Identify the original file mapping by device,
inode and offset, retaining its descriptor without retaining the mapping.
Add an address-reuse regression and keep the import lifetime assertions.
---
 crates/reims-vgpu-vulkan/src/gpu/device.rs  | 17 ++++-
 crates/reims-vgpu-vulkan/src/os.rs          |  2 +-
 crates/reims-vgpu-vulkan/src/os/linux.rs    |  2 +-
 crates/reims-vgpu-vulkan/src/os/linux/vm.rs | 72 +++++++++++++++++++++
 4 files changed, 88 insertions(+), 5 deletions(-)

diff --git a/crates/reims-vgpu-vulkan/src/gpu/device.rs b/crates/reims-vgpu-vulkan/src/gpu/device.rs
index fe4f3c8..c013274 100644
--- a/crates/reims-vgpu-vulkan/src/gpu/device.rs
+++ b/crates/reims-vgpu-vulkan/src/gpu/device.rs
@@ -2192,6 +2192,14 @@ pub(crate) mod tests {
         let imports = || d.raw.work_counts().host_imports_live;
         for (surface, cores) in surfaces {
             let base = surface.base_address();
+            // mincore alone also sees an unrelated mapping that later reused the address.
+            // The surface's own file can be identified without retaining its CPU mapping.
+            let original = (!cores).then(|| crate::os::FileMapping::new(base));
+            let still_mapped = || {
+                original
+                    .as_ref()
+                    .map_or_else(|| crate::os::mapped(base), |file| file.is_mapped())
+            };
             let before = imports();
             let texture = d
                 .new_texture_on_surface(&bgra(64, 32, 0), Some(&surface), 0)
@@ -2200,7 +2208,7 @@ pub(crate) mod tests {
             assert_eq!(imports(), before + 1, "imported (core's mapping: {cores})");
             // Whether the surface's memory is mapped, or the device no longer imports it: read in
             // that order, as the runtime frees the import before it lets the memory go.
-            let mapped_while_imported = || crate::os::mapped(base) || imports() == before;
+            let mapped_while_imported = || still_mapped() || imports() == before;
             let (words, read, held) = (buffer(16), buffer(16), buffer(8));
             let word = |i: usize| {
                 // SAFETY: one of the buffer's four words, which the kernel reads and writes.
@@ -2296,9 +2304,12 @@ pub(crate) mod tests {
                         mapped_while_imported(),
                         "mapped while imported (core's mapping: {cores})"
                     );
-                    !crate::os::mapped(base)
+                    !still_mapped()
                 }),
-                "unmapped once the import was freed (core's mapping: {cores})"
+                "unmapped once the import was freed (core's mapping: {cores}, imports: {}, \
+                 before: {before}, unmap held: {})",
+                imports(),
+                crate::remap::unmap_waits(base, LEN),
             );
             assert_eq!(imports(), before, "freed (core's mapping: {cores})");
         }
