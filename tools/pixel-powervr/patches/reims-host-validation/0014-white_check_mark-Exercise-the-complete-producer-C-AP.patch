+/* The producer API is callable from this same C ABI, including its refusals. The Vulkan
+ * build also requires an actual cached allocation and a complete CPU/export/GPU handoff;
+ * another platform must report unsupported without writing the output handle. */
+static void check_producer(void) {
+    RvgProducer *producer = NULL;
+    RvgProducerCpu *cpu = NULL;
+    RvgProducerNative *native = NULL;
+    RvgProducerInfo info = {0};
+    void *address = NULL;
+    uint64_t epoch = 0;
+    int32_t fd = -1;
+    uint32_t word = 0;
+    CHECK_STATUS(rvg_producer_create(32768, NULL), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_info(NULL, &info, sizeof info), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_upload(NULL, &word, sizeof word), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_download(NULL, &word, sizeof word), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_cpu_begin(NULL, &cpu), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_cpu_pointer(NULL, &address, &epoch), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_cpu_end(NULL), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_native_export(NULL, &native, &fd), RVG_ERR_INVALID_ARGUMENT);
+    CHECK_STATUS(rvg_producer_native_retire(NULL), RVG_ERR_INVALID_ARGUMENT);
+    CHECK(cpu == NULL && native == NULL && address == NULL && epoch == 0 && fd == -1);
+    rvg_producer_native_release(NULL);
+    rvg_producer_cpu_release(NULL);
+    rvg_producer_release(NULL);
+
+#if defined(RVG_TEST_VULKAN_PRODUCER)
+    RvgStatus created = rvg_producer_create(32768, &producer);
+    CHECK_STATUS(created, RVG_OK);
+    CHECK(producer != NULL);
+    if (created != RVG_OK || !producer) {
+        return;
+    }
+    CHECK_STATUS(rvg_producer_info(producer, &info, sizeof info), RVG_OK);
+    CHECK(info.struct_size == sizeof info && info.logical_bytes == 32768);
+    CHECK(info.allocation_bytes >= info.logical_bytes && info.reserved == 0);
+    CHECK(info.allocation_id != 0 && info.runtime_object_id != 0);
+    CHECK(info.flushes == 0 && info.invalidates == 0 && info.completed_submissions == 0);
+    uint64_t allocation_id = info.allocation_id;
+    uint64_t object_id = info.runtime_object_id;
+    uint32_t expected[8192], readback[8192] = {0};
+    for (size_t i = 0; i < 8192; i++) {
+        expected[i] = 0x6a1b2c30u ^ (uint32_t)i;
+    }
+    CHECK_STATUS(rvg_producer_upload(producer, expected, sizeof expected), RVG_OK);
+    CHECK_STATUS(rvg_producer_cpu_begin(producer, &cpu), RVG_OK);
+    CHECK(cpu != NULL);
+    if (!cpu) {
+        rvg_producer_release(producer);
+        return;
+    }
+    CHECK_STATUS(rvg_producer_cpu_pointer(cpu, &address, &epoch), RVG_OK);
+    CHECK(address != NULL && epoch != 0);
+    if (address) {
+        CHECK(memcmp(address, expected, sizeof expected) == 0);
+        ((uint32_t *)address)[4098] = 0x91a2b3c4u;
+        expected[4098] = 0x91a2b3c4u;
+    }
+    CHECK_STATUS(rvg_producer_native_export(cpu, &native, &fd), RVG_OK);
+    CHECK(native != NULL && fd >= 0);
+    if (native) {
+        CHECK_STATUS(rvg_producer_cpu_end(cpu), RVG_ERR_PRODUCER_STATE);
+        CHECK_STATUS(rvg_producer_upload(producer, expected, sizeof expected), RVG_ERR_PRODUCER_STATE);
+        /* No recipient or mapping was created, so this borrowed descriptor is quiescent. */
+        CHECK_STATUS(rvg_producer_native_retire(native), RVG_OK);
+        CHECK_STATUS(rvg_producer_native_retire(native), RVG_ERR_PRODUCER_STATE);
+        rvg_producer_native_release(native);
+    }
+    CHECK_STATUS(rvg_producer_cpu_end(cpu), RVG_OK);
+    CHECK_STATUS(rvg_producer_cpu_end(cpu), RVG_ERR_PRODUCER_STATE);
+    rvg_producer_cpu_release(cpu);
+    CHECK_STATUS(rvg_producer_download(producer, readback, sizeof readback), RVG_OK);
+    CHECK(memcmp(readback, expected, sizeof expected) == 0);
+    CHECK_STATUS(rvg_producer_info(producer, &info, sizeof info), RVG_OK);
+    CHECK(info.allocation_id == allocation_id && info.runtime_object_id == object_id);
+    CHECK(info.flushes == 2 && info.invalidates == 2 && info.completed_submissions == 2);
+    rvg_producer_release(producer);
+#else
+    CHECK_STATUS(rvg_producer_create(32768, &producer), RVG_ERR_PRODUCER_UNSUPPORTED);
+    CHECK(producer == NULL);
+#endif
+}
+
