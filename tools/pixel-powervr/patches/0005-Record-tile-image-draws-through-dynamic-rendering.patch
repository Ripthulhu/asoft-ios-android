+#[test]
+fn unsupported_dynamic_shapes_are_typed_refusals() {
+    let mutations: [fn(&mut PassShape); 8] = [
+        |s| s.samples = 4,
+        |s| s.fetch_inputs = true,
+        |s| s.no_inputs.push(0).unwrap(),
+        |s| s.storage.push(0).unwrap(),
+        |s| s.view_mask = 3,
+        |s| s.locations.push(Some(2)).unwrap(),
+        |s| s.color_resolves[0] = s.colors[0],
+        |s| {
+            s.depth_stencil_resolve = Some((
+                metal2vulkan::vk::Format::D32_SFLOAT,
+                crate::resolve::ResolveMode::SampleZero,
+                crate::resolve::ResolveMode::None,
+            ))
+        },
+    ];
+    for mutation in mutations {
+        let mut shape = shape();
+        mutation(&mut shape);
+        assert!(matches!(
+            Formats::of(&shape),
+            Err(Error::NotImplemented(RuntimeGap::TileImageRendering))
+        ));
+    }
+    assert!(matches!(
+        Pass::new(
+            &shape(),
+            &[super::super::KEEP; 2],
+            None,
+            Feedback(1),
+            vk::ImageLayout::GENERAL
+        ),
+        Err(Error::NotImplemented(RuntimeGap::TileImageRendering))
+    ));
+}
