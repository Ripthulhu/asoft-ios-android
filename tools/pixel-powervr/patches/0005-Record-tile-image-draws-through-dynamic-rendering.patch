+//! The compiler metadata's device gate, and one attachment contract shared by the pipeline,
+//! secondary inheritance and primary's dynamic rendering. No driver or tile extension is faked.
+
+use super::{tile_reads, Formats, Pass};
+use crate::color_list::ColorList;
+use crate::error::{Error, RuntimeGap};
+use crate::render_target::{Feedback, Ops, PassShape};
+use ash::vk::{self, Handle};
+use metal2vulkan::device::{ApiVersion, EnableSet, VkExtension, VkFeature};
+use metal2vulkan::pipeline::{GraphicsState, SampledType, TileImageAttachmentUse};
+
+fn shape() -> PassShape {
+    let mut shape = crate::attachmentless::shape(1, 0);
+    shape.dynamic_rendering = true;
+    shape.colors = ColorList::of([
+        Some(metal2vulkan::vk::Format::R8G8B8A8_UNORM),
+        None,
+        Some(metal2vulkan::vk::Format::R32_UINT),
+    ])
+    .unwrap();
+    shape.color_resolves = ColorList::of([None, None, None]).unwrap();
+    shape
+}
+
+#[test]
+fn tile_metadata_needs_the_enabled_extension_and_both_features_at_vulkan_13() {
+    let mut graphics = GraphicsState::new(
+        metal2vulkan::vk::PrimitiveTopology::TRIANGLE_LIST,
+        metal2vulkan::vk::SampleCountFlags::from_raw(1),
+    );
+    assert_eq!(
+        tile_reads(&graphics, ApiVersion::V1_2, &EnableSet::new()),
+        Ok(false)
+    );
+    graphics
+        .tile_image_attachments
+        .push(TileImageAttachmentUse::new(2, SampledType::Uint));
+    for mask in 0..8 {
+        let mut enabled = EnableSet::new();
+        if mask & 1 != 0 {
+            enabled.features.insert(VkFeature::DynamicRendering);
+        }
+        if mask & 2 != 0 {
+            enabled
+                .features
+                .insert(VkFeature::ShaderTileImageColorReadAccess);
+        }
+        if mask & 4 != 0 {
+            enabled.extensions.insert(VkExtension::ExtShaderTileImage);
+        }
+        let refused = Err(Error::NotImplemented(RuntimeGap::TileImageRendering));
+        assert_eq!(tile_reads(&graphics, ApiVersion::V1_2, &enabled), refused);
+        assert_eq!(
+            tile_reads(&graphics, ApiVersion::V1_3, &enabled),
+            if mask == 7 { Ok(true) } else { refused },
+            "enable mask {mask}"
+        );
+    }
+}
+
+#[test]
+fn dynamic_pipeline_and_secondary_keep_attachment_holes_and_each_depth_stencil_aspect() {
+    for (format, has_depth, has_stencil) in [
+        (None, false, false),
+        (Some(metal2vulkan::vk::Format::D32_SFLOAT), true, false),
+        (Some(metal2vulkan::vk::Format::S8_UINT), false, true),
+        (
+            Some(metal2vulkan::vk::Format::D32_SFLOAT_S8_UINT),
+            true,
+            true,
+        ),
+    ] {
+        let mut shape = shape();
+        shape.depth_stencil = format;
+        let formats = Formats::of(&shape).unwrap();
+        let pipeline = formats.pipeline();
+        let inheritance = formats.inheritance();
+        assert_eq!(pipeline.color_attachment_count, 3);
+        assert_eq!(inheritance.color_attachment_count, 3);
+        // SAFETY: both infos borrow the live `formats` array, of the count above.
+        let (pipeline_colors, inherited_colors) = unsafe {
+            (
+                std::slice::from_raw_parts(pipeline.p_color_attachment_formats, 3),
+                std::slice::from_raw_parts(inheritance.p_color_attachment_formats, 3),
+            )
+        };
+        assert!(
+            pipeline_colors
+                == [
+                    vk::Format::R8G8B8A8_UNORM,
+                    vk::Format::UNDEFINED,
+                    vk::Format::R32_UINT
+                ]
+        );
+        assert!(pipeline_colors == inherited_colors);
+        let raw = format.map_or(vk::Format::UNDEFINED, Into::into);
+        assert!(
+            pipeline.depth_attachment_format
+                == if has_depth {
+                    raw
+                } else {
+                    vk::Format::UNDEFINED
+                }
+        );
+        assert!(
+            pipeline.stencil_attachment_format
+                == if has_stencil {
+                    raw
+                } else {
+                    vk::Format::UNDEFINED
+                }
+        );
+        assert!(pipeline.depth_attachment_format == inheritance.depth_attachment_format);
+        assert!(pipeline.stencil_attachment_format == inheritance.stencil_attachment_format);
+        assert!(inheritance.rasterization_samples == vk::SampleCountFlags::TYPE_1);
+        assert!(inheritance.flags.is_empty());
+        assert_eq!(inheritance.view_mask, 0);
+    }
+}
+
+#[test]
+fn dynamic_primary_uses_packed_views_but_identity_color_locations_and_independent_aspect_ops() {
+    let mut shape = shape();
+    shape.depth_stencil = Some(metal2vulkan::vk::Format::D32_SFLOAT_S8_UINT);
+    let clear_store = Ops {
+        load: vk::AttachmentLoadOp::CLEAR,
+        store: vk::AttachmentStoreOp::STORE,
+        stencil_load: vk::AttachmentLoadOp::LOAD,
+        stencil_store: vk::AttachmentStoreOp::DONT_CARE,
+    };
+    let depth_layout = vk::ImageLayout::DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    let pass = Pass::new(
+        &shape,
+        &[clear_store, super::super::KEEP],
+        Some(clear_store),
+        Feedback::NONE,
+        depth_layout,
+    )
+    .unwrap();
+    let views = [
+        vk::ImageView::from_raw(10),
+        vk::ImageView::from_raw(20),
+        vk::ImageView::from_raw(30),
+    ];
+    let clear = vk::ClearValue {
+        color: vk::ClearColorValue {
+            uint32: [7, 0, 0, 0],
+        },
+    };
+    let depth = vk::ClearValue {
+        depth_stencil: vk::ClearDepthStencilValue {
+            depth: 0.75,
+            stencil: 19,
+        },
+    };
+    let rendering = pass.rendering(&views, &[clear, clear, depth], 2).unwrap();
+    let info = rendering.info(vk::Rect2D::default().extent(vk::Extent2D {
+        width: 17,
+        height: 23,
+    }));
+    assert_eq!(info.color_attachment_count, 3);
+    assert_eq!(info.layer_count, 2);
+    assert_eq!(info.view_mask, 0);
+    assert!(info.flags == vk::RenderingFlags::CONTENTS_SECONDARY_COMMAND_BUFFERS);
+    assert!(rendering.colors[0].image_view == views[0]);
+    assert!(rendering.colors[1].image_view == vk::ImageView::null());
+    assert!(rendering.colors[2].image_view == views[1]);
+    assert!(rendering.colors[0].load_op == vk::AttachmentLoadOp::CLEAR);
+    assert!(rendering.colors[2].load_op == vk::AttachmentLoadOp::LOAD);
+    assert!(rendering.colors[2].store_op == vk::AttachmentStoreOp::STORE);
+    assert!(rendering.colors[0].image_layout == vk::ImageLayout::GENERAL);
+    let depth = rendering.depth.unwrap();
+    let stencil = rendering.stencil.unwrap();
+    assert!(depth.image_view == views[2] && stencil.image_view == views[2]);
+    assert!(depth.image_layout == depth_layout && stencil.image_layout == depth_layout);
+    assert!(depth.load_op == vk::AttachmentLoadOp::CLEAR);
+    assert!(depth.store_op == vk::AttachmentStoreOp::STORE);
+    assert!(stencil.load_op == vk::AttachmentLoadOp::LOAD);
+    assert!(stencil.store_op == vk::AttachmentStoreOp::DONT_CARE);
+    // SAFETY: these values were supplied as depth/stencil clears above.
+    unsafe {
+        assert_eq!(depth.clear_value.depth_stencil.depth, 0.75);
+        assert_eq!(stencil.clear_value.depth_stencil.stencil, 19);
+    }
+}
