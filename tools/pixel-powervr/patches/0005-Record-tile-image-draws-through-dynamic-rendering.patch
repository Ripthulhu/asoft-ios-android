+
+    /// The deferred secondary outlives the stack on which its inheritance was constructed.
+    #[test]
+    fn dynamic_inheritance_copies_its_color_formats() {
+        let mut log = Log::new(vk::CommandBufferLevel::SECONDARY);
+        let mut colors = [
+            vk::Format::R8G8B8A8_UNORM,
+            vk::Format::UNDEFINED,
+            vk::Format::R32_UINT,
+        ];
+        let mut rendering = vk::CommandBufferInheritanceRenderingInfo::default()
+            .color_attachment_formats(&colors)
+            .depth_attachment_format(vk::Format::D32_SFLOAT)
+            .rasterization_samples(vk::SampleCountFlags::TYPE_1);
+        let inheritance = vk::CommandBufferInheritanceInfo::default().push_next(&mut rendering);
+        let begin = vk::CommandBufferBeginInfo::default()
+            .flags(vk::CommandBufferUsageFlags::RENDER_PASS_CONTINUE)
+            .inheritance_info(&inheritance);
+        // SAFETY: all structures and their format array are live for this recording call.
+        assert!(unsafe { log.begin_command_buffer(&begin) } == vk::Result::SUCCESS);
+        colors.fill(vk::Format::R16_SFLOAT);
+        let inherited = log.inheritance.unwrap().rendering.unwrap();
+        assert!(
+            log.formats.get(inherited.colors)
+                == [
+                    vk::Format::R8G8B8A8_UNORM,
+                    vk::Format::UNDEFINED,
+                    vk::Format::R32_UINT
+                ]
+        );
+        assert!(inherited.depth == vk::Format::D32_SFLOAT);
+        assert!(inherited.samples == vk::SampleCountFlags::TYPE_1);
+        log.clear(vk::CommandBufferLevel::SECONDARY);
+        assert!(log.formats.0.is_empty() && log.inheritance.is_none());
+    }
