@@ -0,0 +1,249 @@
+//! Dynamic rendering for coherent color tile-image reads. The same formats describe the
+//! pipeline and its secondary's inheritance; the same load/store operations describe a legacy
+//! pass and its dynamic counterpart. Color images stay in `GENERAL`. Depth/stencil images use
+//! the parent's explicit layout barriers, never an implicit render-pass transition.
+//!
+//! Each tile-reading draw currently records in its own instance. The barriers between instances
+//! run outside rendering, where the runtime's general memory dependencies are legal. Legacy
+//! in-pass barriers include accesses which `VK_EXT_shader_tile_image` does not permit inside
+//! dynamic rendering, so they must not be reused here.
+
+use super::{Feedback, Ops, PassShape};
+use crate::error::{internal, Error, RuntimeGap};
+use ash::vk;
+use metal2vulkan::device::{ApiVersion, EnableSet, VkExtension, VkFeature};
+use metal2vulkan::pipeline::GraphicsState;
+
+/// The formats shared by a dynamic graphics pipeline and its secondary command buffer.
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct Formats {
+    colors: Vec<vk::Format>,
+    depth: vk::Format,
+    stencil: vk::Format,
+}
+
+/// A tile-image use outside the runtime's recorded forms.
+pub(crate) fn refused() -> Error {
+    Error::NotImplemented(RuntimeGap::TileImageRendering)
+}
+
+/// Whether the compiler's descriptor-free attachment reads require this rendering route.
+/// Metadata alone cannot enable it: the logical device must have both actual feature members,
+/// the extension and its Vulkan 1.3 dependency. Ordinary shaders need none of the tile features.
+pub(crate) fn tile_reads(
+    graphics: &GraphicsState,
+    api: ApiVersion,
+    enabled: &EnableSet,
+) -> Result<bool, Error> {
+    if graphics.tile_image_attachments.is_empty() {
+        return Ok(false);
+    }
+    if api < ApiVersion::V1_3
+        || !enabled.features.contains(&VkFeature::DynamicRendering)
+        || !enabled
+            .features
+            .contains(&VkFeature::ShaderTileImageColorReadAccess)
+        || !enabled
+            .extensions
+            .contains(&VkExtension::ExtShaderTileImage)
+    {
+        return Err(refused());
+    }
+    Ok(true)
+}
+
+impl Formats {
+    /// The single-sample, identity-mapped attachment formats of `shape`. Ordinary depth and
+    /// stencil coattachments are included, but no input attachments, storage exclusions,
+    /// resolves, multiview or remapped color locations.
+    pub(crate) fn of(shape: &PassShape) -> Result<Self, Error> {
+        if shape.samples != 1
+            || shape.fetch_inputs
+            || !shape.storage.is_empty()
+            || !shape.no_inputs.is_empty()
+            || shape.view_mask != 0
+            || !shape.locations.is_empty()
+            || shape.color_resolves.iter().any(Option::is_some)
+            || shape.depth_stencil_resolve.is_some()
+        {
+            return Err(refused());
+        }
+        let format = shape
+            .depth_stencil
+            .map_or(vk::Format::UNDEFINED, Into::into);
+        let (depth, stencil) = match format {
+            vk::Format::UNDEFINED => (false, false),
+            vk::Format::D16_UNORM | vk::Format::X8_D24_UNORM_PACK32 | vk::Format::D32_SFLOAT => {
+                (true, false)
+            }
+            vk::Format::S8_UINT => (false, true),
+            vk::Format::D16_UNORM_S8_UINT
+            | vk::Format::D24_UNORM_S8_UINT
+            | vk::Format::D32_SFLOAT_S8_UINT => (true, true),
+            _ => {
+                return Err(internal(
+                    "a dynamic depth/stencil attachment of a color format",
+                ))
+            }
+        };
+        Ok(Self {
+            colors: shape
+                .colors
+                .iter()
+                .map(|format| format.map_or(vk::Format::UNDEFINED, Into::into))
+                .collect(),
+            depth: if depth { format } else { vk::Format::UNDEFINED },
+            stencil: if stencil {
+                format
+            } else {
+                vk::Format::UNDEFINED
+            },
+        })
+    }
+
+    /// A graphics pipeline of these formats, with a null `renderPass`.
+    pub(crate) fn pipeline(&self) -> vk::PipelineRenderingCreateInfo<'_> {
+        vk::PipelineRenderingCreateInfo::default()
+            .color_attachment_formats(&self.colors)
+            .depth_attachment_format(self.depth)
+            .stencil_attachment_format(self.stencil)
+    }
+
+    /// A secondary executed by an instance of these formats. The contents flag belongs to the
+    /// primary's `VkRenderingInfo`, not the inheritance flags.
+    pub(crate) fn inheritance(&self) -> vk::CommandBufferInheritanceRenderingInfo<'_> {
+        vk::CommandBufferInheritanceRenderingInfo::default()
+            .color_attachment_formats(&self.colors)
+            .depth_attachment_format(self.depth)
+            .stencil_attachment_format(self.stencil)
+            .rasterization_samples(vk::SampleCountFlags::TYPE_1)
+    }
+}
+
+/// A dynamic pass's formats and the attachment operations selected by `final_pass`.
+pub(crate) struct Pass {
+    pub(crate) formats: Formats,
+    colors: Vec<Ops>,
+    depth_stencil: Option<Ops>,
+    depth_layout: vk::ImageLayout,
+}
+
+impl Pass {
+    /// A pass of `shape` with the parent's packed attachment operations. Feedback-loop images
+    /// and resolve operations need their own implementation and remain typed refusals.
+    pub(super) fn new(
+        shape: &PassShape,
+        colors: &[Ops],
+        depth_stencil: Option<Ops>,
+        feedback: Feedback,
+        depth_layout: vk::ImageLayout,
+    ) -> Result<Self, Error> {
+        let formats = Formats::of(shape)?;
+        if feedback != Feedback::NONE {
+            return Err(refused());
+        }
+        if colors.len() != shape.colors.iter().flatten().count()
+            || depth_stencil.is_some() != shape.depth_stencil.is_some()
+        {
+            return Err(internal(
+                "dynamic attachment operations disagree with their formats",
+            ));
+        }
+        Ok(Self {
+            formats,
+            colors: colors.to_vec(),
+            depth_stencil,
+            depth_layout,
+        })
+    }
+
+    /// Attach `views` (packed colors, then the depth/stencil view) and their matching clear
+    /// values, retaining holes in the color locations in the dynamic rendering contract.
+    pub(super) fn rendering(
+        &self,
+        views: &[vk::ImageView],
+        clear_values: &[vk::ClearValue],
+        layers: u32,
+    ) -> Result<Rendering, Error> {
+        let count = self.colors.len() + usize::from(self.depth_stencil.is_some());
+        if views.len() != count || clear_values.len() != count || layers == 0 {
+            return Err(internal(
+                "dynamic attachment views disagree with their operations",
+            ));
+        }
+        let mut packed = 0;
+        let mut colors = Vec::with_capacity(self.formats.colors.len());
+        for &format in &self.formats.colors {
+            if format == vk::Format::UNDEFINED {
+                colors.push(vk::RenderingAttachmentInfo::default());
+                continue;
+            }
+            let ops = self.colors[packed];
+            colors.push(
+                vk::RenderingAttachmentInfo::default()
+                    .image_view(views[packed])
+                    .image_layout(vk::ImageLayout::GENERAL)
+                    .load_op(ops.load)
+                    .store_op(ops.store)
+                    .clear_value(clear_values[packed]),
+            );
+            packed += 1;
+        }
+        let mut depth = None;
+        let mut stencil = None;
+        if let Some(ops) = self.depth_stencil {
+            let attachment = vk::RenderingAttachmentInfo::default()
+                .image_view(views[packed])
+                .image_layout(self.depth_layout)
+                .clear_value(clear_values[packed]);
+            if self.formats.depth != vk::Format::UNDEFINED {
+                depth = Some(attachment.load_op(ops.load).store_op(ops.store));
+            }
+            if self.formats.stencil != vk::Format::UNDEFINED {
+                stencil = Some(
+                    attachment
+                        .load_op(ops.stencil_load)
+                        .store_op(ops.stencil_store),
+                );
+            }
+        }
+        Ok(Rendering {
+            colors,
+            depth,
+            stencil,
+            layers,
+        })
+    }
+}
+
+/// A dynamic rendering instance. The owning framebuffer retains the attachment views' textures
+/// through the encoder, just as the legacy framebuffer does. These structures have no `pNext`
+/// allocations; copies retain only handles, values and operations.
+#[derive(Clone)]
+pub(crate) struct Rendering {
+    colors: Vec<vk::RenderingAttachmentInfo<'static>>,
+    depth: Option<vk::RenderingAttachmentInfo<'static>>,
+    stencil: Option<vk::RenderingAttachmentInfo<'static>>,
+    layers: u32,
+}
+
+impl Rendering {
+    /// This instance's begin info. Each instance executes secondary command buffers.
+    pub(crate) fn info(&self, area: vk::Rect2D) -> vk::RenderingInfo<'_> {
+        let mut info = vk::RenderingInfo::default()
+            .flags(vk::RenderingFlags::CONTENTS_SECONDARY_COMMAND_BUFFERS)
+            .render_area(area)
+            .layer_count(self.layers)
+            .color_attachments(&self.colors);
+        if let Some(depth) = &self.depth {
+            info = info.depth_attachment(depth);
+        }
+        if let Some(stencil) = &self.stencil {
+            info = info.stencil_attachment(stencil);
+        }
+        info
+    }
+}
+
+#[cfg(test)]
+mod tests;
