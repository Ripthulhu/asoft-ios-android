                 && (has.generated_commands || !GENERATED_COMMANDS_CALLS.contains(&call))
                 && (has.sparse_binding || !SPARSE_CALLS.contains(&call))
                 && (has.push_descriptor || !PUSH_DESCRIPTOR_CALLS.contains(&call))
@@ -513,6 +522,10 @@ struct RenderStep {
     commands: vk::CommandPool,
     render_pass: vk::RenderPass,
     framebuffer: vk::Framebuffer,
+    /// The legacy pass leaves this color view in `COLOR_ATTACHMENT_OPTIMAL`; the dynamic
+    /// priming instance uses it there too, with no draws and no submission.
+    color_view: vk::ImageView,
+    dynamic_rendering: bool,
     layout: vk::PipelineLayout,
     cache: vk::PipelineCache,
     buffer: vk::Buffer,
@@ -870,7 +883,12 @@ impl Primer<'_> {
     /// # Safety
     ///
     /// As [`prime`]'s.
-    unsafe fn objects(&mut self, queue_family: u32, device_addresses: bool) -> Result<(), Error> {
+    unsafe fn objects(
+        &mut self,
+        queue_family: u32,
+        device_addresses: bool,
+        dynamic_rendering: bool,
+    ) -> Result<(), Error> {
         let device = self.device;
         // SAFETY: the caller's, for every call below; each object is this priming's.
         unsafe {
@@ -1307,6 +1325,8 @@ impl Primer<'_> {
                 commands,
                 render_pass,
                 framebuffer,
+                color_view: view,
+                dynamic_rendering,
                 layout,
                 cache,
                 buffer,
@@ -1333,6 +1353,8 @@ impl Primer<'_> {
             commands,
             render_pass,
             framebuffer,
+            color_view,
+            dynamic_rendering,
             layout,
             cache,
             buffer,
@@ -1536,6 +1558,43 @@ impl Primer<'_> {
             self.made(Call::CmdExecuteCommands);
             device.cmd_end_render_pass(recorded);
             self.made(Call::CmdEndRenderPass);
+            if dynamic_rendering {
+                // The runtime executes dynamic instances through inherited secondaries. Prime
+                // that command shape too: the same color format, no legacy render pass, and
+                // owned attachment information live for the calls. This recording is never
+                // submitted and needs no tile-image shader or feature.
+                let draws = self.allocate_command_buffer(&allocate)?;
+                let formats = [vk::Format::R8G8B8A8_UNORM];
+                let mut rendering = vk::CommandBufferInheritanceRenderingInfo::default()
+                    .color_attachment_formats(&formats)
+                    .rasterization_samples(vk::SampleCountFlags::TYPE_1);
+                let inheritance =
+                    vk::CommandBufferInheritanceInfo::default().push_next(&mut rendering);
+                let begin = vk::CommandBufferBeginInfo::default()
+                    .flags(
+                        vk::CommandBufferUsageFlags::ONE_TIME_SUBMIT
+                            | vk::CommandBufferUsageFlags::RENDER_PASS_CONTINUE,
+                    )
+                    .inheritance_info(&inheritance);
+                device.begin_command_buffer(draws, &begin).map_err(vulkan)?;
+                device.end_command_buffer(draws).map_err(vulkan)?;
+                Barrier::everything().record(device, recorded);
+                let colors = [vk::RenderingAttachmentInfo::default()
+                    .image_view(color_view)
+                    .image_layout(vk::ImageLayout::COLOR_ATTACHMENT_OPTIMAL)
+                    .load_op(vk::AttachmentLoadOp::DONT_CARE)
+                    .store_op(vk::AttachmentStoreOp::DONT_CARE)];
+                let rendering = vk::RenderingInfo::default()
+                    .flags(vk::RenderingFlags::CONTENTS_SECONDARY_COMMAND_BUFFERS)
+                    .render_area(area)
+                    .layer_count(1)
+                    .color_attachments(&colors);
+                device.cmd_begin_rendering(recorded, &rendering);
+                self.made(Call::CmdBeginRendering);
+                device.cmd_execute_commands(recorded, &[draws]);
+                device.cmd_end_rendering(recorded);
+                self.made(Call::CmdEndRendering);
+            }
         }
         Ok(())
     }
