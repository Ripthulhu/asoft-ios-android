diff --git a/crates/metal2vulkan-runtime/src/render/dynamic_tests.rs b/crates/metal2vulkan-runtime/src/render/dynamic_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c8e10e061f39673f2d07acbd119b86531716d9a9
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/render/dynamic_tests.rs
@@ -0,0 +1,250 @@
+//! Execute the runtime's dynamic pipeline, secondary inheritance, command recorder and split
+//! load/store path with ordinary owned shaders. This proves that plumbing on a Vulkan 1.3
+//! device without requiring or pretending to test `VK_EXT_shader_tile_image` instructions.
+//! The production tile-metadata gate is tested separately in `render_target::dynamic`.
+
+use super::{inline_first, Next, RenderCommandEncoder};
+use crate::device::lock;
+use crate::{
+    BlitOption, ClearColor, DebugMessage, Device, DeviceKind, DeviceOptions, LoadAction,
+    MessageSeverity, MessageSink, Origin, PipelineOptions, RenderPassDescriptor,
+    RenderPipelineState, ResourceOptions, ShaderCacheOptions, Size, StoreAction, TextureDescriptor,
+};
+use metal2vulkan::bind::ViewSetup;
+use metal2vulkan::device::{ApiVersion, VkFeature};
+use metal2vulkan::metal::state::DepthStencilDescriptor;
+use metal2vulkan::metal::{
+    BarrierScope, CompareFunction, PixelFormat, PrimitiveType, RenderStages, StencilOperation,
+    TextureUsage,
+};
+use metal2vulkan::pipeline::{ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource};
+use std::ffi::CString;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+const SIDE: u64 = 32;
+
+struct Scratch(PathBuf);
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn validation_layer() -> Option<CString> {
+    let name = c"VK_LAYER_KHRONOS_validation";
+    let entry = crate::device::create::open_loader(None).ok()?;
+    // SAFETY: listing an open loader's layers needs no instance.
+    let layers = unsafe { entry.enumerate_instance_layer_properties() }.ok()?;
+    layers
+        .iter()
+        .any(|layer| layer.layer_name_as_c_str().is_ok_and(|n| n == name))
+        .then(|| name.to_owned())
+}
+
+fn watched(cache: &Path) -> (Device, Arc<Mutex<Vec<String>>>) {
+    let failures = Arc::new(Mutex::new(Vec::new()));
+    let reported = Arc::clone(&failures);
+    let sink = MessageSink::new(move |message: &DebugMessage| {
+        let fails = message.severity == MessageSeverity::Error
+            || (message.severity == MessageSeverity::Warning && message.kind.validation);
+        if fails && message.degradation.is_none() {
+            lock(&reported).push(format!("{}: {}", message.id_name, message.text));
+        }
+    });
+    let options = DeviceOptions {
+        kinds: if cfg!(m2v_cpu_icd) {
+            vec![DeviceKind::Cpu]
+        } else {
+            vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ]
+        },
+        instance_api_version: Some(ApiVersion::V1_3),
+        // The device's normal input-attachment pass is a different contract. The test selects
+        // the same no-ROAA layout a tile-image-only device uses, while compiling ordinary shaders.
+        withheld_features: [VkFeature::RasterizationOrderColorAttachmentAccess].into(),
+        shader_cache: ShaderCacheOptions {
+            directory: Some(cache.to_owned()),
+            ..ShaderCacheOptions::default()
+        },
+        layers: validation_layer().into_iter().collect(),
+        messages: Some(sink),
+        ..DeviceOptions::default()
+    };
+    (Device::system_default_with(&options).unwrap(), failures)
+}
+
+fn state(device: &Device) -> RenderPipelineState {
+    let ll = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/fixtures/public/engine/tob_renders.ll");
+    let bitcode = metal2vulkan_devtools::llvm_assemble(&ll).unwrap();
+    let library = metal2vulkan::library::Library::from_air(&bitcode).unwrap();
+    let library = device.new_library_with_compile_library(library);
+    let vertex = library.new_function_with_name("tob_rect").unwrap();
+    let fragment = library.new_function_with_name("tob_solid").unwrap();
+    let mut descriptor =
+        RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+    descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+    descriptor.color_attachments[0] = Some(ColorAttachmentDescriptor::new(PixelFormat::RGBA8Unorm));
+    descriptor.depth_format = Some(PixelFormat::Depth32FloatStencil8);
+    descriptor.stencil_format = Some(PixelFormat::Depth32FloatStencil8);
+    device
+        .new_render_pipeline_state(&descriptor, &PipelineOptions::default())
+        .unwrap()
+}
+
+fn floats(values: [f32; 4]) -> Vec<u8> {
+    values.into_iter().flat_map(f32::to_le_bytes).collect()
+}
+
+fn fill(encoder: &mut RenderCommandEncoder, rect: [u64; 4], color: [f32; 4]) {
+    let [x0, y0, x1, y1] = rect;
+    let x = |p: u64| p as f32 / SIDE as f32 * 2.0 - 1.0;
+    let y = |p: u64| 1.0 - p as f32 / SIDE as f32 * 2.0;
+    encoder
+        .set_vertex_bytes(&floats([x(x0), y(y1), x(x1), y(y0)]), 0)
+        .unwrap();
+    encoder.set_fragment_bytes(&floats(color), 0).unwrap();
+    encoder
+        .draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+        .unwrap();
+}
+
+#[test]
+fn dynamic_instances_replay_and_preserve_color_depth_and_stencil_across_splits() {
+    let scratch =
+        Scratch(std::env::temp_dir().join(format!("m2v-dynamic-rendering-{}", std::process::id())));
+    std::fs::create_dir_all(&scratch.0).unwrap();
+    let (device, failures) = watched(&scratch.0);
+    assert!(device
+        .enabled()
+        .features
+        .contains(&VkFeature::DynamicRendering));
+    let queue = device.new_command_queue().unwrap();
+    let pipeline = state(&device);
+    let mut descriptor = TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, SIDE, SIDE, false);
+    descriptor.usage = TextureUsage::RENDER_TARGET;
+    descriptor.resource_options = ResourceOptions::private();
+    let target = device.new_texture(&descriptor).unwrap();
+    descriptor.pixel_format = PixelFormat::Depth32FloatStencil8;
+    let depth_stencil = device.new_texture(&descriptor).unwrap();
+    let back = device
+        .new_buffer(SIDE * SIDE * 4, ResourceOptions::shared())
+        .unwrap();
+    let mut pass = RenderPassDescriptor::new();
+    pass.color_attachments[0].texture = Some(target.clone());
+    pass.color_attachments[0].load_action = LoadAction::Clear;
+    pass.color_attachments[0].store_action = StoreAction::Store;
+    pass.color_attachments[0].clear_color = ClearColor::new(0.0, 0.0, 1.0, 1.0);
+    pass.depth_attachment.texture = Some(depth_stencil.clone());
+    pass.depth_attachment.load_action = LoadAction::Clear;
+    pass.depth_attachment.store_action = StoreAction::Store;
+    pass.depth_attachment.clear_depth = 1.0;
+    pass.stencil_attachment.texture = Some(depth_stencil);
+    pass.stencil_attachment.load_action = LoadAction::Clear;
+    pass.stencil_attachment.store_action = StoreAction::Store;
+    pass.stencil_attachment.clear_stencil = 0;
+    let counted = device.work_counts();
+    let command_buffer = queue.command_buffer().unwrap();
+    let mut encoder = command_buffer.render_command_encoder(&pass).unwrap();
+    // Enter through the same instance selection and secondary creation the tile-metadata route
+    // calls. No shader metadata or reported device feature is forged. Normal draws can legally
+    // continue this dynamic instance; this private test only chooses its initial mode.
+    encoder.inline = inline_first::Inline::Never;
+    let (mut next, stood) = encoder
+        .next_instance(
+            (&[], None),
+            (false, false),
+            ViewSetup::default(),
+            false,
+            None,
+            &[],
+            &[],
+            true,
+        )
+        .unwrap();
+    assert!(matches!(next, Next::New { split: false, .. }));
+    encoder.begin_new_draws(&mut next).unwrap();
+    encoder.install(next, stood, None);
+    encoder.set_render_pipeline_state(&pipeline).unwrap();
+    let mut writes = DepthStencilDescriptor::default();
+    writes.depth_compare_function = CompareFunction::Less;
+    writes.depth_write_enabled = true;
+    writes.front_face_stencil.depth_stencil_pass_operation = StencilOperation::Replace;
+    writes.back_face_stencil = writes.front_face_stencil;
+    let writes = device.new_depth_stencil_state(&writes).unwrap();
+    encoder.set_depth_stencil_state(&writes).unwrap();
+    encoder.set_stencil_reference_value(3);
+    fill(&mut encoder, [4, 4, 28, 28], [1.0, 0.0, 0.0, 1.0]);
+    encoder.memory_barrier_with_scope(
+        BarrierScope::RENDER_TARGETS,
+        RenderStages::FRAGMENT,
+        RenderStages::FRAGMENT,
+    );
+    let mut reads = DepthStencilDescriptor::default();
+    reads.depth_compare_function = CompareFunction::Equal;
+    reads.front_face_stencil.stencil_compare_function = CompareFunction::Equal;
+    reads.back_face_stencil = reads.front_face_stencil;
+    let reads = device.new_depth_stencil_state(&reads).unwrap();
+    encoder.set_depth_stencil_state(&reads).unwrap();
+    fill(&mut encoder, [8, 8, 32, 32], [0.0, 1.0, 0.0, 1.0]);
+    assert_eq!(encoder.earlier.len(), 1);
+    assert!(encoder.earlier[0].shape.dynamic_rendering && encoder.current.shape.dynamic_rendering);
+    assert!(!encoder.current.inline && !encoder.earlier[0].inline);
+    encoder.end_encoding().unwrap();
+    let mut blit = command_buffer.blit_command_encoder().unwrap();
+    blit.copy_from_texture_to_buffer(
+        &target,
+        0,
+        0,
+        Origin::new(0, 0, 0),
+        Size::new(SIDE, SIDE, 1),
+        &back,
+        0,
+        SIDE * 4,
+        SIDE * SIDE * 4,
+        BlitOption::None,
+    )
+    .unwrap();
+    blit.end_encoding().unwrap();
+    command_buffer.commit().unwrap();
+    command_buffer
+        .wait_until_completed_for(Duration::from_secs(60))
+        .unwrap();
+    assert_eq!(command_buffer.error(), None);
+    let after = device.work_counts();
+    assert_eq!(
+        after.commands_replayed.cmd_begin_rendering - counted.commands_replayed.cmd_begin_rendering,
+        2
+    );
+    assert_eq!(
+        after.commands_replayed.cmd_end_rendering - counted.commands_replayed.cmd_end_rendering,
+        2
+    );
+    let contents = back.contents().unwrap();
+    // SAFETY: the entire destination buffer, whose command buffer completed above.
+    let bytes = unsafe { std::slice::from_raw_parts(contents.as_ptr(), back.length() as usize) };
+    for y in 0..SIDE {
+        for x in 0..SIDE {
+            let expected = if (8..28).contains(&x) && (8..28).contains(&y) {
+                [0, 255, 0, 255] // The second draw passes the depth and stencil loaded from the first.
+            } else if (4..28).contains(&x) && (4..28).contains(&y) {
+                [255, 0, 0, 255] // The first draw survives the second instance's color load.
+            } else {
+                [0, 0, 255, 255] // The first clear survives; the second draw fails outside the first.
+            };
+            let at = ((y * SIDE + x) * 4) as usize;
+            assert_eq!(&bytes[at..at + 4], &expected, "pixel ({x}, {y})");
+        }
+    }
+    assert!(
+        lock(&failures).is_empty(),
+        "validation: {:?}",
+        lock(&failures)
+    );
+}
