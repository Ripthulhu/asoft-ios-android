 /// Vulkan 1.4.
 const V1_4: ApiVersion = ApiVersion { major: 1, minor: 4 };
 
+/// The color tile-image path enables real feature members, never a surrogate interlock or
+/// attachment-read feature. Dynamic rendering's promoted feature is in the Vulkan 1.3 node.
+#[test]
+fn tile_image_color_reads_enable_the_actual_vulkan_members() {
+    let mut set = EnableSet::new();
+    set.features.extend([
+        VkFeature::DynamicRendering,
+        VkFeature::ShaderTileImageColorReadAccess,
+    ]);
+    set.extensions.insert(VkExtension::ExtShaderTileImage);
+    let listed = BTreeSet::from([c"VK_EXT_shader_tile_image".to_owned()]);
+    let mut enables = Enables::of(&set, ApiVersion::V1_3, &listed, &[]).unwrap();
+    let (dynamic, color, depth, stencil) = enables.with_create_info(&[], |info| {
+        let mut values = (false, false, false, false);
+        let mut next = info.p_next.cast::<vk::BaseInStructure>();
+        while !next.is_null() {
+            // SAFETY: `with_create_info` keeps every node live for the closure; each begins
+            // with `sType` and `pNext`. The cast below is chosen by that declared type.
+            let base = unsafe { &*next };
+            match base.s_type {
+                vk::StructureType::PHYSICAL_DEVICE_VULKAN_1_3_FEATURES => {
+                    let core = unsafe { &*next.cast::<vk::PhysicalDeviceVulkan13Features<'_>>() };
+                    values.0 = core.dynamic_rendering == vk::TRUE;
+                }
+                vk::StructureType::PHYSICAL_DEVICE_SHADER_TILE_IMAGE_FEATURES_EXT => {
+                    let tile = unsafe { &*next.cast::<vk::PhysicalDeviceShaderTileImageFeaturesEXT<'_>>() };
+                    values.1 = tile.shader_tile_image_color_read_access == vk::TRUE;
+                    values.2 = tile.shader_tile_image_depth_read_access == vk::TRUE;
+                    values.3 = tile.shader_tile_image_stencil_read_access == vk::TRUE;
+                }
+                vk::StructureType::PHYSICAL_DEVICE_DYNAMIC_RENDERING_FEATURES => {
+                    panic!("the Vulkan 1.3 feature must not also be chained through its extension node");
+                }
+                _ => {}
+            }
+            next = base.p_next;
+        }
+        values
+    });
+    assert_eq!((dynamic, color, depth, stencil), (true, true, false, false));
+}
