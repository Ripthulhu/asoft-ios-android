+/// Ask a gather source to materialize the whole CPU window. Only its explicit pointer answer
+/// permits importing that mapping, by host pointer or by a separately supplied dma-buf source.
+/// No Vulkan calls or source export occur before this contract has been established.
+pub(super) fn gathered_at_pointer(
+    pointer: NonNull<u8>,
+    window: &ImportWindow,
+    source: &GatherSource,
+) -> Result<(), Error> {
+    let start = NonNull::new(pointer.as_ptr().wrapping_sub(window.offset as usize))
+        .ok_or_else(not_importable)?;
+    let request = GatherRequest {
+        start,
+        length: window.size,
+        granule: window.size,
+    };
+    match source(request).map_err(|_| not_importable())? {
+        GatherAnswer::Pointer => {
+            POINTER_ANSWERS.fetch_add(1, Ordering::Relaxed);
+            Ok(())
+        }
+        GatherAnswer::Pieces(_) => Err(not_importable()),
+    }
+}
+
+#[cfg(test)]
+mod pointer_fallback_contract {
+    use super::{gathered_at_pointer, GatherAnswer, GatherRequest, GatherSource};
+    use crate::host_memory::{host_page, not_importable, ImportWindow};
+    use std::ptr::NonNull;
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn materialization_requests_the_full_window_including_the_pointer_lead() {
+        let page = host_page().unwrap() as usize;
+        let mut bytes = vec![0u8; page * 3];
+        let lead = bytes.as_ptr().addr().wrapping_neg() & (page - 1);
+        let start = NonNull::new(bytes.as_mut_ptr().wrapping_add(lead)).unwrap();
+        let pointer = NonNull::new(start.as_ptr().wrapping_add(37)).unwrap();
+        let window = ImportWindow {
+            start: start.as_ptr() as u64,
+            offset: 37,
+            size: (page * 2) as u64,
+        };
+        let requests = Arc::new(Mutex::new(Vec::new()));
+        let seen = Arc::clone(&requests);
+        let source: GatherSource = Arc::new(move |request| {
+            seen.lock().unwrap().push(request);
+            Ok(GatherAnswer::Pointer)
+        });
+        assert!(gathered_at_pointer(pointer, &window, &source).is_ok());
+        assert_eq!(
+            *requests.lock().unwrap(),
+            vec![GatherRequest {
+                start,
+                length: (page * 2) as u64,
+                granule: (page * 2) as u64,
+            }]
+        );
+    }
+
+    #[test]
+    fn pieces_and_source_failure_do_not_establish_a_persistent_cpu_mapping() {
+        let page = host_page().unwrap() as usize;
+        let mut bytes = vec![0u8; page * 2];
+        let lead = bytes.as_ptr().addr().wrapping_neg() & (page - 1);
+        let pointer = NonNull::new(bytes.as_mut_ptr().wrapping_add(lead)).unwrap();
+        let window = ImportWindow {
+            start: pointer.as_ptr() as u64,
+            offset: 0,
+            size: page as u64,
+        };
+        let pieces: GatherSource = Arc::new(|_| Ok(GatherAnswer::Pieces(Vec::new())));
+        let failure: GatherSource = Arc::new(|_| Err(std::io::Error::other("not materialized")));
+        assert_eq!(
+            gathered_at_pointer(pointer, &window, &pieces),
+            Err(not_importable())
+        );
+        assert_eq!(
+            gathered_at_pointer(pointer, &window, &failure),
+            Err(not_importable())
+        );
+    }
+}
