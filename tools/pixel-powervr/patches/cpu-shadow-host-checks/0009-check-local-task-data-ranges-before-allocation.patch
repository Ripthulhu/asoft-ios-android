+/// The shared global limit wins first; an allowed length still checks the actual task before
+/// reserving its destination, preserving the local copy's exact fault.
+#[test]
+fn data_rejects_global_and_task_ranges_before_allocation() {
+    use crate::device::tasks::MAX_LOCAL_TASK_LENGTH;
+    let td = device(Opts::default()).with_root_page();
+    td.task_root_node(0x55, 0x4000);
+    td.device
+        .create_task_id(Hold::NONE, 0, 0x55, 0x4000, false)
+        .unwrap();
+    let task = td.device.get_kernel_task(OnFault::Return).unwrap();
+    for (length, expected) in [
+        (
+            MAX_LOCAL_TASK_LENGTH,
+            crate::tasks::RaiseKind::Local(RaiseKind::CopyRange),
+        ),
+        (
+            MAX_LOCAL_TASK_LENGTH + 1,
+            crate::tasks::RaiseKind::BufferLength,
+        ),
+        (u64::MAX, crate::tasks::RaiseKind::BufferLength),
+    ] {
+        let error = task
+            .data_from_virtual_offset(Hold::NONE, OnFault::Return, 0x40, length)
+            .unwrap_err();
+        assert_eq!(error.id(), expected.into());
+    }
+}
+
