+/// Observe while this queue's GPU work cannot complete. The controller releases the queue even
+/// if the observation panics or a runtime's scheduling wait needs completion to make progress.
+/// A timeout releases it only for cleanup and fails the observation; it cannot grant a pass.
+fn while_gated<T>(
+    queue: &metal2vulkan_runtime::CommandQueue,
+    observe: impl FnOnce() -> T,
+) -> (T, SubmissionGate) {
+    let mut gate = SubmissionGate::new(queue).unwrap();
+    std::thread::scope(|scope| {
+        // On unwind this sender drops before the scope joins the release controller.
+        let (release, requested) = mpsc::channel();
+        gate.arm().unwrap();
+        let opener = scope.spawn(move || {
+            let request = requested.recv_timeout(Duration::from_secs(30));
+            if let Err(error) = &request {
+                eprintln!("paging gate released without a completed observation: {error}");
+            }
+            gate.open().unwrap();
+            (gate, request)
+        });
+        let observed = observe();
+        // The joined result distinguishes an explicit request from timeout or unwind.
+        let _ = release.send(());
+        let (gate, request) = opener.join().unwrap();
+        request.expect("paging gate was released before its observation finished");
+        (observed, gate)
+    })
+}
