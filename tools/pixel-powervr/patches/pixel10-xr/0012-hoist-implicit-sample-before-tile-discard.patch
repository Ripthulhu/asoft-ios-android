+/// A sample prefix can run before the discard with the original quad. It reads only ordinary
+/// inputs, uniforms and sampled textures and does not observe helper status or write memory.
+/// Keep OpSampledImage in its block because SPIR-V requires its users to stay there too.
+fn can_hoist_tile_sample(m: &TypedModule, inst: &Inst) -> bool {
+    use crate::spirv::ir::ImageQuery;
+    match inst {
+        Inst::Load { ptr, access } => {
+            let Some(def) = m.values.get(ptr.index()) else {
+                return false;
+            };
+            *access == Default::default()
+                && match m.types.get(def.ty) {
+                    Ok(Type::Pointer {
+                        class: StorageClass::Uniform | StorageClass::UniformConstant,
+                        ..
+                    }) => true,
+                    Ok(Type::Pointer {
+                        class: StorageClass::Input,
+                        ..
+                    }) => {
+                        matches!(def.origin, ValueOrigin::Global(g)
+                        if !matches!(m.globals[g.index()].kind, GlobalKind::BuiltIn {
+                            builtin: crate::spv::BuiltIn::HelperInvocation, ..
+                        }))
+                    }
+                    _ => false,
+                }
+        }
+        Inst::AccessChain {
+            non_uniform: false, ..
+        }
+        | Inst::CompositeConstruct { .. }
+        | Inst::CompositeExtract { .. }
+        | Inst::CompositeInsert { .. }
+        | Inst::VectorShuffle { .. }
+        | Inst::Undef
+        | Inst::Convert { .. }
+        | Inst::Select { .. }
+        | Inst::Unary {
+            op: UnOp::CopyObject,
+            ..
+        }
+        | Inst::Image(_)
+        | Inst::ImageQuery {
+            query: ImageQuery::Size | ImageQuery::SizeLod(_),
+            ..
+        } => true,
+        Inst::Glsl {
+            op: GlslOp::FClamp | GlslOp::NClamp | GlslOp::Floor,
+            ..
+        } => true,
+        Inst::Binary { op, .. } => matches!(
+            op,
+            BinOp::IAdd
+                | BinOp::BitwiseAnd
+                | BinOp::ShiftRightLogical
+                | BinOp::IEqual
+                | BinOp::FOrdGreaterThanEqual
+                | BinOp::FAdd
+                | BinOp::FSub
+                | BinOp::FMul
+                | BinOp::FDiv
+        ),
+        Inst::ImageSample { form, .. } => form.implicit && !form.sparse && !form.proj && !form.dref,
+        _ => false,
+    }
+}
