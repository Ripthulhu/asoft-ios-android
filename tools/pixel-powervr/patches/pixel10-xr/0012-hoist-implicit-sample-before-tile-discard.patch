+; A biased sample whose coordinates are independent of the coverage that discards the fragment.
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define <4 x float> @tile_discard_sample(<4 x float> %position, float %coverage, ptr addrspace(1) %texture, ptr addrspace(2) %sampler) {
+entry:
+  %uncovered = fcmp oeq float %coverage, 0.0
+  br i1 %uncovered, label %discard, label %shade
+
+discard:
+  call void @air.discard_fragment()
+  br label %shade
+
+shade:
+  %xy = shufflevector <4 x float> %position, <4 x float> poison, <2 x i32> <i32 0, i32 1>
+  %uv = fmul <2 x float> %xy, <float 0.0625, float 0.0625>
+  %sample = call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %texture, ptr addrspace(2) %sampler, <2 x float> %uv, i1 true, <2 x i32> zeroinitializer, i1 false, float -0.25, float 0.0, i32 0)
+  %color = extractvalue { <4 x float>, i8 } %sample, 0
+  ret <4 x float> %color
+}
+declare void @air.discard_fragment()
+declare { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+
+!air.fragment = !{!0}
+!air.version = !{!8}
+!air.language_version = !{!9}
+!0 = !{ptr @tile_discard_sample, !1, !3}
+!1 = !{!2}
+!2 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4", !"air.arg_name", !"color"}
+!3 = !{!4, !5, !6, !7}
+!4 = !{i32 0, !"air.position", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"float4", !"air.arg_name", !"position"}
+!5 = !{i32 1, !"air.render_target", i32 1, !"air.arg_type_name", !"float", !"air.arg_name", !"coverage"}
+!6 = !{i32 2, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>", !"air.arg_name", !"texture"}
+!7 = !{i32 3, !"air.sampler", !"air.location_index", i32 0, i32 1, !"air.arg_type_name", !"sampler", !"air.arg_name", !"sampler"}
+!8 = !{i32 2, i32 8, i32 0}
+!9 = !{!"Metal", i32 4, i32 0, i32 0}
