+#[test]
+fn tile_image_discard_hoists_only_a_sample_independent_of_the_tile_read() {
+    let Some(mut pipeline) = descriptor(
+        "fetch_scalar",
+        &[
+            metal::PixelFormat::RGBA16Float,
+            metal::PixelFormat::R32Float,
+        ],
+    ) else {
+        return;
+    };
+    let path = metal2vulkan_devtools::engine_dir().join("tile_discard_sample.ll");
+    let independent = std::fs::read_to_string(path).expect("owned sample fixture");
+    let dependent = independent.replace(
+        "  %uv = fmul <2 x float> %xy,",
+        "  %tile_xy = insertelement <2 x float> %xy, float %coverage, i32 0\n  %uv = fmul <2 x float> %tile_xy,",
+    );
+    let mut profile = tile_description();
+    profile
+        .features
+        .insert(VkFeature::ShaderDemoteToHelperInvocation);
+    let device = Device::new(profile, DevicePolicy::default()).expect("tile device");
+    for (text, should_compile) in [(independent, true), (dependent, false)] {
+        let Some(air) = common::llvm_as(&text, "tile discard and biased sample") else {
+            return;
+        };
+        let fragment = Library::from_air(&air)
+            .expect("library")
+            .function("tile_discard_sample")
+            .expect("entry");
+        pipeline.fragment = Some(StageSource::Function(FunctionDescriptor::new(fragment)));
+        let compiled = device.compile_render_pipeline(&pipeline, &Budget::standard());
+        if should_compile {
+            let compiled = compiled.expect("sample independent of the discard");
+            let fragment = compiled
+                .stages
+                .iter()
+                .find(|s| s.stage == vk::ShaderStage::FRAGMENT)
+                .expect("fragment stage");
+            let disassembly = spirv_dis(&fragment.spirv);
+            let sample = disassembly
+                .lines()
+                .find(|line| line.contains("OpImageSampleImplicitLod"))
+                .expect("implicit sample");
+            assert!(sample.contains("Bias"), "{disassembly}");
+            assert!(
+                disassembly.find(sample).unwrap()
+                    < disassembly.find("OpBranchConditional").unwrap()
+            );
+            l3(&fragment.spirv, &compiled.requirements, &device);
+        } else {
+            assert!(
+                matches!(&compiled, Err(Error::Unsupported(u))
+                    if u.feature == Feature::FramebufferFetch && u.needs == Needs::NotImplemented),
+                "{compiled:?}"
+            );
+        }
+    }
+}
