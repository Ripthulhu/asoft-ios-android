diff --git a/crates/metal2vulkan/src/bind/extended_shadow/tests.rs b/crates/metal2vulkan/src/bind/extended_shadow/tests.rs
index e71e60b21848b1f18a67c9681ee686923e67a133..4b3de5c44cb1301e603dfe4bd91a71c079559e39 100644
--- a/crates/metal2vulkan/src/bind/extended_shadow/tests.rs
+++ b/crates/metal2vulkan/src/bind/extended_shadow/tests.rs
@@ -8,6 +8,69 @@ use crate::metal::format::tests::committed_devices;
 use crate::spirv::interp::{run_with_images, Config, Image, Order, Resources};
 use crate::spirv::testing::assert_valid;
 
+#[test]
+fn the_linear_planes_store_only_encodes_the_shadow_extent() {
+    let form = ExtendedRange::Planes { srgb: false };
+    let module = typed_module(form, Transfer::Store)
+        .expect("linear planes")
+        .expect("build");
+    let mut built = false;
+    for (_, device) in committed_devices() {
+        let serialized = crate::spirv::serialize::serialize(
+            typed_module(form, Transfer::Store)
+                .expect("linear planes")
+                .expect("build"),
+        )
+        .expect("serialize");
+        if device.profile().check(&serialized.requirements).is_ok() {
+            assert!(!extended_shadow_store_module(&device)
+                .expect("store")
+                .spirv
+                .is_empty());
+            built = true;
+        } else {
+            assert!(matches!(
+                extended_shadow_store_module(&device),
+                Err(Error::Unsupported(_))
+            ));
+        }
+    }
+    assert!(built);
+
+    let values: [[f32; 4]; 4] = [
+        [-0.75, 0.5, 1.25, 0.5],
+        [-1.5, 1.5, 0.125, 0.25],
+        [f32::NAN, f32::INFINITY, f32::NEG_INFINITY, f32::NAN],
+        [1.0, -0.0, 0.001953125, 1.0],
+    ];
+    let mut shadow = Image::new(SHADOW, [2, 2, 1], 1, 1, 1);
+    let mut codes = Image::new(CODES, [3, 3, 1], 1, 1, 1);
+    codes.texels.fill([0xdead_beef; 4]);
+    let mut expected = codes.clone();
+    for (n, rgba) in values.into_iter().enumerate() {
+        let texel = [(n % 2) as u32, (n / 2) as u32, 0];
+        let at = shadow.index(0, 0, 0, texel).expect("shadow texel");
+        shadow.texels[at] = rgba.map(f32::to_bits);
+        let at = codes.index(0, 0, 0, texel).expect("codes texel");
+        let [r, g, b, a] = rgba.map(|v| if v.is_nan() { 0.0 } else { v });
+        let rgb = |v: f32| ((v * 510.0).round_ties_even() + 384.0).clamp(0.0, 1023.0) as u32;
+        let a = (a.clamp(0.0, 1.0) * 255.0).round_ties_even() as u32;
+        expected.texels[at] = [(rgb(r) << 20) | (rgb(g) << 10) | rgb(b), a, 0, 0];
+    }
+    let config = Config {
+        workgroups: [1, 1, 1],
+        ..Config::default()
+    };
+    let (_, images) = run_with_images(
+        &module,
+        &config,
+        Resources::default(),
+        vec![codes, shadow.clone()],
+    )
+    .expect("run");
+    assert_eq!(images, vec![expected, shadow]);
+}
