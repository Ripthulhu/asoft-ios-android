+
+#[test]
+fn tile_image_discard_guard_keeps_only_quad_work_before_the_branch() {
+    let Some(mut pipeline) = descriptor(
+        "fetch_scalar",
+        &[
+            metal::PixelFormat::RGBA16Float,
+            metal::PixelFormat::RG16Float,
+        ],
+    ) else {
+        return;
+    };
+    let path = metal2vulkan_devtools::engine_dir().join("tsw_fetch_discard.ll");
+    let original = std::fs::read_to_string(path).expect("owned discard fixture");
+    let with_slope = original
+        .replace("!\"position\", !\"air.arg_unused\"", "!\"position\"")
+        .replace(
+            "half %4, half 0xH3800, half %8",
+            "half %4, half %slope16, half %8",
+        )
+        + "\ndeclare float @air.fwidth.f32(float)\n";
+    let slope = "  %posx = extractelement <4 x float> %0, i64 0\n  %slope = call float @air.fwidth.f32(float %posx)\n  %slope16 = fptrunc float %slope to half\n";
+    let mut profile = tile_description();
+    profile
+        .features
+        .insert(VkFeature::ShaderDemoteToHelperInvocation);
+    let device = Device::new(profile, DevicePolicy::default()).expect("tile device");
+    for (before, at) in [(true, "  br i1 %5"), (false, "  %8 = extractelement")] {
+        assert_eq!(with_slope.matches(at).count(), 1);
+        let text = with_slope.replacen(at, &format!("{slope}{at}"), 1);
+        let Some(air) = common::llvm_as(&text, "tile discard and independent derivative") else {
+            return;
+        };
+        let fragment = Library::from_air(&air)
+            .expect("library")
+            .function("tsw_fetch_discard")
+            .expect("entry");
+        pipeline.fragment = Some(StageSource::Function(FunctionDescriptor::new(fragment)));
+        let compiled = device.compile_render_pipeline(&pipeline, &Budget::standard());
+        if before {
+            let compiled = compiled.expect("guarded tile discard");
+            let fragment = compiled
+                .stages
+                .iter()
+                .find(|s| s.stage == vk::ShaderStage::FRAGMENT)
+                .expect("fragment stage");
+            let disassembly = spirv_dis(&fragment.spirv);
+            assert!(disassembly.contains("OpFwidth"), "{disassembly}");
+            assert!(
+                disassembly.contains("OpIsHelperInvocation"),
+                "{disassembly}"
+            );
+            l3(&fragment.spirv, &compiled.requirements, &device);
+        } else {
+            assert!(
+                matches!(&compiled, Err(Error::Unsupported(u))
+                    if u.feature == Feature::FramebufferFetch && u.needs == Needs::NotImplemented),
+                "{compiled:?}"
+            );
+        }
+    }
+}
