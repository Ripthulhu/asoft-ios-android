+/// A branch that only demotes a fragment can bypass that demotion when it is already a helper.
+/// Mask just its condition with a select, so poison from a helper's tile read cannot take
+/// either edge. Keep the usual proof for every other use of the fetched value.
+pub(crate) fn guard_tile_discards(
+    m: &mut TypedModule,
+    p: &DeviceProfile,
+    meter: &mut Meter,
+) -> Result<bool, Error> {
+    if !p.fields().fragment.demote_to_helper
+        || m.blocks.iter().flat_map(|b| &b.insts).any(|node| {
+            node.inst.is_tangled()
+                || matches!(
+                    node.inst,
+                    Inst::ImageGather { .. } | Inst::ImageDrefGather { .. }
+                )
+        })
+    {
+        return Ok(false);
+    }
+    let bytes = m.blocks.len() * 48;
+    meter.charge(bytes)?;
+    let result = guard_tile_discard_branches(m, meter);
+    meter.release(bytes);
+    result
+}
+
+fn guard_tile_discard_branches(m: &mut TypedModule, meter: &mut Meter) -> Result<bool, Error> {
+    let guards: BTreeMap<usize, bool> = m
+        .blocks
+        .iter()
+        .enumerate()
+        .filter_map(|(index, block)| {
+            let Some(Merge::Selection { merge }) = block.merge else {
+                return None;
+            };
+            let Terminator::CondBranch { t, f, .. } = block.term else {
+                return None;
+            };
+            if !m.blocks.get(merge.index())?.phis.is_empty() {
+                return None;
+            }
+            let demotes = |target: BlockId| {
+                m.blocks.get(target.index()).is_some_and(|arm| {
+                    arm.phis.is_empty()
+                        && arm.merge.is_none()
+                        && matches!(arm.insts.as_slice(), [node] if matches!(node.inst, Inst::DemoteToHelperInvocation))
+                        && arm.term == Terminator::Branch(merge)
+                })
+            };
+            if f == merge && demotes(t) {
+                Some((index, false))
+            } else if t == merge && demotes(f) {
+                Some((index, true))
+            } else {
+                None
+            }
+        })
+        .collect();
+    if guards.is_empty()
+        || !crate::spirv::requirements::tile_image_helpers_local_except(m, meter, &guards)?
+    {
+        return Ok(false);
+    }
+    let bool_ty = ty(m, Type::Bool)?;
+    for (index, route) in guards {
+        let Terminator::CondBranch { cond, .. } = m.blocks[index].term else {
+            return Err(invariant("a guarded tile discard without a condition"));
+        };
+        let id = BlockId::new(u32::try_from(index).map_err(|_| invariant("block ids"))?);
+        let helper = value(m, id, bool_ty, Inst::IsHelperInvocation)?;
+        let bypass = constant(
+            m,
+            Constant::Scalar {
+                ty: bool_ty,
+                bits: ConstBits(u64::from(route)),
+            },
+        )?;
+        let defined = value(
+            m,
+            id,
+            bool_ty,
+            Inst::Select {
+                cond: helper,
+                t: bypass,
+                f: cond,
+            },
+        )?;
+        if let Terminator::CondBranch { cond, .. } = &mut m.blocks[index].term {
+            *cond = defined;
+        }
+    }
+    m.rederive()?;
+    Ok(true)
+}
