+    const SNAPSHOT_REUSE_LIMIT: usize = 32 * 1024 * 1024;
+
+    fn reuse_snapshots() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| {
+            std::env::var_os("METAL2VULKAN_CPU_SHADOW_REUSE").is_some_and(|value| value == "1")
+        })
+    }
+
+    fn snapshot_buffer(pool: &mut Vec<Vec<u8>>, size: usize) -> (Vec<u8>, bool) {
+        let Some(mut buffer) = pool.pop().filter(|buffer| buffer.capacity() >= size) else {
+            return (vec![0; size], false);
+        };
+        buffer.resize(size, 0);
+        (buffer, true)
+    }
+
+    #[test]
+    fn snapshot_buffer_reuses_capacity_and_falls_back_when_too_small() {
+        let mut buffer = Vec::with_capacity(8);
+        buffer.extend_from_slice(&[1, 2, 3, 4]);
+        let pointer = buffer.as_ptr();
+        let (reused, hit) = snapshot_buffer(&mut vec![buffer], 6);
+        assert!(hit);
+        assert_eq!(reused.as_ptr(), pointer);
+        assert_eq!(reused.len(), 6);
+        let oversized = reused.capacity() + 1;
+        let (fresh, hit) = snapshot_buffer(&mut vec![reused], oversized);
+        assert!(!hit);
+        assert_eq!(fresh, vec![0; oversized]);
+    }
