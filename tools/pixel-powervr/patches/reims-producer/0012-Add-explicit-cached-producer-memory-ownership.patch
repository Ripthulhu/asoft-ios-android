+struct GpuAccess<'a> {
+    producer: &'a Producer,
+    done: bool,
+}
+impl Drop for GpuAccess<'_> {
+    fn drop(&mut self) {
+        if !self.done {
+            lock(&self.producer.backing.state).poison();
+        }
+    }
+}
