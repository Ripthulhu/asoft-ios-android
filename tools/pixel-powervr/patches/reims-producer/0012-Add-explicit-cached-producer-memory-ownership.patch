diff --git a/crates/reims-vgpu-c/src/producer.rs b/crates/reims-vgpu-c/src/producer.rs
new file mode 100644
index 0000000..15093b7
--- /dev/null
+++ b/crates/reims-vgpu-c/src/producer.rs
@@ -0,0 +1,473 @@
+//! Additive producer-memory interop; this API never selects ordinary guest RAM's provider.
+
+use crate::status::RVG_ERR_INVALID_ARGUMENT;
+#[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+use crate::status::RVG_OK;
+use crate::{RvgStatus, ffi, handle};
+use std::ffi::c_void;
+
+/// Another epoch owns the producer, a transition was replayed, or native aliases remain.
+pub const RVG_ERR_PRODUCER_STATE: u32 = 17;
+/// An abandoned or failed handoff permanently blocks further producer access.
+pub const RVG_ERR_PRODUCER_POISONED: u32 = 18;
+/// GPU completion was not established within the producer's five-second wait.
+pub const RVG_ERR_PRODUCER_TIMEOUT: u32 = 19;
+/// The selected platform or device cannot meet the cached producer-memory contract.
+pub const RVG_ERR_PRODUCER_UNSUPPORTED: u32 = 20;
+
+#[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+use parking_lot::Mutex;
+#[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+use reims_vgpu::producer as api;
+#[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+use std::{sync::Arc, time::Duration};
+
+/// Opaque allocation retained by its CPU/native leases and runtime memory holds.
+pub struct RvgProducer {
+    #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+    allocation: Arc<api::Producer>,
+}
+/// Opaque exclusive CPU epoch; end successfully before release.
+pub struct RvgProducerCpu {
+    #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+    access: Mutex<api::CpuAccess>,
+}
+/// Opaque native export; retire after all recipients and descendants stopped accessing it.
+pub struct RvgProducerNative {
+    #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+    view: Mutex<api::NativeView>,
+}
+
+/// Allocation identity, actual memory requirements and successful ownership-operation counts.
+#[repr(C)]
+pub struct RvgProducerInfo {
+    /// Size written by this library.
+    pub struct_size: u32,
+    /// Compatible memory-type index actually selected.
+    pub memory_type: u32,
+    /// Process-unique, never-reused allocation generation.
+    pub allocation_id: u64,
+    /// The physical adapter's registry ID, not a logical VkDevice identity.
+    pub device_registry_id: u64,
+    /// Logical runtime-buffer length.
+    pub logical_bytes: u64,
+    /// Full VkDeviceMemory allocation/mapping length.
+    pub allocation_bytes: u64,
+    /// Actual VkMemoryPropertyFlags of the chosen type.
+    pub memory_flags: u32,
+    /// Always zero.
+    pub reserved: u32,
+    /// The device's nonCoherentAtomSize.
+    pub noncoherent_atom_bytes: u64,
+    /// One runtime buffer identity for every resolved physical span.
+    pub runtime_object_id: u64,
+    /// Successful complete-allocation flushes.
+    pub flushes: u64,
+    /// Successful invalidations after a completed runtime wait.
+    pub invalidates: u64,
+    /// Successful GPU epochs, including completed invalidation.
+    pub completed_submissions: u64,
+}
+
+#[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+fn status(e: api::Error) -> RvgStatus {
+    use api::{Error, OwnershipError};
+    log::error!("producer memory: {e}");
+    match e {
+        Error::Invalid(_) | Error::Resolve(_) => RVG_ERR_INVALID_ARGUMENT,
+        Error::Unsupported(_) => RVG_ERR_PRODUCER_UNSUPPORTED,
+        Error::Ownership(OwnershipError::Poisoned) => RVG_ERR_PRODUCER_POISONED,
+        Error::Ownership(_) => RVG_ERR_PRODUCER_STATE,
+        Error::Timeout => RVG_ERR_PRODUCER_TIMEOUT,
+        _ => crate::status::RVG_ERR_GPU,
+    }
+}
+
+/// Create CPU-cached producer bytes using reims' system-default Vulkan device selection. This
+/// owns a runtime device; it does not attach to an existing RvgDevice. Requires a nonzero
+/// multiple of 16; refuses an unsupported memory type without falling back to uncached memory.
+/// Unsupported outside Vulkan on Linux/Android. Writes the handle only on RVG_OK.
+///
+/// # Safety
+/// `out` is NULL or writable for one handle.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_create(bytes: u64, out: *mut *mut RvgProducer) -> RvgStatus {
+    ffi::export(|| {
+        if out.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            match api::Producer::system_default(bytes) {
+                Ok(allocation) => {
+                    // SAFETY: non-null writable output by the caller's contract.
+                    unsafe { out.write(handle::new(RvgProducer { allocation })) };
+                    RVG_OK
+                }
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = bytes;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Release one producer handle. Outstanding leases and commands retain its backing; this
+/// neither revokes mappings nor ends an ownership epoch. NULL is accepted.
+///
+/// # Safety
+/// `producer` is NULL or an owned live handle from rvg_producer_create.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_release(producer: *mut RvgProducer) {
+    ffi::export(|| {
+        // SAFETY: caller owns this reference or passed NULL.
+        unsafe { handle::release(producer) };
+    })
+}
+
+/// Write facts into an output of at least sizeof(RvgProducerInfo) bytes.
+///
+/// # Safety
+/// `producer` is NULL or live; `out` is NULL or writable for `out_bytes` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_info(
+    producer: *const RvgProducer,
+    out: *mut RvgProducerInfo,
+    out_bytes: usize,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(p) = (unsafe { handle::get(producer) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if out.is_null() || out_bytes < std::mem::size_of::<RvgProducerInfo>() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            let i = p.allocation.info();
+            let (flushes, invalidates, completed_submissions) = p.allocation.counts();
+            // SAFETY: output is writable and its size was checked.
+            unsafe {
+                out.write(RvgProducerInfo {
+                    struct_size: crate::sized::size_u32::<RvgProducerInfo>(),
+                    memory_type: i.memory_type,
+                    allocation_id: i.allocation_id,
+                    device_registry_id: i.device_registry_id,
+                    logical_bytes: i.logical_bytes,
+                    allocation_bytes: i.allocation_bytes,
+                    memory_flags: i.memory_flags,
+                    reserved: 0,
+                    noncoherent_atom_bytes: i.noncoherent_atom_bytes,
+                    runtime_object_id: i.runtime_object_id,
+                    flushes,
+                    invalidates,
+                    completed_submissions,
+                })
+            };
+            RVG_OK
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = p;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Upload the entire logical allocation through the runtime GPU blit path. Uses a five-second
+/// completion wait; flushes before submission and invalidates before successful return.
+/// No CPU epoch/native export may be active. Calls back: never.
+///
+/// # Safety
+/// `producer` is NULL or live. `bytes` holds `length` initialized, immutable ordinary-memory
+/// bytes, disjoint from all producer mappings. No raw producer alias is accessed meanwhile.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_upload(
+    producer: *const RvgProducer,
+    bytes: *const c_void,
+    length: usize,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(p) = (unsafe { handle::get(producer) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if bytes.is_null() || length > isize::MAX as usize {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            // SAFETY: initialized immutable ordinary bytes supplied for this call.
+            let source = unsafe { std::slice::from_raw_parts(bytes.cast::<u8>(), length) };
+            match p.allocation.upload(source, Duration::from_secs(5)) {
+                Ok(()) => RVG_OK,
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = p;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Download the entire allocation through an independent runtime GPU readback buffer, bounded
+/// as upload. Writes output only on success. Calls back: never.
+///
+/// # Safety
+/// `producer` is NULL or live. `bytes` is writable ordinary memory of `length` bytes, disjoint
+/// from producer mappings. No raw producer alias is accessed meanwhile.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_download(
+    producer: *const RvgProducer,
+    bytes: *mut c_void,
+    length: usize,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(p) = (unsafe { handle::get(producer) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if bytes.is_null() || length > isize::MAX as usize {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            if length as u64 != p.allocation.info().logical_bytes {
+                return RVG_ERR_INVALID_ARGUMENT;
+            }
+            match p.allocation.download(Duration::from_secs(5)) {
+                Ok(result) => {
+                    // SAFETY: disjoint writable ordinary output of exactly the checked size.
+                    unsafe {
+                        std::ptr::copy_nonoverlapping(result.as_ptr(), bytes.cast::<u8>(), length)
+                    };
+                    RVG_OK
+                }
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = p;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Begin an exclusive CPU epoch; write its handle only on success.
+///
+/// # Safety
+/// `producer` is NULL or live; `out` is NULL or writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_cpu_begin(
+    producer: *const RvgProducer,
+    out: *mut *mut RvgProducerCpu,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(p) = (unsafe { handle::get(producer) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if out.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            match p.allocation.cpu() {
+                Ok(access) => {
+                    // SAFETY: writable output, checked non-null.
+                    unsafe {
+                        out.write(handle::new(RvgProducerCpu {
+                            access: Mutex::new(access),
+                        }))
+                    };
+                    RVG_OK
+                }
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = p;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Borrow the canonical CPU address and epoch. Producer atomics and instruction fetch are not
+/// qualified. Stop every access before ending this epoch.
+///
+/// # Safety
+/// `cpu` is NULL or live; both outputs are NULL or writable. Access only the logical allocation
+/// bytes, without data races, and never use this pointer after ending the epoch.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_cpu_pointer(
+    cpu: *const RvgProducerCpu,
+    out: *mut *mut c_void,
+    epoch: *mut u64,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(cpu) = (unsafe { handle::get(cpu) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if out.is_null() || epoch.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            let access = cpu.access.lock();
+            match access.pointer() {
+                Ok(pointer) => {
+                    // SAFETY: both outputs are writable, checked non-null.
+                    unsafe {
+                        out.write(pointer.as_ptr().cast());
+                        epoch.write(access.epoch());
+                    }
+                    RVG_OK
+                }
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = cpu;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// End a CPU epoch; refuse while native exports remain. The handle stays valid until release,
+/// and a replayed end is refused.
+///
+/// # Safety
+/// `cpu` is NULL or live. CPU accesses are paused during the call. After success they never
+/// resume; after refusal the current CPU owner may continue its epoch.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_cpu_end(cpu: *const RvgProducerCpu) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(cpu) = (unsafe { handle::get(cpu) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            // SAFETY: caller establishes CPU quiescence; ownership checks native exports.
+            match unsafe { cpu.access.lock().finish() } {
+                Ok(()) => RVG_OK,
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = cpu;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Release a CPU handle. An epoch not ended successfully poisons its allocation.
+///
+/// # Safety
+/// `cpu` is NULL or an owned live CPU handle.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_cpu_release(cpu: *mut RvgProducerCpu) {
+    ffi::export(|| {
+        // SAFETY: caller owns this reference or passed NULL.
+        unsafe { handle::release(cpu) };
+    })
+}
+
+/// Export a native lease and its borrowed CLOEXEC descriptor. Map the complete allocation from
+/// offset zero; nonzero CPU views need a qualified mapping provider. Duplicate/transfer this FD
+/// without closing its owner's copy. No external recipient may access the memory after
+/// retirement; the lease's own descriptor closes when the lease is released.
+///
+/// # Safety
+/// `cpu` is NULL or live; outputs are NULL or writable. Keep the returned lease while any
+/// recipient, descendant or transferred descriptor can access its pages.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_native_export(
+    cpu: *const RvgProducerCpu,
+    out: *mut *mut RvgProducerNative,
+    fd: *mut i32,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(cpu) = (unsafe { handle::get(cpu) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if out.is_null() || fd.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            match cpu.access.lock().export() {
+                Ok(view) => {
+                    let borrowed = view.fd();
+                    // SAFETY: writable outputs, checked non-null.
+                    unsafe {
+                        out.write(handle::new(RvgProducerNative {
+                            view: Mutex::new(view),
+                        }));
+                        fd.write(borrowed);
+                    }
+                    RVG_OK
+                }
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = cpu;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Retire a native export after every recipient/descendant stopped. Closing its FD alone is
+/// insufficient: mappings survive that close. Release the handle separately.
+///
+/// # Safety
+/// `native` is NULL or live. All recipients, descendants, transferred copies and mappings are
+/// permanently quiescent, established by complete owned-worker reap or equivalent revocation.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_native_retire(native: *const RvgProducerNative) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's handle contract.
+        let Some(native) = (unsafe { handle::get(native) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        #[cfg(all(feature = "vulkan", any(target_os = "linux", target_os = "android")))]
+        {
+            // SAFETY: the caller established complete recipient quiescence.
+            match unsafe { native.view.lock().retire() } {
+                Ok(()) => RVG_OK,
+                Err(e) => status(e),
+            }
+        }
+        #[cfg(not(all(feature = "vulkan", any(target_os = "linux", target_os = "android"))))]
+        {
+            let _ = native;
+            RVG_ERR_PRODUCER_UNSUPPORTED
+        }
+    })
+}
+
+/// Release a native lease. An export not retired successfully poisons its allocation.
+///
+/// # Safety
+/// `native` is NULL or an owned live native-export handle.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_producer_native_release(native: *mut RvgProducerNative) {
+    ffi::export(|| {
+        // SAFETY: caller owns this reference or passed NULL.
+        unsafe { handle::release(native) };
+    })
+}
