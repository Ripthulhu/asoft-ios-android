+/// A native recipient's lease on the allocation, independent of any public producer handle.
+/// Dropping it without retirement poisons the producer; a closed FD does not revoke mappings.
+pub struct NativeView {
+    producer: Arc<Producer>,
+    fd: OwnedFd,
+    epoch: u64,
+    active: bool,
+}
+
+impl NativeView {
+    /// Borrowed CLOEXEC descriptor. Duplicate/transfer it without closing this owner's copy.
+    pub fn fd(&self) -> RawFd {
+        self.fd.as_raw_fd()
+    }
+    /// Its allocation facts, independent of FD number reuse.
+    pub fn info(&self) -> Info {
+        self.producer.info()
+    }
+    /// The CPU epoch this export belongs to.
+    pub fn epoch(&self) -> u64 {
+        self.epoch
+    }
+
+    /// Retire the recipient after its entire process tree stopped accessing the pages.
+    ///
+    /// # Safety
+    /// No recipient, descendant or transferred descriptor may access this export's mappings
+    /// again. The caller establishes that fact, for example by reaping every owned native worker.
+    pub unsafe fn retire(&mut self) -> Result<(), Error> {
+        if !self.active {
+            return Err(OwnershipError::StaleEpoch.into());
+        }
+        lock(&self.producer.backing.state).retired(self.epoch)?;
+        self.active = false;
+        Ok(())
+    }
+}
+impl Drop for NativeView {
+    fn drop(&mut self) {
+        if self.active {
+            lock(&self.producer.backing.state).poison();
+        }
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/src/producer/ownership.rs b/crates/reims-vgpu-vulkan/src/producer/ownership.rs
new file mode 100644
index 0000000..01b6d52
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/producer/ownership.rs
@@ -0,0 +1,202 @@
+//! Whole-allocation ownership. Metadata lives in ordinary memory; this module never accesses
+//! producer bytes. A failed or abandoned GPU handoff cannot make them CPU-visible again.
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Phase {
+    Idle,
+    Cpu(u64),
+    Flushing(u64),
+    Gpu(u64),
+    Invalidating(u64),
+    Poisoned,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+/// Why exclusive ownership could not be transferred.
+pub enum OwnershipError {
+    /// Another CPU or GPU epoch currently owns the allocation.
+    Busy,
+    /// The epoch or requested transition is not current.
+    StaleEpoch,
+    /// An exported native mapping can still access the allocation.
+    AliasesLive,
+    /// A failed or abandoned operation left ownership uncertain.
+    Poisoned,
+    /// A generation or live-export count cannot advance without overflow.
+    Exhausted,
+}
+
+#[derive(Debug)]
+pub(super) struct Ownership {
+    pub(super) phase: Phase,
+    next: u64,
+    external: usize,
+}
+
+impl Default for Ownership {
+    fn default() -> Self {
+        Self {
+            phase: Phase::Idle,
+            next: 1,
+            external: 0,
+        }
+    }
+}
+
+impl Ownership {
+    fn start(&mut self) -> Result<u64, OwnershipError> {
+        match self.phase {
+            Phase::Idle => {}
+            Phase::Poisoned => return Err(OwnershipError::Poisoned),
+            _ => return Err(OwnershipError::Busy),
+        }
+        let epoch = self.next;
+        self.next = epoch.checked_add(1).ok_or(OwnershipError::Exhausted)?;
+        Ok(epoch)
+    }
+
+    pub(super) fn cpu(&mut self) -> Result<u64, OwnershipError> {
+        let epoch = self.start()?;
+        self.phase = Phase::Cpu(epoch);
+        Ok(epoch)
+    }
+
+    pub(super) fn check_cpu(&self, epoch: u64) -> Result<(), OwnershipError> {
+        if self.phase == Phase::Poisoned {
+            return Err(OwnershipError::Poisoned);
+        }
+        if self.phase != Phase::Cpu(epoch) {
+            return Err(OwnershipError::StaleEpoch);
+        }
+        Ok(())
+    }
+
+    pub(super) fn exported(&mut self, epoch: u64) -> Result<(), OwnershipError> {
+        self.check_cpu(epoch)?;
+        self.external = self
+            .external
+            .checked_add(1)
+            .ok_or(OwnershipError::Exhausted)?;
+        Ok(())
+    }
+
+    pub(super) fn retired(&mut self, epoch: u64) -> Result<(), OwnershipError> {
+        self.check_cpu(epoch)?;
+        self.external = self
+            .external
+            .checked_sub(1)
+            .ok_or(OwnershipError::StaleEpoch)?;
+        Ok(())
+    }
+
+    pub(super) fn cpu_done(&mut self, epoch: u64) -> Result<(), OwnershipError> {
+        self.check_cpu(epoch)?;
+        if self.external != 0 {
+            return Err(OwnershipError::AliasesLive);
+        }
+        self.phase = Phase::Idle;
+        Ok(())
+    }
+
+    pub(super) fn flushing(&mut self) -> Result<u64, OwnershipError> {
+        let epoch = self.start()?;
+        self.phase = Phase::Flushing(epoch);
+        Ok(epoch)
+    }
+
+    pub(super) fn gpu(&mut self, epoch: u64) -> Result<(), OwnershipError> {
+        if self.phase != Phase::Flushing(epoch) {
+            return Err(OwnershipError::StaleEpoch);
+        }
+        self.phase = Phase::Gpu(epoch);
+        Ok(())
+    }
+
+    pub(super) fn completed(&mut self, epoch: u64) -> Result<(), OwnershipError> {
+        if self.phase != Phase::Gpu(epoch) {
+            return Err(OwnershipError::StaleEpoch);
+        }
+        self.phase = Phase::Invalidating(epoch);
+        Ok(())
+    }
+
+    pub(super) fn invalidated(&mut self, epoch: u64) -> Result<(), OwnershipError> {
+        if self.phase != Phase::Invalidating(epoch) {
+            return Err(OwnershipError::StaleEpoch);
+        }
+        self.phase = Phase::Idle;
+        Ok(())
+    }
+
+    pub(super) fn poison(&mut self) {
+        self.phase = Phase::Poisoned;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn aliases_must_retire_before_gpu_access() {
+        let mut state = Ownership::default();
+        let cpu = state.cpu().unwrap();
+        state.exported(cpu).unwrap();
+        assert_eq!(state.cpu_done(cpu), Err(OwnershipError::AliasesLive));
+        assert_eq!(state.flushing(), Err(OwnershipError::Busy));
+        assert_eq!(state.retired(cpu + 1), Err(OwnershipError::StaleEpoch));
+        state.retired(cpu).unwrap();
+        state.cpu_done(cpu).unwrap();
+        let gpu = state.flushing().unwrap();
+        assert!(gpu > cpu);
+        assert_eq!(state.cpu(), Err(OwnershipError::Busy));
+        state.gpu(gpu).unwrap();
+        assert_eq!(state.cpu(), Err(OwnershipError::Busy));
+        state.completed(gpu).unwrap();
+        // Completion alone must not publish the allocation to the CPU.
+        assert_eq!(state.cpu(), Err(OwnershipError::Busy));
+        state.invalidated(gpu).unwrap();
+        let next = state.cpu().unwrap();
+        assert!(next > gpu);
+        assert_eq!(state.cpu_done(cpu), Err(OwnershipError::StaleEpoch));
+        state.cpu_done(next).unwrap();
+    }
+
+    #[test]
+    fn every_failed_handoff_stays_poisoned() {
+        for at in 0..4 {
+            let mut state = Ownership::default();
+            let epoch = state.flushing().unwrap();
+            if at > 0 {
+                state.gpu(epoch).unwrap();
+            }
+            if at > 1 {
+                state.completed(epoch).unwrap();
+            }
+            if at > 2 {
+                state.invalidated(epoch).unwrap();
+            }
+            state.poison();
+            assert_eq!(state.cpu(), Err(OwnershipError::Poisoned));
+            assert_eq!(state.flushing(), Err(OwnershipError::Poisoned));
+            assert!(state.invalidated(epoch).is_err());
+            assert_eq!(state.phase, Phase::Poisoned);
+        }
+    }
+
+    #[test]
+    fn no_replayed_transition_releases_a_later_owner() {
+        let mut state = Ownership::default();
+        let first = state.flushing().unwrap();
+        state.gpu(first).unwrap();
+        state.completed(first).unwrap();
+        state.invalidated(first).unwrap();
+        let next = state.flushing().unwrap();
+        for stale in [0, first, next + 1, u64::MAX] {
+            assert!(state.gpu(stale).is_err());
+            assert!(state.completed(stale).is_err());
+            assert!(state.invalidated(stale).is_err());
+            assert_eq!(state.phase, Phase::Flushing(next));
+        }
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/src/producer/registry.rs b/crates/reims-vgpu-vulkan/src/producer/registry.rs
new file mode 100644
index 0000000..9c0dcac
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/producer/registry.rs
@@ -0,0 +1,316 @@
+//! CPU addresses resolve to an owned allocation and an offset, never to an FD number. Adjacent
+//! input pieces are accepted only when they describe one contiguous physical allocation span.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+/// A CPU-address interval supplied by a caller of the producer registry.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HostSpan {
+    /// First CPU virtual address in this registry's address space.
+    pub address: u64,
+    /// Number of consecutive logical bytes.
+    pub length: u64,
+}
+
+/// Why a producer resource cannot be represented by one contiguous Vulkan buffer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ResolveError {
+    /// No nonempty resource or mapping was supplied.
+    Empty,
+    /// Address or length arithmetic overflowed.
+    Overflow,
+    /// A registration overlaps a live CPU-address mapping.
+    Overlap,
+    /// At least one requested byte is not registered.
+    Unregistered,
+    /// Logical bytes are not consecutive offsets in one allocation.
+    Fragmented,
+    /// The mapping extends past its allocation.
+    OutsideAllocation,
+    /// The registration was replaced or already released.
+    StaleRegistration,
+    /// The non-reused registration generation cannot advance.
+    Exhausted,
+}
+
+#[derive(Debug)]
+struct Mapping<T> {
+    end: u64,
+    offset: u64,
+    registration: u64,
+    owner: Arc<T>,
+}
+
+/// One physical span. The retained owner survives removal or reuse of every source address.
+#[derive(Debug)]
+pub struct Resolved<T> {
+    /// The allocation owner, retained independently of its CPU mapping.
+    pub owner: Arc<T>,
+    /// The resource's first byte in that allocation.
+    pub offset: u64,
+    /// The complete validated resource length.
+    pub length: u64,
+}
+
+/// Registrations belong to one process/address space. A different process uses another
+/// registry even if its numerical addresses are equal. Owners are compared by allocation
+/// identity (`Arc::ptr_eq`), not by Vulkan handle or FD values that can be reused.
+#[derive(Debug)]
+pub struct Registry<T> {
+    mappings: BTreeMap<u64, Mapping<T>>,
+    next: u64,
+}
+
+impl<T> Default for Registry<T> {
+    fn default() -> Self {
+        Self {
+            mappings: BTreeMap::new(),
+            next: 1,
+        }
+    }
+}
+
+impl<T> Registry<T> {
+    /// Register a verified CPU alias. The caller owns the mapping and removes this registration
+    /// before unmapping/replacing it; `owner` keeps its allocation alive.
+    pub fn register(
+        &mut self,
+        host: HostSpan,
+        offset: u64,
+        allocation_bytes: u64,
+        owner: Arc<T>,
+    ) -> Result<u64, ResolveError> {
+        if host.length == 0 || host.address == 0 {
+            return Err(ResolveError::Empty);
+        }
+        let end = host
+            .address
+            .checked_add(host.length)
+            .ok_or(ResolveError::Overflow)?;
+        let physical_end = offset
+            .checked_add(host.length)
+            .ok_or(ResolveError::Overflow)?;
+        if physical_end > allocation_bytes {
+            return Err(ResolveError::OutsideAllocation);
+        }
+        if self
+            .mappings
+            .range(..end)
+            .next_back()
+            .is_some_and(|(_, m)| m.end > host.address)
+        {
+            return Err(ResolveError::Overlap);
+        }
+        let registration = self.next;
+        self.next = registration.checked_add(1).ok_or(ResolveError::Exhausted)?;
+        self.mappings.insert(
+            host.address,
+            Mapping {
+                end,
+                offset,
+                registration,
+                owner,
+            },
+        );
+        Ok(registration)
+    }
+
+    /// Remove exactly this incarnation. A stale release cannot remove a replacement mapping.
+    pub fn unregister(&mut self, address: u64, registration: u64) -> Result<(), ResolveError> {
+        let map = self
+            .mappings
+            .get(&address)
+            .ok_or(ResolveError::StaleRegistration)?;
+        if map.registration != registration {
+            return Err(ResolveError::StaleRegistration);
+        }
+        self.mappings.remove(&address);
+        Ok(())
+    }
+
+    /// Resolve the complete logical resource. Reims may split a contiguous run into several
+    /// input pieces; their CPU addresses need not be adjacent, but their allocation offsets
+    /// must advance together. Repeated pages, holes and multiple allocations are refused.
+    pub fn resolve(&self, spans: &[HostSpan]) -> Result<Resolved<T>, ResolveError> {
+        let mut answer: Option<Resolved<T>> = None;
+        for span in spans {
+            if span.length == 0 {
+                return Err(ResolveError::Empty);
+            }
+            let end = span
+                .address
+                .checked_add(span.length)
+                .ok_or(ResolveError::Overflow)?;
+            let mut at = span.address;
+            while at < end {
+                let (&base, map) = self
+                    .mappings
+                    .range(..=at)
+                    .next_back()
+                    .filter(|(_, m)| at < m.end)
+                    .ok_or(ResolveError::Unregistered)?;
+                let length = end.min(map.end) - at;
+                let offset = map
+                    .offset
+                    .checked_add(at - base)
+                    .ok_or(ResolveError::Overflow)?;
+                match &mut answer {
+                    Some(result) => {
+                        let next = result
+                            .offset
+                            .checked_add(result.length)
+                            .ok_or(ResolveError::Overflow)?;
+                        if !Arc::ptr_eq(&result.owner, &map.owner) || next != offset {
+                            return Err(ResolveError::Fragmented);
+                        }
+                        result.length = result
+                            .length
+                            .checked_add(length)
+                            .ok_or(ResolveError::Overflow)?;
+                    }
+                    None => {
+                        answer = Some(Resolved {
+                            owner: Arc::clone(&map.owner),
+                            offset,
+                            length,
+                        })
+                    }
+                }
+                at += length;
+            }
+        }
+        answer.ok_or(ResolveError::Empty)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    fn span(address: u64, length: u64) -> HostSpan {
+        HostSpan { address, length }
+    }
+
+    #[test]
+    fn split_and_moved_aliases_resolve_to_one_physical_span() {
+        let owner = Arc::new(7);
+        let mut table = Registry::default();
+        table
+            .register(span(0x10000, 0x4000), 0x4000, 0x8000, Arc::clone(&owner))
+            .unwrap();
+        table
+            .register(span(0x30000, 0x2000), 0x6000, 0x8000, Arc::clone(&owner))
+            .unwrap();
+        let got = table
+            .resolve(&[
+                span(0x10000, 0x1000),
+                span(0x11000, 0x1000),
+                span(0x30000, 0x2000),
+            ])
+            .unwrap();
+        assert!(Arc::ptr_eq(&got.owner, &owner));
+        assert_eq!((got.offset, got.length), (0x4000, 0x4000));
+        assert_eq!(
+            table
+                .resolve(&[span(0x10000, 0x1000), span(0x10000, 0x1000)])
+                .unwrap_err(),
+            ResolveError::Fragmented
+        );
+        assert_eq!(
+            table
+                .resolve(&[span(0x10000, 0x1000), span(0x12000, 0x1000)])
+                .unwrap_err(),
+            ResolveError::Fragmented
+        );
+    }
+
+    #[test]
+    fn handles_and_addresses_reused_do_not_reuse_allocation_identity() {
+        let mut table = Registry::default();
+        let first = Arc::new(7); // Identical payloads are still distinct allocations.
+        let second = Arc::new(7);
+        let old = table
+            .register(span(0x10000, 0x4000), 0, 0x8000, Arc::clone(&first))
+            .unwrap();
+        table
+            .register(span(0x20000, 0x4000), 0x4000, 0x8000, Arc::clone(&second))
+            .unwrap();
+        assert_eq!(
+            table
+                .resolve(&[span(0x10000, 0x4000), span(0x20000, 0x4000)])
+                .unwrap_err(),
+            ResolveError::Fragmented
+        );
+        let held = table.resolve(&[span(0x10000, 0x4000)]).unwrap();
+        table.unregister(0x10000, old).unwrap();
+        let new = table
+            .register(span(0x10000, 0x4000), 0, 0x8000, Arc::clone(&second))
+            .unwrap();
+        assert_ne!(old, new);
+        assert_eq!(
+            table.unregister(0x10000, old),
+            Err(ResolveError::StaleRegistration)
+        );
+        assert!(Arc::ptr_eq(&held.owner, &first));
+        assert!(Arc::ptr_eq(
+            &table.resolve(&[span(0x10000, 4)]).unwrap().owner,
+            &second
+        ));
+    }
+
+    #[test]
+    fn complete_ranges_are_validated_before_use() {
+        let mut table = Registry::default();
+        let owner = Arc::new(1);
+        table
+            .register(span(0x10000, 0x1000), 0, 0x8000, Arc::clone(&owner))
+            .unwrap();
+        for (s, offset, expected) in [
+            (span(0x10800, 0x1000), 0, ResolveError::Overlap),
+            (span(0xff00, 0x200), 0, ResolveError::Overlap),
+            (
+                span(0x20000, 0x1000),
+                0x7800,
+                ResolveError::OutsideAllocation,
+            ),
+            (span(u64::MAX - 1, 4), 0, ResolveError::Overflow),
+            (span(0x20000, 4), u64::MAX - 1, ResolveError::Overflow),
+            (span(0x20000, 0), 0, ResolveError::Empty),
+        ] {
+            assert_eq!(
+                table.register(s, offset, 0x8000, Arc::clone(&owner)),
+                Err(expected)
+            );
+        }
+        assert_eq!(
+            table.resolve(&[span(0x10000, 0x1001)]).unwrap_err(),
+            ResolveError::Unregistered
+        );
+        assert_eq!(table.resolve(&[]).unwrap_err(), ResolveError::Empty);
+    }
+
+    #[test]
+    fn resolved_span_keeps_backing_after_registration_is_gone() {
+        #[derive(Debug)]
+        struct Backing(Arc<AtomicUsize>);
+        impl Drop for Backing {
+            fn drop(&mut self) {
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let drops = Arc::new(AtomicUsize::new(0));
+        let owner = Arc::new(Backing(Arc::clone(&drops)));
+        let mut table = Registry::default();
+        let id = table
+            .register(span(0x10000, 0x1000), 0, 0x1000, Arc::clone(&owner))
+            .unwrap();
+        let held = table.resolve(&[span(0x10000, 0x1000)]).unwrap();
+        table.unregister(0x10000, id).unwrap();
+        drop(owner);
+        drop(table);
+        assert_eq!(drops.load(Ordering::SeqCst), 0);
+        drop(held);
+        assert_eq!(drops.load(Ordering::SeqCst), 1);
+    }
+}
