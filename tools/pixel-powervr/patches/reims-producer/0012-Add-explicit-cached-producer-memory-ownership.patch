+/// An allocation plus its one runtime buffer and queue. Clones are `Arc` references to this
+/// object; separate Vulkan buffers over the same memory are never created by this API.
+pub struct Producer {
+    backing: Arc<Backing>,
+    buffer: rt::Buffer,
+    queue: rt::CommandQueue,
+    registry: Mutex<Registry<Backing>>,
+    flushes: AtomicU64,
+    invalidates: AtomicU64,
+    submissions: AtomicU64,
+}
+
+impl Producer {
+    /// Create a runtime device through reims' ordinary system-default selection and allocate
+    /// on it. Use `new` with the embedding runtime's device to share that exact logical device;
+    /// equal physical registry IDs alone do not establish logical-device identity.
+    pub fn system_default(bytes: u64) -> Result<Arc<Self>, Error> {
+        if bytes == 0 || !bytes.is_multiple_of(16) || bytes > isize::MAX as u64 {
+            return Err(Error::Invalid(
+                "nonzero, addressable, 16-byte-multiple size required",
+            ));
+        }
+        let device = crate::VulkanPlatform::system_default_device()
+            .ok_or(Error::Unsupported("no runtime Vulkan device"))?;
+        Self::new(&device.raw, bytes)
+    }
+
+    /// Allocate on an existing runtime device that enabled `VK_KHR_external_memory_fd`.
+    /// The entire allocation is mapped once through Vulkan and retained by the runtime buffer.
+    /// A compatible `HOST_VISIBLE | HOST_CACHED` type is mandatory; there is no uncached fallback.
+    pub fn new(device: &rt::Device, bytes: u64) -> Result<Arc<Self>, Error> {
+        if bytes == 0 || !bytes.is_multiple_of(16) || bytes > isize::MAX as u64 {
+            return Err(Error::Invalid(
+                "nonzero, addressable, 16-byte-multiple size required",
+            ));
+        }
+        if device.device_proc_addr(c"vkGetMemoryFdKHR").is_none() {
+            return Err(Error::Unsupported(
+                "VK_KHR_external_memory_fd must be enabled",
+            ));
+        }
+        // SAFETY: borrowed handles remain owned by the retained runtime device.
+        let raw = unsafe { device.raw() };
+        let usage = vk::BufferUsageFlags::from(device.vk_buffer_usage());
+        let handle = vk::ExternalMemoryHandleTypeFlags::OPAQUE_FD;
+        let query = vk::PhysicalDeviceExternalBufferInfo::default()
+            .usage(usage)
+            .handle_type(handle);
+        let mut support = vk::ExternalBufferProperties::default();
+        // SAFETY: exact buffer usage/flags/handle query, initialized output.
+        unsafe {
+            raw.instance.get_physical_device_external_buffer_properties(
+                raw.physical_device,
+                &query,
+                &mut support,
+            )
+        };
+        let external = support.external_memory_properties;
+        if !external
+            .external_memory_features
+            .contains(vk::ExternalMemoryFeatureFlags::EXPORTABLE)
+            || !external.compatible_handle_types.contains(handle)
+            || external
+                .external_memory_features
+                .contains(vk::ExternalMemoryFeatureFlags::DEDICATED_ONLY)
+        {
+            return Err(Error::Unsupported("non-dedicated opaque-FD buffer export"));
+        }
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let id = NEXT
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1))
+            .map_err(|_| Error::Ownership(OwnershipError::Exhausted))?;
+        let state = Arc::new(Mutex::new(Ownership::default()));
+        let mut backing = Backing {
+            device: ManuallyDrop::new(device.clone()),
+            buffer: vk::Buffer::null(),
+            memory: vk::DeviceMemory::null(),
+            mapping: None,
+            fd: None,
+            state,
+            info: Info {
+                allocation_id: id,
+                device_registry_id: device.registry_id(),
+                logical_bytes: bytes,
+                allocation_bytes: 0,
+                memory_type: 0,
+                memory_flags: 0,
+                noncoherent_atom_bytes: 0,
+                runtime_object_id: 0,
+            },
+        };
+        let mut export_buffer = vk::ExternalMemoryBufferCreateInfo::default().handle_types(handle);
+        let mut info = vk::BufferCreateInfo::default()
+            .size(bytes)
+            .usage(usage)
+            .sharing_mode(vk::SharingMode::EXCLUSIVE)
+            .push_next(&mut export_buffer);
+        if raw.queue_families.len() > 1 {
+            info = info
+                .sharing_mode(vk::SharingMode::CONCURRENT)
+                .queue_family_indices(raw.queue_families);
+        }
+        // SAFETY: all creation pointers remain live; resources are immediately RAII-owned.
+        backing.buffer = unsafe { raw.device.create_buffer(&info, None) }?;
+        let mut dedicated = vk::MemoryDedicatedRequirements::default();
+        let mut requirements = vk::MemoryRequirements2::default().push_next(&mut dedicated);
+        // SAFETY: live unbound buffer of this device, initialized output chain.
+        unsafe {
+            raw.device.get_buffer_memory_requirements2(
+                &vk::BufferMemoryRequirementsInfo2::default().buffer(backing.buffer),
+                &mut requirements,
+            )
+        };
+        let requirements = requirements.memory_requirements;
+        if dedicated.requires_dedicated_allocation != 0 || requirements.size < bytes {
+            return Err(Error::Unsupported(
+                "dedicated allocation or invalid size requirement",
+            ));
+        }
+        // SAFETY: the physical device belongs to the retained instance.
+        let properties = unsafe {
+            raw.instance
+                .get_physical_device_memory_properties(raw.physical_device)
+        };
+        let required = vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_CACHED;
+        let memory_type = (0..properties.memory_type_count)
+            .find(|&i| {
+                requirements.memory_type_bits & (1 << i) != 0
+                    && properties.memory_types[i as usize]
+                        .property_flags
+                        .contains(required)
+            })
+            .ok_or(Error::Unsupported(
+                "no compatible CPU-cached host-visible memory type",
+            ))?;
+        backing.info.allocation_bytes = requirements.size;
+        backing.info.memory_type = memory_type;
+        backing.info.memory_flags = properties.memory_types[memory_type as usize]
+            .property_flags
+            .as_raw();
+        // SAFETY: ordinary physical-device properties query.
+        backing.info.noncoherent_atom_bytes = unsafe {
+            raw.instance
+                .get_physical_device_properties(raw.physical_device)
+        }
+        .limits
+        .non_coherent_atom_size;
+        let mut export_memory = vk::ExportMemoryAllocateInfo::default().handle_types(handle);
+        let mut address =
+            vk::MemoryAllocateFlagsInfo::default().flags(vk::MemoryAllocateFlags::DEVICE_ADDRESS);
+        let mut allocate = vk::MemoryAllocateInfo::default()
+            .allocation_size(requirements.size)
+            .memory_type_index(memory_type)
+            .push_next(&mut export_memory);
+        if usage.contains(vk::BufferUsageFlags::SHADER_DEVICE_ADDRESS) {
+            allocate = allocate.push_next(&mut address);
+        }
+        // SAFETY: actual compatible requirements, zero binding offset and BDA allocation flag.
+        unsafe {
+            backing.memory = raw.device.allocate_memory(&allocate, None)?;
+            raw.device
+                .bind_buffer_memory(backing.buffer, backing.memory, 0)?;
+            let pointer = raw.device.map_memory(
+                backing.memory,
+                0,
+                vk::WHOLE_SIZE,
+                vk::MemoryMapFlags::empty(),
+            )?;
+            backing.mapping =
+                Some(NonNull::new(pointer.cast()).ok_or(Error::Invalid("null Vulkan mapping"))?);
+        }
+        let api = ash::khr::external_memory_fd::Device::new(raw.instance, raw.device);
+        // SAFETY: allocation explicitly exported as OPAQUE_FD. Opaque handles are never queried
+        // with vkGetMemoryFdPropertiesKHR, nor identified by fstat/FD number.
+        let fd = unsafe {
+            api.get_memory_fd(
+                &vk::MemoryGetFdInfoKHR::default()
+                    .memory(backing.memory)
+                    .handle_type(handle),
+            )
+        }?;
+        // SAFETY: the successful export transferred ownership of this fresh descriptor.
+        backing.fd = Some(unsafe { OwnedFd::from_raw_fd(fd) });
+        // SAFETY: the exported descriptor is live and owned here; set its descriptor flags.
+        if unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) } < 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        let backing = Arc::new(backing);
+        let descriptor = rt::VkBufferDescriptor::new(
+            backing.buffer,
+            info,
+            rt::VkBufferMemory::new(backing.memory, 0, memory_type, None),
+            bytes,
+            rt::ResourceOptions::private(),
+        )
+        .with_backing_owner(Box::new(Arc::clone(&backing)));
+        // SAFETY: exact same-device creation/binding facts, retained handles and BDA flag.
+        // Private storage deliberately promises no coherent CPU mapping to the runtime.
+        let buffer = unsafe { device.new_buffer_with_vk_buffer_descriptor(descriptor) }?;
+        let queue = device.new_command_queue()?;
+        let mut registry = Registry::default();
+        let mapping = backing
+            .mapping
+            .ok_or(Error::Invalid("no canonical Vulkan mapping"))?;
+        registry.register(
+            HostSpan {
+                address: mapping.as_ptr() as u64,
+                length: bytes,
+            },
+            0,
+            requirements.size,
+            Arc::clone(&backing),
+        )?;
+        Ok(Arc::new(Self {
+            backing,
+            buffer,
+            queue,
+            registry: Mutex::new(registry),
+            flushes: AtomicU64::new(0),
+            invalidates: AtomicU64::new(0),
+            submissions: AtomicU64::new(0),
+        }))
+    }
+
+    /// Actual allocation facts. The runtime object ID is shared by every alias and binding.
+    pub fn info(&self) -> Info {
+        Info {
+            runtime_object_id: self.buffer.object_id().get(),
+            ..self.backing.info
+        }
+    }
+
+    /// Successful flush, invalidate and completed-submission counts, in that order.
+    pub fn counts(&self) -> (u64, u64, u64) {
+        (
+            self.flushes.load(Ordering::Acquire),
+            self.invalidates.load(Ordering::Acquire),
+            self.submissions.load(Ordering::Acquire),
+        )
+    }
+
+    /// Begin an exclusive CPU epoch. Dropping it unfinished poisons the allocation.
+    pub fn cpu(self: &Arc<Self>) -> Result<CpuAccess, Error> {
+        let epoch = lock(&self.backing.state).cpu()?;
+        Ok(CpuAccess {
+            producer: Arc::clone(self),
+            epoch,
+            active: true,
+        })
+    }
+
+    fn cache(&self, flush: bool) -> Result<(), Error> {
+        let range = vk::MappedMemoryRange::default()
+            .memory(self.backing.memory)
+            .offset(0)
+            .size(vk::WHOLE_SIZE);
+        // SAFETY: one complete live Vulkan mapping; the ownership state excludes all other
+        // CPU/GPU access. Whole-size covers complete nonCoherentAtomSize units through the end
+        // of the allocation without rounding beyond it. Invalidation follows a completed wait.
+        unsafe {
+            let raw = self.backing.device.raw();
+            if flush {
+                raw.device.flush_mapped_memory_ranges(&[range])?;
+            } else {
+                raw.device.invalidate_mapped_memory_ranges(&[range])?;
+            }
+        }
+        if flush {
+            self.flushes.fetch_add(1, Ordering::Release);
+        } else {
+            self.invalidates.fetch_add(1, Ordering::Release);
+        }
+        Ok(())
+    }
+
+    /// Encode and execute one whole-allocation GPU epoch through the real runtime. Success
+    /// returns only after the runtime's host wait and this allocation's invalidation.
+    ///
+    /// # Safety
+    /// The closure only encodes into the supplied command buffer. It must not retain/export
+    /// either object, submit work itself, install callbacks, signal CPU-visible events, use
+    /// another queue, or allow access to any CPU alias. Every use of this allocation must occur
+    /// through this method or a live CPU epoch. These restrictions exclude mid-command CPU
+    /// handoffs; an eventual automatic guest integration needs batch-level ownership hooks.
+    pub unsafe fn submit(
+        &self,
+        timeout: Duration,
+        encode: impl FnOnce(&rt::Buffer, &rt::CommandBuffer) -> Result<(), rt::Error>,
+    ) -> Result<(), Error> {
+        if timeout.is_zero() {
+            return Err(Error::Invalid("nonzero GPU deadline required"));
+        }
+        let epoch = lock(&self.backing.state).flushing()?;
+        // A guard poisons on every early return or unwind, including closure failure.
+        let mut guard = GpuAccess {
+            producer: self,
+            done: false,
+        };
+        self.cache(true)?;
+        lock(&self.backing.state).gpu(epoch)?;
+        let command = self.queue.command_buffer()?;
+        encode(&self.buffer, &command)?;
+        command.commit()?;
+        command
+            .wait_until_completed_for(timeout)
+            .map_err(|_| Error::Timeout)?;
+        if let Some(error) = command.error_description() {
+            return Err(Error::CommandFailed(error));
+        }
+        if command.status() != rt::CommandBufferStatus::Completed {
+            return Err(Error::CommandFailed(format!(
+                "unexpected status {:?}",
+                command.status()
+            )));
+        }
+        lock(&self.backing.state).completed(epoch)?;
+        self.cache(false)?;
+        lock(&self.backing.state).invalidated(epoch)?;
+        self.submissions.fetch_add(1, Ordering::Release);
+        guard.done = true;
+        Ok(())
+    }
+
+    /// Upload complete caller bytes through a runtime blit. No host write targets producer
+    /// memory here; the independent staging buffer is retained by the command.
+    pub fn upload(&self, bytes: &[u8], timeout: Duration) -> Result<(), Error> {
+        if bytes.len() as u64 != self.info().logical_bytes {
+            return Err(Error::Invalid("whole allocation upload required"));
+        }
+        let input = self
+            .backing
+            .device
+            .new_buffer_with_bytes(bytes, rt::ResourceOptions::shared())?;
+        // SAFETY: one private command, no callbacks/events, no objects escape the closure.
+        unsafe {
+            self.submit(timeout, |buffer, command| {
+                let mut blit = command.blit_command_encoder()?;
+                blit.copy_from_buffer_to_buffer(&input, 0, buffer, 0, bytes.len() as u64)?;
+                blit.end_encoding()
+            })
+        }
+    }
+
+    /// Copy through an independent runtime readback buffer. The returned ordinary bytes are
+    /// read only after the runtime completed and producer ownership returned to idle.
+    pub fn download(&self, timeout: Duration) -> Result<Vec<u8>, Error> {
+        let bytes = self.info().logical_bytes;
+        let output = self
+            .backing
+            .device
+            .new_buffer(bytes, rt::ResourceOptions::shared())?;
+        // SAFETY: one private command, no callbacks/events, no objects escape the closure.
+        unsafe {
+            self.submit(timeout, |buffer, command| {
+                let mut blit = command.blit_command_encoder()?;
+                blit.copy_from_buffer_to_buffer(buffer, 0, &output, 0, bytes)?;
+                blit.end_encoding()
+            })?;
+        }
+        let pointer = output
+            .contents()
+            .ok_or(Error::Invalid("readback has no CPU mapping"))?;
+        let mut result = vec![0_u8; bytes as usize];
+        // Explicit scalar reads, no atomics against the driver's coherent readback mapping.
+        for (i, slot) in result.as_chunks_mut::<4>().0.iter_mut().enumerate() {
+            // SAFETY: completed independent shared buffer of `bytes` bytes, aligned to four.
+            let word = unsafe { pointer.as_ptr().cast::<u32>().add(i).read_volatile() };
+            slot.copy_from_slice(&word.to_ne_bytes());
+        }
+        Ok(result)
+    }
+}
