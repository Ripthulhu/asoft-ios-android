diff --git a/crates/reims-vgpu-vulkan/src/producer.rs b/crates/reims-vgpu-vulkan/src/producer.rs
new file mode 100644
index 0000000..493ed56
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/producer.rs
@@ -0,0 +1,717 @@
+//! Producer-owned, CPU-cached Vulkan bytes for an explicitly serialized native/GPU bridge.
+//!
+//! This is an opt-in interop API, separate from ordinary guest RAM and no-copy host imports.
+//! One allocation owns one runtime buffer, so every resolved CPU alias uses the same resource
+//! identity plus an offset. Fragmented ranges are refused. Vulkan storage is `Private`: the
+//! runtime never exposes the noncoherent mapping as a coherent Metal `Shared` buffer.
+//!
+//! A CPU epoch excludes GPU work. Exported native views retain the allocation and must be
+//! explicitly retired after every recipient stopped accessing them. GPU submission flushes the
+//! whole mapped allocation, waits for runtime completion, and invalidates before another CPU
+//! epoch can start. This API does not implement concurrent access, producer atomics, guest RAM
+//! remapping, or CPU shared-event callbacks inside a command buffer.
+
+mod ownership;
+pub mod registry;
+
+pub use ownership::OwnershipError;
+pub use registry::{HostSpan, ResolveError};
+
+use ash::vk;
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::sync::{Mutex, MutexGuard};
+use std::fmt;
+use std::mem::ManuallyDrop;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::ptr::NonNull;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+use ownership::{Ownership, Phase};
+use registry::Registry;
+
+/// A producer allocation or ownership operation's refusal. No fallback changes memory type.
+#[derive(Debug)]
+pub enum Error {
+    /// A malformed size, pointer or internal allocation fact.
+    Invalid(&'static str),
+    /// The actual device lacks the requested producer-memory contract.
+    Unsupported(&'static str),
+    /// An ownership transition cannot occur in the present epoch.
+    Ownership(OwnershipError),
+    /// The requested resource is not one registered contiguous physical span.
+    Resolve(ResolveError),
+    /// A Vulkan allocation, mapping or cache operation failed.
+    Vulkan(vk::Result),
+    /// The Metal-shaped runtime refused an operation.
+    Runtime(rt::Error),
+    /// Descriptor duplication or an OS operation failed.
+    Io(std::io::Error),
+    /// GPU completion was not established within the caller's deadline.
+    Timeout,
+    /// The runtime reported a failed command buffer.
+    CommandFailed(String),
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{self:?}")
+    }
+}
+impl std::error::Error for Error {}
+impl From<vk::Result> for Error {
+    fn from(e: vk::Result) -> Self {
+        Self::Vulkan(e)
+    }
+}
+impl From<rt::Error> for Error {
+    fn from(e: rt::Error) -> Self {
+        Self::Runtime(e)
+    }
+}
+impl From<std::io::Error> for Error {
+    fn from(e: std::io::Error) -> Self {
+        Self::Io(e)
+    }
+}
+impl From<OwnershipError> for Error {
+    fn from(e: OwnershipError) -> Self {
+        Self::Ownership(e)
+    }
+}
+impl From<ResolveError> for Error {
+    fn from(e: ResolveError) -> Self {
+        Self::Resolve(e)
+    }
+}
