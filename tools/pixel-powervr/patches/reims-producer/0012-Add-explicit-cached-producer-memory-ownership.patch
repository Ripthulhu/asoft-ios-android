 #define RVG_WINDOW_SCROLL_MOMENTUM_ENDED 3
 
+// Another epoch owns the producer, a transition was replayed, or native aliases remain.
+#define RVG_ERR_PRODUCER_STATE 17
+
+// An abandoned or failed handoff permanently blocks further producer access.
+#define RVG_ERR_PRODUCER_POISONED 18
+
+// GPU completion was not established within the producer's five-second wait.
