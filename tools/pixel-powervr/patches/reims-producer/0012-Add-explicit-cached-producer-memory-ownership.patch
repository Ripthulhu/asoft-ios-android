diff --git a/crates/reims-vgpu-vulkan/examples/producer_memory.rs b/crates/reims-vgpu-vulkan/examples/producer_memory.rs
new file mode 100644
index 0000000..95140b4
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/producer_memory.rs
@@ -0,0 +1,307 @@
+//! Bounded whole-allocation ownership check. The AIR input is the repository-authored
+//! metal2vulkan `fixtures/public/examples/runtime_examples.ll`, assembled with llvm-as.
+//! No producer atomics or instruction fetches are issued.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_vulkan::{
+        VulkanPlatform,
+        producer::{HostSpan, OwnershipError, Producer},
+    };
+    use std::error::Error;
+    use std::ptr::NonNull;
+    use std::time::Duration;
+
+    const BYTES: usize = 32768;
+    const WAIT: Duration = Duration::from_secs(5);
+
+    struct Mapping {
+        address: NonNull<u8>,
+    }
+    // SAFETY: this mapping's bytes are used only inside its producer CPU epoch. The owner only
+    // unmaps it, after those accesses ended, and does not dereference the pointer during Drop.
+    unsafe impl Send for Mapping {}
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: the full offset-zero mapping is exclusively owned and has no surviving users.
+            assert_eq!(
+                unsafe { libc::munmap(self.address.as_ptr().cast(), BYTES) },
+                0
+            );
+        }
+    }
+
+    pub(super) fn run() -> Result<(), Box<dyn Error>> {
+        let mut args = std::env::args().skip(1);
+        let air_path = args
+            .next()
+            .ok_or("provide assembled runtime_examples.air [--canonical-only]")?;
+        let canonical_only = match args.next().as_deref() {
+            None => false,
+            Some("--canonical-only") => true,
+            Some(_) => return Err("unknown mode".into()),
+        };
+        if args.next().is_some() {
+            return Err("unexpected extra argument".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let producer = Producer::new(&device.raw, BYTES as u64)?;
+        println!("PRODUCER_INFO={:?}", producer.info());
+        assert_eq!(producer.info().allocation_bytes, BYTES as u64);
+        let mut expected: Vec<u32> = (0..BYTES / 4)
+            .map(|i| 0x6a1b2c30 + (i / 1024) as u32)
+            .collect();
+        let input = 1024;
+        let output = 3072;
+        for i in 0..64 {
+            expected[input + i] = (i as f32 + 1.0).to_bits();
+        }
+        let bytes: Vec<u8> = expected.iter().flat_map(|w| w.to_ne_bytes()).collect();
+        producer.upload(&bytes, WAIT)?;
+        assert_eq!(producer.download(WAIT)?, bytes);
+
+        let mut cpu = producer.cpu()?;
+        let epoch = cpu.epoch();
+        let canonical = cpu.pointer()?;
+        let mut native = cpu.export()?;
+        for (i, expected) in expected.iter().enumerate() {
+            // SAFETY: canonical bytes are read inside this exclusive CPU epoch.
+            assert_eq!(
+                unsafe { canonical.as_ptr().cast::<u32>().add(i).read_volatile() },
+                *expected
+            );
+        }
+        assert!(matches!(
+            producer.download(WAIT),
+            Err(reims_vgpu_vulkan::producer::Error::Ownership(
+                OwnershipError::Busy
+            ))
+        ));
+        // SAFETY: no CPU accesses are ongoing; refusal is expected because the export remains.
+        assert!(matches!(
+            unsafe { cpu.finish() },
+            Err(reims_vgpu_vulkan::producer::Error::Ownership(
+                OwnershipError::AliasesLive
+            ))
+        ));
+        if canonical_only {
+            // SAFETY: this aligned scalar store uses only the actual Vulkan mapping, inside its
+            // exclusive CPU epoch. OPAQUE_FD itself does not promise a POSIX mmap layout.
+            unsafe {
+                canonical
+                    .as_ptr()
+                    .cast::<u32>()
+                    .add(4098)
+                    .write_volatile(0x91a2b3c4);
+            }
+            println!(
+                "CPU_ALIAS_OWNERSHIP=NOT_TESTED mode=canonical-only native_export_lifetime=checked"
+            );
+        } else {
+            // SAFETY: the CPU epoch owns this live allocation and exported descriptor. Only a full
+            // mapping from zero is used; this test does not assert arbitrary-offset mmap support.
+            let address = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    BYTES,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_SHARED,
+                    native.fd(),
+                    0,
+                )
+            };
+            if address == libc::MAP_FAILED {
+                return Err(std::io::Error::last_os_error().into());
+            }
+            let mapping = Mapping {
+                address: NonNull::new(address.cast()).ok_or("null mapping")?,
+            };
+            // Check the provider's complete initial byte layout before registering this as an alias.
+            for (i, expected) in expected.iter().enumerate() {
+                // SAFETY: mmap made this complete read/write interval valid in this CPU epoch.
+                let got = unsafe {
+                    mapping
+                        .address
+                        .as_ptr()
+                        .cast::<u32>()
+                        .add(i)
+                        .read_volatile()
+                };
+                if got != *expected {
+                    return Err(format!(
+                    "OPAQUE_FD_POSIX_ALIAS_UNQUALIFIED word={i} got={got:#x} expected={expected:#x}"
+                )
+                .into());
+                }
+            }
+            let alias_at = mapping.address.as_ptr() as u64 + 16384;
+            // SAFETY: this is the selected half of a complete same-allocation mapping. Its owner keeps
+            // all bytes stable and unmaps them only after the registration's CPU uses end.
+            let alias = unsafe {
+                cpu.register_alias(
+                    HostSpan {
+                        address: alias_at,
+                        length: 16384,
+                    },
+                    16384,
+                    Box::new(mapping),
+                )
+            }?;
+            let spans = [
+                HostSpan {
+                    address: canonical.as_ptr() as u64 + 16384,
+                    length: 4096,
+                },
+                HostSpan {
+                    address: alias_at + 4096,
+                    length: 12288,
+                },
+            ];
+            assert_eq!(cpu.resolve(&spans)?, (16384, 16384));
+            let repeated = [spans[0], spans[0]];
+            assert!(cpu.resolve(&repeated).is_err());
+            // SAFETY: aligned scalar access inside the live selected CPU alias. No GPU work is active.
+            unsafe {
+                (alias_at as *mut u32).add(2).write_volatile(0x91a2b3c4);
+            }
+            // SAFETY: canonical bytes belong to this exclusive CPU epoch.
+            assert_eq!(
+                unsafe { canonical.as_ptr().cast::<u32>().add(4098).read_volatile() },
+                0x91a2b3c4
+            );
+            drop(alias); // Unregister, unmap, then release this alias's ownership hold.
+            println!(
+                "CPU_ALIAS_OWNERSHIP=PASS epoch={epoch} contiguous=16384 repeated_pages=refused"
+            );
+        }
+        expected[4098] = 0x91a2b3c4;
+        // SAFETY: no transferred descriptors or workers exist; the sole native mapping was dropped.
+        unsafe {
+            native.retire()?;
+        }
+        drop(native);
+        // SAFETY: all CPU accesses ended and every exported alias is gone.
+        unsafe {
+            cpu.finish()?;
+        }
+        println!("CPU_EPOCH=PASS epoch={epoch} live_export_end=refused gpu_during_cpu=refused");
+
+        let library =
+            device
+                .raw
+                .new_library_with_compile_library(metal2vulkan::library::Library::from_air(
+                    &std::fs::read(air_path)?,
+                )?);
+        let function = library.new_function_with_name("scale_and_offset")?;
+        let pipeline = device
+            .raw
+            .new_compute_pipeline_state_with_function(&function, &rt::PipelineOptions::default())?;
+        let scale = device
+            .raw
+            .new_buffer_with_bytes(&2.0_f32.to_le_bytes(), rt::ResourceOptions::shared())?;
+        // SAFETY: this closure only encodes one compute dispatch. No callback, event or object
+        // escapes; CPU ownership has ended and both bindings use the same runtime buffer identity.
+        unsafe {
+            producer.submit(WAIT, |buffer, command| {
+                let mut compute = command.compute_command_encoder()?;
+                compute.set_compute_pipeline_state(&pipeline)?;
+                compute.set_buffer(Some(buffer), (input * 4) as u64, 0)?;
+                compute.set_buffer(Some(buffer), (output * 4) as u64, 1)?;
+                compute.set_buffer(Some(&scale), 0, 2)?;
+                compute.dispatch_threads(rt::Size::new(64, 1, 1), rt::Size::new(32, 1, 1))?;
+                compute.end_encoding()
+            })?;
+        }
+        for i in 0..64 {
+            expected[output + i] = ((i as f32 + 1.0) * 2.0 + i as f32).to_bits();
+        }
+        let got = producer.download(WAIT)?;
+        for (i, word) in got.as_chunks::<4>().0.iter().enumerate() {
+            assert_eq!(u32::from_ne_bytes(*word), expected[i], "word {i}");
+        }
+        let mut cpu = producer.cpu()?;
+        assert!(cpu.epoch() > epoch);
+        let canonical = cpu.pointer()?;
+        for (i, expected) in expected.iter().enumerate() {
+            // SAFETY: all GPU work completed and invalidation preceded this CPU epoch.
+            assert_eq!(
+                unsafe { canonical.as_ptr().cast::<u32>().add(i).read_volatile() },
+                *expected,
+                "CPU word {i}"
+            );
+        }
+        // SAFETY: CPU reads ended; no exports were made in this epoch.
+        unsafe {
+            cpu.finish()?;
+        }
+        let before = producer.counts();
+        assert_eq!(before, (4, 4, 4));
+        println!(
+            "RUNTIME_COMPUTE=PASS words_checked=8192 cache_counts={before:?} same_runtime_object={}",
+            producer.info().runtime_object_id
+        );
+
+        let poisoned = Producer::new(&device.raw, BYTES as u64)?;
+        let abandoned = poisoned.cpu()?;
+        drop(abandoned);
+        assert!(matches!(
+            poisoned.cpu(),
+            Err(reims_vgpu_vulkan::producer::Error::Ownership(
+                OwnershipError::Poisoned
+            ))
+        ));
+        assert!(matches!(
+            poisoned.download(WAIT),
+            Err(reims_vgpu_vulkan::producer::Error::Ownership(
+                OwnershipError::Poisoned
+            ))
+        ));
+        assert_eq!(poisoned.counts(), (0, 0, 0));
+        println!("ABANDONED_EPOCH=PASS later_CPU_and_GPU_refused=true");
+        let retained = Producer::new(&device.raw, BYTES as u64)?;
+        let weak = std::sync::Arc::downgrade(&retained);
+        let mut cpu = retained.cpu()?;
+        let mut native = cpu.export()?;
+        let identity = retained.info().allocation_id;
+        drop(retained);
+        assert!(weak.upgrade().is_some());
+        assert_eq!(native.info().allocation_id, identity);
+        let pointer = cpu.pointer()?;
+        // SAFETY: the CPU lease still owns the allocation after the public owner was dropped.
+        unsafe {
+            pointer.as_ptr().cast::<u32>().write_volatile(0x12345678);
+        }
+        assert_eq!(
+            unsafe { pointer.as_ptr().cast::<u32>().read_volatile() },
+            0x12345678
+        );
+        // SAFETY: this descriptor was never transferred or mapped by another recipient.
+        unsafe {
+            native.retire()?;
+        }
+        drop(native);
+        // SAFETY: the only CPU accesses ended above; no external recipient exists.
+        unsafe {
+            cpu.finish()?;
+        }
+        drop(cpu);
+        assert!(weak.upgrade().is_none());
+        println!("PUBLIC_OWNER_RELEASE=PASS CPU_and_native_leases_retained_allocation=true");
+        println!(
+            "RESULT=REIMS_PRODUCER_RUNTIME_PASS producer_atomics=0 native_execution=not_this_test canonical_only={canonical_only}"
+        );
+        Ok(())
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    supported::run()
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "android")))]
+fn main() {
+    eprintln!("Producer OPAQUE_FD interop requires Linux or Android");
+    std::process::exit(2);
+}
