+/// Immutable allocation identity and the actual driver's memory requirements.
+#[derive(Clone, Copy, Debug)]
+pub struct Info {
+    /// A process-unique allocation generation, never an FD or Vulkan handle number.
+    pub allocation_id: u64,
+    /// The physical adapter's registry ID, not a logical VkDevice identity.
+    pub device_registry_id: u64,
+    /// The runtime buffer's logical byte length.
+    pub logical_bytes: u64,
+    /// The full VkDeviceMemory requirement and mapping length.
+    pub allocation_bytes: u64,
+    /// The driver's chosen compatible memory-type index.
+    pub memory_type: u32,
+    /// The chosen memory type's actual VkMemoryPropertyFlags bits.
+    pub memory_flags: u32,
+    /// The physical device's nonCoherentAtomSize.
+    pub noncoherent_atom_bytes: u64,
+    /// The one runtime buffer identity shared by all spans.
+    pub runtime_object_id: u64,
+}
+
+/// Raw Vulkan resources. Runtime memory holds retain this owner after the public producer
+/// handle is released. Failure with uncertain CPU/GPU use deliberately retains the device and
+/// allocation until process exit; it never guesses that a timeout completed the work.
+struct Backing {
+    device: ManuallyDrop<rt::Device>,
+    buffer: vk::Buffer,
+    memory: vk::DeviceMemory,
+    mapping: Option<NonNull<u8>>,
+    fd: Option<OwnedFd>,
+    state: Arc<Mutex<Ownership>>,
+    info: Info,
+}
+
+// SAFETY: the pointer is accessed only under a CPU epoch; raw handles stay live through the
+// retained runtime owner. Vulkan memory/cache operations are serialized by the ownership state.
+unsafe impl Send for Backing {}
+// SAFETY: the same epoch excludes all competing producer operations.
+unsafe impl Sync for Backing {}
+
+impl Drop for Backing {
+    fn drop(&mut self) {
+        if lock(&self.state).phase != Phase::Idle {
+            return;
+        }
+        // SAFETY: the last runtime/CPU/exported-view hold is gone, with no active or uncertain
+        // work. The handles were each created on this retained device and are destroyed once.
+        unsafe {
+            let raw = self.device.raw();
+            if self.mapping.is_some() {
+                raw.device.unmap_memory(self.memory);
+            }
+            if self.buffer != vk::Buffer::null() {
+                raw.device.destroy_buffer(self.buffer, None);
+            }
+            if self.memory != vk::DeviceMemory::null() {
+                raw.device.free_memory(self.memory, None);
+            }
+            ManuallyDrop::drop(&mut self.device);
+        }
+    }
+}
