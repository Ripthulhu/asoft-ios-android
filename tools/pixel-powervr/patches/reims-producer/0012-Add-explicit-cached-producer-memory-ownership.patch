+/// An exclusive native CPU epoch. Metadata and counters are ordinary host memory; no producer
+/// atomic instruction is issued. Raw-pointer and cross-process users follow the unsafe contracts.
+pub struct CpuAccess {
+    producer: Arc<Producer>,
+    epoch: u64,
+    active: bool,
+}
+
+impl CpuAccess {
+    /// The non-reused epoch number, useful in an authenticated native-worker protocol.
+    pub fn epoch(&self) -> u64 {
+        self.epoch
+    }
+
+    /// The canonical CPU address, valid only through this live CPU epoch.
+    pub fn pointer(&self) -> Result<NonNull<u8>, Error> {
+        lock(&self.producer.backing.state).check_cpu(self.epoch)?;
+        self.producer
+            .backing
+            .mapping
+            .ok_or(Error::Invalid("no mapping"))
+    }
+
+    /// Resolve all CPU pieces to one allocation offset without reading producer bytes.
+    pub fn resolve(&self, spans: &[HostSpan]) -> Result<(u64, u64), Error> {
+        lock(&self.producer.backing.state).check_cpu(self.epoch)?;
+        let resolved = lock(&self.producer.registry).resolve(spans)?;
+        if !Arc::ptr_eq(&resolved.owner, &self.producer.backing) {
+            return Err(Error::Invalid("allocation identity mismatch"));
+        }
+        Ok((resolved.offset, resolved.length))
+    }
+
+    /// Register an additional live CPU alias and retain its mapping owner. The registration
+    /// blocks CPU-epoch completion until dropped; resolved spans retain allocation identity.
+    ///
+    /// # Safety
+    /// `span` maps exactly the allocation bytes at `offset` in this process, readable/writable
+    /// for its full length. `owner` keeps that mapping stable until dropped. Every access to it
+    /// ends before the returned registration is dropped. No atomics/execution are implied.
+    pub unsafe fn register_alias(
+        &self,
+        span: HostSpan,
+        offset: u64,
+        owner: Box<dyn Send>,
+    ) -> Result<CpuAlias, Error> {
+        let mut state = lock(&self.producer.backing.state);
+        state.check_cpu(self.epoch)?;
+        let mut registry = lock(&self.producer.registry);
+        let id = registry.register(
+            span,
+            offset,
+            self.producer.info().logical_bytes,
+            Arc::clone(&self.producer.backing),
+        )?;
+        if let Err(e) = state.exported(self.epoch) {
+            registry.unregister(span.address, id)?;
+            return Err(e.into());
+        }
+        Ok(CpuAlias {
+            producer: Arc::clone(&self.producer),
+            epoch: self.epoch,
+            address: span.address,
+            registration: id,
+            owner: Some(owner),
+        })
+    }
+
+    /// A retained opaque-FD export for native code. The receiver maps the full allocation from
+    /// offset zero and uses its qualified view provider; arbitrary-offset mmap is not promised.
+    pub fn export(&self) -> Result<NativeView, Error> {
+        let mut state = lock(&self.producer.backing.state);
+        state.check_cpu(self.epoch)?;
+        let fd = self
+            .producer
+            .backing
+            .fd
+            .as_ref()
+            .ok_or(Error::Invalid("no producer FD"))?
+            .try_clone()?;
+        state.exported(self.epoch)?;
+        Ok(NativeView {
+            producer: Arc::clone(&self.producer),
+            fd,
+            epoch: self.epoch,
+            active: true,
+        })
+    }
+
+    /// End the CPU epoch after all local accesses ended and all exported native views retired.
+    ///
+    /// # Safety
+    /// All CPU accesses are paused for this call. After success no pointer obtained from this
+    /// epoch may be used again, including by another thread/process. After refusal the current
+    /// CPU owner may resume. Every external worker must stop before successful completion;
+    /// retiring a descriptor alone is not proof.
+    pub unsafe fn finish(&mut self) -> Result<(), Error> {
+        lock(&self.producer.backing.state).cpu_done(self.epoch)?;
+        self.active = false;
+        Ok(())
+    }
+}
+
+impl Drop for CpuAccess {
+    fn drop(&mut self) {
+        if self.active {
+            lock(&self.producer.backing.state).poison();
+        }
+    }
+}
+
+/// A registered CPU mapping held through an exclusive epoch. Its release removes only its
+/// own registration generation, drops the mapping owner, then permits the epoch to end.
+pub struct CpuAlias {
+    producer: Arc<Producer>,
+    epoch: u64,
+    address: u64,
+    registration: u64,
+    owner: Option<Box<dyn Send>>,
+}
+
+impl Drop for CpuAlias {
+    fn drop(&mut self) {
+        let removed = lock(&self.producer.registry).unregister(self.address, self.registration);
+        // The mapping's destructor is caller code and runs with no registry/ownership lock.
+        drop(self.owner.take());
+        let mut state = lock(&self.producer.backing.state);
+        if removed.is_err() || state.retired(self.epoch).is_err() {
+            state.poison();
+        }
+    }
+}
