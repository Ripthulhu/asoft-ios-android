--- a/hw/arm/virt.c
+++ b/hw/arm/virt.c
@@ -274,6 +274,44 @@ static const int a15irqmap[] = {
     [VIRT_PLATFORM_BUS] = 112, /* ...to 112 + PLATFORM_BUS_NUM_IRQS -1 */
 };
 
+/*
+ * A bounded synthetic integration machine for the native-EL0/PowerVR work.
+ * This instantiates the very same reims device as vresearch, over virt's
+ * ordinary memfd RAM. It needs no guest firmware or platform-specific image.
+ * The authored test guest knows these two MMIO addresses; no general-purpose
+ * guest is told that virt has this private test device.
+ */
+static void create_reims_memory_test(VirtMachineState *vms)
+{
+    const char *test = getenv("ASOFT_VIRT_REIMS_TEST");
+    DeviceState *dev;
+    SysBusDevice *sbd;
+
+    if (!test || !strcmp(test, "0")) {
+        return;
+    }
+    if (strcmp(test, "1")) {
+        error_report("ASOFT_VIRT_REIMS_TEST must be 0 or 1");
+        exit(1);
+    }
+    if (!tcg_enabled() ||
+        !object_class_by_name("vresearch-pvg-reims")) {
+        error_report("ASOFT_VIRT_REIMS_TEST needs TCG and the real reims device");
+        exit(1);
+    }
+    dev = qdev_new("vresearch-pvg-reims");
+    qdev_prop_set_uint32(dev, "width", 64);
+    qdev_prop_set_uint32(dev, "height", 64);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    /* Free space between virtio-mmio and the platform bus; free SPI 12/13. */
+    sysbus_mmio_map(sbd, 0, 0x0b000000);
+    sysbus_mmio_map(sbd, 1, 0x0b010000);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(vms->gic, 12));
+    sysbus_connect_irq(sbd, 1, qdev_get_gpio_in(vms->gic, 13));
+    info_report("native-efi-test: real reims at 0x0b000000/0x0b010000, display 64x64");
+}
+
 static void create_randomness(MachineState *ms, const char *node)
 {
     struct {
@@ -3157,6 +3195,7 @@ static void machvirt_init(MachineState *machine)
 
     create_gic(vms, sysmem);
     create_msi_controller(vms);
+    create_reims_memory_test(vms);
 
     virt_post_cpus_gic_realized(vms, sysmem);
 
