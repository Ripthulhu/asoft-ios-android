+            args[index] = value
+            run(name, ["fill", *args], 2)
+        run("worker-data-unchanged", ["fill", 1, 3, 0, 0, 0x100004000, 0x4000, 0], 0)
+        run("legacy-worker-unchanged", ["fill", 0, 7, 1, 0, 3, 3, 3], 0)
+        for mode in (0, 1):
