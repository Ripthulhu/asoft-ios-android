+        if source[end] == "{":
+            depth += 1
+        elif source[end] == "}":
+            depth -= 1
+        end += 1
+    return source[start:end]
+
+
+def simulated_startup_cases(root):
+    source = SOURCE.read_text()
+    functions = [production_function(source, name) for name in (
+        "native_el0_required_mode", "native_el0_required_fail",
+        "native_el0_required_check_enabled")]
+    prelude = r'''
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <time.h>
+#include <pthread.h>
+#define G_GNUC_PRINTF(a,b) __attribute__((format(printf,a,b)))
+'''
+    mocks = r'''
+enum { FAC_FAIL, CHILD_DIED, CHILD_TIMEOUT, BAD_PID, SLOT_TIMEOUT, SLOT_DIED,
+       ALL_READY, LATE_READY, CHECK_ENABLED };
+static int scenario;
+typedef struct CPUState CPUState;
+#define CPU_FOREACH(cs) for ((cs) = NULL; (cs) != NULL; (cs) = NULL)
+#define STUB_VCPUS 8
+#define FAC_SPAWN 1
+#define FUTEX_WAIT 0
+#define qatomic_read(p) (*(p))
+#define qatomic_set(p,v) (*(p) = (v))
+typedef struct { int32_t pid; uint32_t state; } TestCtl;
+typedef struct { uint32_t ready; } TestSlot;
+static struct { uint32_t nvcpus; TestCtl ctl[1]; TestSlot slot[1][STUB_VCPUS]; } state;
+static __typeof__(state) *shm = &state;
+static uint64_t stub_spawns;
+static int64_t fake_time;
+static int64_t mono_ns(void) { return fake_time += 1000000000LL; }
+static bool fac_call(uint32_t command, uint32_t argument)
+{
+    shm->ctl[0].pid = scenario == BAD_PID ? -1 : 123;
+    shm->ctl[0].state = scenario == CHILD_DIED ? 2 :
+                        scenario == CHILD_TIMEOUT ? 0 : 1;
+    for (int v = 0; v < 2; v++) {
+        shm->slot[0][v].ready = scenario == ALL_READY;
+    }
+    return scenario != FAC_FAIL;
+}
+static int futex(void *address, int op, int value, const struct timespec *ts)
+{
+    if (scenario == SLOT_DIED) {
+        shm->ctl[0].state = 2;
+    } else if (scenario == LATE_READY) {
+        shm->slot[0][0].ready = shm->slot[0][1].ready = 1;
+    }
+    return 0;
+}
+'''
+    driver = r'''
+static pthread_mutex_t pool = PTHREAD_MUTEX_INITIALIZER;
+static void cleanup(void)
+{
+    /* exit() inside stub_spawn would deadlock here; _Exit() must bypass us. */
+    pthread_mutex_lock(&pool);
+    puts("CLEANUP_REACHED");
+    pthread_mutex_unlock(&pool);
+}
+int main(int argc, char **argv)
+{
+    if (argc != 2) { return 3; }
+    scenario = atoi(argv[1]);
+    if (scenario == CHECK_ENABLED) {
+        native_el0_required_check_enabled(getenv("ASOFT_NATIVE_EL0"));
+        puts("CHECK_RETURNED");
+        return 0;
+    }
+    shm->nvcpus = 2;
+    atexit(cleanup);
+    pthread_mutex_lock(&pool);
+    bool result = stub_spawn(0);
+    pthread_mutex_unlock(&pool);
+    printf("SPAWN_RESULT=%d\n", result);
+    return result ? 0 : 2;
+}
+'''
+    fixture = root / "startup-fixture.c"
+    fixture.write_text(prelude + "\n".join(functions) + mocks +
+                       production_function(source, "stub_spawn") + driver)
+    exe = root / "startup-fixture"
+    subprocess.run([os.environ.get("CC", "cc"), "-std=gnu11", "-Wall", "-Werror",
+                    "-pthread", str(fixture), "-o", str(exe)], check=True)
+    results = []
+    for required in (None, "0", "1"):
+        for enabled in (None, "", "0", "1"):
+            env = {key: value for key, value in os.environ.items()
+                   if not key.startswith("ASOFT_")}
+            if required is not None:
+                env["ASOFT_NATIVE_EL0_REQUIRED"] = required
+            if enabled is not None:
+                env["ASOFT_NATIVE_EL0"] = enabled
+            run = subprocess.run([str(exe), "8"], env=env, capture_output=True,
+                                 text=True, timeout=2)
+            failure = required == "1" and enabled != "1"
+            assert run.returncode == (1 if failure else 0), run
+            assert ("ASOFT_NATIVE_EL0 is disabled" in run.stderr) == failure, run
+            assert ("CHECK_RETURNED" in run.stdout) != failure, run
+            results.append({"kind": "enabled-option", "required": required,
+                            "enabled": enabled, "exit_code": run.returncode, "pass": True})
+    names = ("factory failure", "child exited", "child timeout", "invalid pid",
+             "thread timeout", "thread exited", "all threads ready", "delayed readiness")
+    for required in (None, "1"):
+        for scenario, name in enumerate(names):
+            env = {key: value for key, value in os.environ.items()
+                   if not key.startswith("ASOFT_")}
+            if required is not None:
+                env["ASOFT_NATIVE_EL0_REQUIRED"] = required
+            run = subprocess.run([str(exe), str(scenario)], env=env,
+                                 capture_output=True, text=True, timeout=2)
+            fatal = required == "1" and scenario < 6
+            expected = 1 if fatal else 2 if scenario < 4 else 0
+            assert run.returncode == expected, (name, run)
+            assert ("CLEANUP_REACHED" in run.stdout) != fatal, (name, run)
+            assert ("required initialization failed" in run.stderr) == fatal, (name, run)
+            results.append({"kind": "simulated-stub-startup", "scenario": name,
+                            "required": required, "exit_code": run.returncode,
+                            "atexit_bypassed_on_fatal": fatal, "pass": True})
+    for invalid in ("2", "true", "01"):
+        env = {key: value for key, value in os.environ.items()
+               if not key.startswith("ASOFT_")}
+        env["ASOFT_NATIVE_EL0_REQUIRED"] = invalid
+        # A failing factory asks the production parser while pool is locked.
+        run = subprocess.run([str(exe), "0"], env=env, capture_output=True,
+                             text=True, timeout=2)
+        assert run.returncode == 1, run
+        assert "must be 0 or 1" in run.stderr, run
+        assert "CLEANUP_REACHED" not in run.stdout, run
+        results.append({"kind": "invalid-required-option", "required": invalid,
+                        "exit_code": run.returncode, "atexit_bypassed_on_fatal": True,
+                        "pass": True})
+    return results
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="native-required-test-") as temp:
+        root = Path(temp)
+        headers = {
+            "qemu/osdep.h": """#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#define G_GNUC_PRINTF(a,b) __attribute__((format(printf,a,b)))
+""",
+            "hw/core/cpu.h": "typedef struct CPUState CPUState;\n",
+            "cpu.h": "typedef struct CPUState CPUState;\n",
+            "internals.h": "",
+            "cpu-features.h": "",
+            "syndrome.h": "",
+        }
+        for name, text in headers.items():
+            path = root / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(text)
+        driver = root / "main.c"
+        driver.write_text('#include <stdio.h>\nint main(void) { puts("MAIN_REACHED"); return 0; }\n')
+        exe = root / "constructor-test"
+        subprocess.run([os.environ.get("CC", "cc"), "-std=gnu11", "-Wall", "-Werror",
+                        "-DCONFIG_USER_ONLY", "-I" + str(root), str(SOURCE),
+                        str(driver), "-o", str(exe)], check=True)
+        results = []
+        for required in (None, "", "0", "1"):
+            for enabled in (None, "0", "1"):
+                env = {key: value for key, value in os.environ.items()
+                       if not key.startswith("ASOFT_")}
+                if required is not None:
+                    env["ASOFT_NATIVE_EL0_REQUIRED"] = required
+                if enabled is not None:
+                    env["ASOFT_NATIVE_EL0"] = enabled
+                run = subprocess.run([str(exe)], env=env, capture_output=True,
+                                     text=True, timeout=5)
+                expected_failure = required == "1"
+                if expected_failure:
+                    assert run.returncode == 1, run
+                    assert "MAIN_REACHED" not in run.stdout, run
+                    assert "this build has no native EL0 engine" in run.stderr, run
+                    assert "refusing to continue" in run.stderr, run
+                else:
+                    assert run.returncode == 0, run
+                    assert run.stdout == "MAIN_REACHED\n", run
+                    assert not run.stderr, run
+                results.append({"required": required, "enabled": enabled,
+                                "exit_code": run.returncode, "pass": True})
+        print(json.dumps({"scope": "production constructor and startup decisions; simulated factory/clock dependencies",
+                          "unsupported_build_cases": results,
+                          "startup_cases": simulated_startup_cases(root)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
