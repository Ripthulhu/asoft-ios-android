+#!/usr/bin/env python3
+"""Exercise the actual phone script's result checker against synthetic logs."""
+from pathlib import Path
+import json
+import re
+import subprocess
+import tempfile
+
+SCRIPT = Path(__file__).resolve().parents[2] / "scripts/native-el0-tpidrro-trap-smoke.sh"
+
+# These guest lines model the existing ELF's kprintf CPU prefix and exact
+# completion/copy spelling. Counts and timings remain synthetic host fixtures.
+GOOD = """native-el0: required initialization ready mode=stubs; guest execution not yet observed
+native-el0: tpidrro-trap ready mode=stubs code=memfd
+[cpu0] T6 OK calls=1000 fpcr=0x0 arith=0x55
+[cpu1] T6 OK calls=1000 fpcr=0x0 arith=0x55
+[cpu0] T7 tpidr=0x1234 tpidrro=0xabcd0000 OK
+[cpu1] T7 tpidr=0x1234 tpidrro=0xabcd0001 OK
+[cpu0] T10 memcpy16 bytes=16777216 reps=20 ns=1000000 ticks=19200 MBps=320000 check=ok
+[cpu1] T10 memcpy16 bytes=16777216 reps=20 ns=1000000 ticks=19200 MBps=320000 check=ok
+[cpu1] EXIT 0 faults=0 irqs=0
+[cpu0] EXIT 0 faults=3 irqs=4
+native-el0: enters 100 svc 40 fills 3 (failed 0) faults-injected 0
+native-el0: stubs 2 spawned 1 bound 1 evictions 0
+native-el0: tpidrro-trap code-copies 1 code-map-requests 2
+native-el0: tpidrro-trap cpu0 reads 2 last-pc 0x100000768
+native-el0: tpidrro-trap cpu1 reads 2 last-pc 0x100000768
+native-el0: time native 8 ms, trap handling 2 ms, entry 0 ms (wall since first vCPU 12 ms)
+"""
+
+
+def main():
+    source = SCRIPT.read_text()
+    functions = []
+    for name in ("fail", "check_benchmark_log"):
+        match = re.search(r"^" + name + r"\(\) \{\n.*?^\}\n", source, re.M | re.S)
+        if not match:
+            raise RuntimeError(f"Missing production shell function: {name}")
+        functions.append(match.group())
+    cases = [
+        ("cpu-prefixed-lowercase-ok", GOOD, True),
+        ("cpu0-completion-only", GOOD.replace("[cpu1] EXIT 0 faults=0 irqs=0\n", ""), False),
+        ("copy-BAD", GOOD.replace("check=ok", "check=BAD"), False),
+        ("uppercase-OK-is-not-guest-output", GOOD.replace("check=ok", "check=OK"), False),
+        ("copy-BAD-alongside-ok", GOOD + "[cpu1] T10 memcpy16 bytes=16 reps=1 check=BAD\n", False),
+        ("zero-native-SVC", GOOD.replace("enters 100 svc 40", "enters 100 svc 0"), False),
+        ("zero-native-time", GOOD.replace("time native 8 ms", "time native 0 ms"), False),
+        ("guest-incomplete", GOOD.replace("[cpu0] EXIT 0 faults=3 irqs=4\n", ""), False),
+        ("unprefixed-completion-is-not-guest-output", GOOD.replace("[cpu0] EXIT", "EXIT"), False),
+        ("cpu0-positive-exit", GOOD.replace("[cpu0] EXIT 0", "[cpu0] EXIT 7"), False),
+        ("cpu0-negative-exit", GOOD.replace("[cpu0] EXIT 0", "[cpu0] EXIT -1"), False),
+        ("secondary-positive-exit-alongside-cpu0-success", GOOD.replace("[cpu1] EXIT 0", "[cpu1] EXIT 7"), False),
+        ("secondary-negative-exit-alongside-cpu0-success", GOOD.replace("[cpu1] EXIT 0", "[cpu1] EXIT -1"), False),
+        ("cpu0-nonzero-alongside-zero-exit", GOOD + "[cpu0] EXIT 1 faults=0 irqs=0\n", False),
+        ("floating-point-mismatch", GOOD + "[cpu1] T6 MISMATCH fpcr got=0x1 want=0x0\n", False),
+        ("missing-trap-mode", GOOD.replace("native-el0: tpidrro-trap ready mode=stubs code=memfd\n", ""), False),
+        ("zero-code-copies", GOOD.replace("code-copies 1", "code-copies 0"), False),
+        ("zero-code-map-requests", GOOD.replace("code-map-requests 2", "code-map-requests 0"), False),
+        ("missing-cpu0-T7", GOOD.replace("[cpu0] T7 tpidr=0x1234 tpidrro=0xabcd0000 OK\n", ""), False),
+        ("missing-cpu1-T7", GOOD.replace("[cpu1] T7 tpidr=0x1234 tpidrro=0xabcd0001 OK\n", ""), False),
+        ("wrong-writable-TPIDR-despite-OK", GOOD.replace("[cpu0] T7 tpidr=0x1234", "[cpu0] T7 tpidr=0x0"), False),
+        ("wrong-TPIDRRO-despite-OK", GOOD.replace("tpidrro=0xabcd0001", "tpidrro=0x0"), False),
+        ("cpu0-T0-only-native", GOOD.replace("cpu0 reads 2 last-pc 0x100000768", "cpu0 reads 1 last-pc 0x100000154"), False),
+        ("cpu1-T0-only-native", GOOD.replace("cpu1 reads 2 last-pc 0x100000768", "cpu1 reads 1 last-pc 0x100000154"), False),
+        ("cpu0-wrong-last-PC", GOOD.replace("cpu0 reads 2 last-pc 0x100000768", "cpu0 reads 2 last-pc 0x100000154"), False),
+        ("cpu1-zero-traps", GOOD.replace("cpu1 reads 2", "cpu1 reads 0"), False),
+        ("runtime-trap-policy-failure", GOOD + "native-el0: TPIDRRO trap mode failed: executable fill bypassed cache\n", False),
+        ("missing-secondary-T6", GOOD.replace("[cpu1] T6 OK calls=1000 fpcr=0x0 arith=0x55\n", ""), False),
+        ("missing-secondary-T10", GOOD.replace("[cpu1] T10 memcpy16 bytes=16777216 reps=20 ns=1000000 ticks=19200 MBps=320000 check=ok\n", ""), False),
+        ("secondary-fatal-after-T7", GOOD.replace("[cpu1] EXIT 0 faults=0 irqs=0\n", "").replace("[cpu1] T10 memcpy16 bytes=16777216 reps=20 ns=1000000 ticks=19200 MBps=320000 check=ok\n", "") + "[cpu1] FATAL\n", False),
+    ]
+    results = []
+    with tempfile.TemporaryDirectory(prefix="native-memfd-log-") as temp:
+        root = Path(temp)
+        harness = root / "checker.sh"
+        harness.write_text("set -eu\n" + "\n".join(functions) +
+                           'bench_results=$2\ncheck_benchmark_log "$1"\n'
+                           "printf 'NATIVE_TPIDRRO_TRAP_BENCH_PASS=1\\n'\n")
+        for name, log, expected in cases:
+            path = root / (name + ".txt")
+            path.write_text(log)
+            run = subprocess.run(["sh", str(harness), str(path), str(root)],
+                                 capture_output=True, text=True, timeout=2)
+            assert run.returncode == (0 if expected else 1), (name, run)
+            assert ("NATIVE_TPIDRRO_TRAP_BENCH_PASS=1" in run.stdout) == expected, (name, run)
+            assert ("NATIVE_TPIDRRO_TRAP_BENCH_PASS=0" in run.stdout) != expected, (name, run)
+            results.append({"name": name, "expected_pass": expected,
+                            "exit_code": run.returncode, "pass": True})
+    print(json.dumps({"scope": "actual TPIDRRO phone-script checker with synthetic guest logs", "cases": results}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
