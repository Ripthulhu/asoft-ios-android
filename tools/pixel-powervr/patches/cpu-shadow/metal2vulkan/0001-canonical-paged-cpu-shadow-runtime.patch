+    #[derive(Default)]
+    struct State {
+        chunks: BTreeMap<Key, Weak<Chunk>>,
+        views: Vec<Weak<View>>,
+        active: bool,
+    }
+
+    #[derive(Default)]
+    pub(crate) struct Store {
+        state: Mutex<State>,
+        enabled: AtomicBool,
+        failed: AtomicBool,
+        pub(super) counts: Counts,
+    }
+
+    fn io_error(error: io::Error) -> Error {
+        refusal(CpuShadowProblem::Io(error.to_string()))
+    }
+
+    /// Canonical identity includes the retained file itself, so an inode cannot be recycled while
+    /// its shadow is live. Only regular writable files are accepted; no device export is imported.
+    fn identity(file: &File, offset: u64, length: u64) -> Result<(Key, u64), Error> {
+        let mut stat = std::mem::MaybeUninit::<libc::stat>::uninit();
+        // SAFETY: the fd is owned and live, and fstat initializes stat on success.
+        if unsafe { libc::fstat(file.as_raw_fd(), stat.as_mut_ptr()) } != 0 {
+            return Err(io_error(io::Error::last_os_error()));
+        }
+        // SAFETY: fstat succeeded.
+        let stat = unsafe { stat.assume_init() };
+        // SAFETY: F_GETFL reads the flags of a live descriptor.
+        let flags = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFL) };
+        let size = u64::try_from(stat.st_size).map_err(|_| refusal(CpuShadowProblem::Backing))?;
+        if flags < 0
+            || flags & libc::O_ACCMODE != libc::O_RDWR
+            || stat.st_mode & libc::S_IFMT != libc::S_IFREG
+            || length == 0
+            || offset.checked_add(length).is_none_or(|end| end > size)
+        {
+            return Err(refusal(CpuShadowProblem::Backing));
+        }
+        Ok((
+            Key {
+                device: stat.st_dev as u64,
+                inode: stat.st_ino as u64,
+                offset: 0,
+            },
+            size,
+        ))
+    }
+
+    impl Device {
+        pub(crate) fn buffer_over_cpu_shadow(
+            &self,
+            pointer: NonNull<u8>,
+            source: CpuShadowSource,
+            length: u64,
+            modes: Modes,
+            release: HostRelease,
+            placement: Place,
+            of_heap: bool,
+        ) -> Result<Buffer, Error> {
+            let alignment = crate::host_memory::host_page().unwrap_or(PAGE);
+            if of_heap && !(pointer.as_ptr() as u64).is_multiple_of(alignment) {
+                return Err(invalid(
+                    "cpu_shadow",
+                    Problem::Heap(crate::heap::HeapProblem::HostMemoryAlignment { alignment }),
+                ));
+            }
+            let view = self.new_cpu_shadow_view(pointer, source, length)?;
+            let buffer =
+                self.buffer_in_cpu_shadow(length, modes, placement, of_heap, Arc::clone(&view))?;
+            view.join_aliases(self, buffer.identity().key);
+            view.accept(self, release, length);
+            Ok(buffer)
+        }
+
+        pub(crate) fn new_cpu_shadow_view(
+            &self,
+            pointer: NonNull<u8>,
+            source: CpuShadowSource,
+            length: u64,
+        ) -> Result<Arc<View>, Error> {
+            if !self.shared().cpu_shadow_mode {
+                return Err(refusal(CpuShadowProblem::ModeDisabled));
+            }
+            let pieces = source(CpuShadowRequest {
+                start: pointer,
+                length,
+                granule: PAGE,
+            })
+            .map_err(io_error)?;
+            let mut resolved = Vec::with_capacity(pieces.len());
+            let mut total = 0u64;
+            for piece in pieces {
+                let file = File::from(piece.fd);
+                let (key, size) = identity(&file, piece.offset, piece.length)?;
+                total = total
+                    .checked_add(piece.length)
+                    .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+                resolved.push((file, key, size, piece.offset, piece.length));
+            }
+            if total != length || length == 0 {
+                return Err(refusal(CpuShadowProblem::Range));
+            }
+            let store = &self.shared().cpu_shadows;
+            {
+                let mut state = lock(&store.state);
+                if store.failed.load(Ordering::Acquire) {
+                    return Err(refusal(CpuShadowProblem::FailedEpoch));
+                }
+                state.chunks.retain(|_, chunk| chunk.strong_count() != 0);
+                state.views.retain(|view| view.strong_count() != 0);
+            }
+            let mut parts = Vec::new();
+            for (file, key, size, mut offset, mut length) in resolved {
+                while length != 0 {
+                    let base = offset / CHUNK * CHUNK;
+                    let key = Key {
+                        offset: base,
+                        ..key
+                    };
+                    let part_offset = offset - base;
+                    let part_length = length.min(CHUNK - part_offset);
+                    let existing = {
+                        let state = lock(&store.state);
+                        state.chunks.get(&key).and_then(Weak::upgrade)
+                    };
+                    let chunk = match existing {
+                        Some(chunk) => chunk,
+                        None => {
+                            let bytes = (size - base).min(CHUNK);
+                            // Vulkan allocation may reclaim or wait on runtime work. Never
+                            // hold the registry while it does so; competing creators converge
+                            // on the first canonical chunk after the allocation.
+                            let gpu = self.write_combined_buffer(bytes)?;
+                            if gpu.contents().is_none() || gpu.device_address().is_none() {
+                                return Err(refusal(CpuShadowProblem::Backing));
+                            }
+                            let made = Arc::new(Chunk {
+                                key,
+                                file: file.try_clone().map_err(io_error)?,
+                                gpu,
+                                length: bytes,
+                            });
+                            let chosen = {
+                                let mut state = lock(&store.state);
+                                if store.failed.load(Ordering::Acquire) {
+                                    Err(refusal(CpuShadowProblem::FailedEpoch))
+                                } else {
+                                    Ok(match state.chunks.get(&key).and_then(Weak::upgrade) {
+                                        Some(chunk) => chunk,
+                                        None => {
+                                            state.chunks.insert(key, Arc::downgrade(&made));
+                                            store
+                                                .counts
+                                                .chunks_created
+                                                .fetch_add(1, Ordering::Relaxed);
+                                            Arc::clone(&made)
+                                        }
+                                    })
+                                }
+                            };
+                            // Both a losing allocation and a failure release their GPU/file
+                            // owners outside the registry lock; a release may reenter runtime.
+                            chosen?
+                        }
+                    };
+                    if part_offset + part_length > chunk.length {
+                        return Err(refusal(CpuShadowProblem::Backing));
+                    }
+                    if let Some(Part { chunk: last, range }) = parts.last_mut() {
+                        if Arc::ptr_eq(last, &chunk) && range.end == part_offset {
+                            range.end += part_length;
+                        } else {
+                            parts.push(Part {
+                                chunk,
+                                range: part_offset..part_offset + part_length,
+                            });
+                        }
+                    } else {
+                        parts.push(Part {
+                            chunk,
+                            range: part_offset..part_offset + part_length,
+                        });
+                    }
+                    offset += part_length;
+                    length -= part_length;
+                }
+            }
+            // Every shader root uses canonical addresses, including contiguous views. A
+            // direct view's separate VkBuffer is only for stable fixed-function offsets.
+            let mut pages = PageMap::new(self, pointer, length, &parts)?;
+            let direct = if parts.len() == 1 {
+                Direct::new(self, &parts[0], pages.prefix, length)?
+            } else {
+                None
+            };
+            if direct.is_none() && pages.scratch.is_none() {
+                pages.scratch = Some(self.write_combined_buffer(pages.prefix + length)?);
+            }
+            let view = Arc::new(View {
+                pointer: pointer.as_ptr() as usize,
+                direct,
+                pages,
+                parts,
+                adapter: OnceLock::new(),
+                release: Mutex::new(None),
+            });
+            if let Some(scratch) = &view.pages.scratch {
+                let adapter = crate::cpu_shadow_adapter::prepare(
+                    self,
+                    scratch,
+                    view.segments().expect("shadow segments"),
+                )?;
+                view.adapter
+                    .set(adapter)
+                    .map_err(|_| refusal(CpuShadowProblem::Backing))?;
+            }
+            let registered = {
+                let mut state = lock(&store.state);
+                if store.failed.load(Ordering::Acquire) {
+                    Err(refusal(CpuShadowProblem::FailedEpoch))
+                } else {
+                    state.views.push(Arc::downgrade(&view));
+                    store.enabled.store(true, Ordering::Release);
+                    Ok(())
+                }
+            };
+            registered?;
+            Ok(view)
+        }
+    }
+
+    pub(crate) fn uses_cpu_shadow(device: &Device) -> bool {
+        device.shared().cpu_shadows.enabled.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn cpu_shadow_failed(device: &Device) -> bool {
+        device.shared().cpu_shadows.failed.load(Ordering::Acquire)
+    }
+
+    struct Snapshot {
+        chunk: Arc<Chunk>,
+        range: Range<u64>,
+        before: Vec<u8>,
+    }
+
+    /// One actual batch's snapshot. The scheduler guarantees no earlier or concurrent GPU work
+    /// reaches the shadows while prepare runs, nor later work before finish returns.
+    pub(crate) struct ShadowEpoch {
+        device: Device,
+        snapshots: Vec<Snapshot>,
+    }
+
+    impl ShadowEpoch {
+        pub(crate) fn prepare(device: &Device) -> Result<ShadowEpoch, Error> {
+            let store = &device.shared().cpu_shadows;
+            let mut state = lock(&store.state);
+            if store.failed.load(Ordering::Acquire) {
+                return Err(refusal(CpuShadowProblem::FailedEpoch));
+            }
+            if state.active {
+                return Err(refusal(CpuShadowProblem::ActiveEpoch));
+            }
+            let views: Vec<_> = state.views.iter().filter_map(Weak::upgrade).collect();
+            state.active = true;
+            drop(state);
+            // An upgraded view may be its last owner. Its release callback and the final
+            // chunk/GPU allocation drop must never run under the registry lock.
+            let mut ranges: BTreeMap<Key, (Arc<Chunk>, Vec<Range<u64>>)> = BTreeMap::new();
+            for view in views {
+                for part in &view.parts {
+                    ranges
+                        .entry(part.chunk.key)
+                        .or_insert_with(|| (Arc::clone(&part.chunk), Vec::new()))
+                        .1
+                        .push(part.range.clone());
+                }
+            }
+            let mut epoch = ShadowEpoch {
+                device: device.clone(),
+                snapshots: Vec::new(),
+            };
+            for (_, (chunk, ranges)) in ranges {
+                for range in merged(ranges) {
+                    let size = usize::try_from(range.end - range.start)
+                        .map_err(|_| refusal(CpuShadowProblem::Range))?;
+                    let mut before = vec![0u8; size];
+                    chunk
+                        .file
+                        .read_exact_at(&mut before, chunk.key.offset + range.start)
+                        .map_err(io_error)?;
+                    let mapped = chunk
+                        .gpu
+                        .contents()
+                        .ok_or_else(|| refusal(CpuShadowProblem::Backing))?;
+                    // SAFETY: the canonical buffer maps this checked range; the scheduler owns
+                    // this epoch, so no GPU command or other epoch accesses it during upload.
+                    unsafe {
+                        std::ptr::copy_nonoverlapping(
+                            before.as_ptr(),
+                            mapped.as_ptr().add(range.start as usize),
+                            size,
+                        )
+                    };
+                    store
+                        .counts
+                        .bytes_uploaded
+                        .fetch_add(size as u64, Ordering::Relaxed);
+                    epoch.snapshots.push(Snapshot {
+                        chunk: Arc::clone(&chunk),
+                        range,
+                        before,
+                    });
+                }
+            }
+            store.counts.epochs_prepared.fetch_add(1, Ordering::Relaxed);
+            Ok(epoch)
+        }
+
+        pub(crate) fn finish(self) -> Result<(), Error> {
+            let result = self.scatter();
+            if result.is_err() {
+                self.device
+                    .shared()
+                    .cpu_shadows
+                    .failed
+                    .store(true, Ordering::Release);
+            }
+            result
+        }
+
+        fn scatter(&self) -> Result<(), Error> {
+            let store = &self.device.shared().cpu_shadows;
+            for snapshot in &self.snapshots {
+                let mapped = snapshot
+                    .chunk
+                    .gpu
+                    .contents()
+                    .ok_or_else(|| refusal(CpuShadowProblem::Backing))?;
+                // SAFETY: completion observed the GPU signal and host visibility; no later batch
+                // runs until scatter finishes. The coherent mapping covers the checked range.
+                let after = unsafe {
+                    std::slice::from_raw_parts(
+                        mapped.as_ptr().add(snapshot.range.start as usize),
+                        snapshot.before.len(),
+                    )
+                };
+                for changed in changes(&snapshot.before, after) {
+                    let offset =
+                        snapshot.chunk.key.offset + snapshot.range.start + changed.start as u64;
+                    snapshot
+                        .chunk
+                        .file
+                        .write_all_at(&after[changed.clone()], offset)
+                        .map_err(io_error)?;
+                    store
+                        .counts
+                        .bytes_scattered
+                        .fetch_add(changed.len() as u64, Ordering::Relaxed);
+                }
+            }
+            store.counts.epochs_finished.fetch_add(1, Ordering::Relaxed);
+            Ok(())
+        }
+
+        /// Submitted work failed after the device was drained. Its writes are unknown; do not
+        /// expose them as a successful scatter or permit another shadow batch to continue.
+        pub(crate) fn abandon(self) {
+            self.device
+                .shared()
+                .cpu_shadows
+                .failed
+                .store(true, Ordering::Release);
+        }
+    }
+
+    impl Drop for ShadowEpoch {
+        fn drop(&mut self) {
+            let store = &self.device.shared().cpu_shadows;
+            lock(&store.state).active = false;
+        }
+    }
+}
+
+#[cfg(not(unix))]
+#[derive(Default)]
+pub(super) struct Store {
+    counts: Counts,
+}
+#[cfg(not(unix))]
+pub(super) fn uses_cpu_shadow(_device: &Device) -> bool {
+    false
+}
+#[cfg(not(unix))]
+pub(super) fn cpu_shadow_failed(_device: &Device) -> bool {
+    false
+}
+#[cfg(not(unix))]
+pub(super) struct ShadowEpoch;
+#[cfg(not(unix))]
+impl ShadowEpoch {
+    pub(super) fn prepare(_device: &Device) -> Result<Self, Error> {
+        Ok(Self)
+    }
+    pub(super) fn finish(self) -> Result<(), Error> {
+        Ok(())
+    }
+    pub(super) fn abandon(self) {}
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{changes, merged};
+
+    #[test]
+    fn byte_delta_preserves_disjoint_cpu_writes() {
+        let before = [0, 0, 7, 8, 0, 0];
+        let after = [0, 2, 7, 3, 4, 0];
+        let mut cpu = [9, 0, 11, 8, 0, 6];
+        for range in changes(&before, &after) {
+            cpu[range.clone()].copy_from_slice(&after[range]);
+        }
+        assert_eq!(cpu, [9, 2, 11, 3, 4, 6]);
+    }
+
+    #[test]
+    fn overlapping_alias_ranges_are_uploaded_once() {
+        assert_eq!(
+            merged(vec![8..20, 0..8, 24..32, 4..16]),
+            vec![0..20, 24..32]
+        );
+    }
+}
diff --git a/crates/metal2vulkan-runtime/src/cpu_shadow_adapter.rs b/crates/metal2vulkan-runtime/src/cpu_shadow_adapter.rs
new file mode 100644
index 0000000000000000000000000000000000000000..279539ddf6cc9d2663195e431640b87efffc44c4
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/cpu_shadow_adapter.rs
@@ -0,0 +1,414 @@
+//! Contiguous GPU scratch for commands that cannot read a paged buffer directly. Canonical file
+//! pages remain the authority: gather immediately before the command, then merge only the bytes
+//! the command changed back into those pages. Shader buffer accesses address the canonical pages
+//! directly, so their disjoint writes survive the merge, including two views of the same page.
+
+use crate::buffer::Buffer;
+use crate::cpu_shadow::CpuShadowSegment;
+use crate::device::functions::Vk;
+use crate::error::{invalid, Error, Problem};
+use crate::owned_kernel::{OwnedBinds, OwnedKernel, OwnedModule, OwnedSet};
+use crate::resource::ResourceKey;
+use crate::tracker::{Barrier, Use};
+use crate::values::{CpuCacheMode, HazardTrackingMode, ResourceOptions, StorageMode};
+use crate::Device;
+use ash::vk;
+use metal2vulkan::bind::ShadowMergeModule;
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+const ALIGNMENT: u64 = 256;
+const GROUP_BYTES: u64 = 4 * ShadowMergeModule::LOCAL_SIZE as u64;
+
+/// An expanded segment: whole descriptor-aligned words in scratch and canonical storage.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Span {
+    logical: u64,
+    physical: u64,
+    length: u64,
+}
+
+fn span(logical: u64, physical: u64, length: u64) -> Option<Span> {
+    if length == 0 || logical % ALIGNMENT != physical % ALIGNMENT {
+        return None;
+    }
+    let prefix = logical % ALIGNMENT;
+    let length = length.checked_add(prefix)?.checked_add(3)? / 4 * 4;
+    Some(Span {
+        logical: logical - prefix,
+        physical: physical - prefix,
+        length,
+    })
+}
+
+fn refused() -> Error {
+    invalid(
+        "cpu_shadow_adapter",
+        Problem::CpuShadow(crate::CpuShadowProblem::Range),
+    )
+}
+
+/// Prebuilt once with the fragmented view, before it is published. No allocation, compilation,
+/// source callback or driver wait is needed when an encoder records its copies.
+pub(crate) struct Adapter {
+    // Plain internal buffers, never the logical buffer containing this adapter: no owner cycle.
+    scratch: Buffer,
+    kept: Buffer,
+    sources: Vec<Buffer>,
+    gathers: Vec<(vk::Buffer, vk::BufferCopy)>,
+    kernel: OwnedKernel,
+    binds: OwnedBinds,
+    dispatches: Vec<(u32, [u8; 16])>,
+}
+
+pub(crate) fn prepare(
+    device: &Device,
+    scratch: &Buffer,
+    segments: Vec<CpuShadowSegment>,
+) -> Result<Arc<Adapter>, Error> {
+    let limits = &device.properties().description.limits;
+    let room = u64::from(limits.max_storage_buffer_range) / ALIGNMENT * ALIGNMENT;
+    let groups = u64::from(limits.max_compute_work_group_count[0]);
+    let window = room.min(groups * GROUP_BYTES) / ALIGNMENT * ALIGNMENT;
+    if window == 0 || segments.is_empty() {
+        return Err(refused());
+    }
+    let kept = device.own_buffer(
+        scratch.length(),
+        ResourceOptions::new(
+            StorageMode::Private,
+            CpuCacheMode::DefaultCache,
+            HazardTrackingMode::Untracked,
+        ),
+    )?;
+    let (scratch_raw, scratch_at) = scratch.at(0);
+    let (kept_raw, kept_at) = kept.at(0);
+    let mut sources = Vec::with_capacity(segments.len());
+    let mut gathers = Vec::with_capacity(segments.len());
+    let mut sets = Vec::new();
+    let mut dispatches = Vec::new();
+    for segment in segments {
+        let span =
+            span(segment.logical_offset, segment.offset, segment.length).ok_or_else(refused)?;
+        if span
+            .logical
+            .checked_add(span.length)
+            .is_none_or(|end| end > scratch.padded_length())
+            || span
+                .physical
+                .checked_add(span.length)
+                .is_none_or(|end| end > segment.buffer.padded_length())
+        {
+            return Err(refused());
+        }
+        let (canonical, at) = segment.buffer.at(span.physical);
+        gathers.push((
+            canonical,
+            vk::BufferCopy {
+                src_offset: at,
+                dst_offset: scratch_at + span.logical,
+                size: span.length,
+            },
+        ));
+        let mut offset = 0;
+        while offset < span.length {
+            let bytes = window.min(span.length - offset);
+            let words = u32::try_from(bytes / 4).map_err(|_| refused())?;
+            sets.push(OwnedSet {
+                images: Vec::new(),
+                storage_images: Vec::new(),
+                buffers: vec![
+                    (kept_raw, kept_at + span.logical + offset, bytes),
+                    (scratch_raw, scratch_at + span.logical + offset, bytes),
+                    (canonical, at + offset, bytes),
+                ],
+            });
+            dispatches.push((
+                words.div_ceil(ShadowMergeModule::LOCAL_SIZE),
+                ShadowMergeModule::shape(words, words, 0, 0),
+            ));
+            offset += bytes;
+        }
+        sources.push(segment.buffer);
+    }
+    let kernel = device.owned_kernel(OwnedModule::ShadowMerge)?;
+    let binds = OwnedBinds::new(device, &kernel, &sets)?;
+    Ok(Arc::new(Adapter {
+        scratch: scratch.clone(),
+        kept,
+        sources,
+        gathers,
+        kernel,
+        binds,
+        dispatches,
+    }))
+}
+
+impl Adapter {
+    /// Gather current canonical bytes for a fixed-function reader. The caller provides barriers
+    /// before and after the gather and retains this adapter until the command completes.
+    pub(crate) unsafe fn gather(&self, raw: &Vk, command_buffer: vk::CommandBuffer) {
+        let (scratch, _) = self.scratch.at(0);
+        debug_assert_eq!(self.sources.len(), self.gathers.len());
+        for (source, region) in &self.gathers {
+            // SAFETY: prepare checked every region; the source and scratch allocations are
+            // retained here, and only the serialized command owning this adapter reaches it.
+            unsafe { raw.cmd_copy_buffer(command_buffer, *source, scratch, &[*region]) };
+        }
+    }
+
+    /// Gather and save its baseline before a command that may write the contiguous scratch.
+    pub(crate) unsafe fn before(&self, raw: &Vk, command_buffer: vk::CommandBuffer) {
+        let (scratch, scratch_at) = self.scratch.at(0);
+        let (kept, kept_at) = self.kept.at(0);
+        // SAFETY: as gather's caller contract; the barrier orders the baseline copy after it.
+        unsafe {
+            self.gather(raw, command_buffer);
+            Barrier::everything().record(raw, command_buffer);
+            for (_, region) in &self.gathers {
+                raw.cmd_copy_buffer(
+                    command_buffer,
+                    scratch,
+                    kept,
+                    &[vk::BufferCopy {
+                        src_offset: region.dst_offset,
+                        dst_offset: kept_at + region.dst_offset - scratch_at,
+                        size: region.size,
+                    }],
+                );
+            }
+        }
+    }
+
+    /// Merge byte deltas into current canonical bytes after the command. Separate dispatches
+    /// can name the same physical word through different logical pages, so each sees the prior
+    /// dispatch's writes before merging another byte of that word.
+    pub(crate) unsafe fn after(&self, raw: &Vk, command_buffer: vk::CommandBuffer) {
+        // SAFETY: the caller orders the command before these dispatches; the adapter retains
+        // their buffers and descriptor sets, and prepare bounded every window and group count.
+        unsafe {
+            raw.cmd_bind_pipeline(
+                command_buffer,
+                vk::PipelineBindPoint::COMPUTE,
+                self.kernel.pipeline,
+            );
+            for (index, (groups, shape)) in self.dispatches.iter().enumerate() {
+                self.binds.bind(raw, command_buffer, &self.kernel, index);
+                raw.cmd_push_constants(
+                    command_buffer,
+                    self.kernel.layout,
+                    vk::ShaderStageFlags::COMPUTE,
+                    0,
+                    shape,
+                );
+                raw.cmd_dispatch(command_buffer, *groups, 1, 1);
+                Barrier::everything().record(raw, command_buffer);
+            }
+        }
+    }
+}
+
+/// The paged backing named by these resource uses, including heaps and buffer-backed textures.
+/// Normal canonical views have no adapter, and a heap's placed resources share one whole adapter.
+pub(crate) fn for_uses(device: &Device, uses: &[Use<ResourceKey>]) -> Vec<Arc<Adapter>> {
+    if !crate::cpu_shadow::uses_cpu_shadow(device) {
+        return Vec::new();
+    }
+    let keys: BTreeSet<_> = uses.iter().map(|used| used.key).collect();
+    for_keys(device, &keys)
+}
+
+pub(crate) fn for_keys(device: &Device, keys: &BTreeSet<ResourceKey>) -> Vec<Arc<Adapter>> {
+    if !crate::cpu_shadow::uses_cpu_shadow(device) {
+        return Vec::new();
+    }
+    let resources = crate::used_resources::of_keys(device.shared(), keys);
+    let mut adapters: Vec<_> = resources
+        .buffers
+        .iter()
+        .chain(resources.heaps.iter().filter_map(|heap| heap.bytes()))
+        .filter_map(Buffer::cpu_shadow_adapter)
+        .collect();
+    adapters.sort_unstable_by_key(|adapter| Arc::as_ptr(adapter) as usize);
+    adapters.dedup_by(|a, b| Arc::ptr_eq(a, b));
+    adapters
+}
+
+/// A buffer copy that names canonical pages directly and needs neither gather nor delta merge.
+/// The caller retains both logical buffers and records these regions with their resource uses.
+pub(crate) struct DirectCopy {
+    pub(crate) source: vk::Buffer,
+    pub(crate) destination: vk::Buffer,
+    pub(crate) region: vk::BufferCopy,
+}
+
+fn ranges(buffer: &Buffer, offset: u64, length: u64) -> Option<Vec<(vk::Buffer, u64, u64)>> {
+    if offset.checked_add(length)? > buffer.length() || length == 0 {
+        return None;
+    }
+    let Some(segments) = buffer.cpu_shadow_segments() else {
+        let (raw, offset) = buffer.at(offset);
+        return Some(vec![(raw, offset, length)]);
+    };
+    let start = buffer.start().checked_add(offset)?;
+    let end = start.checked_add(length)?;
+    let mut out = Vec::new();
+    let mut reached = start;
+    for segment in segments {
+        let from = start.max(segment.logical_offset);
+        let to = end.min(segment.logical_offset.checked_add(segment.length)?);
+        if from >= to {
+            continue;
+        }
+        if from != reached {
+            return None;
+        }
+        let (raw, at) = segment
+            .buffer
+            .at(segment.offset + from - segment.logical_offset);
+        out.push((raw, at, to - from));
+        reached = to;
+    }
+    (reached == end).then_some(out)
+}
+
+/// Whether two logical ranges share physical bytes, including distinct fixed-function
+/// VkBuffer aliases of one canonical allocation. The caller uses a two-stage memmove then.
+pub(crate) fn physically_overlaps(
+    source: &Buffer,
+    source_offset: u64,
+    destination: &Buffer,
+    destination_offset: u64,
+    length: u64,
+) -> bool {
+    if !source.cpu_shadow_is_paged() && !destination.cpu_shadow_is_paged() {
+        return false;
+    }
+    let Some(source) = ranges(source, source_offset, length) else {
+        return false;
+    };
+    let Some(destination) = ranges(destination, destination_offset, length) else {
+        return false;
+    };
+    source.iter().any(|&(a, at, size)| {
+        destination
+            .iter()
+            .any(|&(b, bt, length)| a == b && at < bt + length && bt < at + size)
+    })
+}
+
+/// Segment a pure buffer blit directly into canonical source and destination ranges. A physical
+/// overlap uses the ordinary scratch path, which preserves the existing memmove semantics.
+pub(crate) fn direct_copy(
+    source: &Buffer,
+    source_offset: u64,
+    destination: &Buffer,
+    destination_offset: u64,
+    length: u64,
+) -> Option<Vec<DirectCopy>> {
+    if !source.cpu_shadow_is_paged() && !destination.cpu_shadow_is_paged() {
+        return None;
+    }
+    let source = ranges(source, source_offset, length)?;
+    let destination = ranges(destination, destination_offset, length)?;
+    let destination_aliases = destination.iter().enumerate().any(|(i, &(a, at, length))| {
+        destination[i + 1..]
+            .iter()
+            .any(|&(b, bt, size)| a == b && at < bt + size && bt < at + length)
+    });
+    if destination_aliases
+        || source.iter().any(|&(a, at, length)| {
+            destination
+                .iter()
+                .any(|&(b, bt, size)| a == b && at < bt + size && bt < at + length)
+        })
+    {
+        return None;
+    }
+    let mut out = Vec::new();
+    let (mut s, mut d, mut taken_s, mut taken_d) = (0, 0, 0, 0);
+    while s < source.len() && d < destination.len() {
+        let (src, src_at, src_length) = source[s];
+        let (dst, dst_at, dst_length) = destination[d];
+        let bytes = (src_length - taken_s).min(dst_length - taken_d);
+        out.push(DirectCopy {
+            source: src,
+            destination: dst,
+            region: vk::BufferCopy {
+                src_offset: src_at + taken_s,
+                dst_offset: dst_at + taken_d,
+                size: bytes,
+            },
+        });
+        taken_s += bytes;
+        taken_d += bytes;
+        if taken_s == src_length {
+            s += 1;
+            taken_s = 0;
+        }
+        if taken_d == dst_length {
+            d += 1;
+            taken_d = 0;
+        }
+    }
+    Some(out)
+}
+
+/// Record one complete, non-nested command outside a render pass. Per-render-instance readers
+/// gather separately; shadow copies and merges remain complete commands of their own.
+pub(crate) unsafe fn record(
+    adapters: &[Arc<Adapter>],
+    raw: &Vk,
+    command_buffer: vk::CommandBuffer,
+    command: impl FnOnce(&Vk, vk::CommandBuffer),
+) {
+    // SAFETY: the caller retains each adapter and meets before/after's ordering contract.
+    unsafe {
+        if !adapters.is_empty() {
+            Barrier::everything().record(raw, command_buffer);
+            for adapter in adapters {
+                adapter.before(raw, command_buffer);
+            }
+            Barrier::everything().record(raw, command_buffer);
+        }
+        command(raw, command_buffer);
+        if !adapters.is_empty() {
+            Barrier::everything().record(raw, command_buffer);
+            for adapter in adapters {
+                adapter.after(raw, command_buffer);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{span, Span};
+
+    #[test]
+    fn a_subpage_view_keeps_the_same_prefix_in_canonical_and_scratch() {
+        assert_eq!(
+            span(37, 4096 + 37, 4096 - 37),
+            Some(Span {
+                logical: 0,
+                physical: 4096,
+                length: 4096,
+            })
+        );
+        assert_eq!(
+            span(4096, 8192, 7),
+            Some(Span {
+                logical: 4096,
+                physical: 8192,
+                length: 8,
+            })
+        );
+    }
+
+    #[test]
+    fn invalid_alignment_and_overflow_never_become_gpu_ranges() {
+        assert_eq!(span(1, 0, 4096), None);
+        assert_eq!(span(0, 0, 0), None);
+        assert_eq!(span(255, 255, u64::MAX), None);
+    }
+}
