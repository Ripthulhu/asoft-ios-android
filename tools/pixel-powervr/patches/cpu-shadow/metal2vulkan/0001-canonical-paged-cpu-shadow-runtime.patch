index 0000000000000000000000000000000000000000..af37ffefcbbdba52cfc1d9f0085d6a181ea30d9f
--- /dev/null
+++ b/crates/metal2vulkan/tests/static_psb_offsets.rs
@@ -0,0 +1,85 @@
+//! Known static displacements remain distinguishable when a dynamic root makes windows Whole.
+//! Execution and containment of the accepted far accesses are covered by the authored GPU fixture.
+
+mod common;
+
+use metal2vulkan::device::{Device, DeviceDescription, DevicePolicy};
+use metal2vulkan::error::{Error, Feature, LowerFamily, Needs};
+use metal2vulkan::library::Library;
+use metal2vulkan::pipeline::{FunctionDescriptor, LoweringInputs, SlotClass, SlotRef, Stage};
+use metal2vulkan::Budget;
+
+fn shader(low: i64, high: i64, operation: &str) -> String {
+    format!(
+        r#"target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define void @offsets(ptr addrspace(1) "air-buffer-no-alias" %data, ptr addrspace(1) "air-buffer-no-alias" %out, ptr addrspace(1) "air-buffer-no-alias" %params) {{
+entry:
+  %address = load i64, ptr addrspace(1) %params, align 8
+  %dynamic = inttoptr i64 %address to ptr addrspace(1)
+  %condition = load i32, ptr addrspace(1) %dynamic, align 4
+  %choose = icmp eq i32 %condition, 0
+  %low = getelementptr i8, ptr addrspace(1) %data, i64 {low}
+  %high = getelementptr i8, ptr addrspace(1) %data, i64 {high}
+  %selected = select i1 %choose, ptr addrspace(1) %low, ptr addrspace(1) %high
+  {operation}
+  ret void
+}}
+
+!air.kernel = !{{!0}}
+!air.version = !{{!6}}
+!air.language_version = !{{!7}}
+!0 = !{{ptr @offsets, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4, !5}}
+!3 = !{{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"data"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"out"}}
+!5 = !{{i32 2, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"ulong", !"air.arg_name", !"params"}}
+!6 = !{{i32 2, i32 8, i32 0}}
+!7 = !{{!"Metal", i32 4, i32 0, i32 0}}
+"#
+    )
+}
+
+#[test]
+fn whole_windows_refuse_ambiguous_static_offsets_and_accept_known_far_spans() {
+    let profile = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/profiles/lavapipe.json");
+    let description = DeviceDescription::from_khronos_json(
+        &std::fs::read_to_string(profile).expect("lavapipe profile"),
+        None,
+    )
+    .expect("description");
+    let device = Device::new(description, DevicePolicy::default()).expect("device");
+    for operation in [
+        "%value = load i32, ptr addrspace(1) %selected, align 4\n  store i32 %value, ptr addrspace(1) %out, align 4",
+        "store i32 %condition, ptr addrspace(1) %selected, align 4",
+        "%old = atomicrmw add ptr addrspace(1) %selected, i32 1 monotonic\n  store i32 %old, ptr addrspace(1) %out, align 4",
+    ] {
+        for (low, high, accepted) in [(0, 16, true), (1 << 32, (1 << 32) + 16, true), (0, 1 << 32, false)] {
+            let Some(bitcode) = common::llvm_as(&shader(low, high, operation), "static PSB offsets") else {
+                return;
+            };
+            let library = Library::from_air(&bitcode).expect("authored AIR");
+            let function = FunctionDescriptor::new(library.function("offsets").expect("kernel"));
+            for paged in [false, true] {
+                let mut inputs = LoweringInputs::new();
+                inputs.paged_addresses = paged;
+                inputs.psb_slots.insert(SlotRef { stage: Stage::Kernel, class: SlotClass::Buffer, index: 0 });
+                let result = device.compile_function(&function, &inputs, &Budget::standard());
+                if accepted {
+                    result.unwrap_or_else(|error| panic!("{low}..{high}, paged={paged}, {operation}: {error}"));
+                } else {
+                    match result {
+                        Err(Error::Unsupported(unsupported)) => {
+                            assert_eq!(unsupported.feature, Feature::Lowering(LowerFamily::Access));
+                            assert_eq!(unsupported.needs, Needs::NotImplemented);
+                        }
+                        other => panic!("ambiguous range {low}..{high}, paged={paged}, {operation}: {other:?}"),
+                    }
+                }
+            }
+        }
+    }
+}
