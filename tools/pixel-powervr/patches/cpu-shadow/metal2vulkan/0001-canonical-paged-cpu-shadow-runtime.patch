+/// A fragmented shadow's recorded hazards retain their physical ranges after a detach, while
+/// later uses take only its replacement. Another view of the old bytes stays canonical.
+#[test]
+fn cpu_shadow_detach_ends_only_the_detached_views_physical_aliases() {
+    let aliases = Aliases::default();
+    let (view, other, old, new) = (
+        ResourceKey::new(),
+        ResourceKey::new(),
+        ResourceKey::new(),
+        ResourceKey::new(),
+    );
+    aliases.join_shadow_segments(
+        view,
+        vec![
+            ShadowSegment {
+                key: old,
+                logical: 0..4096,
+                physical: 8192,
+            },
+            ShadowSegment {
+                key: old,
+                logical: 4096..8192,
+                physical: 0,
+            },
+        ],
+    );
+    aliases.join_shadow_segments(
+        other,
+        vec![ShadowSegment {
+            key: old,
+            logical: 0..8192,
+            physical: 0,
+        }],
+    );
+    let used = write(view, 4090..4102);
+    let recorded = aliases.augment(std::slice::from_ref(&used)).unwrap();
+    assert_eq!(
+        recorded,
+        [used.clone(), write(old, 12282..12288), write(old, 0..6)]
+    );
+    aliases.unplace(view);
+    assert_eq!(aliases.augment(std::slice::from_ref(&used)), None);
+    assert_eq!(
+        aliases.shadow_ranges(view, &used.range),
+        [(view, used.range.clone())]
+    );
+    assert_eq!(
+        aliases.augment(&[write(other, 0..6)]),
+        Some(vec![write(other, 0..6), write(old, 0..6)])
+    );
+    aliases.join_shadow_segments(
+        view,
+        vec![ShadowSegment {
+            key: new,
+            logical: 0..8192,
+            physical: 32768,
+        }],
+    );
+    assert_eq!(
+        aliases.augment(std::slice::from_ref(&used)),
+        Some(vec![used.clone(), write(new, 36858..36870)])
+    );
+    assert_eq!(recorded, [used, write(old, 12282..12288), write(old, 0..6)]);
+}
