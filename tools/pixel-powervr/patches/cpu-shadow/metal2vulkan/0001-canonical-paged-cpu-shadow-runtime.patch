+    /// One physical range of an ordinary file, retained for the GPU view's lifetime.
+    #[derive(Debug)]
+    pub struct CpuShadowChunk {
+        /// Owned descriptor of ordinary readable/writable memory, never a dma-buf.
+        pub fd: OwnedFd,
+        /// Byte offset in that file.
+        pub offset: u64,
+        /// Number of bytes, in logical order.
+        pub length: u64,
+    }
+
+    /// Resolves a logical CPU range to canonical ordinary-file pieces. Invoked without runtime
+    /// locks; an error refuses creation. Returned descriptors are retained, not Vulkan-imported.
+    pub type CpuShadowSource =
+        Arc<dyn Fn(CpuShadowRequest) -> io::Result<Vec<CpuShadowChunk>> + Send + Sync + 'static>;
+
