new file mode 100644
index 0000000000000000000000000000000000000000..369a3309b859bf83aee4315b02b52f90d3d2417e
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/command_buffer/cpu_shadow.rs
@@ -0,0 +1,252 @@
+//! One CPU-shadow batch's ownership turn. The scheduler takes the turn before preparing its
+//! snapshot, after earlier submitted work completed, and keeps it until the completion thread
+//! scattered its byte changes. A Vulkan timeline reaching the batch alone does not end the turn.
+
+use super::{step_error, CommandBufferShared};
+use crate::cpu_shadow::ShadowEpoch;
+use crate::device::lock;
+use crate::error::{CommandBufferError, Error};
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Phase {
+    Waiting,
+    Preparing,
+    Ready,
+    Submitted,
+    Cancelling,
+    Finished,
+}
+
+/// The state is generic so the ownership protocol is tested without a Vulkan device.
+struct EpochState<E> {
+    phase: Phase,
+    prepared: Option<Result<E, CommandBufferError>>,
+}
+
+impl<E> EpochState<E> {
+    fn new() -> Self {
+        Self {
+            phase: Phase::Waiting,
+            prepared: None,
+        }
+    }
+
+    fn preparing(&mut self) {
+        assert_eq!(self.phase, Phase::Waiting);
+        self.phase = Phase::Preparing;
+    }
+
+    fn prepared(&mut self, result: Result<E, CommandBufferError>) {
+        assert_eq!(self.phase, Phase::Preparing);
+        self.prepared = Some(result);
+        self.phase = Phase::Ready;
+    }
+
+    fn take(&mut self) -> E {
+        assert_eq!(self.phase, Phase::Ready);
+        let Some(Ok(epoch)) = self.prepared.take() else {
+            panic!("a failed CPU-shadow preparation was submitted");
+        };
+        self.phase = Phase::Submitted;
+        epoch
+    }
+
+    fn finished(&mut self) {
+        self.phase = Phase::Finished;
+    }
+}
+
+/// Shared by the scheduler's active turn, the held batch and its eventual completion.
+pub(crate) struct ShadowBatch {
+    /// Every device queue must have completed through these values before the snapshot.
+    pub(crate) gate: Vec<u64>,
+    state: Mutex<EpochState<ShadowEpoch>>,
+}
+
+impl ShadowBatch {
+    pub(crate) fn new(gate: Vec<u64>) -> Arc<Self> {
+        Arc::new(Self {
+            gate,
+            state: Mutex::new(EpochState::new()),
+        })
+    }
+
+    pub(crate) fn phase(&self) -> Phase {
+        lock(&self.state).phase
+    }
+
+    /// The scheduler queued this turn's preparation, so it cannot queue it a second time.
+    pub(crate) fn preparing(&self) {
+        lock(&self.state).preparing();
+    }
+
+    /// Called on the scheduler thread without its lock. It waits for no GPU operation.
+    pub(crate) fn prepare(&self, buffer: &CommandBufferShared) {
+        if crate::cpu_shadow::cpu_shadow_failed(buffer.device()) {
+            let result = ShadowEpoch::prepare(buffer.device())
+                .map_err(|error| buffer.cpu_shadow_error(error));
+            lock(&self.state).prepared(result);
+            return;
+        }
+        // Freeze the pages and dynamic root table before the snapshot. Otherwise the ordinary
+        // first-submission step could discover a newly registered view after the upload, and
+        // expose canonical bytes this epoch never captured. Rebinds after this point retain
+        // the submitted pages through the command buffer's existing lifetime contract.
+        let first = {
+            let mut state = lock(&buffer.state);
+            if state.submitted {
+                Ok(true)
+            } else {
+                state.first_submission(buffer.device(), buffer)
+            }
+        };
+        let result = match first {
+            Ok(true) => ShadowEpoch::prepare(buffer.device()),
+            Ok(false) => {
+                lock(&self.state).phase = Phase::Waiting;
+                return;
+            }
+            Err(error) => Err(error),
+        }
+        .map_err(|error| buffer.cpu_shadow_error(error));
+        lock(&self.state).prepared(result);
+    }
+
+    pub(crate) fn failure(&self) -> Option<CommandBufferError> {
+        match lock(&self.state).prepared.as_ref() {
+            Some(Err(error)) => Some(*error),
+            _ => None,
+        }
+    }
+
+    /// Called only after the batch was submitted successfully. Its snapshot stays retained
+    /// through the corresponding host wait and scatter.
+    pub(crate) fn submitted(self: &Arc<Self>) -> ShadowCompletion {
+        ShadowCompletion {
+            turn: Arc::clone(self),
+            epoch: lock(&self.state).take(),
+        }
+    }
+
+    /// Nothing of this turn was submitted. Queue its cancellation outside the scheduler lock.
+    pub(crate) fn cancelling(&self) {
+        lock(&self.state).phase = Phase::Cancelling;
+    }
+
+    /// Drop an unsubmitted snapshot without runtime locks, releasing the store's active epoch
+    /// before another batch can prepare. Dropping it may release a canonical allocation.
+    pub(crate) fn cancel(&self) {
+        let prepared = lock(&self.state).prepared.take();
+        drop(prepared);
+        self.finished();
+    }
+
+    fn finished(&self) {
+        lock(&self.state).finished();
+    }
+}
+
+pub(crate) struct ShadowCompletion {
+    turn: Arc<ShadowBatch>,
+    epoch: ShadowEpoch,
+}
+
+impl ShadowCompletion {
+    /// The host wait for this batch returned. Scatter before ending its ownership turn, and
+    /// before the caller publishes events, wakes host steps, or runs completed handlers.
+    pub(crate) fn finish(self, buffer: &CommandBufferShared) -> Result<(), CommandBufferError> {
+        let Self { turn, epoch } = self;
+        let result = epoch
+            .finish()
+            .map_err(|error| buffer.cpu_shadow_error(error));
+        turn.finished();
+        result
+    }
+
+    /// The submitted work failed and its queues have been drained. Its GPU bytes must not be
+    /// scattered, and the canonical store must refuse later work from this uncertain state.
+    pub(crate) fn abandon(self) {
+        let Self { turn, epoch } = self;
+        epoch.abandon();
+        turn.finished();
+    }
+}
+
+impl CommandBufferShared {
+    /// A turn can release a canonical allocation. Retain it until the command buffer's normal
+    /// release, which runs without the scheduler's lock and without its own state lock.
+    pub(crate) fn retain_cpu_shadow(&self, turn: &Arc<ShadowBatch>) {
+        lock(&self.state).retained.push(Box::new(Arc::clone(turn)));
+    }
+
+    fn cpu_shadow_error(&self, error: Error) -> CommandBufferError {
+        let mut state = lock(&self.state);
+        let error = step_error(self.device(), error, &mut state.refusal);
+        state.failure.get_or_insert(error);
+        state.cpu_shadow_failure.get_or_insert(error);
+        // A later host step must not read an epoch whose scatter failed.
+        state.step_failure.get_or_insert(error);
+        error
+    }
+
+    pub(crate) fn cpu_shadow_failure(&self) -> Option<CommandBufferError> {
+        lock(&self.state).cpu_shadow_failure
+    }
+
+    pub(super) fn cpu_shadow_failed(&self, error: CommandBufferError) {
+        let mut state = lock(&self.state);
+        state.failure.get_or_insert(error);
+        state.cpu_shadow_failure.get_or_insert(error);
+        state.step_failure.get_or_insert(error);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{EpochState, Phase};
+    use crate::error::CommandBufferError;
+    use std::sync::{Arc, Barrier, Mutex};
+    use std::thread;
+
+    #[test]
+    fn a_gpu_completion_does_not_publish_an_unscattered_epoch() {
+        let mut state = EpochState::new();
+        state.preparing();
+        state.prepared(Ok(vec![7u8, 9]));
+        let snapshot = state.take();
+        let state = Arc::new(Mutex::new(state));
+        let before_scatter = Arc::new(Barrier::new(2));
+        let after_read = Arc::new(Barrier::new(2));
+        let consumer = thread::spawn({
+            let state = Arc::clone(&state);
+            let before_scatter = Arc::clone(&before_scatter);
+            let after_read = Arc::clone(&after_read);
+            move || {
+                before_scatter.wait();
+                assert_eq!(state.lock().unwrap().phase, Phase::Submitted);
+                after_read.wait();
+            }
+        });
+        // The queue's timeline has reached the batch. Its ownership turn still excludes a
+        // next upload or host step while the completion thread scatters the snapshot.
+        before_scatter.wait();
+        after_read.wait();
+        assert_eq!(snapshot, [7, 9]);
+        state.lock().unwrap().finished();
+        consumer.join().unwrap();
+        assert_eq!(state.lock().unwrap().phase, Phase::Finished);
+    }
+
+    #[test]
+    fn failed_preparation_is_ready_for_refusal_and_keeps_its_error() {
+        let mut state = EpochState::<()>::new();
+        state.preparing();
+        state.prepared(Err(CommandBufferError::OutOfMemory));
+        assert_eq!(state.phase, Phase::Ready);
+        assert_eq!(state.prepared, Some(Err(CommandBufferError::OutOfMemory)));
+        state.finished();
+        assert_eq!(state.phase, Phase::Finished);
+        assert_eq!(state.prepared, Some(Err(CommandBufferError::OutOfMemory)));
+    }
+}
