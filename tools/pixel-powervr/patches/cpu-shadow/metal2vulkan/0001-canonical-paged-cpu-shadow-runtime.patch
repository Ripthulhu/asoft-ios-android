+    /// Bound the allocation amplification of sparse guest RAM. Page tables cross chunk
+    /// boundaries; CPU snapshots and delta scatters still cover only the live physical ranges.
+    const CHUNK: u64 = 1024 * 1024;
+    /// The page granule of a shader address table.
+    pub(super) const PAGE: u64 = 4 * 1024;
+
+    /// The logical CPU range whose physical file backing the runtime needs.
+    #[derive(Clone, Copy, Debug)]
+    pub struct CpuShadowRequest {
+        /// Logical CPU address; a deferred address need not be materialized.
+        pub start: NonNull<u8>,
+        /// Number of bytes in the ordered answer.
+        pub length: u64,
+        /// Preferred splitting granule of the GPU page table.
+        pub granule: u64,
+    }
