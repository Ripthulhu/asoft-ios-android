@@ -0,0 +1,132 @@
+use super::Publication;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{mpsc, Arc};
+use std::thread;
+use std::time::Duration;
+
+const WAIT: Duration = Duration::from_secs(5);
+
+struct Backing {
+    publication: Publication,
+    pages: AtomicUsize,
+    generation: AtomicUsize,
+    alias: AtomicUsize,
+}
+
+impl Backing {
+    fn new() -> Self {
+        Self {
+            publication: Publication::default(),
+            pages: AtomicUsize::new(1),
+            generation: AtomicUsize::new(1),
+            alias: AtomicUsize::new(1),
+        }
+    }
+
+    fn observe_contention(&self) -> mpsc::Receiver<()> {
+        let (send, recv) = mpsc::channel();
+        *self.publication.contended.lock().unwrap() = Some(send);
+        recv
+    }
+}
+
+struct Retired(Arc<Backing>);
+
+impl Drop for Retired {
+    fn drop(&mut self) {
+        assert!(self.0.publication.gate.try_lock().is_ok());
+    }
+}
+
+#[test]
+fn snapshot_cannot_observe_new_pages_with_old_root_generation() {
+    let backing = Arc::new(Backing::new());
+    let contended = backing.observe_contention();
+    let (changed, changed_recv) = mpsc::channel();
+    let (finish, finish_recv) = mpsc::channel();
+    let writer = Arc::clone(&backing);
+    let published = thread::spawn(move || {
+        writer.publication.publish(|| {
+            writer.pages.store(2, Ordering::SeqCst);
+            changed.send(()).unwrap();
+            finish_recv.recv_timeout(WAIT).unwrap();
+            writer.generation.store(2, Ordering::SeqCst);
+            writer.alias.store(2, Ordering::SeqCst);
+            ((), ())
+        });
+    });
+    changed_recv.recv_timeout(WAIT).unwrap();
+    let reader = Arc::clone(&backing);
+    let captured = thread::spawn(move || {
+        reader.publication.snapshot(|| {
+            (
+                reader.pages.load(Ordering::SeqCst),
+                reader.generation.load(Ordering::SeqCst),
+                reader.alias.load(Ordering::SeqCst),
+            )
+        })
+    });
+    contended.recv_timeout(WAIT).unwrap();
+    finish.send(()).unwrap();
+    published.join().unwrap();
+    assert_eq!(captured.join().unwrap(), (2, 2, 2));
+}
+
+#[test]
+fn publication_cannot_split_named_holds_from_dynamic_roots() {
+    let backing = Arc::new(Backing::new());
+    let contended = backing.observe_contention();
+    let (named_ready, named_recv) = mpsc::channel();
+    let (finish, finish_recv) = mpsc::channel();
+    let reader = Arc::clone(&backing);
+    let captured = thread::spawn(move || {
+        reader.publication.snapshot(|| {
+            let named = reader.pages.load(Ordering::SeqCst);
+            named_ready.send(()).unwrap();
+            finish_recv.recv_timeout(WAIT).unwrap();
+            (named, reader.pages.load(Ordering::SeqCst))
+        })
+    });
+    named_recv.recv_timeout(WAIT).unwrap();
+    let writer = Arc::clone(&backing);
+    let published = thread::spawn(move || {
+        writer.publication.publish(|| {
+            writer.pages.store(2, Ordering::SeqCst);
+            writer.generation.store(2, Ordering::SeqCst);
+            writer.alias.store(2, Ordering::SeqCst);
+            ((), ())
+        });
+    });
+    contended.recv_timeout(WAIT).unwrap();
+    finish.send(()).unwrap();
+    assert_eq!(captured.join().unwrap(), (1, 1));
+    published.join().unwrap();
+    assert_eq!(backing.pages.load(Ordering::SeqCst), 2);
+}
+
+#[test]
+fn retirement_leaves_the_gate_on_success_and_refusal() {
+    let backing = Arc::new(Backing::new());
+    for result in [Ok(1), Err(2)] {
+        assert_eq!(
+            backing
+                .publication
+                .publish(|| (result, Retired(Arc::clone(&backing)))),
+            result
+        );
+    }
+}
+
+#[test]
+fn failed_snapshot_retains_transient_owners_until_after_unlock() {
+    let backing = Arc::new(Backing::new());
+    let mut captured = super::Retired::default();
+    assert!(captured.is_empty());
+    let result: Result<(), ()> = backing.publication.snapshot(|| {
+        captured.keep(Retired(Arc::clone(&backing)));
+        Err(())
+    });
+    assert!(result.is_err());
+    assert!(!captured.is_empty());
+    drop(captured);
+}
