+
+    #[derive(Clone, Copy)]
+    pub(crate) struct Backing {
+        pub(crate) raw: vk::Buffer,
+        pub(crate) memory: vk::DeviceMemory,
+        pub(crate) offset: u64,
+        pub(crate) type_index: u32,
+        pub(crate) length: u64,
+        pub(crate) base: u64,
+        pub(crate) prefix: u64,
+        pub(crate) address: u64,
+    }
+
+    struct Direct {
+        device: Device,
+        backing: Backing,
+    }
+
+    impl Direct {
+        fn new(
+            device: &Device,
+            part: &Part,
+            prefix: u64,
+            length: u64,
+        ) -> Result<Option<Self>, Error> {
+            let physical = part
+                .range
+                .start
+                .checked_sub(prefix)
+                .ok_or_else(|| refusal(CpuShadowProblem::PageBoundary))?;
+            let size = prefix
+                .checked_add(length)
+                .and_then(|size| size.checked_add(15))
+                .map(|size| size & !15)
+                .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+            let address = part
+                .chunk
+                .gpu
+                .device_address()
+                .ok_or_else(|| refusal(CpuShadowProblem::Backing))?
+                .checked_add(physical)
+                .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+            let shared = device.shared();
+            let usage = crate::buffer::usage(false);
+            let info = shared
+                .sharing()
+                .buffer(vk::BufferCreateInfo::default().size(size).usage(usage));
+            // SAFETY: this is an ordinary buffer alias over runtime-owned canonical memory.
+            let raw =
+                unsafe { shared.vk().create_buffer(&info, None) }.map_err(crate::error::vulkan)?;
+            let (memory, at, type_index) = part.chunk.gpu.memory();
+            let offset = at
+                .checked_add(physical)
+                .ok_or_else(|| refusal(CpuShadowProblem::Range));
+            let (canonical, _) = part.chunk.gpu.at(0);
+            // SAFETY: both buffers are live, the alias not bound yet.
+            let requirements = unsafe { shared.vk().get_buffer_memory_requirements(raw) };
+            let available = unsafe { shared.vk().get_buffer_memory_requirements(canonical) }.size;
+            let bound = offset.and_then(|offset| {
+                if !offset.is_multiple_of(requirements.alignment)
+                    || requirements.memory_type_bits & (1 << type_index) == 0
+                    || physical
+                        .checked_add(requirements.size)
+                        .is_none_or(|end| end > available)
+                {
+                    return Ok(None);
+                }
+                // SAFETY: offset and type meet the alias requirements, and the retained
+                // canonical chunk owns all of its bytes. No sparse binding is used.
+                unsafe { shared.vk().bind_buffer_memory(raw, memory, offset) }
+                    .map_err(crate::error::vulkan)?;
+                Ok(Some(offset))
+            });
+            let offset = match bound {
+                Ok(Some(offset)) => offset,
+                Ok(None) => {
+                    // This driver cannot alias at the required stable offset; the caller uses
+                    // ordinary scratch plus canonical gathers instead.
+                    unsafe { crate::release::object(shared.vk(), raw) };
+                    return Ok(None);
+                }
+                Err(error) => {
+                    // SAFETY: no command can use the unpublished alias.
+                    unsafe { crate::release::object(shared.vk(), raw) };
+                    return Err(error);
+                }
+            };
+            shared.counts.buffer_made(usage);
+            Ok(Some(Direct {
+                device: device.clone(),
+                backing: Backing {
+                    raw,
+                    memory,
+                    offset,
+                    type_index,
+                    length: size,
+                    base: prefix,
+                    prefix,
+                    address,
+                },
+            }))
+        }
+    }
+
+    impl Drop for Direct {
+        fn drop(&mut self) {
+            let Some(_busy) = crate::exit_guard::enter() else {
+                return;
+            };
+            // SAFETY: the View's last GPU hold has ended. Its canonical chunks drop afterward.
+            unsafe { crate::release::object(self.device.shared().vk(), self.backing.raw) };
+        }
+    }
+
+    /// One logical resource's physical backing. The canonical chunks outlive every Vulkan hold.
+    pub(crate) struct View {
+        pointer: usize,
+        // Vulkan aliases are destroyed before their canonical memory owners.
+        direct: Option<Direct>,
+        pages: PageMap,
+        parts: Vec<Part>,
+        adapter: OnceLock<Arc<crate::cpu_shadow_adapter::Adapter>>,
+        release: Mutex<Option<Release>>,
+    }
+
+    impl View {
+        pub(crate) fn pointer(&self) -> NonNull<u8> {
+            // The source constructor requires a non-null logical pointer.
+            NonNull::new(self.pointer as *mut u8).expect("non-null shadow pointer")
+        }
+
+        pub(crate) fn page_address(&self) -> Option<(u64, u64)> {
+            Some((self.pages.table.device_address()?, self.pages.prefix))
+        }
+
+        pub(crate) fn backing(&self) -> Backing {
+            if let Some(direct) = &self.direct {
+                return direct.backing;
+            }
+            let scratch = self.pages.scratch.as_ref().expect("fragmented scratch");
+            let (raw, base) = scratch.at(0);
+            let (memory, offset, type_index) = scratch.memory();
+            Backing {
+                raw,
+                memory,
+                offset,
+                type_index,
+                length: scratch.length(),
+                base: base + self.pages.prefix,
+                prefix: self.pages.prefix,
+                address: scratch.device_address().expect("shadow device address") - base,
+            }
+        }
+
+        pub(crate) fn join_aliases(&self, device: &Device, key: crate::resource::ResourceKey) {
+            let mut logical = 0;
+            let aliases = self
+                .parts
+                .iter()
+                .map(|part| {
+                    let length = part.range.end - part.range.start;
+                    let alias = crate::host_aliases::ShadowSegment {
+                        key: part.chunk.gpu.identity().key,
+                        logical: logical..logical + length,
+                        physical: part.range.start,
+                    };
+                    logical += length;
+                    alias
+                })
+                .collect();
+            device.shared().aliases.join_shadow_segments(key, aliases);
+        }
+
+        pub(crate) fn accept(&self, device: &Device, release: HostRelease, length: u64) {
+            *lock(&self.release) = release.of(self.pointer(), length);
+            device
+                .shared()
+                .cpu_shadows
+                .counts
+                .views_created
+                .fetch_add(1, Ordering::Relaxed);
+        }
+
+        pub(crate) fn adapter(&self) -> Option<Arc<crate::cpu_shadow_adapter::Adapter>> {
+            self.adapter.get().map(Arc::clone)
+        }
+
+        pub(crate) fn segments(&self) -> Option<Vec<CpuShadowSegment>> {
+            let mut at = self.pages.prefix;
+            Some(
+                self.parts
+                    .iter()
+                    .map(|part| {
+                        let length = part.range.end - part.range.start;
+                        let segment = CpuShadowSegment {
+                            buffer: part.chunk.gpu.clone(),
+                            logical_offset: at,
+                            offset: part.range.start,
+                            length,
+                        };
+                        at += length;
+                        segment
+                    })
+                    .collect(),
+            )
+        }
+
+        pub(crate) fn write(&self, offset: u64, mut from: &[u8]) -> Result<(), Error> {
+            let mut logical = 0u64;
+            let mut next = offset;
+            for part in &self.parts {
+                let size = part.range.end - part.range.start;
+                let end = logical + size;
+                if next < end && !from.is_empty() {
+                    let within = next
+                        .checked_sub(logical)
+                        .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+                    let n = (size - within).min(from.len() as u64) as usize;
+                    let (head, tail) = from.split_at(n);
+                    part.chunk
+                        .file
+                        .write_all_at(head, part.chunk.key.offset + part.range.start + within)
+                        .map_err(io_error)?;
+                    from = tail;
+                    next += n as u64;
+                }
+                logical = end;
+            }
+            if from.is_empty() {
+                Ok(())
+            } else {
+                Err(refusal(CpuShadowProblem::Range))
+            }
+        }
+
+        pub(crate) fn read(&self, offset: u64, mut into: &mut [u8]) -> Result<(), Error> {
+            let mut logical = 0u64;
+            let mut next = offset;
+            for part in &self.parts {
+                let size = part.range.end - part.range.start;
+                let end = logical + size;
+                if next < end && !into.is_empty() {
+                    let within = next
+                        .checked_sub(logical)
+                        .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+                    let n = (size - within).min(into.len() as u64) as usize;
+                    let (head, tail) = into.split_at_mut(n);
+                    part.chunk
+                        .file
+                        .read_exact_at(head, part.chunk.key.offset + part.range.start + within)
+                        .map_err(io_error)?;
+                    into = tail;
+                    next += n as u64;
+                }
+                logical = end;
+            }
+            if into.is_empty() {
+                Ok(())
+            } else {
+                Err(refusal(CpuShadowProblem::Range))
+            }
+        }
+    }
+
+    impl PageMap {
+        fn new(
+            device: &Device,
+            pointer: NonNull<u8>,
+            length: u64,
+            parts: &[Part],
+        ) -> Result<PageMap, Error> {
+            let prefix = pointer.as_ptr() as u64 % PAGE;
+            let bytes = prefix
+                .checked_add(length)
+                .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+            let count = usize::try_from(bytes.div_ceil(PAGE))
+                .map_err(|_| refusal(CpuShadowProblem::Range))?;
+            let mut addresses = vec![None; count];
+            let mut logical = prefix;
+            for part in parts {
+                let mut physical = part.range.start;
+                while physical < part.range.end {
+                    let within = logical % PAGE;
+                    if physical % PAGE != within {
+                        return Err(refusal(CpuShadowProblem::PageBoundary));
+                    }
+                    let address = part
+                        .chunk
+                        .gpu
+                        .device_address()
+                        .ok_or_else(|| refusal(CpuShadowProblem::Backing))?
+                        .checked_add(physical)
+                        .and_then(|value| value.checked_sub(within))
+                        .ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+                    let page = &mut addresses[(logical / PAGE) as usize];
+                    if page.is_some_and(|previous| previous != address) {
+                        return Err(refusal(CpuShadowProblem::PageBoundary));
+                    }
+                    *page = Some(address);
+                    let n = (PAGE - within).min(part.range.end - physical);
+                    physical += n;
+                    logical += n;
+                }
+            }
+            let table = device.write_combined_buffer((count as u64) * 8)?;
+            let mapped = table
+                .contents()
+                .ok_or_else(|| refusal(CpuShadowProblem::Backing))?;
+            for (index, address) in addresses.into_iter().enumerate() {
+                let address = address.ok_or_else(|| refusal(CpuShadowProblem::Range))?;
+                // SAFETY: the new, unsubmitted table has eight mapped bytes per entry.
+                unsafe {
+                    std::ptr::copy_nonoverlapping(
+                        address.to_le_bytes().as_ptr(),
+                        mapped.as_ptr().add(index * 8),
+                        8,
+                    )
+                };
+            }
+            let scratch = (parts.len() != 1)
+                .then(|| device.write_combined_buffer(bytes))
+                .transpose()?;
+            Ok(PageMap {
+                table,
+                scratch,
+                prefix,
+            })
+        }
+    }
+
+    impl Drop for View {
+        fn drop(&mut self) {
+            if let Some(release) = self
+                .release
+                .get_mut()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+            {
+                release.run();
+            }
+        }
+    }
