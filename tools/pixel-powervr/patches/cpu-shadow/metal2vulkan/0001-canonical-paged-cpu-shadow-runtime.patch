+#[test]
+fn shadow_signal_is_hidden_until_scatter_even_after_a_host_wait() {
+    let mut timeline = EventTimeline::default();
+    timeline.keep(1, 7, 0, true);
+    assert_eq!(timeline.known(), 7);
+    // A VkQueue wait for this raw semaphore would run before the CPU scatter too, so both
+    // the host's reads and the scheduler's GPU waits remain held.
+    assert_eq!(timeline.wait(7), None);
+    assert!(!timeline.observe(1));
+    assert_eq!(
+        timeline.observe_read::<()>(1, |_| panic!("a deferred index must not be waited for")),
+        Ok(false)
+    );
+    assert_eq!(timeline.value(), 0);
+    timeline.publish(1);
+    assert!(timeline.observe(1));
+    assert_eq!(timeline.value(), 7);
+    assert_eq!(timeline.wait(7), Some(WaitFor::Reached));
+}
+
+#[test]
