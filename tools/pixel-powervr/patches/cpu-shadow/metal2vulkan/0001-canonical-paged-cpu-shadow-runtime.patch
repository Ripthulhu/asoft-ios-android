diff --git a/crates/metal2vulkan-runtime/src/publication.rs b/crates/metal2vulkan-runtime/src/publication.rs
new file mode 100644
index 0000000000000000000000000000000000000000..928e653675057015492393cb29839971e79714f4
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/publication.rs
@@ -0,0 +1,71 @@
+//! Publish a resource's backing and all metadata that resolves it as one change.
+//!
+//! The rebind registry alone protects named page holds. First submission also reads live-buffer
+//! generations, resident ranges, aliases and texture metadata after releasing that registry.
+//! A rebind must not split those reads across two backings. This outer gate covers publication
+//! and the complete first-submission capture; it never covers source callbacks, preparation of
+//! replacement Vulkan resources, replay, GPU waits, or retirement of the replaced objects.
+
+use std::sync::{Mutex, MutexGuard};
+
+/// Transient owners captured while resolving a submission. They leave the publication gate
+/// before the caller sends them to a handler thread, outside its command-buffer state lock.
+#[derive(Default)]
+pub(crate) struct Retired(Vec<Box<dyn Send>>);
+
+impl Retired {
+    pub(crate) fn keep(&mut self, held: impl Send + 'static) {
+        self.0.push(Box::new(held));
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Publication {
+    gate: Mutex<()>,
+    #[cfg(test)]
+    contended: Mutex<Option<std::sync::mpsc::Sender<()>>>,
+}
+
+impl Publication {
+    fn lock(&self) -> MutexGuard<'_, ()> {
+        // The observer makes the two interleavings below deterministic: they proceed only once
+        // the competing production operation actually reached the held gate.
+        #[cfg(test)]
+        match self.gate.try_lock() {
+            Ok(guard) => return guard,
+            Err(std::sync::TryLockError::Poisoned(error)) => return error.into_inner(),
+            Err(std::sync::TryLockError::WouldBlock) => {
+                if let Some(observed) = self.contended.lock().unwrap().as_ref() {
+                    let _ = observed.send(());
+                }
+            }
+        }
+        self.gate.lock().unwrap_or_else(|error| error.into_inner())
+    }
+
+    /// Resolve named holds and dynamic roots against one complete publication. Any transient
+    /// owner that may run caller code on drop must be retained outside this closure.
+    pub(crate) fn snapshot<T>(&self, capture: impl FnOnce() -> T) -> T {
+        let _guard = self.lock();
+        capture()
+    }
+
+    /// Publish prepared objects, returning retired owners separately. Retirement follows the
+    /// unlock even when `T` is an error; the closure must keep error-path owners outside it too.
+    pub(crate) fn publish<T, R>(&self, update: impl FnOnce() -> (T, R)) -> T {
+        let (result, retired) = {
+            let _guard = self.lock();
+            update()
+        };
+        drop(retired);
+        result
+    }
+}
+
+#[cfg(test)]
+#[path = "tests/publication.rs"]
+mod tests;
