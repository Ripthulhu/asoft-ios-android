@@ -0,0 +1,107 @@
+//! Public root-table metadata and variant selection, without the compiler's monolithic unit
+//! test graph or a Vulkan device. Shader execution is covered by the authored device fixtures.
+
+use metal2vulkan::bind::{
+    BindState, BoundBuffer, ResidentRange, ResidentSet, ResourceClass, UsedResource,
+};
+use metal2vulkan::pipeline::Stage;
+
+const PAGED: u64 = 1 << 63;
+
+fn words(set: &ResidentSet) -> Vec<u64> {
+    set.bytes()
+        .chunks_exact(8)
+        .map(|word| u64::from_le_bytes(word.try_into().unwrap()))
+        .collect()
+}
+
+#[test]
+fn paged_metadata_keeps_flags_lengths_and_page_origins_distinct() {
+    let first = ResidentRange::paged(0x8000, 0x1000, 6000);
+    let next = ResidentRange::paged(0x9000, 0x2000, 8192);
+    let linear = ResidentRange::new(0xa000, 0x5000, 64);
+    let set = ResidentSet::new([linear, next, first]);
+    assert_eq!(set.len(), 3);
+    assert_eq!(
+        words(&set),
+        [
+            0x8000,
+            0x1000,
+            PAGED | 6000,
+            0,
+            0x9000,
+            0x2000,
+            PAGED | 8192,
+            0,
+            0xa000,
+            0x5000,
+            64,
+            0,
+        ]
+    );
+    assert_eq!(set.with([]).bytes(), set.bytes());
+    assert!(set.holds(&ResidentRange::paged(0x8000, 0x1000, 4096)));
+    // Last-start lookup selects `next` inside the overlap. A query starting at `first`
+    // cannot claim its complete length still resolves through its original page table.
+    assert!(!set.holds(&first));
+    assert!(set.holds(&next));
+    assert!(set.holds(&ResidentRange::paged(0x9008, 0x3000, 4096)));
+    assert!(!set.holds(&ResidentRange::paged(0x9008, 0x3001, 16)));
+    assert!(!set.holds(&ResidentRange::paged(0x9010, 0x4000, 16)));
+    assert!(!set.holds(&ResidentRange::new(0x9000, 0x2000, 8192)));
+    assert!(set.holds(&linear));
+    assert!(set.holds(&ResidentRange::new(0xa010, 0x5010, 16)));
+    assert!(!set.holds(&ResidentRange::new(0xa040, 0x5040, 16)));
+    assert!(!set.holds(&ResidentRange::paged(0, 0, 16)));
+}
+
+#[test]
+fn paging_mode_is_part_of_shapes_before_any_resource_is_registered() {
+    let plain = BindState::default();
+    let linear_shape = plain.shape();
+    assert!(!linear_shape.paged_addresses);
+    let mut configured = plain.clone();
+    configured.paged_addresses = true;
+    let shape = configured.shape();
+    assert!(shape.paged_addresses);
+    assert!(configured.has_shape(&shape));
+    assert!(!configured.has_shape(&linear_shape));
+    assert!(!plain.has_shape(&shape));
+
+    let mut listed = plain.clone();
+    listed
+        .resident_ranges
+        .push(ResidentRange::paged(0x8000, 0x1000, 8192));
+    assert!(listed.shape().paged_addresses);
+    assert!(!listed.has_shape(&linear_shape));
+
+    let mut used = plain.clone();
+    let mut resource = UsedResource::new(ResourceClass::Buffer, 3);
+    resource.page_table = true;
+    resource.device_address = Some(0x8000);
+    resource.gpu_address = Some(0x1000);
+    resource.length = 8192;
+    used.used_resources.push(resource);
+    assert!(used.shape().paged_addresses);
+    assert!(!used.has_shape(&linear_shape));
+
+    let mut bound = plain;
+    bound
+        .stages
+        .entry(Stage::Kernel)
+        .or_default()
+        .buffers
+        .insert(
+            0,
+            BoundBuffer::Buffer {
+                length: 8192,
+                offset: 4092,
+                gpu_address: 0x1000,
+                device_address: Some(0x8000),
+                page_table: true,
+                attribute_stride: None,
+            },
+        );
+    assert!(bound.shape().paged_addresses);
+    assert!(!bound.has_shape(&linear_shape));
+}
