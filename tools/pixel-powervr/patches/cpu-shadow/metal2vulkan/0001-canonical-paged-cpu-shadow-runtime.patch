+                            slot_buffer(0, GUEST.to_le_bytes().to_vec()),
+                            slot_buffer(1, vec![0; 16]),
+                            slot_buffer(2, params),
+                            addressed(TABLE, root_table(&statics, &resident)),
+                            addressed(SINK, vec![0; 64]),
+                            addressed(STATUS, vec![0; ExecutionStatus::BYTES]),
+                            addressed(PAGES, [PAGE_A.to_le_bytes(), PAGE_B.to_le_bytes()].concat()),
+                            addressed(PAGE_A, logical[..4096].to_vec()),
+                            addressed(PAGE_B, logical[4096..].to_vec()),
+                        ],
+                        push: push_bytes(&plan),
+                        spec: Default::default(),
+                    };
+                    let out = run(&module, &Config::default(), resources)
+                        .unwrap_or_else(|e| panic!("{name} {what} offset={offset:#x}: {e}"));
+                    let in_bounds = offset <= 8192 - 16;
+                    if store {
+                        let mut want = logical.clone();
+                        if in_bounds {
+                            let value: Vec<u8> = [305419896u32, 1450744508, 0xdeadbeef, 0xcafebabe]
+                                .into_iter()
+                                .flat_map(u32::to_le_bytes)
+                                .collect();
+                            want[offset as usize..offset as usize + 16].copy_from_slice(&value);
+                        }
+                        assert_eq!(
+                            [out.buffers[7].as_slice(), out.buffers[8].as_slice()].concat(),
+                            want,
+                            "{name} {what} offset={offset:#x}"
+                        );
+                    } else {
+                        let want = if in_bounds {
+                            logical[offset as usize..offset as usize + 16].to_vec()
+                        } else {
+                            vec![0; 16]
+                        };
+                        assert_eq!(out.buffers[1], want, "{name} {what} offset={offset:#x}");
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// An atomic through a loaded guest pointer resolves the same physical page that a separate
+/// logical paged root names. This covers the atomic's address path, separate from word leaves.
+#[test]
+fn paged_dynamic_atomic_uses_the_canonical_alias_page() {
+    use crate::pipeline::testing::{compile_with, typed_module_with};
+    use crate::pipeline::LoweringInputs;
+    const PAGES: u64 = 0x0050_0000_0000;
+    const PAGE: u64 = 0x0060_0000_0000;
+    const GUEST: u64 = 0x4000_0000;
+    let body = format!("{CHASE}  %old = atomicrmw add ptr addrspace(1) %q, i32 11 monotonic, align 4\n  store i32 %old, ptr addrspace(1) %1, align 4\n");
+    let Some(bitcode) = assemble_text("paged_atomic", &kernel("paged_atomic", &body)) else {
+        return;
+    };
+    let mut inputs = LoweringInputs::new();
+    inputs.paged_addresses = true;
+    for (what, profile) in profiles() {
+        let artifact = compile_with(&bitcode, "paged_atomic", &profile, &inputs)
+            .expect("paged atomic compile");
+        link_and_validate(&artifact, &profile).expect("paged atomic L3");
+        let (plan, module) = typed_module_with(&bitcode, "paged_atomic", &profile, &inputs)
+            .expect("paged atomic module");
+        let mut data = vec![0; 4096];
+        data[12..16].copy_from_slice(&44u32.to_le_bytes());
+        let mut params = vec![0; 16];
+        params[8..].copy_from_slice(&4108u64.to_le_bytes());
+        let resources = Resources {
+            buffers: vec![
+                slot_buffer(0, GUEST.to_le_bytes().to_vec()),
+                slot_buffer(1, vec![0; 16]),
+                slot_buffer(2, params),
+                addressed(
+                    TABLE,
+                    root_table(
+                        &[(0, 0, 0, 0); 3],
+                        &[(PAGES, GUEST, 8192 | crate::memory::roots::PAGED)],
+                    ),
+                ),
+                addressed(SINK, vec![0; 64]),
+                addressed(STATUS, vec![0; ExecutionStatus::BYTES]),
+                addressed(PAGES, [PAGE.to_le_bytes(), PAGE.to_le_bytes()].concat()),
+                addressed(PAGE, data),
+            ],
+            push: push_bytes(&plan),
+            spec: Default::default(),
+        };
+        let out =
+            run(&module, &Config::default(), resources).unwrap_or_else(|e| panic!("{what}: {e}"));
+        assert_eq!(&out.buffers[1][..4], &44u32.to_le_bytes(), "{what}");
+        assert_eq!(&out.buffers[7][12..16], &55u32.to_le_bytes(), "{what}");
+    }
+}
