+//! Explicit CPU-authoritative ordinary-file storage with canonical Vulkan shadows.
+//!
+//! File identity, not CPU virtual address or Metal buffer identity, owns GPU bytes. A snapshot
+//! epoch is taken only after earlier GPU work completed; its byte-delta scatter completes before
+//! any event or host step can observe that batch. No CPU atomic or guest load touches a Vulkan
+//! mapping. The mappings here are only copied by the runtime at those ownership boundaries.
+
+use crate::device::lock;
+use crate::error::{invalid, Error, Problem};
+use crate::Device;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+/// A CPU-shadow source or synchronization operation that cannot be represented safely.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum CpuShadowProblem {
+    /// The source or a file operation failed, with its operating-system explanation.
+    Io(String),
+    /// The ordered pieces do not exactly cover the requested bytes, or overflow a range.
+    Range,
+    /// The device was created without the explicit CPU-shadow address mode.
+    ModeDisabled,
+    /// A file is not ordinary readable/writable memory, or does not cover its piece.
+    Backing,
+    /// This operation requires one contiguous Vulkan range; its view is fragmented.
+    Fragmented,
+    /// A logical 4 KiB page has no continuous physical window, or a rebind changes its prefix.
+    PageBoundary,
+    /// A registration or submission would change storage during a live GPU epoch.
+    ActiveEpoch,
+    /// A previous scatter failed; continuing would expose stale memory.
+    FailedEpoch,
+    /// A rebind changes between CPU-shadow and imported-host backends.
+    Rebind,
+    /// An external Vulkan binary semaphore would expose GPU bytes before CPU scatter.
+    ExternalSignal,
+}
+
+fn refusal(problem: CpuShadowProblem) -> Error {
+    invalid("cpu_shadow", Problem::CpuShadow(problem))
+}
+
+/// Evidence of actual CPU-shadow work on one device. Creating a source alone changes nothing.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct CpuShadowCounts {
+    /// Canonical Vulkan chunks allocated successfully.
+    pub chunks_created: u64,
+    /// Resource views attached to canonical backing successfully.
+    pub views_created: u64,
+    /// CPU snapshots uploaded before actual batch submissions.
+    pub epochs_prepared: u64,
+    /// GPU deltas scattered before batch visibility.
+    pub epochs_finished: u64,
+    /// Bytes copied from ordinary file memory into Vulkan storage.
+    pub bytes_uploaded: u64,
+    /// Changed bytes copied back to ordinary file memory.
+    pub bytes_scattered: u64,
+}
+
+#[derive(Default)]
+struct Counts {
+    chunks_created: AtomicU64,
+    views_created: AtomicU64,
+    epochs_prepared: AtomicU64,
+    epochs_finished: AtomicU64,
+    bytes_uploaded: AtomicU64,
+    bytes_scattered: AtomicU64,
+}
+
+impl Counts {
+    fn read(&self) -> CpuShadowCounts {
+        CpuShadowCounts {
+            chunks_created: self.chunks_created.load(Ordering::Relaxed),
+            views_created: self.views_created.load(Ordering::Relaxed),
+            epochs_prepared: self.epochs_prepared.load(Ordering::Relaxed),
+            epochs_finished: self.epochs_finished.load(Ordering::Relaxed),
+            bytes_uploaded: self.bytes_uploaded.load(Ordering::Relaxed),
+            bytes_scattered: self.bytes_scattered.load(Ordering::Relaxed),
+        }
+    }
+}
+
+impl Device {
+    /// Whether this device was created for explicit CPU-authoritative file imports.
+    /// The answer is fixed before any resource or pipeline is created.
+    pub fn cpu_shadow_enabled(&self) -> bool {
+        self.shared().cpu_shadow_mode
+    }
+
+    /// Counters for explicit CPU-authoritative shadow storage on this device.
+    pub fn cpu_shadow_counts(&self) -> CpuShadowCounts {
+        self.shared().cpu_shadows.counts.read()
+    }
+}
+
+/// One canonical segment, in the plain fixed-function scratch buffer's byte coordinates.
+/// First/last ranges can be sub-page; logical and physical offsets are congruent modulo 4 KiB.
+#[derive(Clone)]
+pub(super) struct CpuShadowSegment {
+    pub(super) buffer: crate::Buffer,
+    pub(super) logical_offset: u64,
+    pub(super) offset: u64,
+    pub(super) length: u64,
+}
+
+/// Merge overlapping and touching byte intervals, without broadening them to untouched pages.
+fn merged(mut ranges: Vec<std::ops::Range<u64>>) -> Vec<std::ops::Range<u64>> {
+    ranges.sort_unstable_by_key(|r| r.start);
+    let mut out: Vec<std::ops::Range<u64>> = Vec::new();
+    for range in ranges {
+        if let Some(last) = out.last_mut() {
+            if range.start <= last.end {
+                last.end = last.end.max(range.end);
+                continue;
+            }
+        }
+        out.push(range);
+    }
+    out
+}
+
+/// GPU-changed byte runs only. CPU writes outside them survive a scatter.
+fn changes<'a>(
+    before: &'a [u8],
+    after: &'a [u8],
+) -> impl Iterator<Item = std::ops::Range<usize>> + 'a {
+    let mut next = 0;
+    std::iter::from_fn(move || {
+        while next < before.len() && before[next] == after[next] {
+            next += 1;
+        }
+        let first = next;
+        while next < before.len() && before[next] != after[next] {
+            next += 1;
+        }
+        (first != next).then_some(first..next)
+    })
+}
