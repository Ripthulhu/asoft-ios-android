+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_dynamic_rebind.rs
@@ -0,0 +1,478 @@
+//! A committed GPU command reaches a no-copy buffer through its resident GPU address, then
+//! through a named binding. Before its event allows first submission, detach/replace switches
+//! direct ordinary pages to fragmented pages. Cross-page reads, an atomic and cross-page stores
+//! must use the new backing. A real indirect-stage-input step must still refuse early rebinding.
+//! Assemble the repository-authored `cpu_shadow_dynamic_rebind/kernel.ll` with llvm-as.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::Duration;
+
+    use metal2vulkan::metal::ResourceUsage;
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::host::HostPtr;
+    use reims_vgpu_core::platform::HostRange;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::platform::resource::Buffer as _;
+    use reims_vgpu_core::platform::types::ResourceAddressRange;
+    use reims_vgpu_core::platform::values::{BufferDesc, OptionSet};
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+    use reims_vgpu_vulkan::platform::AddressRanges;
+    use reims_vgpu_vulkan::{Obj, VulkanPlatform};
+
+    const PAGE: usize = 16 * 1024;
+    const BYTES: usize = 3 * PAGE;
+    const FILE_BYTES: usize = 4 * PAGE;
+    const WAIT: Duration = Duration::from_secs(15);
+
+    #[derive(Clone, Copy, PartialEq, Eq)]
+    enum Case {
+        Resident,
+        Named,
+        IndirectInput,
+    }
+
+    impl Case {
+        fn name(self) -> &'static str {
+            match self {
+                Self::Resident => "resident_only",
+                Self::Named => "named_control",
+                Self::IndirectInput => "indirect_input_refusal",
+            }
+        }
+    }
+
+    struct Mapping {
+        at: NonNull<u8>,
+        order: [usize; 3],
+    }
+    // SAFETY: only ownership/address tokens cross threads, with no mutable Rust reference.
+    unsafe impl Send for Mapping {}
+    // SAFETY: ordinary-file I/O is the only CPU access; the mapping is retained while used.
+    unsafe impl Sync for Mapping {}
+    impl Mapping {
+        fn new(file: &File, order: [usize; 3]) -> io::Result<Self> {
+            let reserve = BYTES + PAGE;
+            // SAFETY: reserve enough inaccessible address space to align a retained subrange.
+            let base = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    reserve,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if base == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let address = (base as usize + PAGE - 1) & !(PAGE - 1);
+            let head = address - base as usize;
+            let tail = reserve - head - BYTES;
+            // SAFETY: discard only complete host pages outside the selected owned subrange.
+            unsafe {
+                if head != 0 {
+                    libc::munmap(base, head);
+                }
+                if tail != 0 {
+                    libc::munmap((address + BYTES) as *mut libc::c_void, tail);
+                }
+            }
+            let Some(at) = NonNull::new(address as *mut u8) else {
+                // SAFETY: the retained reservation, even at address zero, is ours.
+                unsafe { libc::munmap(address as *mut libc::c_void, BYTES) };
+                return Err(io::Error::other("null aligned mapping"));
+            };
+            for (logical, physical) in order.into_iter().enumerate() {
+                // SAFETY: each mapping replaces a complete page of our retained reservation.
+                let mapped = unsafe {
+                    libc::mmap(
+                        at.as_ptr().wrapping_add(logical * PAGE).cast(),
+                        PAGE,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_FIXED | libc::MAP_SHARED,
+                        file.as_raw_fd(),
+                        (physical * PAGE) as libc::off_t,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    let error = io::Error::last_os_error();
+                    // SAFETY: release our complete range, including pages already mapped.
+                    unsafe { libc::munmap(at.as_ptr().cast(), BYTES) };
+                    return Err(error);
+                }
+            }
+            Ok(Self { at, order })
+        }
+        fn at_file(&self, logical: usize) -> usize {
+            self.order[logical / PAGE] * PAGE + logical % PAGE
+        }
+        fn leases(&self, file: &File) -> io::Result<Vec<GuestRamFile>> {
+            let fd = Arc::new(file.try_clone()?.into());
+            Ok(self
+                .order
+                .into_iter()
+                .enumerate()
+                .map(|(logical, physical)| GuestRamFile {
+                    host: self.at.as_ptr().wrapping_add(logical * PAGE) as u64,
+                    length: PAGE as u64,
+                    offset: (physical * PAGE) as u64,
+                    fd: Arc::clone(&fd),
+                })
+                .collect())
+        }
+        fn ranges(&self) -> Obj<AddressRanges> {
+            Obj::new(AddressRanges {
+                ranges: (0..3)
+                    .map(|i| ResourceAddressRange {
+                        address: self.at.as_ptr().wrapping_add(i * PAGE) as u64,
+                        length: PAGE as u64,
+                    })
+                    .collect(),
+            })
+        }
+    }
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: this final owner releases exactly the retained aligned mapping.
+            unsafe { libc::munmap(self.at.as_ptr().cast(), BYTES) };
+        }
+    }
+    fn file(fill: u8) -> io::Result<(File, Vec<u8>)> {
+        // SAFETY: valid name/flags; the returned descriptor is uniquely owned.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"reims-cpu-shadow-dynamic-rebind".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: the new memfd descriptor has one owner.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        file.set_len(FILE_BYTES as u64)?;
+        // SAFETY: size seals preserve each lease without making RAM unwritable.
+        if unsafe {
+            libc::fcntl(
+                file.as_raw_fd(),
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        let bytes: Vec<u8> = (0..FILE_BYTES)
+            .map(|i| fill.wrapping_add((i * 13 + i / 71) as u8))
+            .collect();
+        file.write_all_at(&bytes, 0)?;
+        Ok((file, bytes))
+    }
+    fn exact(actual: &[u8], expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        if actual != expected {
+            let at = actual
+                .iter()
+                .zip(expected)
+                .position(|(a, b)| a != b)
+                .unwrap_or(actual.len().min(expected.len()));
+            return Err(format!(
+                "{case}: mismatch at byte{at}: {:?} / {:?}",
+                actual.get(at),
+                expected.get(at)
+            )
+            .into());
+        }
+        println!(
+            "CPU_SHADOW_DYNAMIC_REBIND_PASS case={case} exact_bytes={}",
+            expected.len()
+        );
+        Ok(())
+    }
+    fn check_file(file: &File, expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        let mut actual = vec![0; FILE_BYTES];
+        file.read_exact_at(&mut actual, 0)?;
+        exact(&actual, expected, case)
+    }
+    fn shared_bytes(buffer: &rt::Buffer, length: usize) -> Result<Vec<u8>, Box<dyn Error>> {
+        let at = buffer.contents().ok_or("owned readback not mapped")?;
+        // SAFETY: own Shared buffer length checked by construction, read after GPU completion.
+        Ok(unsafe { std::slice::from_raw_parts(at.as_ptr(), length) }.to_vec())
+    }
+    fn paint(model: &mut [u8], mapping: &Mapping, logical: usize, bytes: &[u8]) {
+        for (at, value) in bytes.iter().enumerate() {
+            model[mapping.at_file(logical + at)] = *value;
+        }
+    }
+
+    fn replacement_memory(
+        mapping: &Arc<Mapping>,
+        file: &File,
+        calls: &Arc<AtomicUsize>,
+    ) -> io::Result<rt::HostMemory> {
+        let held = Arc::clone(mapping);
+        let file = file.try_clone()?;
+        let calls = Arc::clone(calls);
+        let source: rt::CpuShadowSource = Arc::new(move |request| {
+            calls.fetch_add(1, Ordering::SeqCst);
+            if request.start != held.at || request.length != BYTES as u64 {
+                return Err(io::Error::other("unexpected replacement source range"));
+            }
+            held.order
+                .iter()
+                .map(|&page| {
+                    Ok(rt::CpuShadowChunk {
+                        fd: file.try_clone()?.into(),
+                        offset: (page * PAGE) as u64,
+                        length: PAGE as u64,
+                    })
+                })
+                .collect()
+        });
+        // SAFETY: the source retains the complete mapping and ordinary size-sealed file, with
+        // offsets matching its pointer's page bias. No replacement races encoding or commit.
+        Ok(unsafe { rt::HostMemory::with_cpu_shadow(mapping.at, source) })
+    }
+
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        let air = arguments
+            .next()
+            .ok_or("dynamic-rebind requires authored AIR path")?;
+        if arguments.next().is_some() {
+            return Err("unexpected dynamic-rebind argument".into());
+        }
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("REIMS_VGPU_CPU_SHADOW=1 required".into());
+        }
+        let air = std::fs::read(air)?;
+        for case in [Case::Resident, Case::Named, Case::IndirectInput] {
+            run_case(&air, case)?;
+        }
+        println!(
+            "CPU_SHADOW_DYNAMIC_REBIND_COMPLETE residency_only=true named_control=true indirect_refusal=true"
+        );
+        Ok(())
+    }
+
+    fn run_case(air: &[u8], case: Case) -> Result<(), Box<dyn Error>> {
+        eprintln!("CPU_SHADOW_DYNAMIC_REBIND_CASE case={}", case.name());
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let (old_file, mut old_expected) = file(0x27)?;
+        let (new_file, mut new_expected) = file(0x96)?;
+        let old = Arc::new(Mapping::new(&old_file, [0, 1, 2])?);
+        let new = Arc::new(Mapping::new(&new_file, [2, 0, 3])?);
+        let mut leases = old.leases(&old_file)?;
+        leases.extend(new.leases(&new_file)?);
+        let _lease = lease_guest_memory(leases);
+        let old_words = [0x55556666u32, 0x77778888, 901, 0x9999aaaa];
+        let new_words = [0x11112222u32, 0x33334444, 37, 0xbbbbcccc];
+        let old_bytes: Vec<u8> = old_words.into_iter().flat_map(u32::to_le_bytes).collect();
+        let new_bytes: Vec<u8> = new_words.into_iter().flat_map(u32::to_le_bytes).collect();
+        paint(&mut old_expected, &old, PAGE - 8, &old_bytes);
+        paint(&mut new_expected, &new, PAGE - 8, &new_bytes);
+        old_file.write_all_at(&old_expected, 0)?;
+        new_file.write_all_at(&new_expected, 0)?;
+        let hold = Arc::clone(&old);
+        // SAFETY: the deallocator retains the complete original mapped range while needed.
+        let contents = unsafe { HostRange::new(HostPtr::from_ptr(old.at.as_ptr()), BYTES as u64) };
+        let target = device
+            .new_buffer(BufferDesc {
+                length: BYTES as u64,
+                options: vec![OptionSet::StorageMode(0)],
+                pinned_gpu_address: None,
+                contents: Some(contents),
+                no_copy: true,
+                deallocator: Some(Box::new(move |_, _| drop(hold))),
+            })
+            .map_err(|e| format!("dynamic target creation: {e:?}"))?
+            .ok_or("no dynamic target")?;
+        let identity = (target.raw.object_id(), target.raw.gpu_address());
+        let address = target.raw.gpu_address().0 + (PAGE - 8) as u64;
+        // The resident-only case binds this separate owned metadata buffer as its input. The
+        // shadow target appears solely in use_resource and cannot acquire a statically bound root.
+        let metadata = device
+            .raw
+            .new_buffer_with_bytes(&address.to_le_bytes(), rt::ResourceOptions::shared())?;
+        let output = device
+            .raw
+            .new_buffer_with_bytes(&[0xe5; 32], rt::ResourceOptions::shared())?;
+        let library = device
+            .raw
+            .new_library_with_compile_library(metal2vulkan::library::Library::from_air(air)?);
+        let function = library.new_function_with_name(match case {
+            Case::Resident => "cpu_shadow_dynamic_rebind",
+            Case::Named | Case::IndirectInput => "cpu_shadow_named_rebind",
+        })?;
+        let pipeline = device
+            .raw
+            .new_compute_pipeline_state_with_function(&function, &rt::PipelineOptions::default())?;
+        let queue = device.raw.new_command_queue()?;
+        let event = device.raw.new_shared_event()?;
+        let command = queue.command_buffer()?;
+        command.encode_wait_for_event((&event).into(), 1)?;
+        let mut compute = command.compute_command_encoder()?;
+        compute.set_compute_pipeline_state(&pipeline)?;
+        match case {
+            Case::Resident => compute.set_buffer(Some(&metadata), 0, 0)?,
+            Case::Named | Case::IndirectInput => {
+                compute.set_buffer(Some(&target.raw), (PAGE - 8) as u64, 0)?;
+                compute.set_stage_in_region(rt::Region::new_3d(0, 0, 0, 1, 1, 1))?;
+            }
+        }
+        compute.set_buffer(Some(&output), 0, 1)?;
+        compute.use_resource(
+            rt::ResourceRef::Buffer(&target.raw),
+            ResourceUsage::READ | ResourceUsage::WRITE,
+        )?;
+        compute.dispatch_threads(rt::Size::new(1, 1, 1), rt::Size::new(1, 1, 1))?;
+        if case == Case::IndirectInput {
+            // This is an actual deferred input read, not delayed pipeline creation. The second
+            // dispatch reads grid_origin.x=5 from these copied bytes after the first work finishes.
+            let words: Vec<u8> = [5u32, 0, 0, 1, 1, 1]
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect();
+            let region = device
+                .raw
+                .new_buffer_with_bytes(&words, rt::ResourceOptions::shared())?;
+            compute.set_stage_in_region_indirect(&region, 0)?;
+            compute.dispatch_threads(rt::Size::new(1, 1, 1), rt::Size::new(1, 1, 1))?;
+        }
+        compute.end_encoding()?;
+        let before = device.raw.cpu_shadow_counts();
+        command.commit()?;
+        assert_eq!(
+            device.raw.cpu_shadow_counts().epochs_prepared,
+            before.epochs_prepared,
+            "the wait event did not block first submission"
+        );
+        if case == Case::IndirectInput {
+            let calls = Arc::new(AtomicUsize::new(0));
+            let memory = replacement_memory(&new, &new_file, &calls)?;
+            // Use the runtime's typed refusal here: the public reims API deliberately aborts
+            // for an invalid replacement. The two positive cases use the public API below.
+            // SAFETY: the prepared source retains valid ordinary pages; no encode/commit races it.
+            let refusal = unsafe { target.raw.rebind_bytes_no_copy(memory, None, None) };
+            let exact_refusal = matches!(refusal,
+                Err(rt::Error::Invalid(ref invalid))
+                    if invalid.problem == rt::Problem::Rebind(rt::RebindProblem::EncodedUses));
+            if !exact_refusal || calls.load(Ordering::SeqCst) != 0 {
+                // Unblock the committed command even on a regression, so teardown cannot wait
+                // forever on this fixture's event while reporting the failed assertion.
+                event.set_signaled_value(1);
+                let _ = command.wait_until_completed_for(WAIT);
+                return Err(format!(
+                    "indirect input did not retain exact EncodedUses refusal: {refusal:?}, source_calls={}",
+                    calls.load(Ordering::SeqCst)
+                ).into());
+            }
+            println!("CPU_SHADOW_DYNAMIC_REBIND_PASS case=indirect_input_refusal source_calls=0");
+        } else {
+            eprintln!("CPU_SHADOW_DYNAMIC_REBIND_STAGE step=committed_then_detach");
+            target
+                .detach_backing()
+                .map_err(|e| format!("dynamic detach: {e:?}"))?;
+            eprintln!("CPU_SHADOW_DYNAMIC_REBIND_STAGE step=replace_fragmented");
+            if !target
+                .replace_backing(&new.ranges(), false)
+                .map_err(|e| format!("dynamic replacement: {e:?}"))?
+            {
+                return Err("dynamic replacement returned false".into());
+            }
+        }
+        assert_eq!((target.raw.object_id(), target.raw.gpu_address()), identity);
+        check_file(&old_file, &old_expected, "old_before_submission")?;
+        check_file(&new_file, &new_expected, "new_before_submission")?;
+        assert_eq!(
+            device.raw.cpu_shadow_counts().epochs_prepared,
+            before.epochs_prepared,
+            "replacement submitted through the closed event"
+        );
+        eprintln!("CPU_SHADOW_DYNAMIC_REBIND_STAGE step=allow_first_submission");
+        event.set_signaled_value(1);
+        command
+            .wait_until_completed_for(WAIT)
+            .map_err(|_| "dynamic rebind command timed out")?;
+        if command.status() != rt::CommandBufferStatus::Completed {
+            return Err(format!(
+                "dynamic rebind command failed: {:?} / {:?}",
+                command.error(),
+                command.refusal()
+            )
+            .into());
+        }
+        let mut expected_output = vec![0xe5; 32];
+        let (counter, final_counter) = match case {
+            Case::IndirectInput => {
+                // The first named dispatch added 17 to the old counter. The indirect second
+                // dispatch reads that result, adds 17 again, and reports the input region's x.
+                expected_output[..16].copy_from_slice(&old_bytes);
+                expected_output[8..12].copy_from_slice(&918u32.to_le_bytes());
+                expected_output[24..28].copy_from_slice(&5u32.to_le_bytes());
+                (918u32, 935u32)
+            }
+            Case::Resident | Case::Named => {
+                expected_output[..16].copy_from_slice(&new_bytes);
+                if case == Case::Named {
+                    expected_output[24..28].copy_from_slice(&0u32.to_le_bytes());
+                }
+                (37u32, 54u32)
+            }
+        };
+        expected_output[16..20].copy_from_slice(&counter.to_le_bytes());
+        expected_output[20..24].copy_from_slice(&final_counter.to_le_bytes());
+        exact(&shared_bytes(&output, 32)?, &expected_output, case.name())?;
+        let stored: Vec<u8> = [0x01234567u32, 0x23456789, 0x456789ab, 0x6789abcd]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect();
+        match case {
+            Case::IndirectInput => {
+                paint(&mut old_expected, &old, PAGE, &final_counter.to_le_bytes());
+                paint(&mut old_expected, &old, 2 * PAGE - 8, &stored);
+            }
+            Case::Resident | Case::Named => {
+                paint(&mut new_expected, &new, PAGE, &final_counter.to_le_bytes());
+                paint(&mut new_expected, &new, 2 * PAGE - 8, &stored);
+            }
+        }
+        check_file(&old_file, &old_expected, "old_whole_file")?;
+        check_file(&new_file, &new_expected, "new_whole_file")?;
+        let counts = device.raw.cpu_shadow_counts();
+        assert!(counts.epochs_prepared > before.epochs_prepared);
+        assert_eq!(counts.epochs_prepared, counts.epochs_finished);
+        assert!(counts.bytes_scattered > before.bytes_scattered);
+        println!(
+            "CPU_SHADOW_DYNAMIC_REBIND_CASE_COMPLETE case={} {counts:?}",
+            case.name()
+        );
+        Ok(())
+    }
+}
+
+/// Run directly or as the combined qualifier's `dynamic-rebind` subcommand.
+pub fn run(arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        supported::run(arguments)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    {
+        let _ = arguments;
+        Err("CPU-shadow qualification requires Linux or Android".into())
+    }
+}
+
+#[allow(dead_code)] // included as a module by the combined qualification executable
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    run(std::env::args().skip(1))
+}
diff --git a/crates/reims-vgpu-vulkan/examples/cpu_shadow_dynamic_rebind/kernel.ll b/crates/reims-vgpu-vulkan/examples/cpu_shadow_dynamic_rebind/kernel.ll
new file mode 100644
