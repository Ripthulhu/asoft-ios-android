diff --git a/crates/reims-vgpu-c/src/cpu_shadow.rs b/crates/reims-vgpu-c/src/cpu_shadow.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ae6e7a65e557f8533181daae03f5e813f57b1a06
--- /dev/null
+++ b/crates/reims-vgpu-c/src/cpu_shadow.rs
@@ -0,0 +1,108 @@
+//! Additive diagnostics for the ordinary-RAM CPU-shadow Vulkan backend.
+
+use crate::device::RvgDevice;
+use crate::status::RVG_ERR_INVALID_ARGUMENT;
+use crate::{RvgStatus, ffi, handle};
+
+/// Actual CPU-shadow work on the runtime device, cumulative from its creation. Several
+/// guest devices may share it. A nonzero environment option alone increments none of these.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RvgCpuShadowCounts {
+    /// Size written by this library. Fields beyond it are unknown to this version.
+    pub struct_size: u32,
+    /// Always zero.
+    pub reserved: u32,
+    /// Canonical Vulkan backing chunks actually created for ordinary file ranges.
+    pub chunks_created: u64,
+    /// Logical CPU-shadow views successfully created over those chunks.
+    pub views_created: u64,
+    /// GPU batches whose ordinary CPU bytes were snapshotted and uploaded.
+    pub epochs_prepared: u64,
+    /// Completed GPU batches whose changed bytes were scattered to ordinary CPU RAM.
+    pub epochs_finished: u64,
+    /// Bytes copied from ordinary CPU RAM into Vulkan-owned memory.
+    pub bytes_uploaded: u64,
+    /// Changed bytes copied from completed Vulkan work into ordinary CPU RAM.
+    pub bytes_scattered: u64,
+}
+
+/// Reads actual CPU-shadow counters from the runtime used by this guest device. This call
+/// neither selects the backend nor waits for work: the snapshot is diagnostic, not a memory
+/// or completion barrier. A frame or event's normal completion must be established first
+/// when checking a submission's effects. Unsupported outside Vulkan on Linux/Android.
+/// Writes only on RVG_OK, and only this library's sizeof(RvgCpuShadowCounts) bytes.
+///
+/// # Safety
+/// `device` is NULL or a live device handle; `out` is NULL or writable for `out_bytes` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_device_cpu_shadow_counts(
+    device: *const RvgDevice,
+    out: *mut RvgCpuShadowCounts,
+    out_bytes: usize,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: the caller's handle contract.
+        let Some(device) = (unsafe { handle::get(device) }) else {
+            return RVG_ERR_INVALID_ARGUMENT;
+        };
+        if out.is_null() || out_bytes < size_of::<RvgCpuShadowCounts>() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(
+            not(test),
+            feature = "vulkan",
+            any(target_os = "linux", target_os = "android")
+        ))]
+        {
+            let counts = device.device.cpu_shadow_counts();
+            // SAFETY: the caller gives writable output and its size was checked above.
+            unsafe {
+                out.write(RvgCpuShadowCounts {
+                    struct_size: crate::sized::size_u32::<RvgCpuShadowCounts>(),
+                    reserved: 0,
+                    chunks_created: counts.chunks_created,
+                    views_created: counts.views_created,
+                    epochs_prepared: counts.epochs_prepared,
+                    epochs_finished: counts.epochs_finished,
+                    bytes_uploaded: counts.bytes_uploaded,
+                    bytes_scattered: counts.bytes_scattered,
+                });
+            }
+            crate::status::RVG_OK
+        }
+        #[cfg(not(all(
+            not(test),
+            feature = "vulkan",
+            any(target_os = "linux", target_os = "android")
+        )))]
+        {
+            let _ = device;
+            crate::status::RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cpu_shadow_query_refuses_null_handles_without_writing() {
+        let mut out = RvgCpuShadowCounts {
+            bytes_uploaded: 37,
+            ..Default::default()
+        };
+        let before = out;
+        // SAFETY: NULL is accepted and the output is writable.
+        let status = unsafe {
+            rvg_device_cpu_shadow_counts(
+                std::ptr::null(),
+                &mut out,
+                size_of::<RvgCpuShadowCounts>(),
+            )
+        };
+        assert_eq!(status, RVG_ERR_INVALID_ARGUMENT);
+        assert_eq!(out, before);
+    }
+}
diff --git a/crates/reims-vgpu-c/src/cpu_shadow_probe.rs b/crates/reims-vgpu-c/src/cpu_shadow_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6327b1560102328f80e811ff01bfae0525ce9844
--- /dev/null
+++ b/crates/reims-vgpu-c/src/cpu_shadow_probe.rs
@@ -0,0 +1,169 @@
+//! Opt-in installed-runtime diagnostics. A caller runs this in a disposable, bounded process.
+
+use crate::status::RVG_ERR_INVALID_ARGUMENT;
+use crate::{RvgStatus, ffi};
+
+/// The installed-runtime probe contract implemented by this entry point.
+pub const RVG_CPU_SHADOW_PROBE_REVISION: u32 = 1;
+/// Every v1 check: device/import, alias atomics, CPU delta, event publication, exact RAM,
+/// fragmented blit and completed GPU readback. A partial mask is never a pass.
+pub const RVG_CPU_SHADOW_PROBE_CHECKS: u64 = 0x7f;
+
+/// Actual identity and completed work of a successful installed-runtime CPU-shadow probe.
+/// This is diagnostic evidence for the tested operations, not a guest compatibility claim.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RvgCpuShadowProbeResult {
+    /// Size written by this library.
+    pub struct_size: u32,
+    /// RVG_CPU_SHADOW_PROBE_REVISION.
+    pub revision: u32,
+    /// RVG_CPU_SHADOW_PROBE_CHECKS, only after every exact comparison succeeds.
+    pub checks_passed: u64,
+    /// Actual VkPhysicalDeviceProperties identity of the runtime's selected device.
+    pub vendor_id: u32,
+    /// The selected physical device's device identifier.
+    pub device_id: u32,
+    /// The physical device's packed Vulkan API version.
+    pub api_version: u32,
+    /// The physical device's driver-defined version value.
+    pub driver_version: u32,
+    /// VkPhysicalDeviceType. A host must not mistake a software device for its phone GPU.
+    pub device_type: u32,
+    /// Always zero.
+    pub reserved: u32,
+    /// VkPhysicalDeviceIDProperties values from the same physical device.
+    pub device_uuid: [u8; 16],
+    /// The driver UUID from that same physical device.
+    pub driver_uuid: [u8; 16],
+    /// Actual runtime counters after the probe's completed commands.
+    pub chunks_created: u64,
+    /// Logical no-copy views actually created over ordinary-file canonical chunks.
+    pub views_created: u64,
+    /// GPU batches whose CPU snapshots were uploaded.
+    pub epochs_prepared: u64,
+    /// Completed GPU batches whose delta scatter finished.
+    pub epochs_finished: u64,
+    /// Ordinary-file bytes copied into Vulkan-owned storage.
+    pub bytes_uploaded: u64,
+    /// GPU-changed bytes copied back into the ordinary file.
+    pub bytes_scattered: u64,
+    /// Bytes whose actual contents were compared with their independently computed values.
+    pub bytes_compared: u64,
+}
+
+/// Exercises the selected Vulkan CPU-shadow implementation through real reims no-copy imports,
+/// GPU alias atomics, a shared event, delta scatter and fragmented buffer blits. Requires the
+/// `cpu-shadow-probe` build feature and REIMS_VGPU_CPU_SHADOW=1 before any platform use.
+/// The caller must use a fresh disposable process, with no other guest or GPU work, and enforce
+/// an external process deadline: driver creation and shader compilation cannot be cancelled.
+/// `timeout_ms` (100..30000) bounds the GPU event/completion waits. No fallback mode is selected.
+/// A pass writes this library's sizeof(RvgCpuShadowProbeResult) bytes and returns RVG_OK.
+/// Every other result leaves `out` unchanged; failure details go to stderr. This call does not
+/// attest a source build, choose a driver, run native guest CPU code or establish an iOS boot.
+///
+/// # Safety
+/// `out` is NULL or suitably aligned writable memory of at least `out_bytes` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_cpu_shadow_probe_v1(
+    timeout_ms: u32,
+    out: *mut RvgCpuShadowProbeResult,
+    out_bytes: usize,
+) -> RvgStatus {
+    ffi::export(|| {
+        if out.is_null()
+            || out_bytes < size_of::<RvgCpuShadowProbeResult>()
+            || !(100..=30_000).contains(&timeout_ms)
+        {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(all(
+            not(test),
+            feature = "vulkan",
+            feature = "cpu-shadow-probe",
+            any(target_os = "linux", target_os = "android")
+        ))]
+        {
+            let report = match reims_vgpu::cpu_shadow_probe::run(std::time::Duration::from_millis(
+                u64::from(timeout_ms),
+            )) {
+                Ok(report) => report,
+                Err(error) => {
+                    eprintln!("reims-vgpu: CPU-shadow installed-runtime probe: {error}");
+                    return crate::status::RVG_ERR_GPU;
+                }
+            };
+            let result = RvgCpuShadowProbeResult {
+                struct_size: crate::sized::size_u32::<RvgCpuShadowProbeResult>(),
+                revision: RVG_CPU_SHADOW_PROBE_REVISION,
+                checks_passed: report.checks_passed,
+                vendor_id: report.vendor_id,
+                device_id: report.device_id,
+                api_version: report.api_version,
+                driver_version: report.driver_version,
+                device_type: report.device_type,
+                reserved: 0,
+                device_uuid: report.device_uuid,
+                driver_uuid: report.driver_uuid,
+                chunks_created: report.counts.chunks_created,
+                views_created: report.counts.views_created,
+                epochs_prepared: report.counts.epochs_prepared,
+                epochs_finished: report.counts.epochs_finished,
+                bytes_uploaded: report.counts.bytes_uploaded,
+                bytes_scattered: report.counts.bytes_scattered,
+                bytes_compared: report.bytes_compared,
+            };
+            // SAFETY: caller's writable/alignment contract; size and NULL checked above.
+            unsafe { out.write(result) };
+            crate::status::RVG_OK
+        }
+        #[cfg(not(all(
+            not(test),
+            feature = "vulkan",
+            feature = "cpu-shadow-probe",
+            any(target_os = "linux", target_os = "android")
+        )))]
+        {
+            crate::status::RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn refuses_invalid_output_and_wait_without_writing() {
+        let mut result = RvgCpuShadowProbeResult {
+            bytes_scattered: 37,
+            ..Default::default()
+        };
+        let before = result;
+        for (timeout, bytes) in [
+            (99, size_of::<RvgCpuShadowProbeResult>()),
+            (30_001, size_of::<RvgCpuShadowProbeResult>()),
+            (1_000, size_of::<RvgCpuShadowProbeResult>() - 1),
+        ] {
+            // SAFETY: the complete result exists; the intentionally short size is refused.
+            let status = unsafe { rvg_cpu_shadow_probe_v1(timeout, &mut result, bytes) };
+            assert_eq!(status, RVG_ERR_INVALID_ARGUMENT);
+            assert_eq!(result, before);
+        }
+        // SAFETY: NULL is explicitly accepted and refused without dereference.
+        let status =
+            unsafe { rvg_cpu_shadow_probe_v1(1_000, std::ptr::null_mut(), size_of_val(&result)) };
+        assert_eq!(status, RVG_ERR_INVALID_ARGUMENT);
+    }
+
+    #[test]
+    fn fake_platform_cannot_claim_a_real_gpu_pass() {
+        let mut result = RvgCpuShadowProbeResult::default();
+        // SAFETY: a valid result and size. Tests use the fake platform, which must refuse.
+        let status = unsafe {
+            rvg_cpu_shadow_probe_v1(1_000, &mut result, size_of::<RvgCpuShadowProbeResult>())
+        };
+        assert_eq!(status, crate::status::RVG_ERR_UNSUPPORTED);
+        assert_eq!(result, RvgCpuShadowProbeResult::default());
+    }
+}
