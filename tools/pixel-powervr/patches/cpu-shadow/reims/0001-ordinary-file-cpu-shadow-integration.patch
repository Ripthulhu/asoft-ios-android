+; Repository-authored indexed-render test; no Apple compiler output or binary.
+source_filename = "cpu_shadow_fixed"
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define <{ <4 x float> }> @fixed_vertex(i32 %vid) {
+entry:
+  %one = icmp eq i32 %vid, 1
+  %three = icmp eq i32 %vid, 3
+  %four = icmp eq i32 %vid, 4
+  %a = or i1 %one, %three
+  %right = or i1 %a, %four
+  %upper = icmp ult i32 %vid, 2
+  %top = or i1 %upper, %three
+  %x = select i1 %right, float 1.0, float -1.0
+  %y = select i1 %top, float 1.0, float -1.0
+  %xy = insertelement <4 x float> <float 0.0, float 0.0, float 0.0, float 1.0>, float %x, i32 0
+  %xyzw = insertelement <4 x float> %xy, float %y, i32 1
+  %out = insertvalue <{ <4 x float> }> undef, <4 x float> %xyzw, 0
+  ret <{ <4 x float> }> %out
+}
+define <4 x float> @fixed_red() {
+  ret <4 x float> <float 1.0, float 0.0, float 0.0, float 1.0>
+}
+define <4 x float> @fixed_blue() {
+  ret <4 x float> <float 0.0, float 0.0, float 1.0, float 1.0>
+}
+define <4 x float> @fixed_write(<4 x float> %position, ptr addrspace(1) %indices) {
+entry:
+  %x = extractelement <4 x float> %position, i32 0
+  %y = extractelement <4 x float> %position, i32 1
+  %left = fcmp olt float %x, 1.0
+  %top = fcmp olt float %y, 1.0
+  %first = and i1 %left, %top
+  br i1 %first, label %write, label %done
+write:
+  store i32 0, ptr addrspace(1) %indices, align 4
+  %one = getelementptr i32, ptr addrspace(1) %indices, i64 1
+  store i32 0, ptr addrspace(1) %one, align 4
+  %two = getelementptr i32, ptr addrspace(1) %indices, i64 2
+  store i32 0, ptr addrspace(1) %two, align 4
+  br label %done
+done:
+  ret <4 x float> <float 1.0, float 0.0, float 0.0, float 1.0>
+}
+
+!air.vertex = !{!0}
+!air.fragment = !{!5, !8, !9}
+!air.version = !{!14}
+!air.language_version = !{!15}
+!llvm.module.flags = !{!16, !17, !18, !19, !20, !21}
+!0 = !{ptr @fixed_vertex, !1, !3}
