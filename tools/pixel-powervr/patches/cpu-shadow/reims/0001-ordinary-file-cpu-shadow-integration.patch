+; Repository-authored diagnostic AIR. No Apple input or compiler is required.
+; The two handles live on opposite sides of a reordered ordinary-file page boundary.
+; They are loaded at execution time; neither texture nor sampler is a bound argument.
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define void @cpu_shadow_arguments(ptr addrspace(2) %arguments, ptr addrspace(1) %output) {
+  %sampler_slot = getelementptr i8, ptr addrspace(2) %arguments, i64 8
+  %texture = load ptr addrspace(1), ptr addrspace(2) %arguments, align 8
+  %sampler = load ptr addrspace(2), ptr addrspace(2) %sampler_slot, align 8
+  ; Nearest repeat picks x=2; clamp-to-edge picks x=7 of an 8-wide texture.
+  %sample = call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %texture, ptr addrspace(2) %sampler, <2 x float> <float 1.250000e+00, float 5.000000e-01>, i1 true, <2 x i32> zeroinitializer, i1 true, float 0.000000e+00, float 0.000000e+00, i32 0)
+  %color = extractvalue { <4 x float>, i8 } %sample, 0
+  store <4 x float> %color, ptr addrspace(1) %output, align 16
+  ret void
+}
+
+declare { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+
+!air.kernel = !{!0}
+!air.version = !{!8}
+!air.language_version = !{!9}
+!llvm.module.flags = !{!10, !11, !12, !13, !14, !15}
+!0 = !{ptr @cpu_shadow_arguments, !1, !2}
+!1 = !{}
+!2 = !{!3, !7}
+!3 = !{i32 0, !"air.indirect_buffer", !"air.buffer_size", i32 16, !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 2, !"air.struct_type_info", !4, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"ShadowSampled", !"air.arg_name", !"arguments"}
+!4 = !{i32 0, i32 8, i32 0, !"texture2d<float, sample>", !"texture", !"air.indirect_argument", !5, i32 8, i32 8, i32 0, !"sampler", !"sampler", !"air.indirect_argument", !6}
+!5 = !{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>", !"air.arg_name", !"texture"}
+!6 = !{i32 1, !"air.sampler", !"air.location_index", i32 1, i32 1, !"air.arg_type_name", !"sampler", !"air.arg_name", !"sampler"}
+!7 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4", !"air.arg_name", !"output"}
+!8 = !{i32 2, i32 8, i32 0}
+!9 = !{!"Metal", i32 4, i32 0, i32 0}
+!10 = !{i32 7, !"air.max_device_buffers", i32 31}
