diff --git a/crates/reims-vgpu-vulkan/examples/cpu_shadow_heap.rs b/crates/reims-vgpu-vulkan/examples/cpu_shadow_heap.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ac994aa8fdc6f7e772b88c3d7667af8d9dd87d05
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_heap.rs
@@ -0,0 +1,505 @@
+//! Actual shared placement heaps over ordinary RAM, including placed textures and replacement.
+//! The capability flags stay disabled until this and the lifecycle checks are qualified.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::platform::resource::Heap as _;
+    use reims_vgpu_core::platform::types::ResourceAddressRange;
+    use reims_vgpu_core::platform::values::{HeapDesc, OptionSet, TextureDesc};
+    use reims_vgpu_vulkan::gpu::desc::{TextureDescriptorObject, TextureFields};
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+    use reims_vgpu_vulkan::platform::AddressRanges;
+    use reims_vgpu_vulkan::{Obj, VulkanPlatform};
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::Arc;
+    use std::time::Duration;
+    const PAGE: usize = 16 * 1024;
+    const BYTES: usize = 3 * PAGE;
+    const FILE_BYTES: usize = 4 * PAGE;
+    const WAIT: Duration = Duration::from_secs(15);
+    struct Mapping {
+        at: NonNull<u8>,
+        order: [usize; 3],
+    }
+    // SAFETY: only ownership/address tokens cross threads, with no mutable Rust reference.
+    unsafe impl Send for Mapping {}
+    // SAFETY: ordinary-file I/O is the only CPU access; the mapping is retained while used.
+    unsafe impl Sync for Mapping {}
+    impl Mapping {
+        fn new(file: &File, order: [usize; 3]) -> io::Result<Self> {
+            let reserve = BYTES + PAGE;
+            // SAFETY: reserve enough inaccessible address space to align a retained subrange.
+            let base = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    reserve,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if base == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let address = (base as usize + PAGE - 1) & !(PAGE - 1);
+            let head = address - base as usize;
+            let tail = reserve - head - BYTES;
+            // SAFETY: discard only complete host pages outside the selected owned subrange.
+            unsafe {
+                if head != 0 {
+                    libc::munmap(base, head);
+                }
+                if tail != 0 {
+                    libc::munmap((address + BYTES) as *mut libc::c_void, tail);
+                }
+            }
+            let Some(at) = NonNull::new(address as *mut u8) else {
+                // SAFETY: the retained reservation, even at address zero, is ours.
+                unsafe { libc::munmap(address as *mut libc::c_void, BYTES) };
+                return Err(io::Error::other("null aligned mapping"));
+            };
+            for (logical, physical) in order.into_iter().enumerate() {
+                // SAFETY: each mapping replaces a complete page of our retained reservation.
+                let mapped = unsafe {
+                    libc::mmap(
+                        at.as_ptr().wrapping_add(logical * PAGE).cast(),
+                        PAGE,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_FIXED | libc::MAP_SHARED,
+                        file.as_raw_fd(),
+                        (physical * PAGE) as libc::off_t,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    let error = io::Error::last_os_error();
+                    // SAFETY: release our complete range, including pages already mapped.
+                    unsafe { libc::munmap(at.as_ptr().cast(), BYTES) };
+                    return Err(error);
+                }
+            }
+            Ok(Self { at, order })
+        }
+        fn at_file(&self, logical: usize) -> usize {
+            self.order[logical / PAGE] * PAGE + logical % PAGE
+        }
+        fn leases(&self, file: &File) -> io::Result<Vec<GuestRamFile>> {
+            let fd = Arc::new(file.try_clone()?.into());
+            Ok(self
+                .order
+                .into_iter()
+                .enumerate()
+                .map(|(logical, physical)| GuestRamFile {
+                    host: self.at.as_ptr().wrapping_add(logical * PAGE) as u64,
+                    length: PAGE as u64,
+                    offset: (physical * PAGE) as u64,
+                    fd: Arc::clone(&fd),
+                })
+                .collect())
+        }
+        fn ranges(&self) -> Obj<AddressRanges> {
+            Obj::new(AddressRanges {
+                ranges: (0..3)
+                    .map(|i| ResourceAddressRange {
+                        address: self.at.as_ptr().wrapping_add(i * PAGE) as u64,
+                        length: PAGE as u64,
+                    })
+                    .collect(),
+            })
+        }
+    }
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: this final owner releases exactly the retained aligned mapping.
+            unsafe { libc::munmap(self.at.as_ptr().cast(), BYTES) };
+        }
+    }
+    fn file(fill: u8) -> io::Result<(File, Vec<u8>)> {
+        // SAFETY: valid name/flags; the returned descriptor is uniquely owned.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"reims-cpu-shadow-heap".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: the new memfd descriptor has one owner.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        file.set_len(FILE_BYTES as u64)?;
+        // SAFETY: size seals preserve each lease without making RAM unwritable.
+        if unsafe {
+            libc::fcntl(
+                file.as_raw_fd(),
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        let bytes: Vec<u8> = (0..FILE_BYTES)
+            .map(|i| fill.wrapping_add((i * 13 + i / 71) as u8))
+            .collect();
+        file.write_all_at(&bytes, 0)?;
+        Ok((file, bytes))
+    }
+    fn exact(actual: &[u8], expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        if actual != expected {
+            let at = actual
+                .iter()
+                .zip(expected)
+                .position(|(a, b)| a != b)
+                .unwrap_or(actual.len().min(expected.len()));
+            return Err(format!(
+                "{case}: mismatch at byte{at}: {:?} / {:?}",
+                actual.get(at),
+                expected.get(at)
+            )
+            .into());
+        }
+        println!(
+            "CPU_SHADOW_HEAP_PASS case={case} exact_bytes={}",
+            expected.len()
+        );
+        Ok(())
+    }
+    fn check_file(file: &File, expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        let mut actual = vec![0; FILE_BYTES];
+        file.read_exact_at(&mut actual, 0)?;
+        exact(&actual, expected, case)
+    }
+    fn shared_bytes(buffer: &rt::Buffer, length: usize) -> Result<Vec<u8>, Box<dyn Error>> {
+        let at = buffer.contents().ok_or("owned readback not mapped")?;
+        // SAFETY: own Shared buffer length checked by construction, read after GPU completion.
+        Ok(unsafe { std::slice::from_raw_parts(at.as_ptr(), length) }.to_vec())
+    }
+
+    const WIDTH: u64 = 64;
+    const HEIGHT: u64 = 128;
+    const TEX_AT: usize = PAGE;
+    const TEX_BYTES: usize = 2 * PAGE;
+    const ROW: u64 = WIDTH * 4;
+    const PLACED_AT: usize = 256;
+
+    fn complete(command: &rt::CommandBuffer) -> Result<(), Box<dyn Error>> {
+        command.commit()?;
+        command
+            .wait_until_completed_for(WAIT)
+            .map_err(|_| "heap command timeout")?;
+        if command.status() != rt::CommandBufferStatus::Completed {
+            return Err(format!(
+                "heap GPU command: {:?} / {:?}",
+                command.error(),
+                command.refusal()
+            )
+            .into());
+        }
+        Ok(())
+    }
+
+    fn paint_model(expected: &mut [u8], mapping: &Mapping, pixel: [u8; 4]) -> Vec<u8> {
+        let pixels: Vec<u8> = (0..TEX_BYTES).map(|i| pixel[i % 4]).collect();
+        // Every texel is the same 4-byte value. Permuting texel positions in Metal's
+        // uncompressed 64x128 tile layout leaves exactly these same heap bytes; there is no
+        // metadata/padding for this explicitly uncompressed, shader-writable shape.
+        for (i, byte) in pixels.iter().copied().enumerate() {
+            expected[mapping.at_file(TEX_AT + i)] = byte;
+        }
+        pixels
+    }
+
+    fn exercise(
+        device: &rt::Device,
+        cover: &rt::Buffer,
+        placed: &rt::Buffer,
+        texture: &rt::Texture,
+        mapping: &Mapping,
+        file: &File,
+        expected: &mut [u8],
+        phase: usize,
+    ) -> Result<(), Box<dyn Error>> {
+        let queue = device.new_command_queue()?;
+        let readback = device.new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+        let pixels_out = device.new_buffer(TEX_BYTES as u64, rt::ResourceOptions::shared())?;
+        let pixel = [0x20 + phase as u8 * 19, 0x50, 0xa6, 0xff];
+        let pixels: Vec<u8> = (0..TEX_BYTES).map(|i| pixel[i % 4]).collect();
+        let upload = device.new_buffer_with_bytes(&pixels, rt::ResourceOptions::shared())?;
+        let command = queue.command_buffer()?;
+        let mut blit = command.blit_command_encoder()?;
+        blit.fill_buffer(
+            placed,
+            (PAGE - PLACED_AT - 5) as u64..(PAGE - PLACED_AT + 11) as u64,
+            0x7a,
+        )?;
+        for i in PAGE - 5..PAGE + 11 {
+            expected[mapping.at_file(i)] = 0x7a;
+        }
+        blit.copy_from_buffer_to_texture(
+            &upload,
+            0,
+            ROW,
+            TEX_BYTES as u64,
+            rt::Size::new(WIDTH, HEIGHT, 1),
+            texture,
+            0,
+            0,
+            rt::Origin::new(0, 0, 0),
+            rt::BlitOption::None,
+        )?;
+        paint_model(expected, mapping, pixel);
+        blit.copy_from_buffer_to_buffer(cover, 0, &readback, 0, BYTES as u64)?;
+        blit.copy_from_texture_to_buffer(
+            texture,
+            0,
+            0,
+            rt::Origin::new(0, 0, 0),
+            rt::Size::new(WIDTH, HEIGHT, 1),
+            &pixels_out,
+            0,
+            ROW,
+            TEX_BYTES as u64,
+            rt::BlitOption::None,
+        )?;
+        blit.end_encoding()?;
+        complete(&command)?;
+        let logical: Vec<u8> = (0..BYTES).map(|i| expected[mapping.at_file(i)]).collect();
+        exact(
+            &shared_bytes(&readback, BYTES)?,
+            &logical,
+            &format!("phase{phase}_placed_buffer_alias"),
+        )?;
+        exact(
+            &shared_bytes(&pixels_out, TEX_BYTES)?,
+            &pixels,
+            &format!("phase{phase}_placed_texture_gpu"),
+        )?;
+        check_file(file, expected, &format!("phase{phase}_whole_file_gpu"))?;
+        let region = rt::Region::new_2d(0, 0, WIDTH, HEIGHT);
+        let mut cpu_pixels = vec![0; TEX_BYTES];
+        texture.get_bytes(&mut cpu_pixels, ROW, TEX_BYTES as u64, region, 0, 0)?;
+        exact(
+            &cpu_pixels,
+            &pixels,
+            &format!("phase{phase}_placed_texture_cpu"),
+        )?;
+
+        let replacement = paint_model(
+            expected,
+            mapping,
+            [0xb4, 0x32 + phase as u8 * 17, 0x11, 0xff],
+        );
+        texture.replace_region(region, 0, 0, &replacement, ROW, TEX_BYTES as u64)?;
+        check_file(
+            file,
+            expected,
+            &format!("phase{phase}_whole_file_cpu_replace"),
+        )?;
+        let command = queue.command_buffer()?;
+        let mut blit = command.blit_command_encoder()?;
+        blit.copy_from_texture_to_buffer(
+            texture,
+            0,
+            0,
+            rt::Origin::new(0, 0, 0),
+            rt::Size::new(WIDTH, HEIGHT, 1),
+            &pixels_out,
+            0,
+            ROW,
+            TEX_BYTES as u64,
+            rt::BlitOption::None,
+        )?;
+        blit.copy_from_buffer_to_buffer(cover, 0, &readback, 0, BYTES as u64)?;
+        blit.end_encoding()?;
+        complete(&command)?;
+        exact(
+            &shared_bytes(&pixels_out, TEX_BYTES)?,
+            &replacement,
+            &format!("phase{phase}_cpu_replace_gpu_refresh"),
+        )?;
+        let logical: Vec<u8> = (0..BYTES).map(|i| expected[mapping.at_file(i)]).collect();
+        exact(
+            &shared_bytes(&readback, BYTES)?,
+            &logical,
+            &format!("phase{phase}_cpu_replace_buffer_alias"),
+        )?;
+        check_file(file, expected, &format!("phase{phase}_whole_file_final"))?;
+        Ok(())
+    }
+
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        if arguments.next().is_some() {
+            return Err("heap fixture takes no arguments".into());
+        }
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("REIMS_VGPU_CPU_SHADOW=1 required".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let (first_file, mut first_expected) = file(0x31)?;
+        let (later_file, mut later_expected) = file(0x86)?;
+        let first = Arc::new(Mapping::new(&first_file, [2, 0, 3])?);
+        let replacement = Arc::new(Mapping::new(&later_file, [1, 2, 3])?);
+        let mut leases = first.leases(&first_file)?;
+        leases.extend(replacement.leases(&later_file)?);
+        let _lease = lease_guest_memory(leases);
+        let ranges = first.ranges();
+        eprintln!("CPU_SHADOW_HEAP_STAGE step=create_shared_address_ranges");
+        let heap = device
+            .new_heap(&HeapDesc {
+                size: BYTES as u64,
+                heap_type: 1,
+                options: vec![OptionSet::StorageMode(0), OptionSet::HazardTrackingMode(0)],
+                address_ranges: Some(&ranges),
+                pinned_gpu_address: None,
+            })
+            .map_err(|e| format!("shared heap creation raised: {e:?}"))?
+            .heap
+            .ok_or("shared no-copy heap returned nil")?;
+        // Core's DetachHeapResource detaches its temporary pages before creating its cover.
+        // Exercise that exact creation order, before any command has reached the heap.
+        eprintln!("CPU_SHADOW_HEAP_STAGE step=initial_detach_before_cover");
+        heap.detach_backing()
+            .map_err(|e| format!("initial heap detach: {e:?}"))?;
+        // This distinct placed buffer reaches the cover's bytes at a nonzero offset, across
+        // a logical/physical page boundary. Both are created while the heap is detached.
+        let cover = heap
+            .new_buffer_of_length(BYTES as u64, 0, 0)
+            .map_err(|e| format!("heap cover raised: {e:?}"))?
+            .ok_or("no heap cover")?;
+        let placed = heap
+            .new_buffer_of_length((PAGE + 512) as u64, 0, PLACED_AT as u64)
+            .map_err(|e| format!("heap placed buffer raised: {e:?}"))?
+            .ok_or("no placed buffer")?;
+        let detached_identity = (
+            heap.gpu_address(),
+            cover.raw.object_id(),
+            cover.raw.gpu_address(),
+            placed.raw.object_id(),
+            placed.raw.gpu_address(),
+        );
+        eprintln!("CPU_SHADOW_HEAP_STAGE step=initial_replace_after_cover");
+        if !heap
+            .replace_backing(&ranges, false)
+            .map_err(|e| format!("initial heap replace: {e:?}"))?
+        {
+            return Err("initial heap replacement returned false".into());
+        }
+        assert_eq!(
+            (
+                heap.gpu_address(),
+                cover.raw.object_id(),
+                cover.raw.gpu_address(),
+                placed.raw.object_id(),
+                placed.raw.gpu_address(),
+            ),
+            detached_identity,
+            "initial attachment changed detached heap placements"
+        );
+        let descriptor = Obj::new(TextureDescriptorObject::new(TextureFields::of(
+            &TextureDesc {
+                width: WIDTH,
+                height: HEIGHT,
+                usage: 3,
+                resource_options: Some(heap.resource_options()),
+                allow_gpu_optimized_contents: Some(false),
+                ..TextureDesc::default()
+            },
+        )));
+        let size = device
+            .heap_texture_size_and_align(&descriptor)
+            .map_err(|e| format!("heap texture size raised: {e:?}"))?;
+        if size.size != TEX_BYTES as u64
+            || size.align == 0
+            || !(TEX_AT as u64).is_multiple_of(size.align)
+        {
+            return Err(format!("uncompressed 64x128 texture layout is {size:?}, expected {TEX_BYTES} bytes fitting offset {TEX_AT}").into());
+        }
+        let texture = heap
+            .new_texture(&descriptor, TEX_AT as u64)
+            .map_err(|e| format!("heap placed texture raised: {e:?}"))?
+            .ok_or("no placed heap texture")?;
+        let identity = (
+            heap.gpu_address(),
+            cover.raw.object_id(),
+            cover.raw.gpu_address(),
+            placed.raw.object_id(),
+            placed.raw.gpu_address(),
+            texture.raw.object_id(),
+        );
+        exercise(
+            &device.raw,
+            &cover.raw,
+            &placed.raw,
+            &texture.raw,
+            &first,
+            &first_file,
+            &mut first_expected,
+            0,
+        )?;
+        eprintln!("CPU_SHADOW_HEAP_STAGE step=detach");
+        heap.detach_backing()
+            .map_err(|e| format!("heap detach: {e:?}"))?;
+        eprintln!("CPU_SHADOW_HEAP_STAGE step=replace_direct");
+        if !heap
+            .replace_backing(&replacement.ranges(), false)
+            .map_err(|e| format!("heap replace: {e:?}"))?
+        {
+            return Err("heap replacement returned false".into());
+        }
+        assert_eq!(
+            (
+                heap.gpu_address(),
+                cover.raw.object_id(),
+                cover.raw.gpu_address(),
+                placed.raw.object_id(),
+                placed.raw.gpu_address(),
+                texture.raw.object_id()
+            ),
+            identity,
+            "heap replacement changed resource GPU addresses or identity"
+        );
+        exercise(
+            &device.raw,
+            &cover.raw,
+            &placed.raw,
+            &texture.raw,
+            &replacement,
+            &later_file,
+            &mut later_expected,
+            1,
+        )?;
+        check_file(&first_file, &first_expected, "old_heap_backing_untouched")?;
+        println!(
+            "CPU_SHADOW_HEAP_COMPLETE addresses=stable {:?}",
+            device.raw.cpu_shadow_counts()
+        );
+        Ok(())
+    }
+}
+
+pub fn run(arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        supported::run(arguments)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    {
+        let _ = arguments;
+        Err("ordinary-file heap fixture needs Linux or Android".into())
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().skip(1)) {
+        eprintln!("CPU_SHADOW_HEAP_FAIL {error}");
+        std::process::exit(1);
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/examples/cpu_shadow_lifetime.rs b/crates/reims-vgpu-vulkan/examples/cpu_shadow_lifetime.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3e45bc0590618a36e911ecd7a5882c72dd13f57b
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_lifetime.rs
@@ -0,0 +1,451 @@
+//! CPU-shadow first-submission ordering and retained backing, through the runtime's public API.
+//! Uses the real reims device but supplies ordinary-file ranges directly to isolate the lifetime
+//! contract from reims' detach-before-replace policy. No shader or guest fixture is needed.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_vulkan::VulkanPlatform;
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+    use std::sync::{Arc, mpsc};
+    use std::time::{Duration, Instant};
+
+    type Result<T> = std::result::Result<T, Box<dyn Error>>;
+    const PAGE: usize = 16 * 1024;
+    const BYTES: usize = 3 * PAGE;
+    const FILE_BYTES: usize = 4 * PAGE;
+    const WAIT: Duration = Duration::from_secs(15);
+
+    struct Reservation(NonNull<u8>);
+    // SAFETY: this inaccessible reservation is an address/lifetime token only. All CPU bytes
+    // are accessed by FileExt and the last deallocator releases the reservation.
+    unsafe impl Send for Reservation {}
+    // SAFETY: no Rust reference to the inaccessible bytes is made or shared.
+    unsafe impl Sync for Reservation {}
+    impl Drop for Reservation {
+        fn drop(&mut self) {
+            // SAFETY: this is exactly the reservation this owner created.
+            unsafe { libc::munmap(self.0.as_ptr().cast(), BYTES) };
+        }
+    }
+
+    struct Backing {
+        file: Arc<File>,
+        at: Arc<Reservation>,
+        order: [usize; 3],
+        initial: Vec<u8>,
+        sources: Arc<AtomicUsize>,
+        releases: Arc<AtomicUsize>,
+        valid_release: Arc<AtomicBool>,
+    }
+
+    impl Backing {
+        fn new(order: [usize; 3], salt: u8) -> Result<Self> {
+            // SAFETY: a fixed NUL-terminated name and supported flags, returning an owned fd.
+            let fd = unsafe {
+                libc::memfd_create(
+                    c"reims-shadow-lifetime".as_ptr(),
+                    libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+                )
+            };
+            if fd < 0 {
+                return Err(io::Error::last_os_error().into());
+            }
+            // SAFETY: this is the new descriptor returned above, owned exactly once here.
+            let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+            file.set_len(FILE_BYTES as u64)?;
+            // SAFETY: retain a fixed file size while allowing ordinary CPU/GPU-delta writes.
+            if unsafe {
+                libc::fcntl(
+                    file.as_raw_fd(),
+                    libc::F_ADD_SEALS,
+                    libc::F_SEAL_GROW | libc::F_SEAL_SHRINK,
+                )
+            } != 0
+            {
+                return Err(io::Error::last_os_error().into());
+            }
+            let initial: Vec<u8> = (0..FILE_BYTES)
+                .map(|i| {
+                    salt.wrapping_add((i / PAGE) as u8)
+                        .wrapping_add((i % 251) as u8)
+                })
+                .collect();
+            file.write_all_at(&initial, 0)?;
+            // SAFETY: no mapping is replaced; this new reservation stays inaccessible. The
+            // CpuShadowSource below supplies its deferred logical bytes through ordinary files.
+            let raw = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    BYTES,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if raw == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error().into());
+            }
+            let Some(at) = NonNull::new(raw.cast::<u8>()) else {
+                // SAFETY: even a null address would be the reservation just created here.
+                unsafe { libc::munmap(raw, BYTES) };
+                return Err("mmap returned a null reservation".into());
+            };
+            Ok(Self {
+                file: Arc::new(file),
+                at: Arc::new(Reservation(at)),
+                order,
+                initial,
+                sources: Arc::new(AtomicUsize::new(0)),
+                releases: Arc::new(AtomicUsize::new(0)),
+                valid_release: Arc::new(AtomicBool::new(true)),
+            })
+        }
+
+        fn memory(&self) -> rt::HostMemory {
+            let file = Arc::clone(&self.file);
+            let start = self.at.0.as_ptr() as usize;
+            let order = self.order;
+            let calls = Arc::clone(&self.sources);
+            let source: rt::CpuShadowSource = Arc::new(move |request| {
+                if request.start.as_ptr() as usize != start || request.length != BYTES as u64 {
+                    return Err(io::Error::other("unexpected CPU-shadow request"));
+                }
+                calls.fetch_add(1, Ordering::SeqCst);
+                order
+                    .into_iter()
+                    .map(|physical| {
+                        Ok(rt::CpuShadowChunk {
+                            fd: file.try_clone()?.into(),
+                            offset: (physical * PAGE) as u64,
+                            length: PAGE as u64,
+                        })
+                    })
+                    .collect()
+            });
+            // SAFETY: each ordered range is retained ordinary, writable, size-sealed memory;
+            // offsets match the deferred pointer modulo 4KiB. The deallocator keeps its token.
+            unsafe { rt::HostMemory::with_cpu_shadow(self.at.0, source) }
+        }
+
+        fn deallocator(&self) -> rt::Deallocator {
+            let held = Arc::clone(&self.at);
+            let releases = Arc::clone(&self.releases);
+            let valid = Arc::clone(&self.valid_release);
+            Box::new(move |pointer, length| {
+                valid.store(
+                    pointer == held.0 && length == BYTES as u64,
+                    Ordering::SeqCst,
+                );
+                releases.fetch_add(1, Ordering::SeqCst);
+                drop(held);
+            })
+        }
+
+        fn import(&self, device: &rt::Device) -> Result<rt::Buffer> {
+            // SAFETY: memory and deallocator satisfy the source/lifetime contract above.
+            Ok(unsafe {
+                device.new_buffer_with_bytes_no_copy(
+                    self.memory(),
+                    BYTES as u64,
+                    rt::ResourceOptions::shared(),
+                    Some(self.deallocator()),
+                )
+            }?)
+        }
+
+        fn replace(&self, buffer: &rt::Buffer) -> std::result::Result<(), rt::Error> {
+            // SAFETY: no encoding or commit races this call. Submitted work keeps its former
+            // files; this backing has the same page bias and supplies a retained address token.
+            unsafe { buffer.rebind_bytes_no_copy(self.memory(), Some(self.deallocator()), None) }
+        }
+
+        fn logical(&self, file: &[u8]) -> Vec<u8> {
+            self.order
+                .iter()
+                .flat_map(|&page| file[page * PAGE..(page + 1) * PAGE].iter().copied())
+                .collect()
+        }
+
+        fn file_bytes(&self) -> Result<Vec<u8>> {
+            let mut bytes = vec![0; FILE_BYTES];
+            self.file.read_exact_at(&mut bytes, 0)?;
+            Ok(bytes)
+        }
+    }
+
+    fn equal(label: &str, got: &[u8], want: &[u8]) -> Result<()> {
+        if got != want {
+            let first = got.iter().zip(want).position(|(a, b)| a != b);
+            return Err(format!(
+                "{label}: first different byte {first:?}, lengths {} / {}",
+                got.len(),
+                want.len()
+            )
+            .into());
+        }
+        Ok(())
+    }
+
+    fn until(label: &str, ready: impl Fn() -> bool) -> Result<()> {
+        let deadline = Instant::now() + WAIT;
+        while !ready() {
+            if Instant::now() >= deadline {
+                return Err(format!("timed out: {label}").into());
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        Ok(())
+    }
+
+    fn completed(command: &rt::CommandBuffer) -> Result<()> {
+        command
+            .wait_until_completed_for(WAIT)
+            .map_err(|_| "lifetime command completion timed out")?;
+        if command.status() != rt::CommandBufferStatus::Completed {
+            return Err(format!("command failed: {:?}", command.error()).into());
+        }
+        Ok(())
+    }
+
+    fn readback(buffer: &rt::Buffer) -> Result<Vec<u8>> {
+        let at = buffer.contents().ok_or("readback is not mapped")?;
+        // SAFETY: the whole owned Shared buffer is mapped; its command completed above.
+        Ok(unsafe { std::slice::from_raw_parts(at.as_ptr(), BYTES) }.to_vec())
+    }
+
+    fn copy(command: &rt::CommandBuffer, from: &rt::Buffer, into: &rt::Buffer) -> Result<()> {
+        let mut encoder = command.blit_command_encoder()?;
+        encoder.copy_from_buffer_to_buffer(from, 0, into, 0, BYTES as u64)?;
+        encoder.end_encoding()?;
+        Ok(())
+    }
+
+    fn pending(device: &rt::Device) -> Result<()> {
+        let old = Backing::new([0, 1, 2], 17)?;
+        let new = Backing::new([2, 0, 1], 83)?;
+        let buffer = old.import(device)?;
+        let address = buffer.gpu_address();
+        let output = device.new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+        let queue = device.new_command_queue()?;
+        let encoded = queue.command_buffer()?;
+        copy(&encoded, &buffer, &output)?;
+        match new.replace(&buffer) {
+            Err(rt::Error::Invalid(invalid))
+                if invalid.problem == rt::Problem::Rebind(rt::RebindProblem::EncodedUses) => {}
+            other => {
+                return Err(
+                    format!("uncommitted rebind must refuse EncodedUses: {other:?}").into(),
+                );
+            }
+        }
+        if new.sources.load(Ordering::SeqCst) != 0 || new.releases.load(Ordering::SeqCst) != 0 {
+            return Err("refused rebind resolved or released the replacement".into());
+        }
+        drop(encoded);
+
+        let event = device.new_shared_event()?;
+        let command = queue.command_buffer()?;
+        command.encode_wait_for_event((&event).into(), 1)?;
+        copy(&command, &buffer, &output)?;
+        command.commit()?;
+        new.replace(&buffer)?;
+        if buffer.gpu_address() != address || buffer.contents() != Some(new.at.0) {
+            return Err("pending rebind changed identity or failed to replace contents".into());
+        }
+        // The event prevents first submission. The replay must release old pages and use new.
+        until("unsubmitted old backing release", || {
+            old.releases.load(Ordering::SeqCst) == 1
+        })?;
+        event.set_signaled_value(1);
+        completed(&command)?;
+        equal(
+            "pending replay",
+            &readback(&output)?,
+            &new.logical(&new.initial),
+        )?;
+        equal(
+            "old file after pending replay",
+            &old.file_bytes()?,
+            &old.initial,
+        )?;
+        equal(
+            "new file after pending read",
+            &new.file_bytes()?,
+            &new.initial,
+        )?;
+        drop((command, buffer));
+        until("replacement release", || {
+            new.releases.load(Ordering::SeqCst) == 1
+        })?;
+        if old.sources.load(Ordering::SeqCst) != 1
+            || new.sources.load(Ordering::SeqCst) != 1
+            || !old.valid_release.load(Ordering::SeqCst)
+            || !new.valid_release.load(Ordering::SeqCst)
+        {
+            return Err("pending rebind source or deallocator contract changed".into());
+        }
+        println!(
+            "CPU_SHADOW_LIFETIME pending=pass uncommitted_refusal=exact replay=new_backing old_release=before_first_submit"
+        );
+        Ok(())
+    }
+
+    struct Open(Option<mpsc::Sender<()>>);
+    impl Drop for Open {
+        fn drop(&mut self) {
+            if let Some(sender) = self.0.take() {
+                let _ = sender.send(());
+            }
+        }
+    }
+
+    fn submitted(device: &rt::Device) -> Result<()> {
+        let old = Backing::new([0, 2, 1], 29)?;
+        let new = Backing::new([1, 2, 3], 131)?;
+        let buffer = old.import(device)?;
+        let output = device.new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+        let queue = device.new_command_queue()?;
+        let command = queue.command_buffer()?;
+        let changed = PAGE - 16..PAGE + 32;
+        let mut encoder = command.blit_command_encoder()?;
+        encoder.fill_buffer(&buffer, changed.start as u64..changed.end as u64, 0xa6)?;
+        encoder.copy_from_buffer_to_buffer(&buffer, 0, &output, 0, BYTES as u64)?;
+        encoder.end_encoding()?;
+
+        let before = device.cpu_shadow_counts();
+        let observed_device = device.clone();
+        let (entered, waiting) = mpsc::sync_channel(1);
+        let (sender, receive) = mpsc::channel();
+        let open = Open(Some(sender));
+        let timed_out = Arc::new(AtomicBool::new(false));
+        let callback_timed_out = Arc::clone(&timed_out);
+        command.add_submission_handler(Box::new(move |_| {
+            let _ = entered.send(observed_device.cpu_shadow_counts());
+            // No GPU wait: hold publication briefly while the test replaces the logical backing.
+            callback_timed_out.store(receive.recv_timeout(WAIT).is_err(), Ordering::SeqCst);
+        }))?;
+        command.commit()?;
+        let during = waiting.recv_timeout(WAIT)?;
+        if during.epochs_prepared <= before.epochs_prepared
+            || during.epochs_finished != before.epochs_finished
+        {
+            return Err("submission gate was outside the uploaded, unscattered epoch".into());
+        }
+        new.replace(&buffer)?;
+        if old.releases.load(Ordering::SeqCst) != 0 {
+            return Err("submitted backing released before its epoch completed".into());
+        }
+        equal(
+            "replacement before old scatter",
+            &new.file_bytes()?,
+            &new.initial,
+        )?;
+        drop(open);
+        completed(&command)?;
+        if timed_out.load(Ordering::SeqCst) {
+            return Err("submission gate timed out".into());
+        }
+        let mut old_expected = old.initial.clone();
+        for logical in changed.clone() {
+            old_expected[old.order[logical / PAGE] * PAGE + logical % PAGE] = 0xa6;
+        }
+        equal(
+            "old submitted readback",
+            &readback(&output)?,
+            &old.logical(&old_expected),
+        )?;
+        equal(
+            "old submitted delta scatter",
+            &old.file_bytes()?,
+            &old_expected,
+        )?;
+        equal(
+            "new file after old scatter",
+            &new.file_bytes()?,
+            &new.initial,
+        )?;
+        drop(command);
+        until("submitted old backing release", || {
+            old.releases.load(Ordering::SeqCst) == 1
+        })?;
+
+        let next = queue.command_buffer()?;
+        copy(&next, &buffer, &output)?;
+        next.commit()?;
+        completed(&next)?;
+        equal(
+            "next command replacement",
+            &readback(&output)?,
+            &new.logical(&new.initial),
+        )?;
+        equal(
+            "old file after replacement use",
+            &old.file_bytes()?,
+            &old_expected,
+        )?;
+        drop((next, buffer));
+        until("final replacement release", || {
+            new.releases.load(Ordering::SeqCst) == 1
+        })?;
+        if old.sources.load(Ordering::SeqCst) != 1
+            || new.sources.load(Ordering::SeqCst) != 1
+            || !old.valid_release.load(Ordering::SeqCst)
+            || !new.valid_release.load(Ordering::SeqCst)
+        {
+            return Err("submitted rebind source or deallocator contract changed".into());
+        }
+        println!(
+            "CPU_SHADOW_LIFETIME submitted=pass scatter=old_file next_submit=new_file old_release=after_completion"
+        );
+        Ok(())
+    }
+
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<()> {
+        if arguments.next().is_some() {
+            return Err("lifetime takes no arguments".into());
+        }
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("run with REIMS_VGPU_CPU_SHADOW=1".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        if !device.raw.cpu_shadow_enabled() {
+            return Err("CPU-shadow mode was not selected".into());
+        }
+        pending(&device.raw)?;
+        submitted(&device.raw)?;
+        println!(
+            "RESULT=CPU_SHADOW_LIFETIME_PASS {:?}",
+            device.raw.cpu_shadow_counts()
+        );
+        Ok(())
+    }
+}
+
+pub(crate) fn run(
+    arguments: impl Iterator<Item = String>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        supported::run(arguments)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    {
+        let _ = arguments;
+        Err("ordinary-file fixture needs Linux or Android".into())
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().skip(1)) {
+        eprintln!("CPU_SHADOW_LIFETIME_FAIL {error}");
+        std::process::exit(1);
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/examples/cpu_shadow_qualification.rs b/crates/reims-vgpu-vulkan/examples/cpu_shadow_qualification.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a7316ebfbc9f632725d37778a426d40d3319aec8
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_qualification.rs
@@ -0,0 +1,47 @@
+//! One executable for the authored CPU-shadow qualification cases, keeping one copy of the
+//! runtime/compiler in the Android transfer. Each invocation runs one bounded case.
+
+#[path = "cpu_shadow_alias.rs"]
+#[allow(dead_code)] // Each included fixture also has its own standalone example entry point.
+mod alias;
+#[path = "cpu_shadow_arguments.rs"]
+#[allow(dead_code)]
+mod arguments;
+#[path = "cpu_shadow_dynamic_rebind.rs"]
+#[allow(dead_code)]
+mod dynamic_rebind;
+#[path = "cpu_shadow_fixed.rs"]
+#[allow(dead_code)]
+mod fixed;
+#[path = "cpu_shadow_heap.rs"]
+#[allow(dead_code)]
+mod heap;
+#[path = "cpu_shadow_lifetime.rs"]
+#[allow(dead_code)]
+mod lifetime;
+#[path = "cpu_shadow_rebind.rs"]
+#[allow(dead_code)]
+mod rebind;
+#[path = "cpu_shadow_tile.rs"]
+#[allow(dead_code)]
+mod tile;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    // Cargo examples include the crate's testkit dev-dependency. Keep production refusal
+    // diagnostics in this bounded executable instead of silently capturing a Death panic.
+    reims_vgpu_core::testkit::capture::set_capture_enabled(false);
+    let mut arguments = std::env::args().skip(1);
+    match arguments.next().as_deref() {
+        Some("alias") => alias::run(arguments),
+        Some("fragmented") => alias::run(arguments.chain(std::iter::once("--fragmented".to_owned()))),
+        Some("chunk-boundary") => alias::run(arguments.chain(std::iter::once("--chunk-boundary".to_owned()))),
+        Some("fixed") => fixed::run(arguments),
+        Some("arguments") => arguments::run(arguments),
+        Some("dynamic-rebind") => dynamic_rebind::run(arguments),
+        Some("rebind") => rebind::run(arguments),
+        Some("lifetime") => lifetime::run(arguments),
+        Some("heap") => heap::run(arguments),
+        Some("tile") => tile::run(arguments),
+        _ => Err("usage: cpu_shadow_qualification {alias|fragmented|chunk-boundary|fixed|arguments|dynamic-rebind} kernel.air, {rebind|lifetime|heap}, or tile vertex.air fragment.air".into()),
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/examples/cpu_shadow_qualification/android_compat.c b/crates/reims-vgpu-vulkan/examples/cpu_shadow_qualification/android_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..011b478c5cf81e418b47f08f59111876201bd640
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_qualification/android_compat.c
@@ -0,0 +1,13 @@
+/* The Android API 29 libc stub has no memfd_create symbol. QEMU supplies this
+ * syscall fallback in util/memfd.c for the runtime archive; the standalone
+ * qualification executable needs an equivalent local wrapper. This creates
+ * ordinary CPU RAM only, never exported Vulkan/producer memory. */
+#include <sys/syscall.h>
+#include <unistd.h>
+
+int memfd_create(const char *name, unsigned int flags);
+
+int memfd_create(const char *name, unsigned int flags)
+{
+    return (int)syscall(SYS_memfd_create, name, flags);
+}
