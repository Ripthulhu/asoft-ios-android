@@ -0,0 +1,65 @@
+; Repository-authored AIR: only metadata and output are bound. The target is resident-only.
+; A host event holds the committed command until that target has acquired new fragmented pages.
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define void @cpu_shadow_dynamic_rebind(ptr addrspace(1) %metadata, ptr addrspace(1) %output) {
+  %address = load i64, ptr addrspace(1) %metadata, align 8
+  %target = inttoptr i64 %address to ptr addrspace(1)
+  %cross = load <4 x i32>, ptr addrspace(1) %target, align 4
+  store <4 x i32> %cross, ptr addrspace(1) %output, align 16
+  %counter = getelementptr i32, ptr addrspace(1) %target, i64 2
+  %before = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %counter, i32 17, i32 0, i32 2, i32 0, i1 true)
+  %after = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %counter, i32 0, i32 0, i32 2, i32 0, i1 true)
+  %before_slot = getelementptr i32, ptr addrspace(1) %output, i64 4
+  %after_slot = getelementptr i32, ptr addrspace(1) %output, i64 5
+  store i32 %before, ptr addrspace(1) %before_slot, align 4
+  store i32 %after, ptr addrspace(1) %after_slot, align 4
+  %cross_store = getelementptr i8, ptr addrspace(1) %target, i64 16384
+  store <4 x i32> <i32 19088743, i32 591751049, i32 1164413355, i32 1737075661>, ptr addrspace(1) %cross_store, align 4
+  ret void
+}
+
+; The named-binding control uses the same work through a directly bound target. Its third
+; argument observes the stage-input origin, so the negative host-step case proves a real input read.
+define void @cpu_shadow_named_rebind(ptr addrspace(1) %target, ptr addrspace(1) %output, <3 x i32> %origin) {
+  %cross = load <4 x i32>, ptr addrspace(1) %target, align 4
+  store <4 x i32> %cross, ptr addrspace(1) %output, align 16
+  %counter = getelementptr i32, ptr addrspace(1) %target, i64 2
+  %before = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %counter, i32 17, i32 0, i32 2, i32 0, i1 true)
+  %after = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %counter, i32 0, i32 0, i32 2, i32 0, i1 true)
+  %before_slot = getelementptr i32, ptr addrspace(1) %output, i64 4
+  %after_slot = getelementptr i32, ptr addrspace(1) %output, i64 5
+  store i32 %before, ptr addrspace(1) %before_slot, align 4
+  store i32 %after, ptr addrspace(1) %after_slot, align 4
