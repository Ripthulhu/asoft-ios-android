+//! Actual Vulkan fixed-function commands over reordered ordinary-file pages. Assemble the
+//! repository-authored `cpu_shadow_fixed/render.ll` with llvm-as and pass its AIR file.
+//! This checks direct segmented blits, byte fills, overlapping moves, and indexed render reads
+//! after CPU and GPU changes. REIMS_VGPU_CPU_SHADOW=1 is mandatory; no fallback is selected.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    use metal2vulkan::metal::{
+        BarrierScope, IndexType, PixelFormat, PrimitiveType, RenderStages, TextureUsage,
+    };
+    use metal2vulkan::pipeline::{
+        ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource,
+    };
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::host::HostPtr;
+    use reims_vgpu_core::platform::HostRange;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::raise::OnFault;
+    use reims_vgpu_vulkan::VulkanPlatform;
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+
+    const PAGE: usize = 16 * 1024;
+    const BYTES: usize = 3 * PAGE;
+    const WAIT: Duration = Duration::from_secs(15);
+    const INDICES: usize = PAGE - 4;
+    const SIDE: u64 = 8;
+
+    struct Mapping {
+        at: NonNull<u8>,
+        order: [usize; 3],
+    }
+    // SAFETY: only an address/ownership token is shared; all mutation is ordinary file I/O.
+    unsafe impl Send for Mapping {}
+    // SAFETY: no Rust references to the shared mutable mapping are created.
+    unsafe impl Sync for Mapping {}
+
+    impl Mapping {
+        fn new(file: &File, order: [usize; 3]) -> io::Result<Self> {
+            // SAFETY: reserve our own complete range; subsequent fixed mappings replace only it.
+            let at = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    BYTES,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if at == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let Some(pointer) = NonNull::<u8>::new(at.cast()) else {
+                // SAFETY: even a zero address would name our successful reservation.
+                unsafe { libc::munmap(at, BYTES) };
+                return Err(io::Error::other("null mapping"));
+            };
+            for (logical, physical) in order.into_iter().enumerate() {
+                let target = pointer.as_ptr().wrapping_add(logical * PAGE);
+                // SAFETY: this page is wholly inside the owned reservation; the sealed file has
+                // the selected full page. Its offset is aligned on 4 KiB and 16 KiB hosts.
+                let mapped = unsafe {
+                    libc::mmap(
+                        target.cast(),
+                        PAGE,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_SHARED | libc::MAP_FIXED,
+                        file.as_raw_fd(),
+                        (physical * PAGE) as libc::off_t,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    let error = io::Error::last_os_error();
+                    // SAFETY: undo our entire reservation, including pages already replaced.
+                    unsafe { libc::munmap(at, BYTES) };
+                    return Err(error);
+                }
+            }
+            Ok(Self { at: pointer, order })
+        }
+        fn file_offset(&self, logical: usize) -> usize {
+            self.order[logical / PAGE] * PAGE + logical % PAGE
+        }
+        fn lease(&self, file: &File) -> io::Result<Vec<GuestRamFile>> {
+            let fd = Arc::new(file.try_clone()?.into());
+            Ok(self
+                .order
+                .into_iter()
+                .enumerate()
+                .map(|(logical, physical)| GuestRamFile {
+                    host: self.at.as_ptr().wrapping_add(logical * PAGE) as u64,
+                    length: PAGE as u64,
+                    fd: Arc::clone(&fd),
+                    offset: (physical * PAGE) as u64,
+                })
+                .collect())
+        }
+        fn set(&self, file: &File, offset: usize, bytes: &[u8]) -> io::Result<()> {
+            let mut taken = 0;
+            while taken < bytes.len() {
+                let logical = offset + taken;
+                let length = (PAGE - logical % PAGE).min(bytes.len() - taken);
+                file.write_all_at(
+                    &bytes[taken..taken + length],
+                    self.file_offset(logical) as u64,
+                )?;
+                taken += length;
+            }
+            Ok(())
+        }
+    }
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: the final owner releases all mapped pages after no-copy resource users.
+            unsafe { libc::munmap(self.at.as_ptr().cast(), BYTES) };
+        }
+    }
+
+    fn file() -> io::Result<File> {
+        // SAFETY: a fixed NUL-terminated name, returning an owned descriptor on success.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"reims-cpu-shadow-fixed".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: this successful memfd_create descriptor has one owner here.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        file.set_len(BYTES as u64)?;
+        // SAFETY: size seals leave ordinary RAM writable while keeping every lease in bounds.
+        if unsafe {
+            libc::fcntl(
+                file.as_raw_fd(),
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(file)
+    }
+    fn complete(command: &rt::CommandBuffer) -> Result<(), Box<dyn Error>> {
+        command.commit()?;
+        command
+            .wait_until_completed_for(WAIT)
+            .map_err(|_| "command timeout")?;
+        if command.status() != rt::CommandBufferStatus::Completed {
+            return Err(format!(
+                "command failed: {:?} / {:?}",
+                command.error(),
+                command.refusal()
+            )
+            .into());
+        }
+        Ok(())
+    }
+    fn host_bytes(buffer: &rt::Buffer, length: usize) -> Result<Vec<u8>, Box<dyn Error>> {
+        let contents = buffer.contents().ok_or("owned readback has no contents")?;
+        // SAFETY: called only after the GPU completed; the owned Shared buffer covers length.
+        Ok(unsafe { std::slice::from_raw_parts(contents.as_ptr(), length) }.to_vec())
+    }
+    fn pixels(
+        target: &rt::Texture,
+        command: &rt::CommandBuffer,
+        into: &rt::Buffer,
+    ) -> Result<(), Box<dyn Error>> {
+        let mut blit = command.blit_command_encoder()?;
+        blit.copy_from_texture_to_buffer(
+            target,
+            0,
+            0,
+            rt::Origin::new(0, 0, 0),
+            rt::Size::new(SIDE, SIDE, 1),
+            into,
+            0,
+            SIDE * 4,
+            SIDE * SIDE * 4,
+            rt::BlitOption::None,
+        )?;
+        blit.end_encoding()?;
+        Ok(())
+    }
+    fn exact(actual: &[u8], expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        if actual != expected {
+            let at = actual
+                .iter()
+                .zip(expected)
+                .position(|(a, b)| a != b)
+                .unwrap_or(actual.len().min(expected.len()));
+            return Err(format!(
+                "{case}: mismatch at byte{at}, actual={:?}, expected={:?}",
+                actual.get(at),
+                expected.get(at)
+            )
+            .into());
+        }
+        println!(
+            "CPU_SHADOW_FIXED_PASS case={case} exact_bytes={}",
+            expected.len()
+        );
+        Ok(())
+    }
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("REIMS_VGPU_CPU_SHADOW=1 required".into());
+        }
+        let air = arguments
+            .next()
+            .ok_or("pass the assembled render AIR file")?;
+        if arguments.next().is_some() {
+            return Err("unexpected extra argument".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let source_file = file()?;
+        let target_file = file()?;
+        let source = Arc::new(Mapping::new(&source_file, [0, 2, 1])?);
+        let target = Arc::new(Mapping::new(&target_file, [2, 0, 1])?);
+        let alias = Arc::new(Mapping::new(&target_file, [0, 1, 2])?);
+        let mut leases = source.lease(&source_file)?;
+        leases.extend(target.lease(&target_file)?);
+        leases.extend(alias.lease(&target_file)?);
+        let _lease = lease_guest_memory(leases);
+        let make = |mapping: &Arc<Mapping>| {
+            let hold = Arc::clone(mapping);
+            // SAFETY: the deallocator retains the full mapped range through every resource use.
+            let range =
+                unsafe { HostRange::new(HostPtr::from_ptr(mapping.at.as_ptr()), BYTES as u64) };
+            device
+                .new_buffer_over_host_memory(
+                    OnFault::Return,
+                    range,
+                    0,
+                    Some(Box::new(move || drop(hold))),
+                )
+                .map_err(|error| format!("import failed: {error:?}"))?
+                .ok_or_else(|| "import returned no buffer".to_owned())
+        };
+        let src = make(&source)?;
+        let dst = make(&target)?;
+        let alias_buffer = make(&alias)?;
+        let source_bytes: Vec<u8> = (0..BYTES)
+            .map(|i| ((i * 37 + i / 97) & 255) as u8)
+            .collect();
+        source_file.write_all_at(&source_bytes, 0)?;
+        let mut expected = vec![0xcd; BYTES];
+        target_file.write_all_at(&expected, 0)?;
+        let queue = device.raw.new_command_queue()?;
+        let command = queue.command_buffer()?;
+        let mut blit = command.blit_command_encoder()?;
+        let (from, to, length) = (PAGE - 7, 2 * PAGE - 11, PAGE + 3);
+        blit.copy_from_buffer_to_buffer(&src.raw, from as u64, &dst.raw, to as u64, length as u64)?;
+        for i in 0..length {
+            expected[target.file_offset(to + i)] = source_bytes[source.file_offset(from + i)];
+        }
+        blit.fill_buffer(&dst.raw, (PAGE - 3) as u64..(PAGE + 11) as u64, 0x6a)?;
+        for i in PAGE - 3..PAGE + 11 {
+            expected[target.file_offset(i)] = 0x6a;
+        }
+        let moved: Vec<u8> = (PAGE - 6..PAGE + 10)
+            .map(|i| expected[target.file_offset(i)])
+            .collect();
+        blit.copy_from_buffer_to_buffer(
+            &dst.raw,
+            (PAGE - 6) as u64,
+            &dst.raw,
+            (PAGE - 2) as u64,
+            16,
+        )?;
+        for (i, byte) in moved.into_iter().enumerate() {
+            expected[target.file_offset(PAGE - 2 + i)] = byte;
+        }
+        // Distinct logical resources overlap in the same canonical file, despite different
+        // raw VkBuffer handles once direct fixed-function aliases are enabled.
+        let moved = expected[5..37].to_vec();
+        blit.copy_from_buffer_to_buffer(&alias_buffer.raw, 5, &dst.raw, (PAGE + 7) as u64, 32)?;
+        expected[7..39].copy_from_slice(&moved);
+        let back = device
+            .raw
+            .new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+        blit.copy_from_buffer_to_buffer(&alias_buffer.raw, 0, &back, 0, BYTES as u64)?;
+        blit.end_encoding()?;
+        complete(&command)?;
+        exact(
+            &host_bytes(&back, BYTES)?,
+            &expected,
+            "canonical_alias_after_blit_fill_memmove",
+        )?;
+        let mut actual = vec![0; BYTES];
+        target_file.read_exact_at(&mut actual, 0)?;
+        exact(&actual, &expected, "ordinary_file_after_delta_scatter")?;
+
+        // CPU texture operations must use the ordinary backing even when the no-copy pointer
+        // itself is deferred/unreadable. Protect only this fixture's own mapping; all subsequent
+        // CPU edits use FileExt and GPU transfers use the retained CPU-shadow file descriptors.
+        let mut texels = rt::TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, 8, 2, false);
+        texels.usage = TextureUsage::SHADER_READ | TextureUsage::SHADER_WRITE;
+        texels.resource_options = rt::ResourceOptions::shared();
+        let texture = dst.raw.new_texture(&texels, (PAGE - 16) as u64, 32)?;
+        // SAFETY: the range belongs solely to this fixture; it stays reserved until Mapping drops.
+        if unsafe { libc::mprotect(target.at.as_ptr().cast(), BYTES, libc::PROT_NONE) } != 0 {
+            return Err(io::Error::last_os_error().into());
+        }
+        let region = rt::Region::new_2d(0, 0, 8, 2);
+        let mut cpu_pixels = vec![0; 64];
+        texture.get_bytes(&mut cpu_pixels, 32, 64, region, 0, 0)?;
+        let wanted: Vec<_> = (PAGE - 16..PAGE + 48)
+            .map(|i| expected[target.file_offset(i)])
+            .collect();
+        exact(&cpu_pixels, &wanted, "cpu_texture_read_deferred_pointer")?;
+        let replacement: Vec<_> = (0..64).map(|i| (i * 17 + 3) as u8).collect();
+        texture.replace_region(region, 0, 0, &replacement, 32, 64)?;
+        texture.get_bytes(&mut cpu_pixels, 32, 64, region, 0, 0)?;
+        exact(
+            &cpu_pixels,
+            &replacement,
+            "cpu_texture_write_deferred_pointer",
+        )?;
+        for (i, byte) in replacement.iter().copied().enumerate() {
+            expected[target.file_offset(PAGE - 16 + i)] = byte;
+        }
+        target_file.read_exact_at(&mut actual, 0)?;
+        exact(&actual, &expected, "cpu_texture_ordinary_file_bytes")?;
+
+        let library =
+            device
+                .raw
+                .new_library_with_compile_library(metal2vulkan::library::Library::from_air(
+                    &std::fs::read(air)?,
+                )?);
+        let vertex = library.new_function_with_name("fixed_vertex")?;
+        let pipeline = |fragment: &str| -> Result<rt::RenderPipelineState, Box<dyn Error>> {
+            let fragment = library.new_function_with_name(fragment)?;
+            let mut descriptor =
+                RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+            descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+            descriptor.color_attachments[0] =
+                Some(ColorAttachmentDescriptor::new(PixelFormat::RGBA8Unorm));
+            Ok(device
+                .raw
+                .new_render_pipeline_state(&descriptor, &rt::PipelineOptions::default())?)
+        };
+        let red = pipeline("fixed_red")?;
+        let blue = pipeline("fixed_blue")?;
+        let writer = pipeline("fixed_write")?;
+        let mut descriptor =
+            rt::TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, SIDE, SIDE, false);
+        descriptor.usage = TextureUsage::RENDER_TARGET;
+        descriptor.resource_options = rt::ResourceOptions::private();
+        let image = device.raw.new_texture(&descriptor)?;
+        let mut pass = rt::RenderPassDescriptor::new();
+        let color = &mut pass.color_attachments[0];
+        color.texture = Some(image.clone());
+        color.load_action = rt::LoadAction::Clear;
+        color.store_action = rt::StoreAction::Store;
+        color.clear_color = rt::ClearColor::new(0.0, 0.0, 1.0, 1.0);
+        let drawn: Vec<u8> = [255u8, 0, 0, 255].repeat((SIDE * SIDE) as usize);
+        let cleared: Vec<u8> = [0u8, 0, 255, 255].repeat((SIDE * SIDE) as usize);
+        let index_bytes: Vec<u8> = (0..6u16).flat_map(u16::to_le_bytes).collect();
+        let readback = device
+            .raw
+            .new_buffer(SIDE * SIDE * 4, rt::ResourceOptions::shared())?;
+        // Establish the authored shader's geometry independently of paged index fetch.
+        let ordinary = device
+            .raw
+            .new_buffer_with_bytes(&index_bytes, rt::ResourceOptions::shared())?;
+        let control = queue.command_buffer()?;
+        let mut render = control.render_command_encoder(&pass)?;
+        render.set_render_pipeline_state(&red)?;
+        render.draw_indexed_primitives(
+            PrimitiveType::Triangle,
+            6,
+            IndexType::UInt16,
+            &ordinary,
+            0,
+            1,
+            0,
+            0,
+        )?;
+        render.end_encoding()?;
+        pixels(&image, &control, &readback)?;
+        complete(&control)?;
+        exact(
+            &host_bytes(&readback, drawn.len())?,
+            &drawn,
+            "owned_indices_control",
+        )?;
+        for phase in 0..3 {
+            target.set(&target_file, INDICES, &index_bytes)?;
+            let command = queue.command_buffer()?;
+            if phase == 1 {
+                let mut fill = command.blit_command_encoder()?;
+                fill.fill_buffer(&dst.raw, INDICES as u64..(INDICES + 12) as u64, 0)?;
+                fill.end_encoding()?;
+            }
+            let mut render = command.render_command_encoder(&pass)?;
+            render.set_render_pipeline_state(&red)?;
+            render.draw_indexed_primitives(
+                PrimitiveType::Triangle,
+                6,
+                IndexType::UInt16,
+                &dst.raw,
+                INDICES as u64,
+                1,
+                0,
+                0,
+            )?;
+            render.end_encoding()?;
+            pixels(&image, &command, &readback)?;
+            complete(&command)?;
+            exact(
+                &host_bytes(&readback, drawn.len())?,
+                if phase == 1 { &cleared } else { &drawn },
+                [
+                    "paged_indices_cpu_upload",
+                    "paged_indices_after_gpu_fill",
+                    "paged_indices_cpu_refresh",
+                ][phase],
+            )?;
+        }
+        // A single fragment writes canonical index pages, then an ordered indexed draw in the
+        // same Metal encoder must gather those changes before its fixed-function index fetch.
+        target.set(&target_file, INDICES, &index_bytes)?;
+        let command = queue.command_buffer()?;
+        let mut render = command.render_command_encoder(&pass)?;
+        render.set_render_pipeline_state(&writer)?;
+        render.set_fragment_buffer(Some(&dst.raw), INDICES as u64, 0)?;
+        render.draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)?;
+        render.memory_barrier_with_scope(
+            BarrierScope::BUFFERS,
+            RenderStages::FRAGMENT,
+            RenderStages::VERTEX,
+        );
+        render.set_render_pipeline_state(&blue)?;
+        render.set_fragment_buffer(None, 0, 0)?;
+        render.draw_indexed_primitives(
+            PrimitiveType::Triangle,
+            6,
+            IndexType::UInt16,
+            &dst.raw,
+            INDICES as u64,
+            1,
+            0,
+            0,
+        )?;
+        render.end_encoding()?;
+        pixels(&image, &command, &readback)?;
+        complete(&command)?;
+        exact(
+            &host_bytes(&readback, drawn.len())?,
+            &drawn,
+            "paged_indices_after_prior_draw",
+        )?;
+        let mut indices = [0xff; 12];
+        for (i, byte) in indices.iter_mut().enumerate() {
+            target_file.read_exact_at(
+                std::slice::from_mut(byte),
+                target.file_offset(INDICES + i) as u64,
+            )?;
+        }
+        exact(&indices, &[0; 12], "fragment_index_writes_scattered")?;
+        println!(
+            "CPU_SHADOW_FIXED_COMPLETE {:?}",
+            device.raw.cpu_shadow_counts()
+        );
+        Ok(())
+    }
+}
+
+/// Entry shared by the standalone fixture and the single Android qualification executable.
+pub fn run(arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        supported::run(arguments)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    {
+        let _ = arguments;
+        Err("ordinary-file fixture needs Linux or Android".into())
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().skip(1)) {
+        eprintln!("CPU_SHADOW_FIXED_FAIL {error}");
+        std::process::exit(1);
+    }
+}
