index 0000000000000000000000000000000000000000..97ca84c471d687dca0d8da43abba6d80742c89ca
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_rebind.rs
@@ -0,0 +1,364 @@
+//! Real reims BufferDesc no-copy detach/replace ownership over ordinary files. One resource and
+//! texture survive direct -> fragmented -> another direct backing while all GPU bytes and untouched
+//! file bytes are checked. The SPI capability remains unadvertised until this path is qualified.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    use metal2vulkan::metal::{PixelFormat, TextureUsage};
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::host::HostPtr;
+    use reims_vgpu_core::platform::HostRange;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::platform::resource::Buffer as _;
+    use reims_vgpu_core::platform::types::ResourceAddressRange;
+    use reims_vgpu_core::platform::values::{BufferDesc, OptionSet};
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+    use reims_vgpu_vulkan::platform::AddressRanges;
+    use reims_vgpu_vulkan::{Obj, VulkanPlatform};
+
+    const PAGE: usize = 16 * 1024;
+    const BYTES: usize = 3 * PAGE;
+    const FILE_BYTES: usize = 4 * PAGE;
+    const WAIT: Duration = Duration::from_secs(15);
+    struct Mapping {
+        at: NonNull<u8>,
+        order: [usize; 3],
+    }
+    // SAFETY: only ownership/address tokens cross threads, with no mutable Rust reference.
+    unsafe impl Send for Mapping {}
+    // SAFETY: ordinary-file I/O is the only CPU access; the mapping is retained while used.
+    unsafe impl Sync for Mapping {}
+    impl Mapping {
+        fn new(file: &File, order: [usize; 3]) -> io::Result<Self> {
+            let reserve = BYTES + PAGE;
+            // SAFETY: reserve enough inaccessible address space to align a retained subrange.
+            let base = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    reserve,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if base == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let address = (base as usize + PAGE - 1) & !(PAGE - 1);
+            let head = address - base as usize;
+            let tail = reserve - head - BYTES;
+            // SAFETY: discard only complete host pages outside the selected owned subrange.
+            unsafe {
+                if head != 0 {
+                    libc::munmap(base, head);
+                }
+                if tail != 0 {
+                    libc::munmap((address + BYTES) as *mut libc::c_void, tail);
+                }
+            }
+            let Some(at) = NonNull::new(address as *mut u8) else {
+                // SAFETY: the retained reservation, even at address zero, is ours.
+                unsafe { libc::munmap(address as *mut libc::c_void, BYTES) };
+                return Err(io::Error::other("null aligned mapping"));
+            };
+            for (logical, physical) in order.into_iter().enumerate() {
+                // SAFETY: each mapping replaces a complete page of our retained reservation.
+                let mapped = unsafe {
+                    libc::mmap(
+                        at.as_ptr().wrapping_add(logical * PAGE).cast(),
+                        PAGE,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_FIXED | libc::MAP_SHARED,
+                        file.as_raw_fd(),
+                        (physical * PAGE) as libc::off_t,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    let error = io::Error::last_os_error();
+                    // SAFETY: release our complete range, including pages already mapped.
+                    unsafe { libc::munmap(at.as_ptr().cast(), BYTES) };
+                    return Err(error);
+                }
+            }
+            Ok(Self { at, order })
+        }
+        fn at_file(&self, logical: usize) -> usize {
+            self.order[logical / PAGE] * PAGE + logical % PAGE
+        }
+        fn leases(&self, file: &File) -> io::Result<Vec<GuestRamFile>> {
+            let fd = Arc::new(file.try_clone()?.into());
+            Ok(self
+                .order
+                .into_iter()
+                .enumerate()
+                .map(|(logical, physical)| GuestRamFile {
+                    host: self.at.as_ptr().wrapping_add(logical * PAGE) as u64,
+                    length: PAGE as u64,
+                    offset: (physical * PAGE) as u64,
+                    fd: Arc::clone(&fd),
+                })
+                .collect())
+        }
+        fn ranges(&self) -> Obj<AddressRanges> {
+            Obj::new(AddressRanges {
+                ranges: (0..3)
+                    .map(|i| ResourceAddressRange {
+                        address: self.at.as_ptr().wrapping_add(i * PAGE) as u64,
+                        length: PAGE as u64,
+                    })
+                    .collect(),
+            })
+        }
+    }
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: this final owner releases exactly the retained aligned mapping.
+            unsafe { libc::munmap(self.at.as_ptr().cast(), BYTES) };
+        }
+    }
+    fn file(fill: u8) -> io::Result<(File, Vec<u8>)> {
+        // SAFETY: valid name/flags; the returned descriptor is uniquely owned.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"reims-cpu-shadow-rebind".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: the new memfd descriptor has one owner.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        file.set_len(FILE_BYTES as u64)?;
+        // SAFETY: size seals preserve each lease without making RAM unwritable.
+        if unsafe {
+            libc::fcntl(
+                file.as_raw_fd(),
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        let bytes: Vec<u8> = (0..FILE_BYTES)
+            .map(|i| fill.wrapping_add((i * 13 + i / 71) as u8))
+            .collect();
+        file.write_all_at(&bytes, 0)?;
+        Ok((file, bytes))
+    }
+    fn exact(actual: &[u8], expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        if actual != expected {
+            let at = actual
+                .iter()
+                .zip(expected)
+                .position(|(a, b)| a != b)
+                .unwrap_or(actual.len().min(expected.len()));
+            return Err(format!(
+                "{case}: mismatch at byte{at}: {:?} / {:?}",
+                actual.get(at),
+                expected.get(at)
+            )
+            .into());
+        }
+        println!(
+            "CPU_SHADOW_REBIND_PASS case={case} exact_bytes={}",
+            expected.len()
+        );
+        Ok(())
+    }
+    fn check_file(file: &File, expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        let mut actual = vec![0; FILE_BYTES];
+        file.read_exact_at(&mut actual, 0)?;
+        exact(&actual, expected, case)
+    }
+    fn shared_bytes(buffer: &rt::Buffer, length: usize) -> Result<Vec<u8>, Box<dyn Error>> {
+        let at = buffer.contents().ok_or("owned readback not mapped")?;
+        // SAFETY: own Shared buffer length checked by construction, read after GPU completion.
+        Ok(unsafe { std::slice::from_raw_parts(at.as_ptr(), length) }.to_vec())
+    }
+    fn exercise(
+        device: &rt::Device,
+        buffer: &rt::Buffer,
+        texture: &rt::Texture,
+        mapping: &Mapping,
+        file: &File,
+        expected: &mut [u8],
+        phase: usize,
+    ) -> Result<(), Box<dyn Error>> {
+        let queue = device.new_command_queue()?;
+        let command = queue.command_buffer()?;
+        let bytes = device.new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+        let pixels = device.new_buffer(64, rt::ResourceOptions::shared())?;
+        let mut blit = command.blit_command_encoder()?;
+        let value = 0x40 + phase as u8 * 29;
+        blit.fill_buffer(buffer, (PAGE - 5) as u64..(PAGE + 19) as u64, value)?;
+        for i in PAGE - 5..PAGE + 19 {
+            expected[mapping.at_file(i)] = value;
+        }
+        blit.copy_from_buffer_to_buffer(buffer, 0, &bytes, 0, BYTES as u64)?;
+        blit.copy_from_texture_to_buffer(
+            texture,
+            0,
+            0,
+            rt::Origin::new(0, 0, 0),
+            rt::Size::new(8, 2, 1),
+            &pixels,
+            0,
+            32,
+            64,
+            rt::BlitOption::None,
+        )?;
+        blit.end_encoding()?;
+        command.commit()?;
+        command
+            .wait_until_completed_for(WAIT)
+            .map_err(|_| "rebind command timeout")?;
+        if command.status() != rt::CommandBufferStatus::Completed {
+            return Err(format!(
+                "rebind phase{phase}: {:?} / {:?}",
+                command.error(),
+                command.refusal()
+            )
+            .into());
+        }
+        let logical: Vec<u8> = (0..BYTES).map(|i| expected[mapping.at_file(i)]).collect();
+        exact(
+            &shared_bytes(&bytes, BYTES)?,
+            &logical,
+            &format!("phase{phase}_gpu_buffer"),
+        )?;
+        exact(
+            &shared_bytes(&pixels, 64)?,
+            &logical[PAGE - 16..PAGE + 48],
+            &format!("phase{phase}_retained_texture"),
+        )?;
+        check_file(file, expected, &format!("phase{phase}_whole_ordinary_file"))?;
+        let mut cpu = [0; 64];
+        texture.get_bytes(&mut cpu, 32, 64, rt::Region::new_2d(0, 0, 8, 2), 0, 0)?;
+        exact(
+            &cpu,
+            &logical[PAGE - 16..PAGE + 48],
+            &format!("phase{phase}_cpu_texture"),
+        )?;
+        Ok(())
+    }
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        if arguments.next().is_some() {
+            return Err("rebind fixture takes no arguments".into());
+        }
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("REIMS_VGPU_CPU_SHADOW=1 required".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let (first_file, mut first_expected) = file(0x27)?;
+        let (later_file, mut later_expected) = file(0x96)?;
+        let first = Arc::new(Mapping::new(&first_file, [0, 1, 2])?);
+        let fragmented = Arc::new(Mapping::new(&later_file, [2, 0, 3])?);
+        let direct = Arc::new(Mapping::new(&later_file, [1, 2, 3])?);
+        let mut leases = first.leases(&first_file)?;
+        leases.extend(fragmented.leases(&later_file)?);
+        leases.extend(direct.leases(&later_file)?);
+        let _lease = lease_guest_memory(leases);
+        let hold = Arc::clone(&first);
+        // SAFETY: the deallocator and fixture keep the whole initial mapped range alive.
+        let contents =
+            unsafe { HostRange::new(HostPtr::from_ptr(first.at.as_ptr()), BYTES as u64) };
+        let buffer = device
+            .new_buffer(BufferDesc {
+                length: BYTES as u64,
+                options: vec![OptionSet::StorageMode(0)],
+                pinned_gpu_address: None,
+                contents: Some(contents),
+                no_copy: true,
+                deallocator: Some(Box::new(move |_, _| drop(hold))),
+            })
+            .map_err(|e| format!("descriptor creation raised: {e:?}"))?
+            .ok_or("descriptor returned no buffer")?;
+        let identity = (buffer.raw.object_id(), buffer.raw.gpu_address());
+        let mut desc = rt::TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, 8, 2, false);
+        desc.resource_options = rt::ResourceOptions::shared();
+        desc.usage = TextureUsage::SHADER_READ | TextureUsage::SHADER_WRITE;
+        let texture = buffer.raw.new_texture(&desc, (PAGE - 16) as u64, 32)?;
+        exercise(
+            &device.raw,
+            &buffer.raw,
+            &texture,
+            &first,
+            &first_file,
+            &mut first_expected,
+            0,
+        )?;
+        for (phase, mapping) in [(1, &fragmented), (2, &direct)] {
+            eprintln!("CPU_SHADOW_REBIND_STAGE phase={phase} step=detach");
+            buffer
+                .detach_backing()
+                .map_err(|e| format!("detach phase{phase}: {e:?}"))?;
+            assert_eq!(
+                (buffer.raw.object_id(), buffer.raw.gpu_address()),
+                identity,
+                "detach changed logical identity"
+            );
+            eprintln!("CPU_SHADOW_REBIND_STAGE phase={phase} step=replace");
+            if !buffer
+                .replace_backing(&mapping.ranges(), false)
+                .map_err(|e| format!("replace phase{phase}: {e:?}"))?
+            {
+                return Err(format!("replace phase{phase} returned false").into());
+            }
+            assert_eq!(
+                (buffer.raw.object_id(), buffer.raw.gpu_address()),
+                identity,
+                "replace changed logical identity"
+            );
+            eprintln!("CPU_SHADOW_REBIND_STAGE phase={phase} step=exercise");
+            exercise(
+                &device.raw,
+                &buffer.raw,
+                &texture,
+                mapping,
+                &later_file,
+                &mut later_expected,
+                phase,
+            )?;
+            check_file(
+                &first_file,
+                &first_expected,
+                &format!("phase{phase}_old_backing_untouched"),
+            )?;
+        }
+        println!(
+            "CPU_SHADOW_REBIND_COMPLETE logical_identity=stable {:?}",
+            device.raw.cpu_shadow_counts()
+        );
+        Ok(())
+    }
+}
+
+pub fn run(arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        supported::run(arguments)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    {
+        let _ = arguments;
+        Err("ordinary-file fixture needs Linux or Android".into())
+    }
+}
+fn main() {
+    if let Err(error) = run(std::env::args().skip(1)) {
+        eprintln!("CPU_SHADOW_REBIND_FAIL {error}");
+        std::process::exit(1);
+    }
+}
