diff --git a/crates/reims-vgpu-vulkan/build_cpu_shadow_probe.rs b/crates/reims-vgpu-vulkan/build_cpu_shadow_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..13b9a5a8e3b99c93a3a266ebcb71bd32caec8790
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/build_cpu_shadow_probe.rs
@@ -0,0 +1,25 @@
+//! Assemble only the repository-authored diagnostic kernel. No Apple tool or guest input.
+
+use std::path::Path;
+use std::process::Command;
+
+pub fn build(out: &Path) -> Result<(), String> {
+    println!("cargo:rerun-if-env-changed=RVG_CPU_SHADOW_LLVM_AS");
+    println!("cargo:rerun-if-changed=src/cpu_shadow_probe/kernel.ll");
+    let assembler = std::env::var_os("RVG_CPU_SHADOW_LLVM_AS").unwrap_or_else(|| "llvm-as".into());
+    let result = Command::new(&assembler)
+        .arg("src/cpu_shadow_probe/kernel.ll")
+        .arg("-o")
+        .arg(out.join("cpu_shadow_probe.air"))
+        .output()
+        .map_err(|error| {
+            format!("CPU-shadow probe needs llvm-as (RVG_CPU_SHADOW_LLVM_AS): {error}")
+        })?;
+    if !result.status.success() {
+        return Err(format!(
+            "CPU-shadow probe llvm-as failed: {}",
+            String::from_utf8_lossy(&result.stderr)
+        ));
+    }
+    Ok(())
+}
