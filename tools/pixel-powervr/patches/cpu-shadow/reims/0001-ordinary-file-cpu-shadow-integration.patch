index 0000000000000000000000000000000000000000..cfefa87f889a9bf13c0566ea2ab441920eeb89de
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_tile.rs
@@ -0,0 +1,292 @@
+//! Ordered float framebuffer fetch through the runtime's real tile-image path. AIR inputs
+//! are the repository-authored fbl_fetch_blend8_safe.ll and fragment_fetch.ll fixtures.
+//! Readback goes through an actual ordinary-memfd no-copy resource and delta scatter.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    use metal2vulkan::device::{VkExtension, VkFeature};
+    use metal2vulkan::metal::{
+        BarrierScope, PixelFormat, PrimitiveType, RenderStages, TextureUsage,
+    };
+    use metal2vulkan::pipeline::{
+        ColorAttachmentDescriptor, RenderPipelineDescriptor, SampledType, StageSource,
+        TileImageAttachmentUse,
+    };
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::host::HostPtr;
+    use reims_vgpu_core::platform::HostRange;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::raise::OnFault;
+    use reims_vgpu_vulkan::VulkanPlatform;
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+
+    const SIDE: u64 = 32;
+    const PIXEL_BYTES: usize = (SIDE * SIDE * 4) as usize;
+    const FILE_BYTES: usize = 16 * 1024;
+
+    struct Mapping(NonNull<u8>);
+    // SAFETY: an ownership token for ordinary shared file bytes, with no Rust byte references.
+    unsafe impl Send for Mapping {}
+    // SAFETY: every mutation in this fixture uses FileExt on ordinary RAM after GPU completion.
+    unsafe impl Sync for Mapping {}
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: the last resource owner releases the entire owned mapping.
+            unsafe { libc::munmap(self.0.as_ptr().cast(), FILE_BYTES) };
+        }
+    }
+
+    fn memory() -> io::Result<(File, Arc<Mapping>)> {
+        // SAFETY: fixed NUL-terminated name and valid flags; success gives a new owned fd.
+        let raw = unsafe {
+            libc::memfd_create(
+                c"reims-shadow-tile".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if raw < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: memfd_create returned one descriptor owned here.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(raw) });
+        file.set_len(FILE_BYTES as u64)?;
+        // SAFETY: size seals keep the RAM file writable and every retained range in bounds.
+        if unsafe {
+            libc::fcntl(
+                raw,
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: this new complete mapping belongs to the returned owner.
+        let pointer = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                FILE_BYTES,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                raw,
+                0,
+            )
+        };
+        if pointer == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        let Some(pointer) = NonNull::new(pointer.cast()) else {
+            // SAFETY: even an address-zero mapping would still be owned by this function.
+            unsafe { libc::munmap(pointer, FILE_BYTES) };
+            return Err(io::Error::other("null mapping"));
+        };
+        Ok((file, Arc::new(Mapping(pointer))))
+    }
+
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("REIMS_VGPU_CPU_SHADOW=1 required".into());
+        }
+        let vertex_air = arguments.next().ok_or("pass vertex.air and fragment.air")?;
+        let fragment_air = arguments.next().ok_or("pass vertex.air and fragment.air")?;
+        if arguments.next().is_some() {
+            return Err("unexpected extra argument".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        assert!(
+            device.raw.cpu_shadow_enabled(),
+            "immutable CPU-shadow mode was not selected"
+        );
+        let enables = device.raw.enabled();
+        if !enables.features.contains(&VkFeature::DynamicRendering)
+            || !enables
+                .features
+                .contains(&VkFeature::ShaderTileImageColorReadAccess)
+            || !enables
+                .extensions
+                .contains(&VkExtension::ExtShaderTileImage)
+        {
+            println!(
+                "RESULT=REIMS_CPU_SHADOW_TILE_UNSUPPORTED required=dynamic_rendering,shader_tile_image_color_read_access cpu_shadow_mode=true"
+            );
+            std::process::exit(3);
+        }
+        let vertex_library =
+            device
+                .raw
+                .new_library_with_compile_library(metal2vulkan::library::Library::from_air(
+                    &std::fs::read(vertex_air)?,
+                )?);
+        let fragment_library =
+            device
+                .raw
+                .new_library_with_compile_library(metal2vulkan::library::Library::from_air(
+                    &std::fs::read(fragment_air)?,
+                )?);
+        let vertex = vertex_library.new_function_with_name("fbl8_safe_vertex")?;
+        let fragment = fragment_library.new_function_with_name("fetch_scalar")?;
+        let mut descriptor =
+            RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+        descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+        descriptor.color_attachments[0] =
+            Some(ColorAttachmentDescriptor::new(PixelFormat::R32Float));
+        let pipeline = device
+            .raw
+            .new_render_pipeline_state(&descriptor, &rt::PipelineOptions::default())?;
+        let (file, mapping) = memory()?;
+        let _lease = lease_guest_memory([GuestRamFile {
+            host: mapping.0.as_ptr() as u64,
+            length: FILE_BYTES as u64,
+            fd: Arc::new(file.try_clone()?.into()),
+            offset: 0,
+        }]);
+        let hold = Arc::clone(&mapping);
+        // SAFETY: the no-copy deallocator retains the complete ordinary CPU mapping.
+        let range =
+            unsafe { HostRange::new(HostPtr::from_ptr(mapping.0.as_ptr()), PIXEL_BYTES as u64) };
+        let readback = device
+            .new_buffer_over_host_memory(
+                OnFault::Return,
+                range,
+                0,
+                Some(Box::new(move || drop(hold))),
+            )
+            .map_err(|e| format!("readback no-copy import raised: {e:?}"))?
+            .ok_or("readback no-copy import returned no buffer")?;
+        let queue = device.raw.new_command_queue()?;
+        for (case, clear, draws, barrier) in [(0, 1.0f32, 2u64, false), (1, 0.75f32, 3u64, true)] {
+            file.write_all_at(&vec![0xa5; FILE_BYTES], 0)?;
+            let mut texture =
+                rt::TextureDescriptor::texture_2d(PixelFormat::R32Float, SIDE, SIDE, false);
+            texture.usage = TextureUsage::RENDER_TARGET;
+            texture.resource_options = rt::ResourceOptions::private();
+            let target = device.raw.new_texture(&texture)?;
+            let mut pass = rt::RenderPassDescriptor::new();
+            let color = &mut pass.color_attachments[0];
+            color.texture = Some(target.clone());
+            color.load_action = rt::LoadAction::Clear;
+            color.store_action = rt::StoreAction::Store;
+            color.clear_color = rt::ClearColor::new(clear as f64, 0.0, 0.0, 1.0);
+            let before = device.raw.work_counts();
+            let command = queue.command_buffer()?;
+            let mut encoder = command.render_command_encoder(&pass)?;
+            encoder.set_render_pipeline_state(&pipeline)?;
+            for draw in 0..draws {
+                if barrier && draw != 0 {
+                    encoder.memory_barrier_with_scope(
+                        BarrierScope::RENDER_TARGETS,
+                        RenderStages::FRAGMENT,
+                        RenderStages::FRAGMENT,
+                    );
+                }
+                encoder.draw_primitives(PrimitiveType::Triangle, 0, 3, 1, 0)?;
+            }
+            encoder.end_encoding()?;
+            let mut blit = command.blit_command_encoder()?;
+            blit.copy_from_texture_to_buffer(
+                &target,
+                0,
+                0,
+                rt::Origin::new(0, 0, 0),
+                rt::Size::new(SIDE, SIDE, 1),
+                &readback.raw,
+                0,
+                SIDE * 4,
+                SIDE * SIDE * 4,
+                rt::BlitOption::None,
+            )?;
+            blit.end_encoding()?;
+            command.commit()?;
+            command
+                .wait_until_completed_for(Duration::from_secs(15))
+                .map_err(|_| "tile completion timed out")?;
+            if command.status() != rt::CommandBufferStatus::Completed {
+                return Err(format!(
+                    "tile command failed: {:?} / {:?}",
+                    command.error(),
+                    command.refusal()
+                )
+                .into());
+            }
+            let records = command.executions();
+            assert_eq!(records.len(), draws as usize);
+            for record in &records {
+                let rt::ExecutedPipeline::Render(pipeline) = record.pipeline() else {
+                    return Err("unexpected execution record".into());
+                };
+                assert_eq!(
+                    pipeline.graphics.tile_image_attachments,
+                    [TileImageAttachmentUse::new(0, SampledType::Float)]
+                );
+                assert!(pipeline.graphics.input_attachments.is_empty());
+                assert!(!pipeline.graphics.rasterization_order_attachment_access);
+                assert!(
+                    pipeline
+                        .requirements
+                        .features
+                        .contains(&VkFeature::ShaderTileImageColorReadAccess)
+                );
+            }
+            let after = device.raw.work_counts();
+            let begins = after.commands_replayed.cmd_begin_rendering
+                - before.commands_replayed.cmd_begin_rendering;
+            let ends = after.commands_replayed.cmd_end_rendering
+                - before.commands_replayed.cmd_end_rendering;
+            assert_eq!((begins, ends), (draws, draws));
+            let expected = clear * 0.5f32.powi(draws as i32);
+            let mut actual = vec![0; FILE_BYTES];
+            file.read_exact_at(&mut actual, 0)?;
+            for (index, pixel) in actual[..PIXEL_BYTES].chunks_exact(4).enumerate() {
+                assert_eq!(
+                    pixel,
+                    expected.to_bits().to_le_bytes(),
+                    "tile case {case} pixel {index}"
+                );
+            }
+            assert!(
+                actual[PIXEL_BYTES..].iter().all(|v| *v == 0xa5),
+                "readback scatter modified padding"
+            );
+            println!(
+                "CPU_SHADOW_TILE_PASS case={case} draws={draws} explicit_barriers={barrier} pixels=1024 expected={expected} dynamic_begins={begins} dynamic_ends={ends} padding_preserved=true"
+            );
+        }
+        let counts = device.raw.cpu_shadow_counts();
+        assert!(
+            counts.chunks_created > 0
+                && counts.views_created > 0
+                && counts.epochs_finished > 0
+                && counts.bytes_scattered > 0
+        );
+        println!("CPU_SHADOW_COUNTS={counts:?}");
+        println!(
+            "RESULT=REIMS_CPU_SHADOW_TILE_PASS actual_tile_metadata=true cases=2 pixels=2048 readback=ordinary_memfd cpu_atomics_on_gpu_memory=0"
+        );
+        Ok(())
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+pub(crate) fn run(
+    arguments: impl Iterator<Item = String>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    supported::run(arguments)
+}
+#[cfg(not(any(target_os = "linux", target_os = "android")))]
+pub(crate) fn run(
+    _arguments: impl Iterator<Item = String>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    Err("CPU-shadow tile qualification requires Linux or Android".into())
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    run(std::env::args().skip(1))
+}
