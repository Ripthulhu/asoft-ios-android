diff --git a/crates/reims-vgpu-vulkan/examples/cpu_shadow_arguments.rs b/crates/reims-vgpu-vulkan/examples/cpu_shadow_arguments.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bb5c24fcfdee45f342877875b170abcf1f3a9c2a
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/examples/cpu_shadow_arguments.rs
@@ -0,0 +1,345 @@
+//! Actual GPU texture and sampler handles loaded from a fragmented CPU-shadow argument buffer.
+//! Assemble the repository-authored `cpu_shadow_arguments/kernel.ll` with llvm-as and pass it
+//! as the only argument. This uses the guest's representation (resource IDs in ordinary RAM),
+//! without the separate host `ArgumentEncoder` API. No fallback mode is selected.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    use metal2vulkan::metal::{PixelFormat, ResourceUsage, TextureUsage};
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::host::HostPtr;
+    use reims_vgpu_core::platform::HostRange;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::platform::values::SamplerDesc;
+    use reims_vgpu_core::raise::OnFault;
+    use reims_vgpu_vulkan::VulkanPlatform;
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+
+    const PAGE: usize = 16 * 1024;
+    const BYTES: usize = 3 * PAGE;
+    const ORDER: [usize; 3] = [0, 2, 1];
+    const ARGUMENTS: usize = PAGE - 8;
+    const OUTPUT: usize = PAGE + 4096;
+    const TEXTURE_A: usize = 2 * PAGE - 256;
+    const TEXTURE_B: usize = 512;
+    const WIDTH: usize = 8;
+    const HEIGHT: usize = 16;
+    const WAIT: Duration = Duration::from_secs(15);
+
+    struct Mapping(NonNull<u8>);
+    // SAFETY: this is an ownership token, never a Rust reference to its shared mutable bytes.
+    unsafe impl Send for Mapping {}
+    // SAFETY: accesses use ordinary file I/O; no references to mapped memory are constructed.
+    unsafe impl Sync for Mapping {}
+
+    impl Mapping {
+        fn new(file: &File) -> io::Result<Self> {
+            // SAFETY: reserve the complete range exclusively before replacing its pages.
+            let first = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    BYTES,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if first == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let Some(first) = NonNull::<u8>::new(first.cast()) else {
+                // SAFETY: a successful zero-address reservation still belongs to us.
+                unsafe { libc::munmap(first, BYTES) };
+                return Err(io::Error::other("null mapping"));
+            };
+            let mapping = Self(first);
+            for (logical, physical) in ORDER.into_iter().enumerate() {
+                // SAFETY: the replacement is within our reservation, with a full aligned page
+                // of the size-sealed file on both 4 KiB and 16 KiB host page sizes.
+                let made = unsafe {
+                    libc::mmap(
+                        first.as_ptr().wrapping_add(logical * PAGE).cast(),
+                        PAGE,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_SHARED | libc::MAP_FIXED,
+                        file.as_raw_fd(),
+                        (physical * PAGE) as libc::off_t,
+                    )
+                };
+                if made == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+            }
+            Ok(mapping)
+        }
+
+        fn leases(&self, file: &File) -> io::Result<Vec<GuestRamFile>> {
+            let fd = Arc::new(file.try_clone()?.into());
+            Ok(ORDER
+                .into_iter()
+                .enumerate()
+                .map(|(logical, physical)| GuestRamFile {
+                    host: self.0.as_ptr().wrapping_add(logical * PAGE) as u64,
+                    length: PAGE as u64,
+                    fd: Arc::clone(&fd),
+                    offset: (physical * PAGE) as u64,
+                })
+                .collect())
+        }
+    }
+
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: no resource or command remains after its last ownership token is gone.
+            unsafe { libc::munmap(self.0.as_ptr().cast(), BYTES) };
+        }
+    }
+
+    fn memory() -> io::Result<File> {
+        // SAFETY: fixed NUL-terminated name; the returned descriptor is newly owned.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"reims-cpu-shadow-arguments".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: ownership of this successful descriptor is transferred exactly once.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        file.set_len(BYTES as u64)?;
+        // SAFETY: size seals preserve bounds while leaving ordinary RAM writable.
+        if unsafe {
+            libc::fcntl(
+                file.as_raw_fd(),
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(file)
+    }
+
+    fn paint(model: &mut [u8], logical: usize, bytes: &[u8]) {
+        for (offset, byte) in bytes.iter().enumerate() {
+            let at = logical + offset;
+            model[ORDER[at / PAGE] * PAGE + at % PAGE] = *byte;
+        }
+    }
+
+    fn texture(left: [u8; 4], right: [u8; 4]) -> Vec<u8> {
+        let mut bytes = Vec::with_capacity(WIDTH * HEIGHT * 4);
+        for _ in 0..HEIGHT {
+            for x in 0..WIDTH {
+                bytes.extend_from_slice(if x < WIDTH / 2 { &left } else { &right });
+            }
+        }
+        bytes
+    }
+
+    fn exact(actual: &[u8], expected: &[u8], case: &str) -> Result<(), Box<dyn Error>> {
+        if actual != expected {
+            let at = actual
+                .iter()
+                .zip(expected)
+                .position(|(a, b)| a != b)
+                .unwrap_or(actual.len().min(expected.len()));
+            return Err(format!(
+                "{case}: byte {at}, actual={:?}, expected={:?}",
+                actual.get(at),
+                expected.get(at)
+            )
+            .into());
+        }
+        println!(
+            "CPU_SHADOW_ARGUMENTS_PASS case={case} exact_bytes={}",
+            expected.len()
+        );
+        Ok(())
+    }
+
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        let air = arguments
+            .next()
+            .ok_or("argument-handle fixture requires authored AIR path")?;
+        if arguments.next().is_some() {
+            return Err("unexpected argument-handle fixture argument".into());
+        }
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("REIMS_VGPU_CPU_SHADOW=1 required".into());
+        }
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let file = memory()?;
+        let mapping = Arc::new(Mapping::new(&file)?);
+        let _lease = lease_guest_memory(mapping.leases(&file)?);
+        let hold = Arc::clone(&mapping);
+        // SAFETY: the deallocator retains the whole file mapping through all resource users.
+        let range = unsafe { HostRange::new(HostPtr::from_ptr(mapping.0.as_ptr()), BYTES as u64) };
+        let whole = device
+            .new_buffer_over_host_memory(
+                OnFault::Return,
+                range,
+                0,
+                Some(Box::new(move || drop(hold))),
+            )
+            .map_err(|e| format!("argument-buffer import raised: {e:?}"))?
+            .ok_or("argument-buffer import returned nil")?;
+        let mut descriptor = rt::TextureDescriptor::texture_2d(
+            PixelFormat::RGBA8Unorm,
+            WIDTH as u64,
+            HEIGHT as u64,
+            false,
+        );
+        descriptor.resource_options = rt::ResourceOptions::shared();
+        descriptor.usage = TextureUsage::SHADER_READ;
+        let a = whole
+            .raw
+            .new_texture(&descriptor, TEXTURE_A as u64, (WIDTH * 4) as u64)?;
+        let b = whole
+            .raw
+            .new_texture(&descriptor, TEXTURE_B as u64, (WIDTH * 4) as u64)?;
+        let sampler = |mode| {
+            device
+                .new_sampler_state(&SamplerDesc {
+                    s_address_mode: Some(mode),
+                    support_argument_buffers: Some(true),
+                    ..SamplerDesc::default()
+                })
+                .map_err(|e| format!("argument sampler raised: {e:?}"))?
+                .ok_or_else(|| "argument sampler returned nil".to_owned())
+        };
+        // Metal's Repeat=2, ClampToEdge=0; all other fields are nearest/no-mipmap defaults.
+        let repeat = sampler(2)?;
+        let clamp = sampler(0)?;
+        assert_ne!(repeat.gpu_resource_id(), clamp.gpu_resource_id());
+        assert_ne!(a.gpu_resource_id(), b.gpu_resource_id());
+        let library =
+            device
+                .raw
+                .new_library_with_compile_library(metal2vulkan::library::Library::from_air(
+                    &std::fs::read(air)?,
+                )?);
+        let function = library.new_function_with_name("cpu_shadow_arguments")?;
+        let pipeline = device
+            .raw
+            .new_compute_pipeline_state_with_function(&function, &rt::PipelineOptions::default())?;
+        let queue = device.raw.new_command_queue()?;
+        let readback = device.raw.new_buffer(16, rt::ResourceOptions::shared())?;
+        let mut expected = vec![0x6d; BYTES];
+        paint(
+            &mut expected,
+            TEXTURE_A,
+            &texture([255, 0, 0, 255], [0, 255, 0, 255]),
+        );
+        paint(
+            &mut expected,
+            TEXTURE_B,
+            &texture([0, 0, 255, 255], [255, 255, 0, 255]),
+        );
+        let made = device.raw.cpu_shadow_counts();
+
+        for (phase, selected, sampling, wanted) in [
+            ("first_handles", &a, &repeat, [1.0f32, 0.0, 0.0, 1.0]),
+            ("sampler_replaced", &a, &clamp, [0.0, 1.0, 0.0, 1.0]),
+            ("texture_replaced", &b, &clamp, [1.0, 1.0, 0.0, 1.0]),
+            ("texture_cpu_refresh", &a, &repeat, [1.0, 0.0, 1.0, 1.0]),
+        ] {
+            if phase == "texture_cpu_refresh" {
+                paint(
+                    &mut expected,
+                    TEXTURE_A,
+                    &texture([255, 0, 255, 255], [0, 255, 0, 255]),
+                );
+            }
+            // These are the two 64-bit resource IDs a guest writes into its argument bytes.
+            // The first ends at a page boundary; the second starts on another physical page.
+            paint(
+                &mut expected,
+                ARGUMENTS,
+                &selected.gpu_resource_id().0.to_le_bytes(),
+            );
+            paint(
+                &mut expected,
+                ARGUMENTS + 8,
+                &sampling.gpu_resource_id().0.to_le_bytes(),
+            );
+            paint(&mut expected, OUTPUT, &[0x39; 16]);
+            file.write_all_at(&expected, 0)?;
+            let command = queue.command_buffer()?;
+            let mut compute = command.compute_command_encoder()?;
+            compute.set_compute_pipeline_state(&pipeline)?;
+            compute.set_buffer(Some(&whole.raw), ARGUMENTS as u64, 0)?;
+            compute.set_buffer(Some(&whole.raw), OUTPUT as u64, 1)?;
+            // No set_texture or set_sampler_state: shader handle lookup is the only path.
+            compute.use_resources(
+                &[rt::ResourceRef::Texture(&a), rt::ResourceRef::Texture(&b)],
+                ResourceUsage::READ,
+            )?;
+            compute.dispatch_threads(rt::Size::new(1, 1, 1), rt::Size::new(1, 1, 1))?;
+            compute.end_encoding()?;
+            let mut blit = command.blit_command_encoder()?;
+            blit.copy_from_buffer_to_buffer(&whole.raw, OUTPUT as u64, &readback, 0, 16)?;
+            blit.end_encoding()?;
+            command.commit()?;
+            command
+                .wait_until_completed_for(WAIT)
+                .map_err(|_| "argument command timed out")?;
+            if command.status() != rt::CommandBufferStatus::Completed {
+                return Err(format!(
+                    "argument command failed: {:?} / {:?}",
+                    command.error(),
+                    command.refusal()
+                )
+                .into());
+            }
+            let wanted: Vec<u8> = wanted.into_iter().flat_map(f32::to_le_bytes).collect();
+            let contents = readback
+                .contents()
+                .ok_or("owned readback has no contents")?;
+            // SAFETY: its command completed, and the owned shared buffer is 16 bytes long.
+            let actual = unsafe { std::slice::from_raw_parts(contents.as_ptr(), 16) };
+            exact(actual, &wanted, phase)?;
+            paint(&mut expected, OUTPUT, &wanted);
+            let mut ordinary = vec![0; BYTES];
+            file.read_exact_at(&mut ordinary, 0)?;
+            exact(&ordinary, &expected, &format!("{phase}_whole_file"))?;
+        }
+        let counts = device.raw.cpu_shadow_counts();
+        assert_eq!(counts.epochs_prepared - made.epochs_prepared, 4);
+        assert_eq!(counts.epochs_finished - made.epochs_finished, 4);
+        assert!(counts.bytes_scattered > made.bytes_scattered);
+        println!("CPU_SHADOW_ARGUMENTS_COMPLETE handles=texture_and_sampler {counts:?}");
+        Ok(())
+    }
+}
+
+/// Run this case directly or as the combined CPU-shadow qualifier's `arguments` subcommand.
+pub fn run(arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        supported::run(arguments)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    {
+        let _ = arguments;
+        Err("CPU-shadow qualification requires Linux or Android".into())
+    }
+}
+
+#[allow(dead_code)] // the combined qualification executable includes this example as a module
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    run(std::env::args().skip(1))
+}
