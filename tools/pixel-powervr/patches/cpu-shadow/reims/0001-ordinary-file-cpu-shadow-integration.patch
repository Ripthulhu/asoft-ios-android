+//! Real reims no-copy imports over two ordinary-memfd aliases, followed by a Vulkan compute
+//! dispatch. Assemble `cpu_shadow_alias/kernel.ll` with llvm-as and pass that AIR file.
+//! `REIMS_VGPU_CPU_SHADOW=1` is required; this executable never selects a fallback backend.
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod supported {
+    use std::error::Error;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    use std::os::unix::fs::FileExt as _;
+    use std::ptr::NonNull;
+    use std::sync::{Arc, mpsc};
+    use std::time::{Duration, Instant};
+
+    use metal2vulkan_runtime as rt;
+    use reims_vgpu_core::host::HostPtr;
+    use reims_vgpu_core::platform::HostRange;
+    use reims_vgpu_core::platform::device::GpuDevice as _;
+    use reims_vgpu_core::raise::OnFault;
+    use reims_vgpu_vulkan::VulkanPlatform;
+    use reims_vgpu_vulkan::os::{GuestRamFile, lease_guest_memory};
+
+    const REGION: usize = 16 * 1024;
+    const ORDER: [usize; 4] = [0, 2, 1, 2];
+    const CPU_WORD: u32 = 0xa1b2c3d4;
+    const WAIT: Duration = Duration::from_secs(5);
+
+    struct Mapping {
+        at: NonNull<u8>,
+        length: usize,
+    }
+
+    // SAFETY: Mapping owns only a shared ordinary-file mapping, kept by each no-copy buffer's
+    // deallocator. CPU reads and writes use FileExt; Drop runs after the final pointer user.
+    unsafe impl Send for Mapping {}
+    // SAFETY: sharing its address and lifetime adds no Rust reference to its mutable bytes.
+    unsafe impl Sync for Mapping {}
+
+    impl Mapping {
+        fn new(file: &File, length: usize) -> io::Result<Self> {
+            // SAFETY: a full shared mapping of the size-sealed ordinary file, owned here.
+            let at = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    length,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_SHARED,
+                    file.as_raw_fd(),
+                    0,
+                )
+            };
+            if at == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let Some(at) = NonNull::new(at.cast()) else {
+                // SAFETY: even address zero would be our newly created complete mapping.
+                unsafe { libc::munmap(at, length) };
+                return Err(io::Error::other(
+                    "mmap unexpectedly returned a null address",
+                ));
+            };
+            Ok(Self { at, length })
+        }
+
+        fn permuted(file: &File, file_base: usize) -> io::Result<Self> {
+            let length = ORDER.len() * REGION;
+            // SAFETY: a new inaccessible reservation owned here; no pointer is published yet.
+            let raw = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    length,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                    -1,
+                    0,
+                )
+            };
+            if raw == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            let Some(at) = NonNull::new(raw.cast::<u8>()) else {
+                // SAFETY: even address zero would be our newly created complete reservation.
+                unsafe { libc::munmap(raw, length) };
+                return Err(io::Error::other("mmap returned a null reservation"));
+            };
+            let mapping = Self { at, length };
+            for (logical, physical) in ORDER.into_iter().enumerate() {
+                // SAFETY: each full 16KiB region replaces only this owner's reservation, before
+                // any CPU or GPU caller sees it. Every physical region is inside the memfd.
+                let mapped = unsafe {
+                    libc::mmap(
+                        mapping.at.as_ptr().add(logical * REGION).cast(),
+                        REGION,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_SHARED | libc::MAP_FIXED,
+                        file.as_raw_fd(),
+                        (file_base + physical * REGION) as libc::off_t,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+            }
+            Ok(mapping)
+        }
+    }
+
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: the last mapping owner is gone after every no-copy user released it.
+            unsafe { libc::munmap(self.at.as_ptr().cast(), self.length) };
+        }
+    }
+
+    fn memory(bytes: usize) -> io::Result<File> {
+        // SAFETY: fixed NUL-terminated name and valid flags. Success gives one owned fd.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"reims-cpu-shadow-alias".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: memfd_create returned a new descriptor owned only here.
+        let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        file.set_len(bytes as u64)?;
+        // SAFETY: sealing the size of the new ordinary file; its bytes remain writable.
+        if unsafe {
+            libc::fcntl(
+                file.as_raw_fd(),
+                libc::F_ADD_SEALS,
+                libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(file)
+    }
+
+    pub(super) fn run(mut arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+        if std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1") {
+            return Err("run with REIMS_VGPU_CPU_SHADOW=1".into());
+        }
+        let air = arguments
+            .next()
+            .ok_or("pass the assembled kernel AIR file")?;
+        let (fragmented, chunk_boundary) = match arguments.next().as_deref() {
+            None => (false, false),
+            Some("--fragmented") => (true, false),
+            Some("--chunk-boundary") => (true, true),
+            Some(_) => return Err("expected optional --fragmented or --chunk-boundary".into()),
+        };
+        if arguments.next().is_some() {
+            return Err("unexpected extra argument".into());
+        }
+        // The bounded chunk-boundary case deliberately straddles the runtime's 1MiB
+        // canonical allocation boundary while leaving a large unrelated file prefix.
+        let file_base = if chunk_boundary {
+            1024 * 1024 - REGION
+        } else {
+            0
+        };
+        let live_bytes = if fragmented { 3 * REGION } else { REGION };
+        let bytes = file_base + live_bytes;
+        let alias_offset = file_base + if fragmented { 2 * REGION } else { 4096 };
+        let alias_bytes = if fragmented { REGION } else { 8192 };
+        let cpu_offset = (alias_offset + 64) as u64;
+        let final_counter = if fragmented { 0x55667788u32 } else { 55 };
+        let device = VulkanPlatform::system_default_device().ok_or("no Vulkan device")?;
+        let file = memory(bytes)?;
+        let a = Arc::new(Mapping::new(&file, bytes)?);
+        let b = Arc::new(if fragmented {
+            Mapping::permuted(&file, file_base)?
+        } else {
+            Mapping::new(&file, bytes)?
+        });
+        assert_ne!(a.at, b.at);
+        let mut regions = vec![GuestRamFile {
+            host: a.at.as_ptr() as u64,
+            length: bytes as u64,
+            fd: Arc::new(file.try_clone()?.into()),
+            offset: 0,
+        }];
+        if fragmented {
+            for (logical, physical) in ORDER.into_iter().enumerate() {
+                regions.push(GuestRamFile {
+                    host: b.at.as_ptr() as u64 + (logical * REGION) as u64,
+                    length: REGION as u64,
+                    fd: Arc::new(file.try_clone()?.into()),
+                    offset: (file_base + physical * REGION) as u64,
+                });
+            }
+        } else {
+            regions.push(GuestRamFile {
+                host: b.at.as_ptr() as u64,
+                length: bytes as u64,
+                fd: Arc::new(file.try_clone()?.into()),
+                offset: 0,
+            });
+        }
+        let _lease = lease_guest_memory(regions);
+        let mut expected = vec![0x3c; bytes];
+        expected[alias_offset..alias_offset + 4].copy_from_slice(&37u32.to_le_bytes());
+        file.write_all_at(&expected, 0)?;
+
+        let make = |mapping: &Arc<Mapping>, offset: usize, length: usize| {
+            let hold = Arc::clone(mapping);
+            let pointer = HostPtr::from_ptr(mapping.at.as_ptr().wrapping_add(offset));
+            // SAFETY: the deallocator owns a mapping reference, so all bytes stay mapped until
+            // every command/resource using this no-copy buffer has released them.
+            let range = unsafe { HostRange::new(pointer, length as u64) };
+            device
+                .new_buffer_over_host_memory(
+                    OnFault::Return,
+                    range,
+                    0,
+                    Some(Box::new(move || drop(hold))),
+                )
+                .map_err(|error| format!("reims no-copy import raised: {error:?}"))?
+                .ok_or_else(|| "reims no-copy import returned no buffer".to_owned())
+        };
+        let whole = make(if fragmented { &b } else { &a }, 0, b.length)?;
+        let alias = make(if fragmented { &a } else { &b }, alias_offset, alias_bytes)?;
+        if fragmented {
+            let dynamic_address = whole.raw.gpu_address().0 + (REGION - 4) as u64;
+            expected[file_base + 128..file_base + 136]
+                .copy_from_slice(&dynamic_address.to_le_bytes());
+            file.write_all_at(
+                &expected[file_base + 128..file_base + 136],
+                (file_base + 128) as u64,
+            )?;
+        }
+        let made = device.raw.cpu_shadow_counts();
+        assert_eq!(
+            made.chunks_created,
+            if chunk_boundary { 2 } else { 1 },
+            "overlap must use only the distinct canonical file chunks"
+        );
+        assert_eq!(
+            made.views_created, 2,
+            "both real no-copy resources must use shadows"
+        );
+
+        let library =
+            device
+                .raw
+                .new_library_with_compile_library(metal2vulkan::library::Library::from_air(
+                    &std::fs::read(air)?,
+                )?);
+        let function = library.new_function_with_name(if fragmented {
+            "cpu_shadow_fragmented"
+        } else {
+            "cpu_shadow_alias"
+        })?;
+        let pipeline = device
+            .raw
+            .new_compute_pipeline_state_with_function(&function, &rt::PipelineOptions::default())?;
+        // A non-granule-sized owned root gives the dynamic one-past case a guard gap before
+        // the next aligned GPU allocation. An untyped address does not retain provenance.
+        let result_bytes = if fragmented { 125 } else { 8 };
+        let result = device
+            .raw
+            .new_buffer(result_bytes, rt::ResourceOptions::shared())?;
+        if fragmented {
+            for (offset, address) in [
+                (136, 0u64),
+                (144, u64::MAX - 4095),
+                (152, result.gpu_address().0 + result_bytes),
+            ] {
+                expected[file_base + offset..file_base + offset + 8]
+                    .copy_from_slice(&address.to_le_bytes());
+                file.write_all_at(
+                    &expected[file_base + offset..file_base + offset + 8],
+                    (file_base + offset) as u64,
+                )?;
+            }
+        }
+        let queue = device.raw.new_command_queue()?;
+        let command = queue.command_buffer()?;
+        if fragmented {
+            let mut fill = command.blit_command_encoder()?;
+            fill.fill_buffer(&result, 0..result_bytes, 0x5a)?;
+            fill.end_encoding()?;
+        }
+        let mut compute = command.compute_command_encoder()?;
+        compute.set_compute_pipeline_state(&pipeline)?;
+        compute.set_buffer(Some(&whole.raw), 0, 0)?;
+        compute.set_buffer(Some(&alias.raw), 0, 1)?;
+        compute.set_buffer(Some(&result), 0, 2)?;
+        if fragmented {
+            compute.use_resource(
+                rt::ResourceRef::Buffer(&whole.raw),
+                metal2vulkan::metal::ResourceUsage::READ
+                    | metal2vulkan::metal::ResourceUsage::WRITE,
+            )?;
+            compute.use_resource(
+                rt::ResourceRef::Buffer(&result),
+                metal2vulkan::metal::ResourceUsage::READ
+                    | metal2vulkan::metal::ResourceUsage::WRITE,
+            )?;
+        }
+        compute.dispatch_threads(rt::Size::new(1, 1, 1), rt::Size::new(1, 1, 1))?;
+        compute.end_encoding()?;
+        let event = device.raw.new_shared_event()?;
+        command.encode_signal_event((&event).into(), 1)?;
+
+        // The callback must see an uploaded epoch that has not scattered. Its ordinary CPU
+        // write is in the GPU resource's range but disjoint from the GPU counter's bytes.
+        let callback_file = file.try_clone()?;
+        let callback_device = device.raw.clone();
+        let (sent, observed) = mpsc::sync_channel(1);
+        command.add_submission_handler(Box::new(move |_| {
+            let counts = callback_device.cpu_shadow_counts();
+            let result = callback_file
+                .write_all_at(&CPU_WORD.to_le_bytes(), cpu_offset)
+                .map(|_| counts);
+            let _ = sent.send(result);
+        }))?;
+        command.commit()?;
+        let deadline = Instant::now() + WAIT;
+        while event.signaled_value() < 1 {
+            if Instant::now() >= deadline {
+                return Err(format!("shared event timed out: {:?}", command.error()).into());
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        let mut visible = [0; 4];
+        file.read_exact_at(&mut visible, alias_offset as u64)?;
+        assert_eq!(
+            u32::from_le_bytes(visible),
+            final_counter,
+            "event preceded GPU delta scatter"
+        );
+        command
+            .wait_until_completed_for(WAIT)
+            .map_err(|_| "command completion timed out")?;
+        assert_eq!(
+            command.status(),
+            rt::CommandBufferStatus::Completed,
+            "{:?}",
+            command.error()
+        );
+        let during = observed.recv_timeout(WAIT)??;
+        assert!(
+            during.epochs_prepared > made.epochs_prepared,
+            "CPU edit preceded snapshot"
+        );
+        assert_eq!(
+            during.epochs_finished, made.epochs_finished,
+            "CPU edit followed scatter"
+        );
+
+        let contents = result.contents().ok_or("result has no CPU contents")?;
+        // SAFETY: the result buffer's full logical bytes are mapped and GPU writes completed.
+        let output =
+            unsafe { std::slice::from_raw_parts(contents.as_ptr(), result_bytes as usize) };
+        let words: &[u32] = if fragmented {
+            &[
+                37, 44, 55, 0x3c3c3c3c, 68, 0x3c3c3c3c, 0x3c3c3c3c, 0x3c3c3c3c, 68, 0x55667788,
+                0x3c3c3c3c, 0x55667788, 0x3c3c3c3c, 0x3c3c3c3c, 0x3c3c3c3c, 0x55667788, 0x55667788,
+                0, 0, 0, 0, 0, 0, 0, 0, 0,
+            ]
+        } else {
+            &[37, 44]
+        };
+        let mut output_expected: Vec<u8> =
+            words.iter().flat_map(|word| word.to_le_bytes()).collect();
+        output_expected.resize(result_bytes as usize, 0x5a);
+        assert_eq!(
+            output, output_expected,
+            "same-dispatch alias or cross-page load failed"
+        );
+        if fragmented {
+            for (offset, word) in [
+                (3 * REGION - 4, 0x12345678u32),
+                (REGION, 0x23456789),
+                (REGION + 4, 0x3456789a),
+                (REGION + 8, 0x456789ab),
+                (2 * REGION - 4, 0x11223344),
+            ] {
+                expected[file_base + offset..file_base + offset + 4]
+                    .copy_from_slice(&word.to_le_bytes());
+            }
+        }
+        expected[alias_offset..alias_offset + 4].copy_from_slice(&final_counter.to_le_bytes());
+        expected[cpu_offset as usize..cpu_offset as usize + 4]
+            .copy_from_slice(&CPU_WORD.to_le_bytes());
+        let mut actual = vec![0; bytes];
+        file.read_exact_at(&mut actual, 0)?;
+        if let Some((offset, (actual, expected))) = actual
+            .iter()
+            .zip(&expected)
+            .enumerate()
+            .find(|(_, (actual, expected))| actual != expected)
+        {
+            return Err(format!(
+                "CPU-shadow RAM differs at byte {offset:#x}: got {actual:#04x}, expected {expected:#04x}"
+            )
+            .into());
+        }
+        let counts = device.raw.cpu_shadow_counts();
+        assert!(counts.epochs_finished > made.epochs_finished);
+        assert_eq!(
+            counts.bytes_uploaded, live_bytes as u64,
+            "overlapping/repeated pages or unused file bytes uploaded"
+        );
+        assert!(counts.bytes_scattered > 0);
+        println!("CPU_SHADOW_COUNTS={counts:?}");
+        println!(
+            "RESULT=REIMS_CPU_SHADOW_ALIAS_PASS fragmented={fragmented} chunk_boundary={chunk_boundary} file_counter={final_counter} bytes_checked={bytes} disjoint_cpu_write=preserved event_after_scatter=true cpu_atomics_on_gpu_memory=0"
+        );
+        Ok(())
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+pub(crate) fn run(
+    arguments: impl Iterator<Item = String>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    supported::run(arguments)
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "android")))]
+pub(crate) fn run(
+    _arguments: impl Iterator<Item = String>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    Err("CPU-shadow alias integration requires Linux or Android".into())
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    run(std::env::args().skip(1))
+}
