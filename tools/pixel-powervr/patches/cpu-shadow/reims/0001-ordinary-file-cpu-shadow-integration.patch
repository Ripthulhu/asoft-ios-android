+++ b/crates/reims-vgpu-vulkan/src/os/linux/shadow.rs
@@ -0,0 +1,342 @@
+//! Ordinary CPU files behind the runtime's explicit CPU-shadow backend.
+//!
+//! `REIMS_VGPU_CPU_SHADOW=1` routes real guest buffer and heap imports here. The CPU
+//! keeps its ordinary memfd mappings. The runtime owns separate Vulkan storage,
+//! preserves file-page identity across aliases and synchronizes at GPU batch
+//! boundaries; these descriptors are never opaque GPU handles or dma-bufs.
+//!
+//! A source resolves both eager and deferred views through the existing backing
+//! table. It captures the file offsets at import time and gives the runtime owned
+//! descriptors. Replacing or releasing the CPU alias therefore cannot retarget a
+//! live GPU resource. The caller's normal keep-alive still retains its CPU view.
+//! Private zero pieces receive fresh ordinary backing for this import, matching
+//! the existing dma-buf path: a GPU write must not mutate the shared zero block.
+//! Unregistered pages and files that can shrink are refused explicitly.
+
+use std::io;
+use std::os::fd::AsRawFd as _;
+use std::sync::{Arc, OnceLock};
+
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::num::ToU64 as _;
+use reims_vgpu_core::raise::death::{DeathId, DeathKind, fatal_with_detail};
+
+use super::files::{self, Backing};
+use super::vm;
+
+/// Explicit opt-in; an invalid spelling must not silently select another backend.
+pub(crate) fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        let value = match std::env::var("REIMS_VGPU_CPU_SHADOW") {
+            Ok(value) => Some(value),
+            Err(std::env::VarError::NotPresent) => None,
+            Err(std::env::VarError::NotUnicode(_)) => invalid_policy(),
+        };
+        match parse(value.as_deref()) {
+            Ok(enabled) => enabled,
+            Err(_) => invalid_policy(),
+        }
+    })
+}
+
+fn invalid_policy() -> ! {
+    fatal_with_detail(
+        DeathId::Platform {
+            kind: DeathKind::Abort,
+            call: "REIMS_VGPU_CPU_SHADOW",
+        },
+        "REIMS_VGPU_CPU_SHADOW must be 0 or 1",
+    )
+}
+
+fn parse(value: Option<&str>) -> Result<bool, &'static str> {
+    match value {
+        None | Some("0") => Ok(false),
+        Some("1") => Ok(true),
+        Some(_) => Err("REIMS_VGPU_CPU_SHADOW must be 0 or 1"),
+    }
+}
+
+/// The backing table's file bytes, in the logical import's order. The runtime
+/// canonicalizes file identity, so duplicated descriptors and repeated physical
+/// pages retain their aliases rather than becoming independent copies.
+pub(super) fn source() -> rt::CpuShadowSource {
+    Arc::new(|request: rt::CpuShadowRequest| {
+        of_range(
+            request.start.as_ptr().addr().to_u64(),
+            request.length,
+            request.granule,
+        )
+    })
+}
+
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, message)
+}
+
+fn of_range(first: u64, length: u64, granule: u64) -> io::Result<Vec<rt::CpuShadowChunk>> {
+    let page = vm::page_size();
+    if length == 0
+        || first.checked_add(length).is_none()
+        || !granule.is_power_of_two()
+        || granule > page
+        || !page.is_multiple_of(granule)
+    {
+        return Err(invalid(
+            "CPU-shadow request has an invalid range or page granule",
+        ));
+    }
+    let pieces = files::pieces(first, length)
+        .ok_or_else(|| invalid("CPU-shadow bytes have no registered ordinary file backing"))?;
+    let zero_bytes = pieces
+        .iter()
+        .filter(|p| super::import::zeros(&p.backing.fd))
+        .try_fold(0u64, |total, p| {
+            total
+                .checked_next_multiple_of(page)?
+                .checked_add(p.backing.offset % page)?
+                .checked_add(p.length)
+        })
+        .ok_or_else(|| invalid("CPU-shadow private-zero size overflow"))?;
+    let zeros = (zero_bytes != 0).then(|| vm::memfd(zero_bytes));
+    let mut zero_at = 0u64;
+    let mut runs: Vec<(Backing, u64)> = Vec::new();
+    for piece in pieces {
+        if piece.prot & libc::PROT_READ == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "CPU-shadow source bytes are not readable by the caller",
+            ));
+        }
+        let backing = match &zeros {
+            Some(zeros) if super::import::zeros(&piece.backing.fd) => {
+                // Preserve a sub-page pointer's alignment inside the new file. The checked
+                // sizing pass above established that these additions cannot overflow.
+                zero_at = zero_at.next_multiple_of(page) + piece.backing.offset % page;
+                let backing = Backing {
+                    fd: Arc::clone(zeros),
+                    offset: zero_at,
+                };
+                zero_at += piece.length;
+                backing
+            }
+            _ => piece.backing,
+        };
+        let end = backing
+            .offset
+            .checked_add(piece.length)
+            .ok_or_else(|| invalid("CPU-shadow file range overflow"))?;
+        // SAFETY: this backing holds an open descriptor while the kernel inspects it.
+        let seals = unsafe { libc::fcntl(backing.fd.as_raw_fd(), libc::F_GET_SEALS) };
+        if seals < 0 || seals & libc::F_SEAL_SHRINK == 0 {
+            return Err(invalid(
+                "CPU-shadow backing must be an ordinary size-sealed memfd",
+            ));
+        }
+        if seals & (libc::F_SEAL_WRITE | libc::F_SEAL_FUTURE_WRITE) != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "CPU-shadow backing forbids GPU delta scatter",
+            ));
+        }
+        // SAFETY: as above. F_GETFL does not mutate the descriptor or its flags.
+        let flags = unsafe { libc::fcntl(backing.fd.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0 || flags & libc::O_ACCMODE != libc::O_RDWR {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "CPU-shadow backing must permit GPU delta scatter",
+            ));
+        }
+        let file = std::fs::File::from(backing.fd.try_clone()?);
+        if file.metadata()?.len() < end {
+            return Err(invalid("CPU-shadow piece extends past its file"));
+        }
+        match runs.last_mut() {
+            Some((last, bytes))
+                if Arc::ptr_eq(&last.fd, &backing.fd)
+                    && last.offset.checked_add(*bytes) == Some(backing.offset) =>
+            {
+                *bytes += piece.length;
+            }
+            _ => runs.push((backing, piece.length)),
+        }
+    }
+    runs.into_iter()
+        .map(|(backing, length)| {
+            Ok(rt::CpuShadowChunk {
+                fd: backing.fd.try_clone()?,
+                offset: backing.offset,
+                length,
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::os::unix::fs::FileExt as _;
+
+    use reims_vgpu_core::platform::os::vm::{HostVm as _, VmProt};
+
+    use super::super::LinuxVm;
+    use super::*;
+    use crate::os::HostPointerExtension;
+
+    fn read(chunk: &rt::CpuShadowChunk) -> u8 {
+        let mut value = [0];
+        std::fs::File::from(chunk.fd.try_clone().unwrap())
+            .read_exact_at(&mut value, chunk.offset)
+            .unwrap();
+        value[0]
+    }
+
+    fn write(chunk: &rt::CpuShadowChunk, value: u8) {
+        std::fs::File::from(chunk.fd.try_clone().unwrap())
+            .write_all_at(&[value], chunk.offset)
+            .unwrap();
+    }
+
+    #[test]
+    fn cpu_shadow_policy_is_explicit_and_rejects_misspellings() {
+        assert_eq!(parse(None), Ok(false));
+        assert_eq!(parse(Some("0")), Ok(false));
+        assert_eq!(parse(Some("1")), Ok(true));
+        assert!(parse(Some("yes")).is_err());
+        assert!(parse(Some("")).is_err());
+    }
+
+    #[test]
+    fn cpu_shadow_reordered_and_repeated_pages_keep_file_identity() {
+        let vm = LinuxVm::new();
+        let page = vm.page_size();
+        let original = vm::allocate_aliasable(3 * page).unwrap();
+        let first = original.addr().to_u64();
+        let original_chunks = of_range(first, 3 * page, page).unwrap();
+        let file = std::fs::File::from(original_chunks[0].fd.try_clone().unwrap());
+        for (index, value) in [0x11, 0x22, 0x33].into_iter().enumerate() {
+            file.write_all_at(&[value], index.to_u64() * page).unwrap();
+        }
+        let view = vm.allocate_anywhere(3 * page).unwrap();
+        for (to, from) in [2, 0, 2].into_iter().enumerate() {
+            vm.remap_shared_overwrite(
+                view.wrapping_add(to.to_u64() * page),
+                original.wrapping_add(from * page),
+                page,
+            )
+            .unwrap();
+        }
+        let chunks = of_range(view.addr().to_u64(), 3 * page, page).unwrap();
+        assert_eq!(
+            chunks.iter().map(|c| c.offset).collect::<Vec<_>>(),
+            [2 * page, 0, 2 * page]
+        );
+        assert_eq!(
+            chunks.iter().map(read).collect::<Vec<_>>(),
+            [0x33, 0x11, 0x33]
+        );
+        write(&chunks[0], 0xa7);
+        assert_eq!(
+            read(&chunks[2]),
+            0xa7,
+            "repeated physical page remains an alias"
+        );
+        assert!(vm.deallocate(view, 3 * page).is_success());
+        assert!(vm.deallocate(original, 3 * page).is_success());
+        assert_eq!(
+            read(&chunks[0]),
+            0xa7,
+            "owned descriptors retain the captured pages"
+        );
+    }
+
+    #[test]
+    fn cpu_shadow_one_read_only_deferred_page_needs_no_twin() {
+        let vm = LinuxVm::new();
+        let page = vm.page_size();
+        let original = vm::allocate_aliasable(page).unwrap();
+        vm.protect_max(original, page, VmProt::READ).unwrap();
+        assert!(super::super::deferred::make_lazy(
+            original.addr().to_u64(),
+            page
+        ));
+        let at = std::ptr::NonNull::new(original.as_ptr()).unwrap();
+        let view = super::super::import::import_view(at, page, HostPointerExtension::CpuShadow);
+        assert_eq!(view.at(), at);
+        assert!(view.writes_kept());
+        let chunks = of_range(original.addr().to_u64(), page, page).unwrap();
+        assert_eq!(chunks.len(), 1);
+        assert_eq!(
+            files::mappings_between(original.addr().to_u64(), original.addr().to_u64() + page),
+            0
+        );
+        assert!(
+            files::pieces(original.addr().to_u64(), page)
+                .unwrap()
+                .iter()
+                .all(|p| p.prot == libc::PROT_READ)
+        );
+        drop(view);
+        assert!(vm.deallocate(original, page).is_success());
+    }
+
+    #[test]
+    fn cpu_shadow_sub_page_view_captures_only_its_bytes() {
+        let vm = LinuxVm::new();
+        let page = vm.page_size();
+        let original = vm::allocate_aliasable(2 * page).unwrap();
+        let start = original.addr().to_u64() + 17;
+        let chunks = of_range(start, page + 23, page).unwrap();
+        assert_eq!(chunks.len(), 1);
+        assert_eq!((chunks[0].offset, chunks[0].length), (17, page + 23));
+        write(&chunks[0], 0x62);
+        let same = of_range(start, 1, page).unwrap();
+        assert_eq!(read(&same[0]), 0x62);
+        assert!(vm.deallocate(original, 2 * page).is_success());
+    }
+
+    #[test]
+    fn cpu_shadow_refuses_a_nonreadable_cpu_view() {
+        let vm = LinuxVm::new();
+        let page = vm.page_size();
+        let original = vm::allocate_aliasable(page).unwrap();
+        vm.protect_max(original, page, VmProt::NONE).unwrap();
+        let error = of_range(original.addr().to_u64(), page, page).unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+        assert!(vm.deallocate(original, page).is_success());
+    }
+
+    #[test]
+    fn cpu_shadow_private_zeros_do_not_modify_the_shared_zero_source() {
+        let vm = LinuxVm::new();
+        let page = vm.page_size();
+        let original = super::super::import::allocate_zeros(page).unwrap();
+        let a = of_range(original.addr().to_u64(), page, page).unwrap();
+        let b = of_range(original.addr().to_u64(), page, page).unwrap();
+        write(&a[0], 0xe5);
+        assert_eq!(read(&a[0]), 0xe5);
+        assert_eq!(read(&b[0]), 0);
+        let backing = files::pieces(original.addr().to_u64(), page).unwrap();
+        let mut byte = [1];
+        std::fs::File::from(backing[0].backing.fd.try_clone().unwrap())
+            .read_exact_at(&mut byte, 0)
+            .unwrap();
+        assert_eq!(byte, [0]);
+        let sub = of_range(original.addr().to_u64() + 17, 29, page).unwrap();
+        assert_eq!((sub[0].offset, sub[0].length), (17, 29));
+        assert_eq!(read(&sub[0]), 0);
+        assert!(vm.deallocate(original, page).is_success());
+    }
+
+    #[test]
+    fn cpu_shadow_rejects_unregistered_or_malformed_memory() {
+        let vm = LinuxVm::new();
+        let page = vm.page_size();
+        let anonymous = vm.allocate_anywhere(page).unwrap();
+        assert!(of_range(anonymous.addr().to_u64(), page, page).is_err());
+        assert!(of_range(anonymous.addr().to_u64() + 1, page, page).is_err());
+        assert!(of_range(anonymous.addr().to_u64(), 0, page).is_err());
+        assert!(of_range(anonymous.addr().to_u64(), page, 3).is_err());
+        assert!(vm.deallocate(anonymous, page).is_success());
+    }
+}
