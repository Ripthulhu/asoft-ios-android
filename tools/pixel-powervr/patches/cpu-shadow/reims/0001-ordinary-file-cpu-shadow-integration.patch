+!36 = !{!"half", !37, i64 0}
+!37 = !{!"omnipotent char", !38, i64 0}
+!38 = !{!"Simple C++ TBAA"}
+!39 = !{!40}
+!40 = distinct !{!40, !41, !"air-alias-scope-arg(2)"}
+!41 = distinct !{!41, !"air-alias-scopes(fbl8_safe_loaded)"}
+!42 = !{!43, !43, i64 0}
+!43 = !{!"float", !37, i64 0}
+!44 = !{!45}
+!45 = distinct !{!45, !46, !"air-alias-scope-arg(2)"}
+!46 = distinct !{!46, !"air-alias-scopes(fbl8_safe_loaded_float)"}
+!47 = !{!48}
+!48 = distinct !{!48, !49, !"air-alias-scope-arg(2)"}
+!49 = distinct !{!49, !"air-alias-scopes(fbl8_safe_product)"}
diff --git a/crates/reims-vgpu-vulkan/src/cpu_shadow_probe.rs b/crates/reims-vgpu-vulkan/src/cpu_shadow_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e4871bbd5c3df3591d965e7bb4bb5d7d9a4900ec
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/cpu_shadow_probe.rs
@@ -0,0 +1,490 @@
+//! A small installed-runtime probe, deliberately separate from device capability answers.
+//!
+//! The caller selects the loader and CPU-shadow mode before any platform use, and runs this
+//! in a fresh disposable process with an external deadline. A compiler or driver call cannot
+//! be cancelled safely. The bounded GPU waits below complement that process deadline. Passing
+//! establishes these exact operations on the selected runtime; it does not establish a guest
+//! boot, native CPU execution, or the larger qualification suite's coverage.
+
+use std::fmt;
+use std::fs::File;
+use std::io;
+use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+use std::os::unix::fs::FileExt as _;
+use std::ptr::NonNull;
+use std::sync::{Arc, mpsc};
+use std::time::{Duration, Instant};
+
+use ash::vk;
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::host::HostPtr;
+use reims_vgpu_core::platform::HostRange;
+use reims_vgpu_core::platform::device::GpuDevice as _;
+use reims_vgpu_core::raise::OnFault;
+
+use crate::VulkanPlatform;
+use crate::os::{GuestRamFile, lease_guest_memory};
+
+const PAGE: usize = 16 * 1024;
+const BYTES: usize = 3 * PAGE;
+const ORDER: [usize; 3] = [0, 2, 1];
+const COUNTER: usize = 2 * PAGE;
+const CPU_EDIT: usize = COUNTER + 64;
+const CPU_WORD: u32 = 0xa1b2c3d4;
+const CHECKS: u64 = 0x7f;
+
+/// Same-device identity and actual successful work. No field is an extension-based guess.
+#[derive(Clone, Debug)]
+pub struct Report {
+    /// All seven version-one checks, set only after their exact comparisons succeed.
+    pub checks_passed: u64,
+    /// The selected physical device's vendor identifier.
+    pub vendor_id: u32,
+    /// The selected physical device's device identifier.
+    pub device_id: u32,
+    /// The physical device's packed Vulkan API version.
+    pub api_version: u32,
+    /// The physical device's driver-defined version value.
+    pub driver_version: u32,
+    /// The raw VkPhysicalDeviceType; a software renderer remains identified as such.
+    pub device_type: u32,
+    /// The selected physical device's UUID, queried from its live instance.
+    pub device_uuid: [u8; 16],
+    /// The selected driver's UUID, queried from that same physical device.
+    pub driver_uuid: [u8; 16],
+    /// Actual completed ordinary-RAM/Vulkan ownership operations of this fresh device.
+    pub counts: rt::CpuShadowCounts,
+    /// Total bytes compared against independently computed expected contents.
+    pub bytes_compared: u64,
+}
+
+/// A probe failure. Every variant is a failure; none selects a fallback or claims support.
+#[derive(Debug)]
+pub enum Error {
+    /// The caller did not explicitly enable the backend or gave an invalid wait duration.
+    Policy,
+    /// This process already used shadow resources, so its counters cannot describe this probe.
+    NotFresh,
+    /// A GPU wait or the expected submission callback exceeded its deadline.
+    Timeout(&'static str),
+    /// Device, file, shader or runtime setup refused an operation.
+    Operation(String),
+    /// Observed counters/order did not prove a required ownership transition.
+    Evidence(&'static str),
+    /// GPU or ordinary-file bytes differ from the probe's independent model.
+    Mismatch {
+        /// The exact comparison that failed.
+        operation: &'static str,
+        /// The first differing byte, or the end of the shorter input.
+        byte: usize,
+        /// The observed byte; absent when the actual input ended first.
+        actual: Option<u8>,
+        /// The required byte; absent when the expected input ended first.
+        expected: Option<u8>,
+    },
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Policy => f.write_str("requires CPU-shadow mode and a 100..30000 ms wait"),
+            Self::NotFresh => {
+                f.write_str("requires a fresh process without other shadow resources")
+            }
+            Self::Timeout(operation) => write!(f, "timed out at {operation}"),
+            Self::Operation(message) => f.write_str(message),
+            Self::Evidence(message) => write!(f, "missing runtime evidence: {message}"),
+            Self::Mismatch {
+                operation,
+                byte,
+                actual,
+                expected,
+            } => write!(
+                f,
+                "{operation} differs at byte {byte}: {actual:?}, expected {expected:?}"
+            ),
+        }
+    }
+}
+impl std::error::Error for Error {}
+impl From<io::Error> for Error {
+    fn from(error: io::Error) -> Self {
+        Self::Operation(format!("ordinary-file operation: {error}"))
+    }
+}
+impl From<rt::Error> for Error {
+    fn from(error: rt::Error) -> Self {
+        Self::Operation(format!("runtime operation: {error}"))
+    }
+}
+
+struct Mapping {
+    at: NonNull<u8>,
+}
+// SAFETY: the mapping carries an owned address/lifetime, no Rust reference to its mutable bytes.
+unsafe impl Send for Mapping {}
+// SAFETY: CPU reads/writes are ordinary-file I/O; the raw mapping is only an import address.
+unsafe impl Sync for Mapping {}
+
+impl Mapping {
+    fn new(file: &File, order: [usize; 3]) -> io::Result<Self> {
+        // SAFETY: a private inaccessible reservation, owned here before any publication.
+        let raw = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                BYTES,
+                libc::PROT_NONE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        };
+        if raw == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        let Some(at) = NonNull::new(raw.cast::<u8>()) else {
+            // SAFETY: address zero, if returned, is still the complete owned reservation.
+            unsafe { libc::munmap(raw, BYTES) };
+            return Err(io::Error::other("null probe mapping"));
+        };
+        let mapping = Self { at };
+        for (logical, physical) in order.into_iter().enumerate() {
+            // SAFETY: replace only a full region of our reservation, before it is published.
+            let mapped = unsafe {
+                libc::mmap(
+                    at.as_ptr().wrapping_add(logical * PAGE).cast(),
+                    PAGE,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_SHARED | libc::MAP_FIXED,
+                    file.as_raw_fd(),
+                    (physical * PAGE) as libc::off_t,
+                )
+            };
+            if mapped == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+        }
+        Ok(mapping)
+    }
+
+    fn ranges(&self, file: &File, order: [usize; 3]) -> io::Result<Vec<GuestRamFile>> {
+        let fd = Arc::new(file.try_clone()?.into());
+        Ok(order
+            .into_iter()
+            .enumerate()
+            .map(|(logical, physical)| GuestRamFile {
+                host: self.at.as_ptr().wrapping_add(logical * PAGE) as u64,
+                length: PAGE as u64,
+                offset: (physical * PAGE) as u64,
+                fd: Arc::clone(&fd),
+            })
+            .collect())
+    }
+}
+impl Drop for Mapping {
+    fn drop(&mut self) {
+        // SAFETY: the final mapping owner releases its whole reservation after its users.
+        unsafe { libc::munmap(self.at.as_ptr().cast(), BYTES) };
+    }
+}
+
+fn memory() -> io::Result<File> {
+    // SAFETY: valid name/flags; success transfers ownership of a new ordinary memfd.
+    let fd = unsafe {
+        libc::memfd_create(
+            c"reims-installed-shadow-probe".as_ptr(),
+            libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fd is uniquely owned after the successful call above.
+    let file = File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+    file.set_len(BYTES as u64)?;
+    // SAFETY: size seals keep every captured physical byte in the file and preserve writes.
+    if unsafe {
+        libc::fcntl(
+            file.as_raw_fd(),
+            libc::F_ADD_SEALS,
+            libc::F_SEAL_SHRINK | libc::F_SEAL_GROW,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(file)
+}
+
+fn exact(
+    actual: &[u8],
+    expected: &[u8],
+    operation: &'static str,
+    compared: &mut u64,
+) -> Result<(), Error> {
+    if actual != expected {
+        let byte = actual
+            .iter()
+            .zip(expected)
+            .position(|(a, b)| a != b)
+            .unwrap_or(actual.len().min(expected.len()));
+        return Err(Error::Mismatch {
+            operation,
+            byte,
+            actual: actual.get(byte).copied(),
+            expected: expected.get(byte).copied(),
+        });
+    }
+    *compared += expected.len() as u64;
+    Ok(())
+}
+
+fn file_exact(
+    file: &File,
+    expected: &[u8],
+    operation: &'static str,
+    compared: &mut u64,
+) -> Result<(), Error> {
+    let mut actual = vec![0; expected.len()];
+    file.read_exact_at(&mut actual, 0)?;
+    exact(&actual, expected, operation, compared)
+}
+
+fn gpu_exact(
+    buffer: &rt::Buffer,
+    expected: &[u8],
+    operation: &'static str,
+    compared: &mut u64,
+) -> Result<(), Error> {
+    let at = buffer
+        .contents()
+        .ok_or(Error::Evidence("owned GPU readback is unmapped"))?;
+    // SAFETY: callers pass a readback of exactly this length, after its GPU completion.
+    let bytes = unsafe { std::slice::from_raw_parts(at.as_ptr(), expected.len()) };
+    exact(bytes, expected, operation, compared)
+}
+
+fn completed(command: &rt::CommandBuffer, deadline: Instant) -> Result<(), Error> {
+    command
+        .wait_until_completed_for(deadline.saturating_duration_since(Instant::now()))
+        .map_err(|_| Error::Timeout("GPU completion"))?;
+    if command.status() != rt::CommandBufferStatus::Completed {
+        return Err(Error::Operation(format!(
+            "GPU command failed: {:?} / {:?}",
+            command.error(),
+            command.refusal()
+        )));
+    }
+    Ok(())
+}
+
+/// Runs the version-one operations through the same Vulkan platform and no-copy import
+/// provider as the guest device. Call only in a fresh, externally time-bounded process.
+pub fn run(timeout: Duration) -> Result<Report, Error> {
+    if !(Duration::from_millis(100)..=Duration::from_secs(30)).contains(&timeout)
+        || std::env::var("REIMS_VGPU_CPU_SHADOW").as_deref() != Ok("1")
+        || !crate::os::cpu_shadow_enabled()
+    {
+        return Err(Error::Policy);
+    }
+    let device = VulkanPlatform::system_default_device()
+        .ok_or_else(|| Error::Operation("no Vulkan device".into()))?;
+    let before = device.raw.cpu_shadow_counts();
+    if before.chunks_created != 0
+        || before.views_created != 0
+        || before.epochs_prepared != 0
+        || before.epochs_finished != 0
+    {
+        return Err(Error::NotFresh);
+    }
+    // SAFETY: only immutable identity is queried while the runtime owns this device/instance.
+    let raw = unsafe { device.raw.raw() };
+    let mut ids = vk::PhysicalDeviceIDProperties::default();
+    let mut properties = vk::PhysicalDeviceProperties2::default().push_next(&mut ids);
+    // SAFETY: the runtime's physical device belongs to this live Vulkan >=1.2 instance.
+    unsafe {
+        raw.instance
+            .get_physical_device_properties2(raw.physical_device, &mut properties)
+    };
+    let properties = properties.properties;
+
+    let file = memory()?;
+    let linear = Arc::new(Mapping::new(&file, [0, 1, 2])?);
+    let fragmented = Arc::new(Mapping::new(&file, ORDER)?);
+    let mut regions = linear.ranges(&file, [0, 1, 2])?;
+    regions.extend(fragmented.ranges(&file, ORDER)?);
+    let _lease = lease_guest_memory(regions);
+    let mut expected: Vec<u8> = (0..BYTES).map(|i| (i * 13 + i / 71) as u8).collect();
+    expected[COUNTER..COUNTER + 4].copy_from_slice(&37u32.to_le_bytes());
+    file.write_all_at(&expected, 0)?;
+    let make = |mapping: &Arc<Mapping>| {
+        let hold = Arc::clone(mapping);
+        // SAFETY: the closure retains the complete CPU mapping for every no-copy user.
+        let range = unsafe { HostRange::new(HostPtr::from_ptr(mapping.at.as_ptr()), BYTES as u64) };
+        device
+            .new_buffer_over_host_memory(
+                OnFault::Return,
+                range,
+                0,
+                Some(Box::new(move || drop(hold))),
+            )
+            .map_err(|error| Error::Operation(format!("no-copy import raised: {error:?}")))?
+            .ok_or_else(|| Error::Operation("no-copy import returned no buffer".into()))
+    };
+    let whole = make(&fragmented)?;
+    let alias = make(&linear)?;
+    let made = device.raw.cpu_shadow_counts();
+    if made.chunks_created != 1 || made.views_created != 2 || made.epochs_prepared != 0 {
+        return Err(Error::Evidence(
+            "two imports did not share one canonical backing",
+        ));
+    }
+
+    let library = metal2vulkan::library::Library::from_air(include_bytes!(concat!(
+        env!("OUT_DIR"),
+        "/cpu_shadow_probe.air"
+    )))
+    .map_err(|error| Error::Operation(format!("authored diagnostic AIR: {error}")))?;
+    let library = device.raw.new_library_with_compile_library(library);
+    let function = library.new_function_with_name("cpu_shadow_probe")?;
+    let pipeline = device
+        .raw
+        .new_compute_pipeline_state_with_function(&function, &rt::PipelineOptions::default())?;
+    let result = device.raw.new_buffer(8, rt::ResourceOptions::shared())?;
+    let queue = device.raw.new_command_queue()?;
+    let command = queue.command_buffer()?;
+    let mut compute = command.compute_command_encoder()?;
+    compute.set_compute_pipeline_state(&pipeline)?;
+    compute.set_buffer(Some(&whole.raw), 0, 0)?;
+    compute.set_buffer(Some(&alias.raw), COUNTER as u64, 1)?;
+    compute.set_buffer(Some(&result), 0, 2)?;
+    compute.dispatch_threads(rt::Size::new(1, 1, 1), rt::Size::new(1, 1, 1))?;
+    compute.end_encoding()?;
+    let event = device.raw.new_shared_event()?;
+    command.encode_signal_event((&event).into(), 1)?;
+    let callback_file = file.try_clone()?;
+    let callback_device = device.raw.clone();
+    let (send, observe) = mpsc::sync_channel(1);
+    command.add_submission_handler(Box::new(move |_| {
+        let counts = callback_device.cpu_shadow_counts();
+        let outcome = callback_file
+            .write_all_at(&CPU_WORD.to_le_bytes(), CPU_EDIT as u64)
+            .map(|()| counts);
+        let _ = send.send(outcome);
+    }))?;
+    let deadline = Instant::now() + timeout;
+    command.commit()?;
+    while event.signaled_value() < 1 {
+        if Instant::now() >= deadline {
+            return Err(Error::Timeout("shared event publication"));
+        }
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    let mut compared = 0;
+    let mut visible = [0; 4];
+    file.read_exact_at(&mut visible, COUNTER as u64)?;
+    exact(
+        &visible,
+        &55u32.to_le_bytes(),
+        "shared event after scatter",
+        &mut compared,
+    )?;
+    completed(&command, deadline)?;
+    let during = observe
+        .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+        .map_err(|_| Error::Timeout("submission callback"))??;
+    if during.epochs_prepared != 1 || during.epochs_finished != 0 {
+        return Err(Error::Evidence(
+            "CPU mutation was not between upload and scatter",
+        ));
+    }
+    gpu_exact(
+        &result,
+        &[37u32.to_le_bytes(), 44u32.to_le_bytes()].concat(),
+        "same-dispatch alias atomics",
+        &mut compared,
+    )?;
+    file.read_exact_at(&mut visible, CPU_EDIT as u64)?;
+    exact(
+        &visible,
+        &CPU_WORD.to_le_bytes(),
+        "disjoint CPU mutation",
+        &mut compared,
+    )?;
+    expected[COUNTER..COUNTER + 4].copy_from_slice(&55u32.to_le_bytes());
+    expected[CPU_EDIT..CPU_EDIT + 4].copy_from_slice(&CPU_WORD.to_le_bytes());
+    file_exact(
+        &file,
+        &expected,
+        "ordinary RAM after compute",
+        &mut compared,
+    )?;
+
+    // The next command crosses a physical discontinuity, writes partial words, then reads
+    // both differently ordered aliases. All expected bytes come from the ordinary-file model.
+    let command = queue.command_buffer()?;
+    let read_fragmented = device
+        .raw
+        .new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+    let read_linear = device
+        .raw
+        .new_buffer(BYTES as u64, rt::ResourceOptions::shared())?;
+    let mut blit = command.blit_command_encoder()?;
+    blit.fill_buffer(
+        &whole.raw,
+        (2 * PAGE - 3) as u64..(2 * PAGE + 9) as u64,
+        0x6a,
+    )?;
+    for logical in 2 * PAGE - 3..2 * PAGE + 9 {
+        expected[ORDER[logical / PAGE] * PAGE + logical % PAGE] = 0x6a;
+    }
+    blit.copy_from_buffer_to_buffer(&whole.raw, 0, &read_fragmented, 0, BYTES as u64)?;
+    blit.copy_from_buffer_to_buffer(&alias.raw, 0, &read_linear, 0, BYTES as u64)?;
+    blit.end_encoding()?;
+    let deadline = Instant::now() + timeout;
+    command.commit()?;
+    completed(&command, deadline)?;
+    let logical: Vec<u8> = (0..BYTES)
+        .map(|at| expected[ORDER[at / PAGE] * PAGE + at % PAGE])
+        .collect();
+    gpu_exact(
+        &read_fragmented,
+        &logical,
+        "fragmented GPU blit",
+        &mut compared,
+    )?;
+    gpu_exact(
+        &read_linear,
+        &expected,
+        "physical alias GPU blit",
+        &mut compared,
+    )?;
+    file_exact(
+        &file,
+        &expected,
+        "ordinary RAM after fragmented blit",
+        &mut compared,
+    )?;
+    let counts = device.raw.cpu_shadow_counts();
+    if counts.chunks_created != 1
+        || counts.views_created != 2
+        || counts.epochs_prepared < 2
+        || counts.epochs_prepared != counts.epochs_finished
+        || counts.bytes_uploaded < (2 * BYTES) as u64
+        || counts.bytes_scattered == 0
+    {
+        return Err(Error::Evidence("completed GPU upload/scatter counters"));
+    }
+    Ok(Report {
+        checks_passed: CHECKS,
+        vendor_id: properties.vendor_id,
+        device_id: properties.device_id,
+        api_version: properties.api_version,
+        driver_version: properties.driver_version,
+        device_type: properties.device_type.as_raw() as u32,
+        device_uuid: ids.device_uuid,
+        driver_uuid: ids.driver_uuid,
+        counts,
+        bytes_compared: compared,
+    })
+}
diff --git a/crates/reims-vgpu-vulkan/src/cpu_shadow_probe/kernel.ll b/crates/reims-vgpu-vulkan/src/cpu_shadow_probe/kernel.ll
new file mode 100644
index 0000000000000000000000000000000000000000..74503daa22fbc300d7a3f94b4071e7204c557890
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/cpu_shadow_probe/kernel.ll
@@ -0,0 +1,37 @@
+; Repository-authored installed-runtime diagnostic, assembled with upstream llvm-as.
+; Both arguments intentionally name the same file word through distinct logical views.
+source_filename = "cpu_shadow_probe"
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define void @cpu_shadow_probe(ptr addrspace(1) %fragmented, ptr addrspace(1) %alias, ptr addrspace(1) %out) {
+entry:
+  %shared = getelementptr i32, ptr addrspace(1) %fragmented, i64 4096
+  %old0 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %shared, i32 7, i32 0, i32 2, i32 0, i1 true)
+  %old1 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %alias, i32 11, i32 0, i32 2, i32 0, i1 true)
+  store i32 %old0, ptr addrspace(1) %out, align 4
+  %out1 = getelementptr i32, ptr addrspace(1) %out, i64 1
+  store i32 %old1, ptr addrspace(1) %out1, align 4
+  ret void
+}
+
+declare i32 @air.atomic.global.add.u.i32(ptr addrspace(1), i32, i32, i32, i32, i1)
+
+!air.kernel = !{!0}
+!air.version = !{!6}
+!air.language_version = !{!7}
+!llvm.module.flags = !{!8, !9, !10, !11, !12, !13}
+!0 = !{ptr @cpu_shadow_probe, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"fragmented"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"alias"}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"out"}
+!6 = !{i32 2, i32 8, i32 0}
+!7 = !{!"Metal", i32 4, i32 0, i32 0}
