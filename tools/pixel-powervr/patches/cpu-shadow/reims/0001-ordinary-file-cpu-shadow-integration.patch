+; Repository-authored CPU-shadow alias test. No Apple binary or compiler output.
+; Two buffer arguments intentionally alias the same ordinary-file word. Do not add
+; noalias metadata: observing both atomic return values is the identity check.
+source_filename = "cpu_shadow_alias"
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
+target triple = "air64_v28-apple-macosx26.0.0"
+
+define void @cpu_shadow_alias(ptr addrspace(1) %whole, ptr addrspace(1) %alias, ptr addrspace(1) %out) {
+entry:
+  %shared = getelementptr i32, ptr addrspace(1) %whole, i64 1024
+  %old0 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %shared, i32 7, i32 0, i32 2, i32 0, i1 true)
+  %old1 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %alias, i32 11, i32 0, i32 2, i32 0, i1 true)
+  store i32 %old0, ptr addrspace(1) %out, align 4
+  %out1 = getelementptr i32, ptr addrspace(1) %out, i64 1
+  store i32 %old1, ptr addrspace(1) %out1, align 4
+  ret void
+}
+
+; Logical 16KiB regions are file regions [0, 2, 1, 2]. Every vector/i64 access
+; below crosses a logical 4KiB leaf and a noncontiguous physical file boundary.
+define void @cpu_shadow_fragmented(ptr addrspace(1) %whole, ptr addrspace(1) %alias, ptr addrspace(1) %out) {
+entry:
+  %shared = getelementptr i32, ptr addrspace(1) %whole, i64 4096
+  %repeated = getelementptr i32, ptr addrspace(1) %whole, i64 12288
+  %old0 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %shared, i32 7, i32 0, i32 2, i32 0, i1 true)
+  %old1 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %alias, i32 11, i32 0, i32 2, i32 0, i1 true)
+  %old2 = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %repeated, i32 13, i32 0, i32 2, i32 0, i1 true)
+  store i32 %old0, ptr addrspace(1) %out, align 4
+  %out1 = getelementptr i32, ptr addrspace(1) %out, i64 1
+  %out2 = getelementptr i32, ptr addrspace(1) %out, i64 2
+  store i32 %old1, ptr addrspace(1) %out1, align 4
+  store i32 %old2, ptr addrspace(1) %out2, align 4
+  %cross_load = getelementptr i32, ptr addrspace(1) %whole, i64 4095
+  %vector = load <4 x i32>, ptr addrspace(1) %cross_load, align 4
+  %out3 = getelementptr i32, ptr addrspace(1) %out, i64 3
+  store <4 x i32> %vector, ptr addrspace(1) %out3, align 4
+  %wide = load i64, ptr addrspace(1) %cross_load, align 4
+  %out7 = getelementptr i32, ptr addrspace(1) %out, i64 7
+  store i64 %wide, ptr addrspace(1) %out7, align 4
+  %cross_vector_store = getelementptr i32, ptr addrspace(1) %whole, i64 8191
+  store <4 x i32> <i32 305419896, i32 591751049, i32 878082202, i32 1164413355>, ptr addrspace(1) %cross_vector_store, align 4
+  %cross_wide_store = getelementptr i32, ptr addrspace(1) %whole, i64 12287
+  store i64 6153737367135073092, ptr addrspace(1) %cross_wide_store, align 4
+  %final = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %alias, i32 0, i32 0, i32 2, i32 0, i1 true)
+  %out9 = getelementptr i32, ptr addrspace(1) %out, i64 9
+  store i32 %final, ptr addrspace(1) %out9, align 4
+  ; The ordinary file contains a guest GPU address, not a Vulkan device address.
+  ; Loading it exercises the actual runtime address table's dynamic root metadata.
+  %address_slot = getelementptr i8, ptr addrspace(1) %whole, i64 128
+  %address = load i64, ptr addrspace(1) %address_slot, align 8
+  %dynamic = inttoptr i64 %address to ptr addrspace(1)
+  %dynamic_vector = load <4 x i32>, ptr addrspace(1) %dynamic, align 4
+  %out10 = getelementptr i32, ptr addrspace(1) %out, i64 10
+  store <4 x i32> %dynamic_vector, ptr addrspace(1) %out10, align 4
+  %dynamic_wide = load i64, ptr addrspace(1) %dynamic, align 4
+  %out14 = getelementptr i32, ptr addrspace(1) %out, i64 14
+  store i64 %dynamic_wide, ptr addrspace(1) %out14, align 4
+  %dynamic_shared = getelementptr i32, ptr addrspace(1) %dynamic, i64 1
+  %dynamic_final = call i32 @air.atomic.global.add.u.i32(ptr addrspace(1) %dynamic_shared, i32 0, i32 0, i32 2, i32 0, i1 true)
+  %out16 = getelementptr i32, ptr addrspace(1) %out, i64 16
+  store i32 %dynamic_final, ptr addrspace(1) %out16, align 4
+  %null_slot = getelementptr i8, ptr addrspace(1) %whole, i64 136
+  %far_slot = getelementptr i8, ptr addrspace(1) %whole, i64 144
+  %end_slot = getelementptr i8, ptr addrspace(1) %whole, i64 152
+  %null_address = load i64, ptr addrspace(1) %null_slot, align 8
+  %far_address = load i64, ptr addrspace(1) %far_slot, align 8
+  %end_address = load i64, ptr addrspace(1) %end_slot, align 8
+  %null_pointer = inttoptr i64 %null_address to ptr addrspace(1)
+  %far_pointer = inttoptr i64 %far_address to ptr addrspace(1)
+  %end_pointer = inttoptr i64 %end_address to ptr addrspace(1)
+  %null_value = load i32, ptr addrspace(1) %null_pointer, align 4
+  %far_value = load i32, ptr addrspace(1) %far_pointer, align 4
+  %end_value = load i32, ptr addrspace(1) %end_pointer, align 1
+  %static_end = getelementptr i32, ptr addrspace(1) %whole, i64 16384
+  %static_far = getelementptr i32, ptr addrspace(1) %whole, i64 1073741824
+  %static_end_value = load i32, ptr addrspace(1) %static_end, align 4
+  %static_far_value = load i32, ptr addrspace(1) %static_far, align 4
+  %out17 = getelementptr i32, ptr addrspace(1) %out, i64 17
+  %out18 = getelementptr i32, ptr addrspace(1) %out, i64 18
+  %out19 = getelementptr i32, ptr addrspace(1) %out, i64 19
+  %out20 = getelementptr i32, ptr addrspace(1) %out, i64 20
+  %out21 = getelementptr i32, ptr addrspace(1) %out, i64 21
+  store i32 %null_value, ptr addrspace(1) %out17, align 4
+  store i32 %far_value, ptr addrspace(1) %out18, align 4
+  store i32 %end_value, ptr addrspace(1) %out19, align 4
+  store i32 %static_end_value, ptr addrspace(1) %out20, align 4
+  store i32 %static_far_value, ptr addrspace(1) %out21, align 4
+  %null_vector = load <4 x i32>, ptr addrspace(1) %null_pointer, align 4
+  %out22 = getelementptr i32, ptr addrspace(1) %out, i64 22
+  store <4 x i32> %null_vector, ptr addrspace(1) %out22, align 4
+  store i32 1515870810, ptr addrspace(1) %null_pointer, align 4
+  store i32 1515870810, ptr addrspace(1) %far_pointer, align 4
+  store i32 1515870810, ptr addrspace(1) %end_pointer, align 1
+  store i32 1515870810, ptr addrspace(1) %static_end, align 4
+  store i32 1515870810, ptr addrspace(1) %static_far, align 4
+  ret void
+}
+
+declare i32 @air.atomic.global.add.u.i32(ptr addrspace(1), i32, i32, i32, i32, i1)
+
+!air.kernel = !{!0, !14}
+!air.version = !{!6}
+!air.language_version = !{!7}
+!llvm.module.flags = !{!8, !9, !10, !11, !12, !13}
+!0 = !{ptr @cpu_shadow_alias, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"whole"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"alias"}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"out"}
+!6 = !{i32 2, i32 8, i32 0}
+!7 = !{!"Metal", i32 4, i32 0, i32 0}
+!8 = !{i32 7, !"air.max_device_buffers", i32 31}
+!9 = !{i32 7, !"air.max_constant_buffers", i32 31}
+!10 = !{i32 7, !"air.max_threadgroup_buffers", i32 31}
+!11 = !{i32 7, !"air.max_textures", i32 128}
+!12 = !{i32 7, !"air.max_read_write_textures", i32 8}
