 use std::sync::Arc;
 
+/// Whether this device enabled host-pointer import. On Linux, its absence selects the
+/// file-backed path; its presence keeps gathering, without promising every pointer is importable.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum HostPointerExtension {
+    Enabled,
+    Absent,
+}
+
+impl HostPointerExtension {
+    pub(crate) fn of(device: &metal2vulkan_runtime::Device) -> Self {
+        if device
+            .enabled()
+            .extensions
+            .contains(&metal2vulkan::device::VkExtension::ExtExternalMemoryHost)
+        {
+            Self::Enabled
+        } else {
+            Self::Absent
+        }
+    }
+}
+
 /// The OS's handle to a file whose bytes back a range of the guest's RAM: a file descriptor on
