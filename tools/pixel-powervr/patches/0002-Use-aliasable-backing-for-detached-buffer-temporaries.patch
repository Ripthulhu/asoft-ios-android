+            assert!(vm.remap_shared_overwrite(view, anonymous, length).is_err());
+            drop(r);
+            assert!(!vm.is_mapped(at, length));
+            assert_eq!(vm.read(view.wrapping_add(7), 1), Some(vec![0x39]));
+            assert!(vm.deallocate(view, length).is_success());
+            assert!(vm.deallocate(anonymous, length).is_success());
