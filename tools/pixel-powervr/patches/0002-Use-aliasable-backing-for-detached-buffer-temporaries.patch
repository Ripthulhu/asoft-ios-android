+    /// Aliasable backing is a writable, size-sealed memfd, held by its recorded mappings:
+    /// unlike an anonymous reservation it can supply the same pages to a no-copy importer.
+    #[test]
+    fn aliasable_backing_keeps_a_size_sealed_file_until_its_last_view_goes() {
+        let v = vm();
+        let length = 2 * page();
+        let at = allocate_aliasable(length).unwrap();
+        let pieces = files::pieces(at.addr().to_u64(), length).unwrap();
+        assert_eq!(pieces.len(), 1);
+        assert_eq!((pieces[0].backing.offset, pieces[0].length), (0, length));
+        // SAFETY: this test holds an open memfd descriptor.
+        let seals = unsafe { libc::fcntl(pieces[0].backing.fd.as_raw_fd(), libc::F_GET_SEALS) };
+        assert!(seals >= 0);
+        let size_seals = libc::F_SEAL_GROW | libc::F_SEAL_SHRINK;
+        assert_eq!(seals & size_seals, size_seals);
+        let held = Arc::downgrade(&pieces[0].backing.fd);
+        drop(pieces);
+
+        let view = v.allocate_anywhere(length).unwrap();
+        assert!(files::pieces(view.addr().to_u64(), length).is_none());
+        v.remap_shared_overwrite(view, at, length).unwrap();
+        write(at, page() + 7, 0x39);
+        assert_eq!(read(view, page() + 7), 0x39);
+        assert!(v.deallocate(at, length).is_success());
+        assert!(
+            held.upgrade().is_some(),
+            "the surviving view holds the file"
+        );
+        write(view, 9, 0x7c);
+        assert_eq!(read(view, 9), 0x7c);
+        assert!(v.deallocate(view, length).is_success());
+        assert!(
+            held.upgrade().is_none(),
+            "the last recorded mapping releases the FD"
+        );
+    }
+
     /// A view shows its source's pages both ways, from the page of the source's first byte; a
     /// view of the view shows them too, and keeps showing them after the first view is unmapped
     #[test]
