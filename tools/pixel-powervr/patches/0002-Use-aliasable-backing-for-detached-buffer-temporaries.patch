index 904e1db..a1dc671 100644
--- a/crates/reims-vgpu-core/src/platform/os/vm.rs
+++ b/crates/reims-vgpu-core/src/platform/os/vm.rs
@@ -65,10 +65,11 @@ pub trait HostVm: Send + Sync {
     fn page_shift(&self) -> u32;
     /// `mach_vm_allocate(task, &a, len, VM_FLAGS_ANYWHERE)`: a fresh zero-filled range.
     fn allocate_anywhere(&self, len: u64) -> Result<HostAddr, KernReturn>;
-    /// The same call, [`HostVm::allocate_anywhere`], for a range core then names in address
-    /// ranges, which the platform maps again as an alias of its pages (the detach heap's
-    /// temporary). On Mach any range can be aliased; a platform whose fresh ranges cannot be
-    /// (Linux's anonymous memory) gives one that can.
+    /// The same call, [`HostVm::allocate_anywhere`], for a range whose backing the platform
+    /// must be able to share: the detach heap's temporary, mapped again as an alias of its
+    /// pages, and the detach buffer's, which a no-copy GPU import may need as file pages.
+    /// On Mach any range can be aliased; a platform whose fresh ranges cannot be (Linux's
+    /// anonymous memory) gives one that can.
     fn allocate_aliasable(&self, len: u64) -> Result<HostAddr, KernReturn> {
         self.allocate_anywhere(len)
     }
