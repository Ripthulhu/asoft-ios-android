+
+            let env = Env::new();
+            let vm = env.p.fake_vm();
+            vm.require_aliasable_sources();
+            let length = vm.page_size();
+            let r = detach(&env, length, 0, None).unwrap();
+            let at = r.get_buffer().unwrap().unwrap().contents();
+            let view = vm.allocate_anywhere(length).unwrap();
+            vm.remap_shared_overwrite(view, at, length).unwrap();
+            assert_eq!(vm.read(view, 1), Some(vec![0]));
+            assert!(vm.write(at.wrapping_add(7), &[0x39]));
+            assert_eq!(vm.read(view.wrapping_add(7), 1), Some(vec![0x39]));
+            assert!(vm.write(view.wrapping_add(9), &[0x7c]));
