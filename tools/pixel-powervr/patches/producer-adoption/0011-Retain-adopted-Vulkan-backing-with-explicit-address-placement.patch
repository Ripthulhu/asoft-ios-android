+/// A caller's Vulkan buffer, its Metal address placement, and optional lifetime owners for
+/// [`Device::new_buffer_with_vk_buffer_descriptor`]. A Vulkan interop extension, with no Metal
+/// counterpart: the buffer's contents and Vulkan allocation already exist. The runtime checks
+/// the stated creation facts; the unsafe creation call requires the caller to make them true.
+#[non_exhaustive]
+pub struct VkBufferDescriptor<'a> {
+    /// The live `VkBuffer` to wrap, created on this runtime device.
+    pub buffer: vk::Buffer,
+    /// The buffer's exact creation info. Its pointer fields remain valid for the creation call;
+    /// the runtime reads the concurrent queue families, but not the `pNext` chain.
+    pub info: vk::BufferCreateInfo<'a>,
+    /// The memory bound to the buffer, and its CPU mapping for `Shared` storage.
+    pub memory: VkBufferMemory,
+    /// The Metal buffer's length in bytes, no greater than the Vulkan buffer's padded capacity.
+    pub length: u64,
+    /// `resourceOptions`: the storage, CPU cache and hazard tracking modes.
+    pub resource_options: ResourceOptions,
+    /// Where the buffer goes in the Metal address space, as `pinnedGPUAddress` places it.
+    pub placement: AddressPlacement,
+    /// Dropped when the Metal address range is released ([`RangeToken`]), which may precede
+    /// the release of the Vulkan backing. A runtime extension, independent of `backing_owner`.
+    pub range_token: Option<RangeToken>,
+    /// Keeps the Vulkan buffer, its bound memory and any CPU mappings alive until every runtime
+    /// hold on the backing is gone, including pending command buffers' resident tables.
+    /// The runtime never destroys the handles itself; this owner's destructor may do so.
+    ///
+    /// Dropped with no runtime lock held, possibly on a handler thread, with a panic caught;
+    /// never during process exit. A refused creation drops it before returning. This lifetime
+    /// may exceed `range_token`'s: an argument buffer can retain backing after its Metal address
+    /// has been released. The caller still synchronizes its own access and keeps the device
+    /// live through any later destruction. A runtime extension, with no Metal counterpart.
+    pub backing_owner: Option<KeepAlive>,
+}
+
+impl<'a> VkBufferDescriptor<'a> {
+    /// A descriptor over `buffer` made with `info`, bound at `memory`, of `length` bytes and
+    /// `resource_options`. The runtime picks its Metal address; it keeps no token or owner.
+    pub fn new(
+        buffer: vk::Buffer,
+        info: vk::BufferCreateInfo<'a>,
+        memory: VkBufferMemory,
+        length: u64,
+        resource_options: ResourceOptions,
+    ) -> VkBufferDescriptor<'a> {
+        VkBufferDescriptor {
+            buffer,
+            info,
+            memory,
+            length,
+            resource_options,
+            placement: AddressPlacement::Any,
+            range_token: None,
+            backing_owner: None,
+        }
+    }
+
+    /// This descriptor at `placement` in the Metal address space.
+    pub fn with_placement(self, placement: AddressPlacement) -> VkBufferDescriptor<'a> {
+        VkBufferDescriptor { placement, ..self }
+    }
+
+    /// This descriptor with `token`, dropped once the Metal address range is free.
+    pub fn with_range_token(self, token: RangeToken) -> VkBufferDescriptor<'a> {
+        VkBufferDescriptor {
+            range_token: Some(token),
+            ..self
+        }
+    }
+
+    /// This descriptor with `owner`, retained through every runtime use of the Vulkan backing,
+    /// independently of the address range's lifetime. It does not synchronize external use.
+    pub fn with_backing_owner(self, owner: KeepAlive) -> VkBufferDescriptor<'a> {
+        VkBufferDescriptor {
+            backing_owner: Some(owner),
+            ..self
+        }
+    }
+}
+
+impl fmt::Debug for VkBufferDescriptor<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VkBufferDescriptor")
+            .field("buffer", &self.buffer)
+            .field("size", &self.info.size)
+            .field("usage", &self.info.usage.as_raw())
+            .field("flags", &self.info.flags.as_raw())
+            .field("sharing_mode", &self.info.sharing_mode.as_raw())
+            .field("memory", &self.memory)
+            .field("length", &self.length)
+            .field("resource_options", &self.resource_options)
+            .field("placement", &self.placement)
+            .field("range_token", &self.range_token)
+            .field("has_backing_owner", &self.backing_owner.is_some())
+            .finish()
+    }
+}
