+    /// Keep the caller's Vulkan backing before a new wrapped buffer is published. The owner is
+    /// counted as program code before any command may hold it, so completion cannot run its
+    /// destructor on a queue waiter. The fixed pages keep it after the Metal range is released.
+    pub(super) fn keep_backing_owner(&mut self, owner: KeepAlive) -> Result<(), Error> {
+        let Some(buffer) = Arc::get_mut(&mut self.0) else {
+            return Err(internal(
+                "a backing owner attached after buffer publication",
+            ));
+        };
+        let Bytes::Own(own) = &mut buffer.bytes else {
+            return Err(internal("a backing owner for a heap's buffer"));
+        };
+        let Lie::Fixed(pages) = &mut own.lie else {
+            return Err(internal("a Vulkan backing owner for host pages"));
+        };
+        if !matches!(own.owner, Owner::Vulkan) {
+            return Err(internal("a Vulkan backing owner for runtime memory"));
+        }
+        let Some(pages) = Arc::get_mut(pages) else {
+            return Err(internal("a backing owner attached after pages publication"));
+        };
+        let kept = pages
+            .backing_owner
+            .get_mut()
+            .unwrap_or_else(PoisonError::into_inner);
+        if kept.is_some() {
+            return Err(internal("a buffer's backing owner kept twice"));
+        }
+        *kept = Some(ProgramObject::new(owner));
+        Ok(())
+    }
