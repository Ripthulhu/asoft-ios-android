@@ -0,0 +1,308 @@
+//! The descriptor form keeps a caller's Vulkan allocation through actual command use, apart
+//! from its Metal address token. Real Vulkan objects are destroyed by the owner's destructor;
+//! the validation layer therefore checks the lifetime, not just a stand-in counter.
+
+use super::{Made, SIZE};
+use crate::candidate::engine::ComputeOutput;
+use crate::gpu::TEST_DEVICE;
+use crate::runtime_lane::{
+    bound_buffers, encode_case, pipeline_state, public_case, read_buffer, validated_device,
+    CaseResources, Messages, ScratchCache, WAIT,
+};
+use ash::vk;
+use metal2vulkan_runtime::{
+    AddressPlacement, Buffer, BufferContents, BufferDescriptor, CommandBufferStatus, Device, Error,
+    GpuAddress, PlacementConflict, ResourceOptions, VkBufferDescriptor,
+};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+const HIGH: u64 = 0x7000_0000_0000;
+const POINTER_WALKER: &str = "walk-a-device-pointer-chain-through-a-loop-phi";
+
+/// What the two independent owners did, observable without holding either.
+#[derive(Default)]
+struct Seen {
+    range: AtomicUsize,
+    backing: AtomicUsize,
+    remade: Mutex<Option<bool>>,
+}
+
+impl Seen {
+    fn counts(&self) -> (usize, usize) {
+        (
+            self.range.load(Ordering::SeqCst),
+            self.backing.load(Ordering::SeqCst),
+        )
+    }
+}
+
+/// Owns the live Vulkan handles. No host pointer is shared with the releasing thread: it only
+/// destroys handles once the runtime's last memory hold has gone.
+struct Backing {
+    device: Device,
+    buffer: vk::Buffer,
+    memory: vk::DeviceMemory,
+    seen: Arc<Seen>,
+}
+
+impl Drop for Backing {
+    fn drop(&mut self) {
+        // SAFETY: adoption keeps this owner through every runtime use. The device is held by
+        // this object and no external operation uses the allocation. Freeing it unmaps it.
+        unsafe {
+            let raw = self.device.raw();
+            raw.device.destroy_buffer(self.buffer, None);
+            raw.device.free_memory(self.memory, None);
+        }
+        assert_eq!(self.seen.backing.fetch_add(1, Ordering::SeqCst), 0);
+    }
+}
+
+/// Reenters the runtime at the freed address. Its result distinguishes a range released from
+/// backing that an older resident table can still hold, and checks that no address lock is held.
+struct Token {
+    device: Device,
+    address: GpuAddress,
+    seen: Arc<Seen>,
+}
+
+impl Drop for Token {
+    fn drop(&mut self) {
+        let made = pinned(&self.device, self.address).is_ok();
+        *self.seen.remade.lock().unwrap() = Some(made);
+        assert_eq!(self.seen.range.fetch_add(1, Ordering::SeqCst), 0);
+    }
+}
+
+fn pinned(device: &Device, address: GpuAddress) -> Result<Buffer, Error> {
+    device.new_buffer_with_descriptor(
+        BufferDescriptor::new(SIZE, ResourceOptions::shared(), BufferContents::Zero)
+            .with_placement(AddressPlacement::At(address)),
+    )
+}
+
+/// The real caller-owned allocation, with both lifetime hooks. A failed adoption destroys this
+/// unused allocation before returning, so refusal paths are checked under validation too.
+fn adopt(
+    device: &Device,
+    address: GpuAddress,
+    length: u64,
+    bytes: &[u8],
+    seen: &Arc<Seen>,
+) -> Result<Buffer, Error> {
+    let usage = vk::BufferUsageFlags::from(device.vk_buffer_usage());
+    let flags = vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT;
+    // SAFETY: the backing owner below takes destruction responsibility immediately; no external
+    // operations use this allocation after the initial write.
+    let made = unsafe { Made::new(device, SIZE, usage, flags) }.expect("coherent host memory");
+    made.write(bytes);
+    // SAFETY: the device stays live through this call and through the backing owner's clone.
+    let raw = unsafe { device.raw() };
+    let info = Made::info(SIZE, usage, raw.queue_families);
+    let owner = Backing {
+        device: device.clone(),
+        buffer: made.buffer,
+        memory: made.memory,
+        seen: Arc::clone(seen),
+    };
+    let token = Token {
+        device: device.clone(),
+        address,
+        seen: Arc::clone(seen),
+    };
+    let descriptor = VkBufferDescriptor::new(
+        made.buffer,
+        info,
+        made.memory(made.mapped),
+        length,
+        ResourceOptions::shared(),
+    )
+    .with_placement(AddressPlacement::At(address))
+    .with_range_token(Box::new(token))
+    .with_backing_owner(Box::new(owner));
+    // SAFETY: exact creation and binding on the runtime's live device, device-address flags
+    // where requested, a coherent mapping of the whole allocation, and its owner retained by
+    // the descriptor. The tests order CPU access with command completion.
+    unsafe { device.new_buffer_with_vk_buffer_descriptor(descriptor) }
+}
+
+fn on_device(f: impl FnOnce(&Device)) {
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    {
+        let device = validated_device(TEST_DEVICE, &messages, cache.path()).unwrap();
+        f(&device);
+    }
+    assert_eq!(messages.take(), Vec::new(), "the validation layer reported");
+}
+
+/// Requested address and existing bytes are preserved; a conflict frees only the refused
+/// candidate's handles and tokens. Releasing the accepted buffer releases each owner once and
+/// lets its token immediately allocate at the address. A preflight length refusal also returns
+/// both owners without publishing the buffer.
+#[test]
+fn an_adopted_buffer_has_its_requested_address_and_refusals_return_its_owners() {
+    on_device(|device| {
+        let address = GpuAddress(HIGH);
+        let seen = Arc::new(Seen::default());
+        let buffer = adopt(device, address, SIZE, &[1, 3, 5, 7], &seen).unwrap();
+        assert_eq!(buffer.gpu_address(), address);
+        assert_eq!(read_buffer(&buffer, 0, 4).unwrap(), [1, 3, 5, 7]);
+        let refused = Arc::new(Seen::default());
+        assert!(matches!(
+            adopt(device, address, SIZE, &[], &refused),
+            Err(Error::PlacementConflict(PlacementConflict::Held { .. }))
+        ));
+        assert_eq!(refused.counts(), (1, 1));
+        assert_eq!(*refused.remade.lock().unwrap(), Some(false));
+        assert_eq!(seen.counts(), (0, 0));
+        assert_eq!(read_buffer(&buffer, 0, 4).unwrap(), [1, 3, 5, 7]);
+        drop(buffer);
+        assert_eq!(seen.counts(), (1, 1));
+        assert_eq!(*seen.remade.lock().unwrap(), Some(true));
+        let refused = Arc::new(Seen::default());
+        assert!(matches!(
+            adopt(device, address, 0, &[], &refused),
+            Err(Error::Nil(_))
+        ));
+        assert_eq!(refused.counts(), (1, 1));
+        assert_eq!(*refused.remade.lock().unwrap(), Some(true));
+    });
+}
+
+/// A submitted command waits on an explicit event before filling and copying the caller's
+/// allocation. Its named buffer retains the address and backing until completion; the owner
+/// destroys the Vulkan objects only then. No timing or workload-size assumption holds it open.
+#[test]
+fn an_adopted_backing_and_range_survive_a_pending_named_command() {
+    on_device(|device| {
+        let queue = device.new_command_queue().unwrap();
+        let address = GpuAddress(HIGH);
+        let seen = Arc::new(Seen::default());
+        let buffer = adopt(device, address, SIZE, &[], &seen).unwrap();
+        let copied = device.new_buffer(SIZE, ResourceOptions::shared()).unwrap();
+        let started = device.new_shared_event().unwrap();
+        let release = device.new_shared_event().unwrap();
+        let command = queue.command_buffer().unwrap();
+        command.encode_signal_event((&started).into(), 1).unwrap();
+        command.encode_wait_for_event((&release).into(), 1).unwrap();
+        let mut blit = command.blit_command_encoder().unwrap();
+        blit.fill_buffer(&buffer, 0..SIZE, 0x5a).unwrap();
+        blit.copy_from_buffer_to_buffer(&buffer, 0, &copied, 0, SIZE)
+            .unwrap();
+        blit.end_encoding().unwrap();
+        let completed_here = device.work_counts().completed_where_seen;
+        command.commit().unwrap();
+        assert!(started.wait_until_signaled_value(1, WAIT));
+        drop(buffer);
+        assert_eq!(seen.counts(), (0, 0), "the command owns the buffer");
+        assert!(matches!(
+            pinned(device, address),
+            Err(Error::PlacementConflict(PlacementConflict::Held { .. }))
+        ));
+        release.set_signaled_value(1);
+        command.wait_until_completed_for(WAIT).unwrap();
+        assert_eq!(command.status(), CommandBufferStatus::Completed);
+        assert_eq!(
+            read_buffer(&copied, 0, SIZE).unwrap(),
+            vec![0x5a; SIZE as usize]
+        );
+        assert_eq!(seen.counts(), (1, 1), "released before waiters wake");
+        assert_eq!(*seen.remade.lock().unwrap(), Some(true));
+        assert_eq!(device.work_counts().completed_where_seen, completed_here);
+        drop(command);
+        assert_eq!(seen.counts(), (1, 1), "neither owner runs twice");
+
+        // Recorded work that is never committed releases the same owners when discarded.
+        let seen = Arc::new(Seen::default());
+        let buffer = adopt(device, address, SIZE, &[], &seen).unwrap();
+        let command = queue.command_buffer().unwrap();
+        let mut blit = command.blit_command_encoder().unwrap();
+        blit.fill_buffer(&buffer, 0..SIZE, 1).unwrap();
+        blit.end_encoding().unwrap();
+        drop(buffer);
+        assert_eq!(seen.counts(), (0, 0));
+        drop(command);
+        assert_eq!(seen.counts(), (1, 1));
+    });
+}
+
+/// A real compute dispatch reaches the adopted buffer only through its Metal address in an
+/// argument buffer. After that dispatch a second event holds the command open. Releasing the
+/// Metal buffer frees its address and token immediately, while the command's resident table
+/// retains the Vulkan allocation until completion. A token alone cannot supply this lifetime.
+#[test]
+fn an_argument_only_command_keeps_adopted_backing_after_its_range_is_free() {
+    on_device(|device| {
+        let queue = device.new_command_queue().unwrap();
+        let walker = public_case(POINTER_WALKER).unwrap();
+        let ComputeOutput::Buffer {
+            binding,
+            offset,
+            length,
+        } = walker.compute.output
+        else {
+            panic!("the walker has a buffer output");
+        };
+        let pipeline = pipeline_state(device, &walker).unwrap();
+        let mut resources = CaseResources::new(device, &walker).unwrap();
+        let [(&field, member)] = resources.argument_buffers.iter().collect::<Vec<_>>()[..] else {
+            panic!("the walker has one argument-buffer buffer");
+        };
+        let bytes = read_buffer(member, 0, member.length()).unwrap();
+        assert!(bytes.len() as u64 <= SIZE);
+        let address = GpuAddress(HIGH);
+        let seen = Arc::new(Seen::default());
+        let buffer = adopt(device, address, bytes.len() as u64, &bytes, &seen).unwrap();
+        resources.argument_buffers.insert(field, buffer.clone());
+        let buffers = bound_buffers(device, &walker.compute, &resources).unwrap();
+        assert_eq!(
+            read_buffer(&buffers[&field.0], u64::from(field.1), 8).unwrap(),
+            address.0.to_le_bytes()
+        );
+        // The address is in the bound argument buffer. Do not also name the adopted resource
+        // through use_resource: that would retain the Metal object and miss the lifetime split.
+        resources.argument_buffers.clear();
+        let started = device.new_shared_event().unwrap();
+        let release = device.new_shared_event().unwrap();
+        let command = queue.command_buffer().unwrap();
+        let mut encoder = command.compute_command_encoder().unwrap();
+        encode_case(
+            &mut encoder,
+            &pipeline,
+            &walker.compute,
+            &buffers,
+            &resources,
+        )
+        .unwrap();
+        encoder.end_encoding().unwrap();
+        command.encode_signal_event((&started).into(), 1).unwrap();
+        command.encode_wait_for_event((&release).into(), 1).unwrap();
+        let completed_here = device.work_counts().completed_where_seen;
+        command.commit().unwrap();
+        assert!(
+            started.wait_until_signaled_value(1, WAIT),
+            "the dispatch ran"
+        );
+        drop(buffer);
+        assert_eq!(seen.counts(), (1, 0), "only the address owner is released");
+        assert_eq!(*seen.remade.lock().unwrap(), Some(true));
+        let replacement = pinned(device, address).unwrap();
+        release.set_signaled_value(1);
+        command.wait_until_completed_for(WAIT).unwrap();
+        assert_eq!(command.status(), CommandBufferStatus::Completed);
+        assert_eq!(
+            read_buffer(&buffers[&binding], offset, length).unwrap(),
+            walker.metal_output
+        );
+        assert_eq!(
+            seen.counts(),
+            (1, 1),
+            "the resident backing is now released"
+        );
+        assert_eq!(device.work_counts().completed_where_seen, completed_here);
+        drop((command, replacement));
+        assert_eq!(seen.counts(), (1, 1));
+    });
+}
