+// These flags describe resource operations, not the presence of a Vulkan extension.
+// CPU-shadow replacement retains resource identities over ordinary-file backing.
+fn supports_rebindable_memory(backend: crate::os::HostPointerExtension) -> bool {
+    match backend {
+        crate::os::HostPointerExtension::Enabled => true,
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        crate::os::HostPointerExtension::CpuShadow => true,
+        crate::os::HostPointerExtension::Absent => false,
+    }
+}
