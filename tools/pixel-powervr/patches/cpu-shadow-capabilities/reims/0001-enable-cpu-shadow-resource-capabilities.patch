@@ -0,0 +1,97 @@
+//! The real C API, MMIO/FIFO and isolated task resource routes with ordinary guest RAM.
+//! This authored fixture also builds for Android; the host test selects CPU-shadow in a
+//! separate process before Vulkan initialization, with a fresh shader cache for each run.
+
+#![cfg(all(feature = "vulkan", feature = "guest-arm64", target_os = "linux"))]
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use std::path::PathBuf;
+use std::process::{Command, Output};
+
+struct FixtureDir(PathBuf);
+
+impl Drop for FixtureDir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn success(out: &Output, operation: &str) {
+    assert!(
+        out.status.success(),
+        "{operation} failed ({:?}):\n{}\n{}",
+        out.status,
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
+
+/// Device-info gates, task handshake, private-flag buffer and shared heap construction,
+/// GPU writes, discard/rebind and deletion run through the installed C API, not FakePlatform.
+#[test]
+fn isolated_cpu_shadow_resources_rebind_through_the_c_api() {
+    let crate_dir = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let deps = std::env::current_exe()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .to_path_buf();
+    let dir = FixtureDir(
+        std::env::temp_dir().join(format!("rvg-cpu-shadow-core-{}", std::process::id())),
+    );
+    std::fs::create_dir(&dir.0).unwrap();
+    let generated = Command::new("python3")
+        .arg(crate_dir.join("tests/c/cpu_shadow_core.py"))
+        .arg(dir.0.join("cpu_shadow_core_data.h"))
+        .env("PYTHONDONTWRITEBYTECODE", "1")
+        .output()
+        .unwrap();
+    success(&generated, "generate authored guest traffic");
+    let binary = dir.0.join("cpu_shadow_core");
+    // Keep the selected Vulkan loader's search paths, but give this build's C
+    // library precedence over a different checkout named by the caller.
+    let inherited = std::env::var_os("LD_LIBRARY_PATH").unwrap_or_default();
+    let libraries = std::env::join_paths(
+        std::iter::once(deps.clone()).chain(
+            std::env::split_paths(&inherited).filter(|path| !path.as_os_str().is_empty()),
+        ),
+    )
+    .unwrap();
+    let compiled = Command::new("cc")
+        .args(["-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-I"])
+        .arg(crate_dir.join("include"))
+        .arg("-I")
+        .arg(&dir.0)
+        .arg(crate_dir.join("tests/c/cpu_shadow_core.c"))
+        .arg("-L")
+        .arg(&deps)
+        .arg("-lreims_vgpu_c")
+        .arg(format!("-Wl,-rpath,{}", deps.display()))
+        .arg("-o")
+        .arg(&binary)
+        .output()
+        .unwrap();
+    success(&compiled, "compile C API fixture");
+    for argument_buffers in [true, false] {
+        let cache = dir.0.join(format!("cache-{argument_buffers}"));
+        std::fs::create_dir(&cache).unwrap();
+        let mut command = Command::new(&binary);
+        if !argument_buffers {
+            command.arg("--no-argument-buffers");
+        }
+        let out = command
+            .env_remove("LD_PRELOAD")
+            .env("LD_LIBRARY_PATH", &libraries)
+            .env("REIMS_VGPU_CPU_SHADOW", "1")
+            .env("XDG_CACHE_HOME", &cache)
+            .output()
+            .unwrap();
+        success(&out, "actual isolated task fixture");
+        let stdout = String::from_utf8_lossy(&out.stdout);
+        assert!(stdout.contains("cpu_shadow_core: ok"), "{stdout}");
+        println!(
+            "argument_buffers={argument_buffers}\n{stdout}{}",
+            String::from_utf8_lossy(&out.stderr)
+        );
+    }
+}
