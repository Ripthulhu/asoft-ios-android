+        Some(path) => unsafe { ash::Entry::load_from(path) },
+        None => open_loader(),
+    };
+    let entry = match opened {
         Ok(entry) => entry,
         Err(e) => {
             log::warn!(
@@ -66,6 +78,10 @@ pub fn add_window_extensions(options: &mut rt::DeviceOptions) {
             return;
         }
     };
+    options.instance_api_version = instance_version(options.instance_api_version, || {
+        // SAFETY: a global command of the same loader the runtime's options select.
+        unsafe { entry.try_enumerate_instance_version() }
+    });
     // SAFETY: a global command of a loaded entry.
     let listed = unsafe { entry.enumerate_instance_extension_properties(None) }.unwrap_or_default();
     let listed: Vec<&CStr> = listed
@@ -117,6 +133,23 @@ pub fn add_window_extensions(options: &mut rt::DeviceOptions) {
     }
 }
 
+/// Keeps an explicit request. Otherwise asks the loader before selecting 1.3; no answer,
+/// a failed query or an older loader keeps the runtime's 1.2 default (`None`).
+fn instance_version(
+    requested: Option<ApiVersion>,
+    loader: impl FnOnce() -> Result<Option<u32>, vk::Result>,
+) -> Option<ApiVersion> {
+    if requested.is_some() {
+        return requested;
+    }
+    loader()
+        .ok()
+        .flatten()
+        .map(ApiVersion::from_packed)
+        .filter(|version| *version >= ApiVersion::V1_3)
+        .map(|_| ApiVersion::V1_3)
+}
+
 /// Whether `options` give a device present fences: they list one of the device extensions
 /// [`add_window_extensions`] adds for them, whose feature the runtime then enables on every
 /// device it makes of them (the module doc).
@@ -257,6 +290,45 @@ fn probe(entry: &ash::Entry, listed: &[&CStr]) -> Probed {
 mod tests {
     use super::*;
 
+    /// Dynamic rendering's core version is requested only when the loader reports it.
+    #[test]
+    fn instance_version_uses_1_3_only_when_the_loader_supports_it() {
+        for version in [
+            vk::API_VERSION_1_0,
+            vk::API_VERSION_1_1,
+            vk::API_VERSION_1_2,
+        ] {
+            assert_eq!(instance_version(None, || Ok(Some(version))), None);
+        }
+        for version in [vk::API_VERSION_1_3, vk::make_api_version(0, 1, 4, 0)] {
+            assert_eq!(
+                instance_version(None, || Ok(Some(version))),
+                Some(ApiVersion::V1_3)
+            );
+        }
+    }
+
+    /// An unavailable version query must not cause an unsupported 1.3 request.
+    #[test]
+    fn instance_version_keeps_1_2_when_the_query_gives_no_version() {
+        assert_eq!(instance_version(None, || Ok(None)), None);
+        assert_eq!(
+            instance_version(None, || Err(vk::Result::ERROR_INITIALIZATION_FAILED)),
+            None
+        );
+    }
+
+    /// The caller's explicit version is the runtime's to validate, without probing another.
+    #[test]
+    fn instance_version_preserves_an_explicit_request_without_querying() {
+        for version in [ApiVersion::V1_2, ApiVersion::V1_3] {
+            assert_eq!(
+                instance_version(Some(version), || panic!("no version query")),
+                Some(version)
+            );
+        }
+    }
+
     /// A host with a Vulkan driver gets `VK_KHR_surface` and a swapchain, and nothing twice
     #[test]
     fn the_window_systems_extensions_are_named_once() {
