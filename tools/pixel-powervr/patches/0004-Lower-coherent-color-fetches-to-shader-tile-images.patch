index 0000000000000000000000000000000000000000..93c4dcb84e3dbc00045e552c5e9a2ccb99d96691
--- /dev/null
+++ b/crates/metal2vulkan/src/pipeline/link/tile_image.rs
@@ -0,0 +1,66 @@
+//! Descriptor-free, coherent color fetch through dynamic-rendering tile images.
+
+use crate::device::DeviceProfile;
+use crate::error::{Attachment, DescriptorError, Error, Feature, RuntimeInput, Unsupported};
+use crate::library::FunctionArtifact;
+use crate::lower::fragment::tile_images_order;
+use crate::metal::format::{self, ExtendedRange};
+use crate::pipeline::color_writes;
+use crate::pipeline::facts::RuntimeFact;
+use crate::pipeline::graphics::TileImageAttachmentUse;
+use crate::pipeline::link::RenderLinkInputs;
+use crate::pipeline::sym::SampledType;
+
+/// Check each declared tile-image location against the pipeline's actual attachment. The
+/// current lowering reads single-sample float or unsigned-integer colors represented directly;
+/// signed colors and converted attachment forms need their own lowering before they can link.
+pub fn attachments(
+    r: &RenderLinkInputs,
+    fragment: Option<&FunctionArtifact>,
+    p: &DeviceProfile,
+) -> Result<Vec<TileImageAttachmentUse>, Error> {
+    let mut out = Vec::new();
+    for fact in fragment.into_iter().flat_map(|f| &f.facts) {
+        let RuntimeFact::TileImageFramebufferFetch {
+            color,
+            format_class,
+        } = *fact
+        else {
+            continue;
+        };
+        if !tile_images_order(p) {
+            return Err(Error::NeedsInput(RuntimeInput::FramebufferFetch));
+        }
+        let attachment = r
+            .color_attachments
+            .get(color as usize)
+            .copied()
+            .flatten()
+            .ok_or(Error::InvalidDescriptor(DescriptorError::ColorAttachment {
+                index: color,
+            }))?;
+        let pf = attachment.pixel_format;
+        let actual = format::sampled_type(pf);
+        if r.raster_sample_count != 1
+            || actual == Some(SampledType::Sint)
+            || ExtendedRange::of(pf).is_some()
+            || format::rotated_channels(pf)
+            || format::alpha_in_red(pf, p)
+            || format::ycbcr_renders(pf)
+            || format::ycbcr_pass_refused(pf)
+            || color_writes::srgb_fetched(pf)
+            || color_writes::word_color(color, &attachment, r.alpha_to_coverage, p).is_some()
+        {
+            return Err(Unsupported::not_implemented(Feature::FramebufferFetch)
+                .at_attachment(Attachment::Color(color))
+                .into());
+        }
+        if actual != Some(format_class) {
+            return Err(Error::InvalidDescriptor(DescriptorError::ColorAttachment {
+                index: color,
+            }));
+        }
+        out.push(TileImageAttachmentUse::new(color, format_class));
+    }
+    Ok(out)
+}
