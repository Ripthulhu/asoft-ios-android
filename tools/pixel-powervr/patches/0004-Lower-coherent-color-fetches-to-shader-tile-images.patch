+/// Whether coherent tile-image color reads can run through dynamic rendering. This capability
+/// orders attachment reads only; it is not a substitute for fragment interlock on other memory.
+pub(crate) fn tile_images_order(p: &DeviceProfile) -> bool {
+    let f = p.fields();
+    f.fragment.shader_tile_image_color_read_access
+        && f.enabled.features.contains(&VkFeature::DynamicRendering)
+        && f.api_version >= crate::device::requirements::ApiVersion::V1_3
+}
