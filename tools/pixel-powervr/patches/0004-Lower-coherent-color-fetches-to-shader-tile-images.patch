+/// A single-sample color attachment at its output location, with no descriptor decoration.
+fn tile_image(mb: &mut ModuleBuilder, color: u32, float: bool) -> BResult<GlobalId> {
+    let sampled_type = if float {
+        mb.ty(SType::Float { width: 32 })?
+    } else {
+        mb.ty(SType::Int {
+            width: 32,
+            signed: false,
+        })?
+    };
+    let ty = mb.ty(SType::Image(ImageType {
+        sampled_type,
+        dim: Dim::TileImageDataEXT,
+        depth: false,
+        arrayed: false,
+        multisampled: false,
+        usage: ImageUsage::Storage,
+        format: crate::spv::ImageFormat::Unknown,
+    }))?;
+    mb.tile_image(color, ty)
+}
