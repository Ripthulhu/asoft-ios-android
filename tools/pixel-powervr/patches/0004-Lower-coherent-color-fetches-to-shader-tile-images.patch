diff --git a/crates/metal2vulkan/tests/tile_image.rs b/crates/metal2vulkan/tests/tile_image.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a1506c0c33f2dbb876a074acd6cf4f3f6bb745f1
--- /dev/null
+++ b/crates/metal2vulkan/tests/tile_image.rs
@@ -0,0 +1,349 @@
+//! Actual AIR-to-pipeline coherent tile fetches, attachment contracts, and explicit refusals.
+
+mod common;
+
+use metal2vulkan::cache::PipelineArtifact;
+use metal2vulkan::device::{
+    ApiVersion, Device, DeviceDescription, DevicePolicy, Requirements, VkExtension, VkFeature,
+};
+use metal2vulkan::error::{Error, Feature, Needs};
+use metal2vulkan::library::Library;
+use metal2vulkan::pipeline::{
+    ColorAttachmentDescriptor, FunctionDescriptor, RenderPipelineDescriptor, SampledType,
+    StageSource, TileImageAttachmentUse,
+};
+use metal2vulkan::{metal, vk, Budget};
+use metal2vulkan_devtools::spirv::{check_l3, spirv_dis, L3Failure};
+
+fn fixture(stem: &str) -> Option<Vec<u8>> {
+    let path = metal2vulkan_devtools::engine_dir().join(format!("{stem}.ll"));
+    common::llvm_as(
+        &std::fs::read_to_string(path).expect("owned AIR fixture"),
+        stem,
+    )
+}
+
+fn description(stem: &str) -> DeviceDescription {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/profiles")
+        .join(format!("{stem}.json"));
+    DeviceDescription::from_khronos_json(&std::fs::read_to_string(path).expect("profile"), None)
+        .expect("description")
+}
+
+fn l3(words: &[u32], requirements: &Requirements, dev: &Device) {
+    dev.profile()
+        .check(requirements)
+        .expect("requirements within profile");
+    let plan = dev.profile().spirv_validation();
+    match check_l3(
+        words,
+        &plan.target_envs,
+        &plan.relaxations,
+        &plan.relaxations.join(" "),
+        &format!("{requirements:?}"),
+    ) {
+        Ok(()) => {}
+        Err(L3Failure::Tooling(why)) => eprintln!("SKIPPED spirv-val: {why}"),
+        Err(error) => panic!("L3: {error}"),
+    }
+}
+
+fn tile_description() -> DeviceDescription {
+    let mut d = description("lavapipe");
+    d.api_version = ApiVersion::V1_3;
+    for feature in [
+        VkFeature::RasterizationOrderColorAttachmentAccess,
+        VkFeature::FragmentShaderPixelInterlock,
+        VkFeature::FragmentShaderSampleInterlock,
+    ] {
+        d.features.remove(&feature);
+    }
+    d.extensions.insert(VkExtension::ExtShaderTileImage);
+    d.features.insert(VkFeature::ShaderTileImageColorReadAccess);
+    d.features.insert(VkFeature::DynamicRendering);
+    d
+}
+
+fn descriptor(name: &str, formats: &[metal::PixelFormat]) -> Option<RenderPipelineDescriptor> {
+    let (Some(io), Some(fetch)) = (fixture("stage_io"), fixture("fragment_fetch")) else {
+        return None;
+    };
+    let vertex = Library::from_air(&io)
+        .expect("vertex library")
+        .function("stage_io_vertex_position")
+        .expect("vertex");
+    let fragment = Library::from_air(&fetch)
+        .expect("fragment library")
+        .function(name)
+        .expect("fragment");
+    let mut d =
+        RenderPipelineDescriptor::new(StageSource::Function(FunctionDescriptor::new(vertex)));
+    d.fragment = Some(StageSource::Function(FunctionDescriptor::new(fragment)));
+    for (index, &format) in formats.iter().enumerate() {
+        d.color_attachments[index] = Some(ColorAttachmentDescriptor::new(format));
+    }
+    Some(d)
+}
+
+#[test]
+fn tile_image_air_pipeline_carries_real_requirements_and_descriptor_free_locations() {
+    let desc = tile_description();
+    let dev = Device::new(desc.clone(), DevicePolicy::default()).expect("tile device");
+    assert!(!dev
+        .metal_properties()
+        .unsupported_features
+        .iter()
+        .any(|u| u.feature == Feature::FramebufferFetch));
+    assert!(dev
+        .metal_properties()
+        .unsupported_features
+        .iter()
+        .any(|u| u.feature == Feature::RasterOrderGroups));
+    for (entry, formats, attachments) in [
+        (
+            "fetch_scalar",
+            vec![metal::PixelFormat::R32Float],
+            vec![TileImageAttachmentUse::new(0, SampledType::Float)],
+        ),
+        (
+            "fetch_scalar",
+            vec![metal::PixelFormat::R8Unorm],
+            vec![TileImageAttachmentUse::new(0, SampledType::Float)],
+        ),
+        (
+            "fetch_blend",
+            vec![
+                metal::PixelFormat::BGRA8Unorm,
+                metal::PixelFormat::RGBA32Uint,
+                metal::PixelFormat::RG16Float,
+            ],
+            vec![
+                TileImageAttachmentUse::new(0, SampledType::Float),
+                TileImageAttachmentUse::new(1, SampledType::Uint),
+                TileImageAttachmentUse::new(2, SampledType::Float),
+            ],
+        ),
+    ] {
+        let Some(mut d) = descriptor(entry, &formats) else {
+            return;
+        };
+        if entry == "fetch_scalar" {
+            let color = d.color_attachments[0].as_mut().expect("color");
+            color.blending_enabled = true;
+            color.destination_rgb_blend_factor = metal::BlendFactor::One;
+        }
+        let started = std::time::Instant::now();
+        let pipe = dev
+            .compile_render_pipeline(&d, &Budget::standard())
+            .expect(entry);
+        eprintln!("{entry} tile-image compile: {:?}", started.elapsed());
+        let encoded = pipe.to_bytes();
+        let cached =
+            metal2vulkan::pipeline::RenderPipeline::from_bytes_for_key(&encoded, &pipe.key, &dev)
+                .expect("cached tile pipeline");
+        assert_eq!(
+            cached, pipe,
+            "tile requirements, locations and facts survive the cache"
+        );
+        assert_eq!(cached.to_bytes(), encoded);
+        assert_eq!(pipe.graphics.tile_image_attachments, attachments);
+        assert!(pipe.graphics.input_attachments.is_empty());
+        assert!(pipe.graphics.storage_attachments.is_empty());
+        assert!(!pipe.graphics.rasterization_order_attachment_access);
+        assert_eq!(pipe.requirements.api_version, Some(ApiVersion::V1_3));
+        let enables = desc
+            .required_enables(&pipe.requirements)
+            .expect("real enables");
+        assert!(enables.features.contains(&VkFeature::DynamicRendering));
+        assert!(enables
+            .features
+            .contains(&VkFeature::ShaderTileImageColorReadAccess));
+        assert!(enables
+            .extensions
+            .contains(&VkExtension::ExtShaderTileImage));
+        assert!(!enables
+            .features
+            .contains(&VkFeature::FragmentShaderPixelInterlock));
+        for stage in &pipe.stages {
+            l3(&stage.spirv, &pipe.requirements, &dev);
+            if stage.stage == vk::ShaderStage::FRAGMENT {
+                let dis = spirv_dis(&stage.spirv);
+                assert!(dis.contains("OpColorAttachmentReadEXT"), "{dis}");
+                assert!(dis.contains("TileImageDataEXT"), "{dis}");
+                assert!(!dis.contains("NonCoherent"), "{dis}");
+                assert!(!dis.contains("InputAttachmentIndex"), "{dis}");
+                assert!(!dis.contains("OpBeginInvocationInterlockEXT"), "{dis}");
+            }
+        }
+    }
+}
+
+#[test]
+fn tile_image_air_pipeline_refuses_missing_features_msaa_signed_formats_and_groups() {
+    let Some(plain) = descriptor("fetch_scalar", &[metal::PixelFormat::R32Float]) else {
+        return;
+    };
+    for missing in [
+        VkFeature::ShaderTileImageColorReadAccess,
+        VkFeature::DynamicRendering,
+    ] {
+        let mut desc = tile_description();
+        desc.features.remove(&missing);
+        let dev = Device::new(desc, DevicePolicy::default()).expect("device with missing feature");
+        assert!(
+            matches!(dev.compile_render_pipeline(&plain, &Budget::standard()),
+            Err(Error::Unsupported(u)) if u.feature == Feature::FramebufferFetch && matches!(u.needs, Needs::AnyOf(_)))
+        );
+    }
+    let dev = Device::new(tile_description(), DevicePolicy::default()).expect("tile device");
+    let mut msaa = plain.clone();
+    msaa.raster_sample_count = 4;
+    assert!(
+        matches!(dev.compile_render_pipeline(&msaa, &Budget::standard()),
+        Err(Error::Unsupported(u)) if u.feature == Feature::FramebufferFetch && u.needs == Needs::NotImplemented)
+    );
+    let Some(signed) = descriptor(
+        "fetch_blend",
+        &[
+            metal::PixelFormat::RGBA32Float,
+            metal::PixelFormat::RGBA32Sint,
+            metal::PixelFormat::RG16Float,
+        ],
+    ) else {
+        return;
+    };
+    assert!(
+        matches!(dev.compile_render_pipeline(&signed, &Budget::standard()),
+        Err(Error::Unsupported(u)) if u.feature == Feature::FramebufferFetch && u.needs == Needs::NotImplemented)
+    );
+    let Some(srgb) = descriptor("fetch_scalar", &[metal::PixelFormat::RGBA8UnormSRGB]) else {
+        return;
+    };
+    assert!(
+        matches!(dev.compile_render_pipeline(&srgb, &Budget::standard()),
+        Err(Error::Unsupported(u)) if u.feature == Feature::FramebufferFetch && u.needs == Needs::NotImplemented)
+    );
+    let Some(group) = descriptor("fetch_ordered", &[metal::PixelFormat::RGBA32Float]) else {
+        return;
+    };
+    assert!(
+        matches!(dev.compile_render_pipeline(&group, &Budget::standard()),
+        Err(Error::Unsupported(u)) if u.feature == Feature::RasterOrderGroups)
+    );
+}
+
+#[test]
+fn tile_image_extension_enable_requires_vulkan_1_3_even_when_advertised() {
+    let mut floor = description("vk12-floor");
+    assert_eq!(floor.api_version, ApiVersion::V1_2);
+    floor.extensions.insert(VkExtension::ExtShaderTileImage);
+    floor
+        .features
+        .insert(VkFeature::ShaderTileImageColorReadAccess);
+    let enables = floor.recommended_enables(&DevicePolicy::default());
+    assert!(!enables
+        .extensions
+        .contains(&VkExtension::ExtShaderTileImage));
+    assert!(!enables
+        .features
+        .contains(&VkFeature::ShaderTileImageColorReadAccess));
+    let mut requested = metal2vulkan::device::EnableSet::new();
+    requested.extensions.insert(VkExtension::ExtShaderTileImage);
+    assert!(matches!(
+        floor.clone().with_enabled(&requested),
+        Err(Error::InvalidDescriptor(_))
+    ));
+    let mut req = Requirements::default();
+    req.extensions.insert(VkExtension::ExtShaderTileImage);
+    assert_eq!(
+        floor.required_enables(&req),
+        Err(metal2vulkan::error::Capability::ApiVersion(
+            ApiVersion::V1_3
+        ))
+    );
+    assert!(matches!(
+        Device::new(floor, DevicePolicy::default()),
+        Err(Error::InvalidDescriptor(_))
+    ));
+}
+
+#[test]
+fn existing_raster_order_and_interlock_paths_remain_preferred() {
+    let Some(d) = descriptor("fetch_scalar", &[metal::PixelFormat::R32Float]) else {
+        return;
+    };
+    for raster_order in [true, false] {
+        let mut desc = description("lavapipe");
+        desc.extensions.insert(VkExtension::ExtShaderTileImage);
+        desc.features
+            .insert(VkFeature::ShaderTileImageColorReadAccess);
+        desc.features.insert(VkFeature::DynamicRendering);
+        if !raster_order {
+            desc.features
+                .remove(&VkFeature::RasterizationOrderColorAttachmentAccess);
+        }
+        let dev = Device::new(desc, DevicePolicy::default()).expect("ordered device");
+        let pipe = dev
+            .compile_render_pipeline(&d, &Budget::standard())
+            .expect("existing ordered fetch");
+        assert!(pipe.graphics.tile_image_attachments.is_empty());
+        assert_eq!(
+            pipe.graphics.rasterization_order_attachment_access,
+            raster_order
+        );
+        assert_eq!(
+            pipe.graphics.input_attachments.len(),
+            usize::from(raster_order)
+        );
+        assert_eq!(
+            pipe.graphics.storage_attachments.len(),
+            usize::from(!raster_order)
+        );
+        assert!(!pipe
+            .requirements
+            .features
+            .contains(&VkFeature::ShaderTileImageColorReadAccess));
+        for stage in &pipe.stages {
+            l3(&stage.spirv, &pipe.requirements, &dev);
+            assert!(!spirv_dis(&stage.spirv).contains("OpColorAttachmentReadEXT"));
+        }
+    }
+}
+
+#[test]
+fn tile_image_fetch_dependent_derivative_is_refused_without_assuming_helper_reads() {
+    let Some(mut pipeline) = descriptor("fetch_scalar", &[metal::PixelFormat::R32Float]) else {
+        return;
+    };
+    // A structural variant of the owned public fixture: its fetched value reaches a derivative.
+    // The fixture on disk is generated and remains unchanged.
+    let path = metal2vulkan_devtools::engine_dir().join("fragment_fetch.ll");
+    let original = std::fs::read_to_string(path).expect("fixture");
+    let text = original.replace(
+        "fmul fast float %0, 5.000000e-01",
+        "call float @air.dfdx.f32(float %0)",
+    ) + "\ndeclare float @air.dfdx.f32(float)\n";
+    let Some(bc) = common::llvm_as(&text, "color fetch derivative") else {
+        return;
+    };
+    let fragment = Library::from_air(&bc)
+        .expect("derivative library")
+        .function("fetch_scalar")
+        .expect("derivative function");
+    pipeline.fragment = Some(StageSource::Function(FunctionDescriptor::new(fragment)));
+    let tile = Device::new(tile_description(), DevicePolicy::default()).expect("tile device");
+    assert!(
+        matches!(tile.compile_render_pipeline(&pipeline, &Budget::standard()),
+        Err(Error::Unsupported(u)) if u.feature == Feature::FramebufferFetch && u.needs == Needs::NotImplemented)
+    );
+    // The ordinary ordered-input path is unchanged and supports the derivative instruction.
+    let ordered =
+        Device::new(description("lavapipe"), DevicePolicy::default()).expect("ordered device");
+    let pipe = ordered
+        .compile_render_pipeline(&pipeline, &Budget::standard())
+        .expect("ordered input derivative");
+    for stage in &pipe.stages {
+        l3(&stage.spirv, &pipe.requirements, &ordered);
+    }
+}
