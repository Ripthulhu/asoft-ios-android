+//! Coherent tile-image declarations and instructions, with explicit Vulkan requirements.
+
+use crate::budget::{Budget, Meter};
+use crate::device::requirements::{
+    ApiVersion, SpirvCapability, SpirvExtension, VkExtension, VkFeature,
+};
+use crate::spirv::builder::ModuleBuilder;
+use crate::spirv::error::{BResult, BuildError, EntryRule};
+use crate::spirv::ir::{
+    Dim, ExecModel, ImageOperands, ImageType, ImageUsage, IoDir, MemAccess, StorageClass,
+    TexelMemory, Type, TypedModule,
+};
+use crate::spirv::serialize::{relocate, serialize};
+use crate::spirv::testing::{spirv_dis, spirv_val_with, TargetEnv, ValOptions};
+use crate::spv::{Capability, ImageFormat, Op};
+
+fn module(model: ExecModel, unsigned: bool) -> BResult<TypedModule> {
+    let mut b = ModuleBuilder::new();
+    let scalar = b.ty(if unsigned {
+        Type::Int {
+            width: 32,
+            signed: false,
+        }
+    } else {
+        Type::Float { width: 32 }
+    })?;
+    let image = b.ty(Type::Image(ImageType {
+        sampled_type: scalar,
+        dim: Dim::TileImageDataEXT,
+        depth: false,
+        arrayed: false,
+        multisampled: false,
+        usage: ImageUsage::Storage,
+        format: ImageFormat::Unknown,
+    }))?;
+    // A tile image cannot enter a descriptor storage class.
+    assert!(b
+        .ty(Type::Pointer {
+            class: StorageClass::UniformConstant,
+            pointee: image
+        })
+        .is_err());
+    let input = b.tile_image(2, image)?;
+    assert!(
+        b.tile_image(2, image).is_err(),
+        "one tile declaration per location"
+    );
+    let vector = b.ty(Type::Vector {
+        elem: scalar,
+        len: 4,
+    })?;
+    let output = b.fixed_io(2, IoDir::Output, vector, false)?;
+    let void = b.ty(Type::Void)?;
+    let mut f = b.function(void)?;
+    let pointer = f.module().global_value(input)?;
+    let image = f.load(pointer, MemAccess::default())?;
+    let color = f.color_attachment_read(image)?;
+    // The tile image cannot be read as a storage image using an arbitrary coordinate.
+    let u32_ = f.module().ty(Type::Int {
+        width: 32,
+        signed: false,
+    })?;
+    let zero = super::cval(&mut f, u32_, 0);
+    assert!(f
+        .read(image, zero, &ImageOperands::default(), TexelMemory::PRIVATE)
+        .is_err());
+    let pointer = f.module().global_value(output)?;
+    f.store(pointer, color, MemAccess::default())?;
+    f.ret(None)?;
+    let main = f.finish()?;
+    let modes = if model == ExecModel::GLCompute {
+        vec![crate::spirv::ir::ExecMode::LocalSize { x: 1, y: 1, z: 1 }]
+    } else {
+        Vec::new()
+    };
+    b.entry(model, main, modes)?;
+    b.finalize()
+}
+
+#[test]
+fn tile_image_reads_serialize_coherently_without_descriptors() {
+    for unsigned in [false, true] {
+        let m = module(ExecModel::Fragment, unsigned).expect("fragment");
+        let mut meter = Meter::new(&Budget::default());
+        crate::spirv::verify::check_structure(&m, &mut meter).expect("structural verifier");
+        let r = serialize(m).expect("serialize");
+        assert!(
+            r.relocs.is_empty(),
+            "tile images use fixed locations, no descriptor relocations"
+        );
+        let req = &r.requirements;
+        assert_eq!(req.api_version, Some(ApiVersion::V1_3));
+        assert!(req
+            .features
+            .contains(&VkFeature::ShaderTileImageColorReadAccess));
+        assert!(req.features.contains(&VkFeature::DynamicRendering));
+        assert!(req.extensions.contains(&VkExtension::ExtShaderTileImage));
+        assert!(req
+            .spirv_extensions
+            .contains(&SpirvExtension::ExtShaderTileImage));
+        assert!(req.spirv_capabilities.contains(&SpirvCapability::of(
+            Capability::TileImageColorReadAccessEXT
+        )));
+        assert!(!req
+            .spirv_capabilities
+            .contains(&SpirvCapability::of(Capability::InputAttachment)));
+        assert!(!req.spirv_capabilities.contains(&SpirvCapability::of(
+            Capability::StorageImageReadWithoutFormat
+        )));
+        crate::spirv::requirements::tests::check_against_registry(req).expect("registry");
+        let words = relocate(&r, &std::collections::BTreeMap::new()).expect("relocate");
+        spirv_val_with(
+            &words,
+            TargetEnv::Vulkan1_3,
+            ValOptions::for_requirements(req),
+        )
+        .expect("Vulkan 1.3 SPIR-V");
+        let dis = spirv_dis(&words);
+        assert!(dis.contains("OpColorAttachmentReadEXT"), "{dis}");
+        assert!(dis.contains("TileImageEXT"), "{dis}");
+        assert!(dis.contains("TileImageDataEXT"), "{dis}");
+        assert!(!dis.contains("NonCoherent"), "{dis}");
+        assert!(!dis.contains("DescriptorSet"), "{dis}");
+        assert!(!dis.contains("InputAttachmentIndex"), "{dis}");
+    }
+}
+
+#[test]
+fn tile_image_reads_are_fragment_only() {
+    for model in [ExecModel::Vertex, ExecModel::GLCompute] {
+        assert_eq!(
+            module(model, false).err(),
+            Some(BuildError::Entry(EntryRule::InstructionForModel(
+                Op::ColorAttachmentReadEXT
+            )))
+        );
+    }
+}
