+/* Constructors run before QEMU's error-reporting context is initialized.
+ * Deferred failures can occur with pool_lock held: do not run atexit handlers.
+ */
+static void G_GNUC_PRINTF(1, 2) native_el0_required_fail(const char *fmt, ...)
+{
+    va_list ap;
+
+    if (!native_el0_required_mode()) {
+        return;
+    }
+    fprintf(stderr, "native-el0: required initialization failed: ");
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "; refusing to continue without the requested native engine\n");
+    fflush(stderr);
+    _Exit(EXIT_FAILURE);
+}
