+static void native_gpu_channel_wait(short events, int64_t deadline)
+{
+    for (;;) {
+        int64_t left = deadline - mono_ns();
+        struct pollfd p = { .fd = native_gpu.event_fd, .events = events };
+        if (left <= 0) {
+            native_gpu_fail("durable owner acknowledgment timed out");
+        }
+        int rc = poll(&p, 1, (left + 999999) / 1000000);
+        if (rc < 0 && errno == EINTR) {
+            continue;
+        }
+        if (rc <= 0 || !(p.revents & events)) {
+            native_gpu_fail("owner witness channel closed or timed out");
+        }
+        return;
+    }
+}
