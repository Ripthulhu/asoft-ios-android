+    if (native_gpu.phase != GPU_READY || native_gpu.entered ||
+        !native_gpu.attached || !native_gpu.registered ||
+        nc->cs->cpu_index != 0 || nc->stub != 0 || env->pc != GPU_CODE_VA ||
+        qatomic_read(&shm->nvcpus) != 1 || nstubs != 1 ||
+        qatomic_read(&shm->ctl[0].pid) <= 0 ||
+        sl->owner_pid != qatomic_read(&shm->ctl[0].pid) ||
+        !sl->tid || sl->proof_ack_count) {
+        native_gpu_fail("native entry identity/state mismatch");
+    }
+    native_gpu.stub_pid = sl->owner_pid;
+    native_gpu.worker_tid = sl->tid;
+    native_gpu.invalidation_generation = qatomic_read(&shm->ctl[0].inval_seq);
+    native_gpu.entered = true;
+    native_gpu_event(GPU_ENTRY, GPU_CODE_VA, 0, 0, 0, NGP_ACCESS_NONE);
