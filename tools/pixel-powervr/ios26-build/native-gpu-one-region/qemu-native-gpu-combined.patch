+static void native_gpu_event(uint32_t phase, uint64_t pc, uint64_t address,
+                             uint64_t input, uint64_t output, uint32_t access)
+{
+    NgpPacket event = {
+        .magic = NGP_MAGIC, .version = NGP_PROTOCOL_VERSION,
+        .bytes = NGP_PACKET_BYTES, .kind = NGP_EVENT,
+        .phase = phase, .sequence = phase,
+        .run_generation = native_gpu.generation,
+        .inval_generation = native_gpu.invalidation_generation,
+        .owner_pid = native_gpu.owner_pid, .qemu_pid = native_gpu.qemu_pid,
+        .factory_pid = factory_pid, .stub_pid = native_gpu.stub_pid,
+        .worker_tid = native_gpu.worker_tid,
+        .gpa = GPU_REGION_GPA, .va = GPU_DATA_VA,
+        .allocation_bytes = GPU_BACKING_LEN, .backing_offset = GPU_BACKING_OFF,
+        .view_bytes = GPU_VIEW_LEN, .pc = pc, .fault_address = address,
+        .access = access, .input = input, .output = output,
+        .proof_flags = ngp_phase_flags(phase),
+    };
+    NgpPacket ack, expected;
+    int64_t deadline = mono_ns() + (int64_t)NGP_ACK_TIMEOUT_MS * 1000000;
+
+    if (!native_gpu_mode || phase != native_gpu.phase + 1 ||
+        phase < GPU_READY || phase > GPU_COMPLETE || factory_pid <= 0) {
+        native_gpu_fail("witness phase/order/identity mismatch");
+    }
+    memcpy(event.code_sha256, ngp_code_sha256, sizeof(event.code_sha256));
+    if (phase == GPU_ENTRY || phase == GPU_CODE_MAP) {
+        event.instruction = ngp_payload_words[0];
+    } else if (phase == GPU_DATA_FAULT || phase == GPU_DATA_MAP) {
+        event.instruction = ngp_payload_words[2];
+    } else if (phase == GPU_COMPLETE) {
+        event.instruction = ngp_payload_words[8];
+    }
+    native_gpu_channel_wait(POLLOUT, deadline);
+    if (send(native_gpu.event_fd, &event, sizeof(event), MSG_DONTWAIT | MSG_NOSIGNAL)
+        != sizeof(event)) {
+        native_gpu_fail("could not send complete owner witness");
+    }
+    native_gpu_channel_wait(POLLIN, deadline);
+    struct iovec iov = { .iov_base = &ack, .iov_len = sizeof(ack) };
+    union { struct cmsghdr align; char bytes[CMSG_SPACE(sizeof(struct ucred))]; } control;
+    memset(&control, 0, sizeof(control));
+    struct msghdr msg = {
+        .msg_iov = &iov, .msg_iovlen = 1,
+        .msg_control = control.bytes, .msg_controllen = sizeof(control.bytes),
+    };
+    ssize_t received = recvmsg(native_gpu.event_fd, &msg, MSG_DONTWAIT);
+    if (received != sizeof(ack) || (msg.msg_flags & (MSG_TRUNC | MSG_CTRUNC))) {
+        native_gpu_fail("truncated or malformed owner acknowledgment");
+    }
+    struct cmsghdr *c = CMSG_FIRSTHDR(&msg);
+    struct ucred credential;
+    if (!c || c->cmsg_level != SOL_SOCKET || c->cmsg_type != SCM_CREDENTIALS ||
+        c->cmsg_len != CMSG_LEN(sizeof(credential)) || CMSG_NXTHDR(&msg, c)) {
+        native_gpu_fail("owner acknowledgment lacks exact process credentials");
+    }
