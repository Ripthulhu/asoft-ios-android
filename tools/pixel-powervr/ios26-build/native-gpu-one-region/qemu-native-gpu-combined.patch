+        sl->owner_pid != native_gpu.stub_pid || sl->tid != native_gpu.worker_tid ||
+        sl->proof_ack_count != expected || sl->proof_ack_kind != kind ||
+        sl->proof_ack_generation != native_gpu.generation ||
+        sl->proof_ack_invalidation != native_gpu.invalidation_generation ||
+        sl->fill.gen != native_gpu.invalidation_generation ||
