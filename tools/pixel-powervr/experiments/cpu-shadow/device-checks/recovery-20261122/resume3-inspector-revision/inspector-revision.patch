+                any(type(info.get(k)) is not int for k in ("flags", "jib_offset", "offset", "bytes")) or
+                info["flags"] not in (1, 5) or info["jib_offset"] != volumes[0]["geometry"]["jib_block"] * 4096 or
+                info["bytes"] != 8 << 20 or info["offset"] % 4096 or
