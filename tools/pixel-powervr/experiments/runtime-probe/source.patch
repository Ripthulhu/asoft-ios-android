+use crate::move_page::MovePage;
+use crate::{
+    air, checked, guard_native_reads, require, run, stop, EXIT_FAIL, EXIT_MOVE_UNSUPPORTED,
+    EXIT_UNSUPPORTED,
+};
+use ash::vk;
+use metal2vulkan_runtime::{
+    Buffer, CommandQueue, ComputePipelineState, Device, ExecutedPipeline, PipelineOptions,
+    ResourceOptions, Size, VkBufferMemory,
+};
+use std::ptr::{self, NonNull};
+use std::sync::atomic::{fence, Ordering};
+
+const COUNT: usize = 64;
+const INPUT_PAGE: usize = 5;
+const OUTPUT_PAGE: usize = 6;
+
+fn compare(pointer: *const u8, expected: &[u32], label: &str, code: i32) {
+    for (i, wanted) in expected.iter().copied().enumerate() {
+        // SAFETY: the caller supplies the live mapped span, only after GPU completion.
+        let got = unsafe { pointer.cast::<u32>().add(i).read_volatile() };
+        if got != wanted {
+            stop(
+                code,
+                label,
+                format_args!("word={i} got=0x{got:08x} expected=0x{wanted:08x}"),
+            );
+        }
+    }
+    println!("{label}=PASS checked_words={}", expected.len());
+}
+
+fn write(pointer: *mut u8, words: &[u32]) {
+    for (i, word) in words.iter().copied().enumerate() {
+        // SAFETY: the caller supplies a live writable span, with no GPU work outstanding.
+        unsafe { pointer.cast::<u32>().add(i).write_volatile(word) };
+    }
+    fence(Ordering::SeqCst);
+}
+
+struct ComputeRun<'a> {
+    device: &'a Device,
+    queue: &'a CommandQueue,
+    pipeline: &'a ComputePipelineState,
+    metal: &'a Buffer,
+    readback: &'a Buffer,
+}
+
+impl ComputeRun<'_> {
+    fn dispatch(&self, input: u64, output: u64, factor: f32, label: &str) {
+        let Self {
+            device,
+            queue,
+            pipeline,
+            metal,
+            readback,
+        } = *self;
+        let scale = checked(
+            device.new_buffer_with_bytes(&factor.to_le_bytes(), ResourceOptions::shared()),
+            "SCALE_BUFFER_FAILED",
+        );
+        let command = checked(queue.command_buffer(), "COMMAND_BUFFER_FAILED");
+        let mut encoder = checked(command.compute_command_encoder(), "COMPUTE_ENCODER_FAILED");
+        checked(
+            encoder.set_compute_pipeline_state(pipeline),
+            "COMPUTE_PIPELINE_BIND_FAILED",
+        );
+        checked(
+            encoder.set_buffer(Some(metal), input, 0),
+            "INPUT_BIND_FAILED",
+        );
+        checked(
+            encoder.set_buffer(Some(metal), output, 1),
+            "OUTPUT_BIND_FAILED",
+        );
+        checked(encoder.set_buffer(Some(&scale), 0, 2), "SCALE_BIND_FAILED");
+        checked(
+            encoder.dispatch_threads(Size::new(COUNT as u64, 1, 1), Size::new(32, 1, 1)),
+            "DISPATCH_FAILED",
+        );
+        checked(encoder.end_encoding(), "COMPUTE_END_FAILED");
+        let mut blit = checked(command.blit_command_encoder(), "READBACK_ENCODER_FAILED");
+        checked(
+            blit.copy_from_buffer_to_buffer(metal, 0, readback, 0, metal.length()),
+            "READBACK_COPY_FAILED",
+        );
+        checked(blit.end_encoding(), "READBACK_END_FAILED");
+        run(&command, label);
+        let records = command.executions();
+        require(
+            records.len() == 1,
+            "COMPUTE_RECORD_COUNT_FAILED",
+            records.len(),
+        );
+        let ExecutedPipeline::Compute(artifact) = records[0].pipeline() else {
+            stop(
+                EXIT_FAIL,
+                "COMPUTE_RECORD_KIND_FAILED",
+                "expected a compute execution",
+            );
+        };
+        require(
+            !artifact.stage.spirv.is_empty(),
+            "COMPUTE_SPIRV_MISSING",
+            "actual executed pipeline",
+        );
+        println!("COMPUTE_EXECUTED phase={label} dispatch_threads={COUNT} input_offset={input} output_offset={output} factor={factor} entry={:?} spirv_words={}", artifact.stage.entry_point, artifact.stage.spirv.len());
+    }
+}
+
+fn expected_dispatch(expected: &mut [u32], input: usize, output: usize, factor: f32) {
+    for i in 0..COUNT {
+        expected[output + i] = (f32::from_bits(expected[input + i]) * factor + i as f32).to_bits();
+    }
+}
+
+pub(crate) fn probe(device: &Device, native_move: bool) {
+    // SAFETY: process page-size query, checked before converting to usize.
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
