+        compare(
+            readback_ptr.as_ptr(),
+            &expected,
+            "RUNTIME_MOVE_SHADER_READ_GPU_BACK",
+            EXIT_FAIL,
+        );
+
+        compute.dispatch(
+            (output * 4) as u64,
+            (input * 4) as u64,
+            2.0,
+            "metal-compute-to-moved-cpu",
+        );
+        expected_dispatch(&mut expected, output, input, 2.0);
+        compare(
+            mapping.as_ptr(),
+            &expected,
+            "RUNTIME_MOVE_SHADER_WRITE_CANONICAL",
+            EXIT_FAIL,
+        );
+        compare(
+            full.cast(),
+            &expected,
+            "RUNTIME_MOVE_SHADER_WRITE_NATIVE",
+            EXIT_FAIL,
+        );
+        compare(
+            readback_ptr.as_ptr(),
+            &expected,
+            "RUNTIME_MOVE_SHADER_WRITE_GPU_BACK",
+            EXIT_FAIL,
+        );
+        compare(
+            moved.slot(),
+            &expected[input..input + words_per_page],
+            "RUNTIME_MOVE_SHADER_WRITE_ALIAS",
+            EXIT_FAIL,
+        );
+        checked(moved.cleanup(), "RUNTIME_MOVE_CLEANUP_FAILED");
+        // SAFETY: retained independent full map, no pending GPU work; moved helper excluded the hole.
+        require(
+            unsafe { libc::munmap(full, bytes) } == 0,
+            "FULL_NATIVE_CLEANUP_FAILED",
+            std::io::Error::last_os_error(),
+        );
+        println!("RUNTIME_MOVED_PAGE_COMPUTE=PASS cpu_source_page=5 shader_elements={COUNT} checked_pages=8 untouched_guard_pages=6 gpu_buffer=contiguous cleanup=exact");
+    } else {
+        println!("NATIVE_MOVE=NOT_REQUESTED mode=producer-compute-only");
+    }
+    drop(metal);
+    // Every command was dropped after completion inside dispatch. Nothing names the adopted
+    // VkBuffer now. The independent runtime readback, pipeline and queue own no such reference.
+    // SAFETY: caller-owned objects released in lifetime order after all work is complete.
+    unsafe {
+        raw.device.unmap_memory(memory);
+        raw.device.destroy_buffer(buffer, None);
+        raw.device.free_memory(memory, None);
+        require(
+            libc::close(fd) == 0,
+            "EXPORTED_FD_CLOSE_FAILED",
+            std::io::Error::last_os_error(),
+        );
+    }
+    println!("PRODUCER_OWNER_CLEANUP=PASS");
+}
diff --git a/pixel-runtime-probes/src/tile.rs b/pixel-runtime-probes/src/tile.rs
new file mode 100644
index 0000000..659af91
--- /dev/null
+++ b/pixel-runtime-probes/src/tile.rs
@@ -0,0 +1,182 @@
+use crate::{air, checked, require, run, stop, EXIT_UNSUPPORTED};
+use metal2vulkan::device::{VkExtension, VkFeature};
+use metal2vulkan::metal::{BarrierScope, PixelFormat, PrimitiveType, RenderStages, TextureUsage};
+use metal2vulkan::pipeline::{
+    ColorAttachmentDescriptor, RenderPipelineDescriptor, SampledType, StageSource,
+    TileImageAttachmentUse,
+};
+use metal2vulkan_runtime::{
+    BlitOption, ClearColor, Device, ExecutedPipeline, LoadAction, Origin, PipelineOptions,
+    RenderPassDescriptor, ResourceOptions, Size, StoreAction, TextureDescriptor,
+};
+
+const SIDE: u64 = 32;
+
+pub(crate) fn probe(device: &Device) {
+    let enables = device.enabled();
+    if !enables.features.contains(&VkFeature::DynamicRendering)
+        || !enables
+            .features
+            .contains(&VkFeature::ShaderTileImageColorReadAccess)
+        || !enables
+            .extensions
+            .contains(&VkExtension::ExtShaderTileImage)
+    {
+        stop(
+            EXIT_UNSUPPORTED,
+            "TILE_RUNTIME_UNSUPPORTED",
+            "normal runtime enable set lacks dynamic rendering and coherent color tile access",
+        );
+    }
+    let vertex_library = air(
+        device,
+        include_bytes!(concat!(env!("OUT_DIR"), "/vertex.air")),
+        "fullscreen-vertex",
+    );
+    let fragment_library = air(
+        device,
+        include_bytes!(concat!(env!("OUT_DIR"), "/fragment.air")),
+        "framebuffer-fetch",
+    );
+    let vertex = checked(
+        vertex_library.new_function_with_name("fbl8_safe_vertex"),
+        "VERTEX_LOOKUP_FAILED",
+    );
+    let fragment = checked(
+        fragment_library.new_function_with_name("fetch_scalar"),
+        "FRAGMENT_LOOKUP_FAILED",
+    );
+    let mut descriptor =
+        RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+    descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+    descriptor.color_attachments[0] = Some(ColorAttachmentDescriptor::new(PixelFormat::R32Float));
+    let state = checked(
+        device.new_render_pipeline_state(&descriptor, &PipelineOptions::default()),
+        "TILE_AIR_COMPILE_FAILED",
+    );
+    let queue = checked(device.new_command_queue(), "QUEUE_FAILED");
+
+    for (case, clear, draws, barrier) in [(0, 1.0f32, 2u64, false), (1, 0.75f32, 3u64, true)] {
+        let mut texture = TextureDescriptor::texture_2d(PixelFormat::R32Float, SIDE, SIDE, false);
+        texture.usage = TextureUsage::RENDER_TARGET;
+        texture.resource_options = ResourceOptions::private();
+        let target = checked(device.new_texture(&texture), "TILE_TARGET_FAILED");
+        let back = checked(
+            device.new_buffer(SIDE * SIDE * 4, ResourceOptions::shared()),
+            "TILE_READBACK_FAILED",
+        );
+        let mut pass = RenderPassDescriptor::new();
+        let color = &mut pass.color_attachments[0];
+        color.texture = Some(target.clone());
+        color.load_action = LoadAction::Clear;
+        color.store_action = StoreAction::Store;
+        color.clear_color = ClearColor::new(clear as f64, 0.0, 0.0, 1.0);
+        let before = device.work_counts();
+        let command = checked(queue.command_buffer(), "COMMAND_BUFFER_FAILED");
+        let mut encoder = checked(
+            command.render_command_encoder(&pass),
+            "RENDER_ENCODER_FAILED",
+        );
+        checked(
+            encoder.set_render_pipeline_state(&state),
+            "RENDER_PIPELINE_BIND_FAILED",
+        );
+        for draw in 0..draws {
+            if barrier && draw != 0 {
+                encoder.memory_barrier_with_scope(
+                    BarrierScope::RENDER_TARGETS,
+                    RenderStages::FRAGMENT,
+                    RenderStages::FRAGMENT,
+                );
+            }
+            checked(
+                encoder.draw_primitives(PrimitiveType::Triangle, 0, 3, 1, 0),
+                "TILE_DRAW_FAILED",
+            );
+        }
+        checked(encoder.end_encoding(), "RENDER_END_FAILED");
+        let mut blit = checked(command.blit_command_encoder(), "BLIT_ENCODER_FAILED");
+        checked(
+            blit.copy_from_texture_to_buffer(
+                &target,
+                0,
+                0,
+                Origin::new(0, 0, 0),
+                Size::new(SIDE, SIDE, 1),
+                &back,
+                0,
+                SIDE * 4,
+                SIDE * SIDE * 4,
+                BlitOption::None,
+            ),
+            "TILE_BLIT_FAILED",
+        );
+        checked(blit.end_encoding(), "BLIT_END_FAILED");
+        run(&command, "compiled-tile-render");
+
+        let records = command.executions();
+        require(
+            records.len() == draws as usize,
+            "TILE_EXECUTION_RECORD_FAILED",
+            format_args!("records={} draws={draws}", records.len()),
+        );
+        for record in &records {
+            let ExecutedPipeline::Render(pipeline) = record.pipeline() else {
+                stop(1, "WRONG_PIPELINE_RECORD", "expected a render pipeline");
+            };
+            require(
+                pipeline.graphics.tile_image_attachments
+                    == [TileImageAttachmentUse::new(0, SampledType::Float)]
+                    && pipeline.graphics.input_attachments.is_empty()
+                    && !pipeline.graphics.rasterization_order_attachment_access,
+                "TILE_PATH_NOT_SELECTED",
+                format_args!("graphics={:?}", pipeline.graphics),
+            );
+            require(
+                pipeline
+                    .requirements
+                    .features
+                    .contains(&VkFeature::ShaderTileImageColorReadAccess),
+                "TILE_REQUIREMENT_MISSING",
+                "actual compiled artifact must require tile color reads",
+            );
+            println!(
+                "TILE_EXECUTED_PIPELINE case={case} attachments={:?} stages={:?}",
+                pipeline.graphics.tile_image_attachments,
+                pipeline
+                    .stages
+                    .iter()
+                    .map(|s| (&s.entry_point, s.spirv.len()))
+                    .collect::<Vec<_>>()
+            );
+        }
+        let after = device.work_counts();
+        let begins = after.commands_replayed.cmd_begin_rendering
+            - before.commands_replayed.cmd_begin_rendering;
+        let ends =
+            after.commands_replayed.cmd_end_rendering - before.commands_replayed.cmd_end_rendering;
+        require(
+            begins == draws && ends == draws,
+            "DYNAMIC_RENDERING_COUNT_FAILED",
+            format_args!("begins={begins} ends={ends} draws={draws}"),
+        );
+        let expected = clear * 0.5f32.powi(draws as i32);
+        let contents = back
+            .contents()
+            .unwrap_or_else(|| stop(1, "READBACK_MAPPING_MISSING", "Shared buffer"));
+        // SAFETY: the Shared readback has this length, and its last command completed.
+        for i in 0..(SIDE * SIDE) as usize {
+            let got = unsafe { contents.as_ptr().cast::<u32>().add(i).read_volatile() };
+            require(
+                got == expected.to_bits(),
+                "TILE_PIXEL_MISMATCH",
+                format_args!(
+                    "case={case} pixel={i} got=0x{got:08x} expected=0x{:08x}",
+                    expected.to_bits()
+                ),
+            );
+        }
+        println!("TILE_CASE=PASS case={case} clear={clear} draws={draws} explicit_barriers={barrier} checked_pixels=1024 wrong=0 expected={expected} dynamic_begins={begins} dynamic_ends={ends}");
+    }
+    println!("TILE_RUNTIME=PASS input=AIR compiler=runtime actual_tile_metadata=true dynamic_rendering=true cases=2 pixels=2048");
+}
