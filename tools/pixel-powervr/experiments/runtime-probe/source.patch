+#!/usr/bin/env python3
+"""Cross-build only this diagnostic and record the exact inputs and output."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def output(command, **kwargs):
+    return subprocess.check_output(command, text=True, **kwargs).strip()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ndk", required=True, type=Path)
+    parser.add_argument("--cargo", default=shutil.which("cargo") or "cargo")
+    parser.add_argument("--toolchain", default="1.98.1")
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--target-dir", type=Path)
+    args = parser.parse_args()
+    here = Path(__file__).resolve().parent
+    root = here.parent
+    destination = args.output.resolve()
+    destination.mkdir(parents=True, exist_ok=True)
+    target = (args.target_dir or destination / "cargo-target").resolve()
+    tools = args.ndk.resolve() / "toolchains/llvm/prebuilt/linux-x86_64/bin"
+    compiler = tools / "aarch64-linux-android35-clang"
+    assembler = tools / "llvm-as"
+    strip = tools / "llvm-strip"
+    readelf = tools / "llvm-readelf"
+    for path in (compiler, assembler, strip, readelf):
+        if not path.is_file():
+            parser.error(f"tool not found: {path}")
+    env = os.environ.copy()
+    env.pop("RUSTFLAGS", None)
+    env["CARGO_TARGET_DIR"] = str(target)
+    env["CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER"] = str(compiler)
+    env["PIXEL_LLVM_AS"] = str(assembler)
+    rust_flags = ["-Dwarnings", "-C", "link-arg=-Wl,-z,max-page-size=16384",
+                  "--remap-path-prefix", f"{root}=/metal2vulkan"]
+    env["CARGO_ENCODED_RUSTFLAGS"] = "\x1f".join(rust_flags)
+    cargo = [args.cargo, f"+{args.toolchain}"]
+    manifest = str(here / "Cargo.toml")
+    if not (here / "Cargo.lock").exists():
+        subprocess.run(cargo + ["generate-lockfile", "--offline", "--manifest-path", manifest],
+                       env=env, cwd=root, check=True)
+    command = cargo + ["build", "--offline", "--locked", "--release", "--target",
+                       "aarch64-linux-android", "--manifest-path", manifest]
+    subprocess.run(command, env=env, cwd=root, check=True)
+    binary = destination / "pixel_runtime_probe"
+    shutil.copy2(target / "aarch64-linux-android/release/pixel_runtime_probe", binary)
+    subprocess.run([strip, "--strip-all", binary], check=True)
+    elf = output([readelf, "-h", "-l", "-d", binary])
+    (destination / "elf-info.txt").write_text(elf + "\n")
+    fixtures = root / "crates/metal2vulkan-validation/fixtures/public"
+    inputs = [here / "Cargo.toml", here / "Cargo.lock", here / "build.rs", here / "build.py"]
+    inputs += sorted((here / "src").glob("*.rs"))
+    inputs += [fixtures / relative for relative in (
+        "examples/runtime_examples.ll", "engine/fbl_fetch_blend8_safe.ll", "engine/fragment_fetch.ll")]
+    metadata = {
+        "probe": "pixel_runtime_probe",
+        "target": "aarch64-linux-android", "android_api": 35,
+        "m2v_reference": "ffda2ffd9485b6796ad8ca49bc024bf97401342c",
+        "m2v_head": output(["git", "rev-parse", "HEAD"], cwd=root),
+        "cargo": output(cargo + ["--version", "--verbose"]),
+        "ndk_source_properties": (args.ndk.resolve() / "source.properties").read_text(),
+        "clang": output([compiler, "--version"]),
+        "llvm_as": output([assembler, "--version"]),
+        "rust_flags": rust_flags,
+        "build_command": command,
+        "inputs": {str(path.relative_to(root)): sha(path) for path in inputs},
+        "binary": {"file": binary.name, "bytes": binary.stat().st_size, "sha256": sha(binary)},
+        "air_input": "Owned LLVM text assembled at build time; AIR-to-SPIR-V translation runs in the probe.",
+        "device_execution": "Not established by this build; see separate device evidence.",
+    }
+    (destination / "build-info.json").write_text(json.dumps(metadata, indent=2) + "\n")
+    (destination / "SHA256SUMS").write_text(f"{sha(binary)}  {binary.name}\n")
+    print(json.dumps(metadata["binary"]))
+
+
+if __name__ == "__main__":
+    main()
