+        stop(EXIT_UNSUPPORTED, "PAGE_SIZE_UNSUPPORTED", page);
+    }
+    let page = page as usize;
+    let bytes = page * 8;
+    let words_per_page = page / 4;
+    let library = air(
+        device,
+        include_bytes!(concat!(env!("OUT_DIR"), "/compute.air")),
+        "scale-and-offset",
+    );
+    let function = checked(
+        library.new_function_with_name("scale_and_offset"),
+        "COMPUTE_LOOKUP_FAILED",
+    );
+    let pipeline = checked(
+        device.new_compute_pipeline_state_with_function(&function, &PipelineOptions::default()),
+        "COMPUTE_AIR_COMPILE_FAILED",
+    );
+    let queue = checked(device.new_command_queue(), "QUEUE_FAILED");
+    let readback = checked(
+        device.new_buffer(bytes as u64, ResourceOptions::shared()),
+        "READBACK_ALLOCATION_FAILED",
+    );
+    // SAFETY: use the runtime's borrowed handles, without destroying them or submitting raw queues.
+    let raw = unsafe { device.raw() };
+    let usage = vk::BufferUsageFlags::from(device.vk_buffer_usage());
+    let handle = vk::ExternalMemoryHandleTypeFlags::OPAQUE_FD;
+    let query = vk::PhysicalDeviceExternalBufferInfo::default()
+        .usage(usage)
+        .handle_type(handle);
+    let mut support = vk::ExternalBufferProperties::default();
+    // SAFETY: the feature-independent query uses the exact buffer flags (zero) and usage.
+    unsafe {
+        raw.instance.get_physical_device_external_buffer_properties(
+            raw.physical_device,
+            &query,
+            &mut support,
+        )
+    };
+    let flags = support.external_memory_properties.external_memory_features;
+    println!("OPAQUE_CONTRACT usage=0x{:x} external_features=0x{:x} importable={} exportable={} dedicated_only={} page_size={page} bytes={bytes}",
+        usage.as_raw(), flags.as_raw(), flags.contains(vk::ExternalMemoryFeatureFlags::IMPORTABLE),
+        flags.contains(vk::ExternalMemoryFeatureFlags::EXPORTABLE), flags.contains(vk::ExternalMemoryFeatureFlags::DEDICATED_ONLY));
+    if !flags.contains(vk::ExternalMemoryFeatureFlags::EXPORTABLE)
+        || flags.contains(vk::ExternalMemoryFeatureFlags::DEDICATED_ONLY)
+    {
+        stop(
+            EXIT_UNSUPPORTED,
+            "PRODUCER_CONTRACT_UNSUPPORTED",
+            "exact runtime usage needs non-dedicated exportable opaque memory",
+        );
+    }
+    let mut external = vk::ExternalMemoryBufferCreateInfo::default().handle_types(handle);
+    let mut info = vk::BufferCreateInfo::default()
+        .size(bytes as u64)
+        .usage(usage)
+        .sharing_mode(vk::SharingMode::EXCLUSIVE)
+        .push_next(&mut external);
