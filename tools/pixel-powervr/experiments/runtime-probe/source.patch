@@ -0,0 +1,32 @@
+//! Only assemble the repository's owned LLVM text to input AIR. All AIR -> SPIR-V
+//! translation and Vulkan pipeline creation still happen in the running probe.
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-env-changed=PIXEL_LLVM_AS");
+    let tool = std::env::var_os("PIXEL_LLVM_AS").unwrap_or_else(|| "llvm-as".into());
+    let root = PathBuf::from(std::env::var_os("CARGO_MANIFEST_DIR").unwrap())
+        .join("../crates/metal2vulkan-validation/fixtures/public");
+    let out = PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+    for (source, name) in [
+        ("examples/runtime_examples.ll", "compute.air"),
+        ("engine/fbl_fetch_blend8_safe.ll", "vertex.air"),
+        ("engine/fragment_fetch.ll", "fragment.air"),
+    ] {
+        let input = root.join(source);
+        println!("cargo:rerun-if-changed={}", input.display());
+        let result = Command::new(&tool)
+            .arg(&input)
+            .arg("-o")
+            .arg(out.join(name))
+            .output()
+            .expect("run LLVM 21+ llvm-as (set PIXEL_LLVM_AS)");
+        assert!(
+            result.status.success(),
+            "llvm-as {}: {}",
+            input.display(),
+            String::from_utf8_lossy(&result.stderr)
+        );
+    }
+}
