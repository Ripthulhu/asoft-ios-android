@@ -0,0 +1,240 @@
+//! CPU-only movement of one page from a disposable full offset-zero mapping.
+//! Never moves either vkMapMemory or the retained full native baseline map.
+use std::io;
+use std::ptr;
+
+// libc 0.2.191 omits this declaration on Android. These are the exact Linux and
+// NDK r29 sys/mman.h ABI and constants, used unchanged by the host fixture too.
+const MREMAP_MAYMOVE: libc::c_int = 1;
+const MREMAP_FIXED: libc::c_int = 2;
+unsafe extern "C" {
+    fn mremap(
+        old_address: *mut libc::c_void,
+        old_size: libc::size_t,
+        new_size: libc::size_t,
+        flags: libc::c_int,
+        ...
+    ) -> *mut libc::c_void;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum State {
+    Prepared,
+    Moved,
+    Uncertain,
+    Empty,
+}
+
+pub(crate) struct MovePage {
+    source: *mut u8,
+    slot: *mut u8,
+    page: usize,
+    bytes: usize,
+    offset: usize,
+    state: State,
+    owned: [(*mut u8, usize); 3],
+}
+
+impl MovePage {
+    pub(crate) fn prepare(fd: libc::c_int, page: usize, bytes: usize) -> io::Result<Self> {
+        if !(4096..=65536).contains(&page) || !page.is_power_of_two() || bytes != page * 8 {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        // SAFETY: two fresh mappings with no fixed-address replacement.
+        let source = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                bytes,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            )
+        };
+        if source == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: a fresh owned destination, disjoint from the existing source.
+        let slot = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                page,
+                libc::PROT_NONE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        };
+        if slot == libc::MAP_FAILED {
+            let error = io::Error::last_os_error();
+            // SAFETY: before mremap the entire source is still the mapping we own.
+            unsafe { libc::munmap(source, bytes) };
+            return Err(error);
+        }
+        Ok(Self {
+            source: source.cast(),
+            slot: slot.cast(),
+            page,
+            bytes,
+            offset: 5 * page,
+            state: State::Prepared,
+            owned: [
+                (source.cast(), bytes),
+                (ptr::null_mut(), 0),
+                (slot.cast(), page),
+            ],
+        })
+    }
+
+    pub(crate) fn source(&self) -> *mut u8 {
+        self.source
+    }
+    pub(crate) fn slot(&self) -> *mut u8 {
+        self.slot
+    }
+
+    /// Caller must read/verify the full source first, while GPU work is fenced.
+    /// After ANY syscall failure, the only safe probe path is immediate exit:
+    /// the kernel may already have unmapped the owned fixed destination.
+    pub(crate) fn move_one(&mut self) -> io::Result<()> {
+        if self.state != State::Prepared {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        self.state = State::Uncertain;
+        // SAFETY: equal-sized, page-aligned move into our separate owned reservation.
+        // The full source has been populated; the caller never reuses its moved hole.
+        let got = unsafe {
+            mremap(
+                self.source.add(self.offset).cast(),
+                self.page,
+                self.page,
+                MREMAP_MAYMOVE | MREMAP_FIXED,
+                self.slot.cast::<libc::c_void>(),
+            )
+        };
+        if got == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        if got != self.slot.cast() {
+            return Err(io::Error::from_raw_os_error(libc::EFAULT));
+        }
+        self.owned[0] = (self.source, self.offset);
+        // SAFETY: this address is inside the former full source; its suffix remains owned.
+        self.owned[1] = (
+            unsafe { self.source.add(self.offset + self.page) },
+            self.bytes - self.offset - self.page,
+        );
+        self.state = State::Moved;
+        Ok(())
+    }
+
+    pub(crate) fn cleanup(&mut self) -> io::Result<()> {
+        if self.state == State::Uncertain {
+            return Err(io::Error::from_raw_os_error(libc::EBUSY));
+        }
+        for interval in &mut self.owned {
+            if interval.1 == 0 {
+                continue;
+            }
+            // SAFETY: these are only the live intervals whose ownership we recorded.
+            if unsafe { libc::munmap(interval.0.cast(), interval.1) } != 0 {
+                self.state = State::Uncertain;
+                return Err(io::Error::last_os_error());
+            }
+            *interval = (ptr::null_mut(), 0);
+        }
+        self.state = State::Empty;
+        Ok(())
+    }
+}
+
+// Deliberately no Drop: uncertain mappings must not be reclaimed by inferred ranges.
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ordinary_memfd_page_moves_and_cleanup_preserves_a_reused_source_hole() {
+        // SAFETY: the fixture owns every fd/map and never submits GPU work.
+        unsafe {
+            let page = libc::sysconf(libc::_SC_PAGESIZE) as usize;
+            let bytes = page * 8;
+            let fd = libc::memfd_create(c"runtime-move-fixture".as_ptr(), libc::MFD_CLOEXEC);
+            assert!(fd >= 0);
+            assert_eq!(libc::ftruncate(fd, bytes as libc::off_t), 0);
+            let full = libc::mmap(
+                ptr::null_mut(),
+                bytes,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            );
+            assert_ne!(full, libc::MAP_FAILED);
+            for i in 0..bytes / 4 {
+                full.cast::<u32>()
+                    .add(i)
+                    .write_volatile(0x41000000 | i as u32);
+            }
+            let mut moved = MovePage::prepare(fd, page, bytes).unwrap();
+            for i in 0..bytes / 4 {
+                assert_eq!(
+                    moved.source().cast::<u32>().add(i).read_volatile(),
+                    0x41000000 | i as u32
+                );
+            }
+            let hole = moved.source().add(page * 5);
+            moved.move_one().unwrap();
+            for i in 0..page / 4 {
+                assert_eq!(
+                    moved.slot().cast::<u32>().add(i).read_volatile(),
+                    0x41000000 | (page * 5 / 4 + i) as u32
+                );
+            }
+            moved.slot().cast::<u32>().write_volatile(0x12345678);
+            assert_eq!(
+                full.cast::<u8>()
+                    .add(page * 5)
+                    .cast::<u32>()
+                    .read_volatile(),
+                0x12345678
+            );
+            full.cast::<u8>()
+                .add(page * 5 + 4)
+                .cast::<u32>()
+                .write_volatile(0x76543210);
+            assert_eq!(
+                moved.slot().cast::<u32>().add(1).read_volatile(),
+                0x76543210
+            );
+            let sentinel = libc::mmap(
+                hole.cast(),
+                page,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED_NOREPLACE,
+                -1,
+                0,
+            );
+            assert_eq!(sentinel, hole.cast());
+            sentinel.cast::<u32>().write_volatile(0xaabbccdd);
+            moved.cleanup().unwrap();
+            assert_eq!(sentinel.cast::<u32>().read_volatile(), 0xaabbccdd);
+            for p in 0..8 {
+                if p == 5 {
+                    continue;
+                }
+                for word in 0..page / 4 {
+                    let i = p * page / 4 + word;
+                    assert_eq!(
+                        full.cast::<u32>().add(i).read_volatile(),
+                        0x41000000 | i as u32
+                    );
+                }
+            }
+            assert_eq!(libc::munmap(sentinel, page), 0);
+            assert_eq!(libc::munmap(full, bytes), 0);
+            assert_eq!(libc::close(fd), 0);
+        }
+    }
+}
