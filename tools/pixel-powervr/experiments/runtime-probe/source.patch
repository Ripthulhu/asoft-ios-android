--- /dev/null
+++ b/pixel-runtime-probes/src/main.rs
@@ -0,0 +1,194 @@
+//! Bounded, real public-runtime tests; this binary does not modify product gates.
+mod move_page;
+mod producer;
+mod tile;
+
+use metal2vulkan::device::{ApiVersion, VkFeature};
+use metal2vulkan_runtime::{
+    CommandBuffer, CommandBufferStatus, Device, DeviceOptions, Library, ShaderCacheOptions,
+};
+use std::fmt::{Debug, Display};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicI32, Ordering};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+const GPU_WAIT: Duration = Duration::from_secs(5);
+const EXIT_FAIL: i32 = 1;
+const EXIT_UNSUPPORTED: i32 = 3;
+const EXIT_MOVE_UNSUPPORTED: i32 = 5;
+const EXIT_TIMEOUT: i32 = 6;
+static NATIVE_FAULT_EXIT: AtomicI32 = AtomicI32::new(EXIT_UNSUPPORTED);
+
+/// No destructors run after an error. This also avoids releasing Vulkan objects
+/// after an uncertain submission or an uncertain MREMAP_FIXED destination.
+pub(crate) fn stop(code: i32, label: &str, detail: impl Display) -> ! {
+    eprintln!("{label}: {detail}");
+    println!("RESULT={label} exit={code}");
+    let _ = std::io::stdout().flush();
+    let _ = std::io::stderr().flush();
+    // SAFETY: a standalone bounded diagnostic; the OS reclaims all its resources.
+    unsafe { libc::_exit(code) }
+}
+
+pub(crate) fn checked<T, E: Display + Debug>(result: Result<T, E>, label: &str) -> T {
+    result.unwrap_or_else(|error| stop(EXIT_FAIL, label, format_args!("typed={error:?}; {error}")))
+}
+
+pub(crate) fn require(yes: bool, label: &str, detail: impl Display) {
+    if !yes {
+        stop(EXIT_FAIL, label, detail);
+    }
+}
+
+extern "C" fn native_fault(signal: i32) {
+    const MESSAGE: &[u8] = b"NATIVE_MAPPING_FAULT: terminating without uncertain cleanup\n";
+    // SAFETY: write and _exit are async-signal-safe; this is a static byte string.
+    unsafe {
+        libc::write(2, MESSAGE.as_ptr().cast(), MESSAGE.len());
+        let code = NATIVE_FAULT_EXIT.load(Ordering::Relaxed);
+        libc::_exit(if signal == libc::SIGBUS {
+            code
+        } else {
+            EXIT_FAIL
+        });
+    }
+}
+
+pub(crate) fn guard_native_reads(code: i32) {
+    NATIVE_FAULT_EXIT.store(code, Ordering::Relaxed);
+    // SAFETY: process-local handlers; this diagnostic has no recoverable fault path.
+    unsafe {
+        let mut action: libc::sigaction = std::mem::zeroed();
+        action.sa_sigaction = native_fault as *const () as libc::sighandler_t;
+        libc::sigemptyset(&mut action.sa_mask);
+        require(
+            libc::sigaction(libc::SIGBUS, &action, std::ptr::null_mut()) == 0,
+            "SIGACTION_FAILED",
+            std::io::Error::last_os_error(),
+        );
+    }
+}
+
+pub(crate) fn run(command: &CommandBuffer, label: &str) {
+    checked(command.commit(), "COMMAND_COMMIT_FAILED");
+    if command.wait_until_completed_for(GPU_WAIT).is_err() {
+        stop(
+            EXIT_TIMEOUT,
+            "GPU_TIMEOUT",
+            format_args!("phase={label} wait_ms=5000"),
+        );
+    }
+    require(
+        command.status() == CommandBufferStatus::Completed && command.error().is_none(),
+        "COMMAND_EXECUTION_FAILED",
+        format_args!(
+            "phase={label} status={:?} error={:?}",
+            command.status(),
+            command.error()
+        ),
+    );
+    println!("GPU_COMPLETED phase={label} wait_limit_ms=5000");
+}
+
+pub(crate) fn air(device: &Device, input: &[u8], label: &str) -> Library {
+    // LLVM may wrap an AIR-target module in its standard bitcode wrapper.
+    // The library parser below validates the complete bitcode in either form.
+    require(
+        input.starts_with(b"BC\xc0\xde") || input.starts_with(&0x0b17_c0deu32.to_le_bytes()),
+        "BAD_EMBEDDED_AIR",
+        label,
+    );
+    println!(
+        "AIR_INPUT label={label} bytes={} format=LLVM-bitcode translation=on-device",
+        input.len()
+    );
+    let parsed = checked(
+        metal2vulkan::library::Library::from_air(input),
+        "AIR_PARSE_FAILED",
+    );
+    device.new_library_with_compile_library(parsed)
+}
+
+fn device(cache: &Path, external_fd: bool) -> Device {
+    let mut options = DeviceOptions::default();
+    options.instance_api_version = Some(ApiVersion::V1_3);
+    options.record_executions = true;
+    options.shader_cache = ShaderCacheOptions::in_directory(cache);
+    options.shader_cache.capacity = 16 << 20;
+    options.shader_cache.memory_capacity = 64 << 20;
+    if external_fd {
+        options
+            .device_extensions
+            .push(c"VK_KHR_external_memory_fd".to_owned());
+    }
+    let device = checked(
+        Device::system_default_with(&options),
+        "RUNTIME_DEVICE_FAILED",
+    );
+    println!("RUNTIME_DEVICE name={:?} requested_api=1.3", device.name());
+    let features = &device.enabled().features;
+    println!(
+        "RUNTIME_FEATURES bda={} dynamic_rendering={} tile_color_read={} roaa={} pixel_interlock={}",
+        features.contains(&VkFeature::BufferDeviceAddress),
+        features.contains(&VkFeature::DynamicRendering),
+        features.contains(&VkFeature::ShaderTileImageColorReadAccess),
+        features.contains(&VkFeature::RasterizationOrderColorAttachmentAccess),
+        features.contains(&VkFeature::FragmentShaderPixelInterlock),
+    );
+    device
+}
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let mode = args.next().unwrap_or_default();
+    if !matches!(
+        mode.as_str(),
+        "--producer" | "--producer-compute-only" | "--tile"
+    ) {
+        eprintln!("usage: pixel_runtime_probe (--producer|--producer-compute-only|--tile) [--cache-root WRITABLE_DIRECTORY]");
+        std::process::exit(2);
+    }
+    let root = match args.next().as_deref() {
+        None => checked(std::env::current_dir(), "CURRENT_DIRECTORY_FAILED"),
+        Some("--cache-root") => PathBuf::from(args.next().unwrap_or_else(|| {
+            stop(
+                2,
+                "BAD_ARGUMENTS",
+                "--cache-root needs a writable directory",
+            )
+        })),
+        Some(other) => stop(2, "BAD_ARGUMENTS", other),
+    };
+    require(
+        args.next().is_none(),
+        "BAD_ARGUMENTS",
+        "unexpected trailing argument",
+    );
+    let stamp = checked(SystemTime::now().duration_since(UNIX_EPOCH), "CLOCK_FAILED").as_nanos();
+    let cache = root.join(format!("pixel-runtime-{}-{stamp}", std::process::id()));
+    // create_dir, not create_dir_all: this must be a new empty cache for this run.
+    checked(std::fs::create_dir(&cache), "FRESH_CACHE_FAILED");
+    println!(
+        "PROBE=real-metal2vulkan-runtime base=ffda2ffd9485b6796ad8ca49bc024bf97401342c mode={mode} uid={} euid={} cache={}",
+        // SAFETY: identity queries have no preconditions.
+        unsafe { libc::getuid() }, unsafe { libc::geteuid() }, cache.display()
+    );
+    let device = device(&cache, mode != "--tile");
+    match mode.as_str() {
+        "--producer" => producer::probe(&device, true),
+        "--producer-compute-only" => producer::probe(&device, false),
+        "--tile" => tile::probe(&device),
+        _ => unreachable!(),
+    }
+    drop(device);
+    checked(std::fs::remove_dir_all(&cache), "CACHE_CLEANUP_FAILED");
+    println!(
+        "RESULT={} exit=0",
+        if mode == "--producer-compute-only" {
+            "COMPUTE_ONLY_PASS"
+        } else {
+            "PASS"
+        }
+    );
+}
